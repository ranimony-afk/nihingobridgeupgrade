index 0000000..a346a7e
--- /dev/null
+++ b/src/app/api/kanji/[character]/readings/route.ts
@@ -0,0 +1,58 @@
+import { NextRequest, NextResponse } from "next/server";
+import { kanjiLexicalGraphService } from "@/services/knowledge/kanjiLexicalGraphService";
+
+export const dynamic = "force-dynamic";
+
+/**
+ * GET /api/kanji/[character]/readings
+ * Retrieve structured reading intelligence for a character:
+ * On'yomi, Kun'yomi, Nanori, Jukujikun, Ateji, irregular readings with okurigana analysis.
+ */
+export async function GET(
+  request: NextRequest,
+  { params }: { params: Promise<{ character: string }> }
+) {
+  try {
+    const { character } = await params;
+    const decoded = decodeURIComponent(character);
+
+    const [canonicalReadings, vocab] = await Promise.all([
+      kanjiLexicalGraphService.getKanjiReadings(decoded),
+      kanjiLexicalGraphService.getKanjiVocabulary(decoded, { limit: 100 }),
+    ]);
+
+    // Extract special whole-compound readings (Jukujikun, Ateji, Irregular)
+    const specialReadings: typeof canonicalReadings = [];
+    const seenSpecial = new Set<string>();
+    vocab.forEach((edge) => {
+      if (
+        (edge.readingType === "JUKUJIKUN" ||
+          edge.readingType === "ATEJI" ||
+          edge.readingType === "SPECIAL" ||
+          edge.readingType === "IRREGULAR") &&
+        !seenSpecial.has(edge.wordReading)
+      ) {
+        seenSpecial.add(edge.wordReading);
+        specialReadings.push({
+          reading: edge.wordReading,
+          normalized: edge.wordReading,
+          type: edge.readingType,
+          hasOkurigana: false,
+        });
+      }
+    });
+
+    const combinedReadings = [...canonicalReadings, ...specialReadings];
+
+    return NextResponse.json({
+      success: true,
+      character: decoded,
+      total: combinedReadings.length,
+      readings: combinedReadings,
