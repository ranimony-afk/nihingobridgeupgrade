@@ -0,0 +1,304 @@
+/**
+ * Phase 14.4F: Takoboto-Class Dictionary & Kanji API + Web UX Foundation Test Battery
+ *
+ * Verifies all 25 testing invariants from Gate 22:
+ * 1. dictionary search
+ * 2. exact lookup
+ * 3. kana lookup
+ * 4. romaji lookup
+ * 5. Kanji lookup
+ * 6. vocabulary detail
+ * 7. Kanji detail
+ * 8. Kanji -> vocabulary
+ * 9. vocabulary -> Kanji
+ * 10. reading filtering
+ * 11. radical display
+ * 12. component display
+ * 13. composition ordering
+ * 14. KanjiVG rendering
+ * 15. stroke-count discrepancy preservation (箸 canonical 14 vs visual 15)
+ * 16. JLPT filtering
+ * 17. special readings (Jukujikun, Ateji, irregular)
+ * 18. CMS overlay
+ * 19. translation priority
+ * 20. security boundaries
+ * 21. pagination
+ * 22. mobile contract
+ * 23. accessibility
+ * 24. empty states
+ * 25. malformed graph fallback
+ */
+
+import { describe, it, expect } from "vitest";
+import { NextRequest } from "next/server";
+import { GET as dictionarySearchGet } from "@/app/api/dictionary/route";
+import { GET as dictionaryEntryGet } from "@/app/api/dictionary/[id]/route";
+import { GET as kanjiDetailGet } from "@/app/api/kanji/[character]/route";
+import { GET as kanjiVocabGet } from "@/app/api/kanji/[character]/vocabulary/route";
+import { GET as kanjiReadingsGet } from "@/app/api/kanji/[character]/readings/route";
+import { GET as kanjiComponentsGet } from "@/app/api/kanji/[character]/components/route";
+import { DictionaryService } from "@/services/dictionary/dictionaryService";
+import { kanjiLexicalGraphService } from "@/services/knowledge/kanjiLexicalGraphService";
+import { kanjiVisualService } from "@/services/knowledge/kanjiVisualService";
+import type { MobileSearchResponse, MobileDictionaryDetailResponse } from "@/types/mobileDictionary";
+
+describe("Phase 14.4F: Takoboto-Class Dictionary & Kanji API Foundation", () => {
+  // 1. dictionary search
+  it("1. executes dictionary search across vocabulary entries", async () => {
+    const req = new NextRequest("http://localhost/api/dictionary?q=水&limit=10");
+    const res = await dictionarySearchGet(req);
+    expect(res.status).toBe(200);
+    const json = await res.json();
+    expect(json.success).toBe(true);
+    expect(json.data.entries.length).toBeGreaterThan(0);
+    expect(json.data.total).toBeGreaterThan(0);
+  });
+
+  // 2. exact lookup
+  it("2. supports exact headword lookup prioritizing exact matches", async () => {
+    const req = new NextRequest("http://localhost/api/dictionary?q=食べる");
+    const res = await dictionarySearchGet(req);
+    const json = await res.json();
+    expect(json.success).toBe(true);
+    const first = json.data.entries[0];
+    expect(first.headword).toBe("食べる");
+  });
+
+  // 3. kana lookup
+  it("3. searches by hiragana/katakana phonetic readings", async () => {
+    const req = new NextRequest("http://localhost/api/dictionary?q=たべる");
+    const res = await dictionarySearchGet(req);
+    const json = await res.json();
+    expect(json.success).toBe(true);
+    const found = json.data.entries.some((e: any) => e.headword === "食べる");
+    expect(found).toBe(true);
+  });
+
+  // 4. romaji lookup
+  it("4. searches by latin-script romaji queries", async () => {
+    const req = new NextRequest("http://localhost/api/dictionary?q=taberu");
+    const res = await dictionarySearchGet(req);
+    const json = await res.json();
+    expect(json.success).toBe(true);
+    const found = json.data.entries.some((e: any) => e.headword === "食べる");
+    expect(found).toBe(true);
+  });
+
+  // 5. Kanji lookup
+  it("5. searches by single kanji character retrieving containing words", async () => {
+    const req = new NextRequest("http://localhost/api/dictionary?q=語");
+    const res = await dictionarySearchGet(req);
+    const json = await res.json();
+    expect(json.success).toBe(true);
+    expect(json.data.entries.length).toBeGreaterThan(0);
+    const allContainKanji = json.data.entries.some((e: any) => e.headword.includes("語"));
+    expect(allContainKanji).toBe(true);
+  });
+
+  // 6. vocabulary detail
+  it("6. loads full vocabulary detail including meanings and POS", async () => {
+    const req = new NextRequest("http://localhost/api/dictionary/de-mizu");
+    const res = await dictionaryEntryGet(req, { params: Promise.resolve({ id: "de-mizu" }) });
+    expect(res.status).toBe(200);
+    const json = await res.json();
+    expect(json.success).toBe(true);
+    expect(json.data.entry.headword).toBe("水");
+    expect(json.data.entry.reading).toBe("みず");
+    expect(json.data.entry.senses.length).toBeGreaterThan(0);
+    expect(json.data.source).toBeDefined();
+  });
+
+  // 7. Kanji detail
+  it("7. loads full kanji detail with meanings, readings, and stroke count", async () => {
+    const req = new NextRequest("http://localhost/api/kanji/%E6%97%A5");
+    const res = await kanjiDetailGet(req, { params: Promise.resolve({ character: "日" }) });
+    expect(res.status).toBe(200);
+    const json = await res.json();
+    expect(json.success).toBe(true);
+    expect(json.kanji.character).toBe("日");
+    expect(json.kanji.strokeCount).toBe(4);
+    expect(json.readings.length).toBeGreaterThan(0);
+  });
+
+  // 8. Kanji -> vocabulary
+  it("8. navigates from kanji to vocabulary containing the character", async () => {
+    const vocab = await kanjiLexicalGraphService.getKanjiVocabulary("日", { limit: 10 });
+    expect(vocab.length).toBeGreaterThan(0);
+    vocab.forEach((edge) => {
+      expect(edge.headword).toContain("日");
+      expect(edge.kanji).toBe("日");
+    });
+  });
+
+  // 9. vocabulary -> Kanji
+  it("9. decomposes vocabulary into constituent kanji characters with clickable links", async () => {
+    const kanjiEdges = await kanjiLexicalGraphService.getVocabularyKanji("de-mizu");
+    expect(kanjiEdges.length).toBe(1);
+    expect(kanjiEdges[0].kanji).toBe("水");
+    expect(kanjiEdges[0].position).toBe(0);
+  });
+
+  // 10. reading filtering
+  it("10. filters kanji vocabulary by specific reading", async () => {
+    const req = new NextRequest("http://localhost/api/kanji/%E9%A3%9F/vocabulary?reading=たべる");
+    const res = await kanjiVocabGet(req, { params: Promise.resolve({ character: "食" }) });
+    const json = await res.json();
+    expect(json.success).toBe(true);
+    expect(json.vocabulary.length).toBeGreaterThan(0);
+    const hasTaberu = json.vocabulary.some((v: any) => v.headword === "食べる");
+    expect(hasTaberu).toBe(true);
+  });
+
+  // 11. radical display
+  it("11. retrieves radical information for canonical kanji", async () => {
+    const req = new NextRequest("http://localhost/api/kanji/%E9%A3%9F/components");
+    const res = await kanjiComponentsGet(req, { params: Promise.resolve({ character: "食" }) });
+    const json = await res.json();
+    expect(json.success).toBe(true);
+    expect(json.radical).toBeDefined();
+    expect(json.radical.character).toBe("食");
+  });
+
+  // 12. component display
+  it("12. decomposes kanji into structural components", async () => {
+    const components = await kanjiLexicalGraphService.getKanjiComponents("明");
+    expect(components.length).toBeGreaterThan(0);
+    const chars = components.map((c) => c.character);
+    expect(chars).toContain("日");
+  });
+
+  // 13. composition ordering
