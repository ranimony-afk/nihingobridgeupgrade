+
+    it("3. returns null for unregistered source lookups", () => {
+      const source = getRegisteredSource("upstream:nonexistent-corpus:2026");
+      expect(source).toBeNull();
+    });
+
+    it("4. blocks unverified candidate sources from ingestion", () => {
+      expect(() => {
