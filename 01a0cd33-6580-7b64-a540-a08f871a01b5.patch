--- /dev/null
+++ b/src/etl/tatoeba/safety.ts
@@ -0,0 +1,86 @@
+/**
+ * Preflight Safety Guard & Disposable Database Assertion — Phase 14.5A.
+ *
+ * Strictly prevents accidental connection or execution against production databases.
+ * Rejects Supabase, Neon, Vercel, or any remote PostgreSQL instance.
+ */
+
+export interface DatabaseTargetSafety {
+  isLoopback: boolean;
+  classification: "AUTHORIZED_LOCAL" | "FORBIDDEN" | "AMBIGUOUS";
+  host: string;
+  port: string;
+  databaseName: string;
+}
+
+export class ProductionDatabaseForbiddenError extends Error {
+  constructor(message: string) {
+    super(`[SAFETY FATAL] Production Database Forbidden: ${message}`);
+    this.name = "ProductionDatabaseForbiddenError";
+  }
+}
+
+/**
+ * Asserts that the target database is an explicitly authorized local disposable instance.
+ * Fails closed if production hosts or external endpoints are detected.
+ */
+export function assertDisposableLocalDatabase(
+  customConnStr?: string
+): DatabaseTargetSafety {
+  const connStr = customConnStr || process.env.DATABASE_URL;
+
+  if (!connStr) {
+    throw new ProductionDatabaseForbiddenError(
+      "DATABASE_URL is not set. Execution halted."
+    );
+  }
+
+  let url: URL;
+  try {
+    url = new URL(connStr);
+  } catch {
+    throw new ProductionDatabaseForbiddenError("Invalid DATABASE_URL format.");
+  }
+
+  const host = (url.hostname || "").toLowerCase().trim();
+  const port = url.port || "5432";
+  const databaseName = url.pathname.replace(/^\//, "");
+
+  // 1. Explicit forbidden production hosts
+  const isForbiddenHost =
+    host.includes("pooler.supabase.com") ||
+    host.includes("aws-0-ap-northeast-1") ||
+    host.includes("supabase.co") ||
+    host.includes("supabase.in") ||
+    host.includes("neon.tech") ||
+    host.includes("vercel-storage.com") ||
+    host.includes("aivencloud.com") ||
+    host.includes("render.com");
+
+  if (isForbiddenHost) {
+    throw new ProductionDatabaseForbiddenError(
+      `Host "${host}" matches known production database hosts. Execution prohibited.`
+    );
+  }
+
+  // 2. Strict loopback assertion
+  const isLoopback =
+    host === "127.0.0.1" ||
+    host === "localhost" ||
+    host === "::1" ||
+    host === "[::1]";
+
+  if (!isLoopback) {
+    throw new ProductionDatabaseForbiddenError(
+      `Host "${host}" is not a verified local loopback address (127.0.0.1, localhost, ::1). Execution prohibited.`
+    );
+  }
+
+  return {
+    isLoopback: true,
+    classification: "AUTHORIZED_LOCAL",
+    host,
+    port,
+    databaseName,
+  };
+}
