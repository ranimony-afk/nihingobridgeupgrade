+
+    it("Case 10: parses priority metadata into commonness and frequency rank", () => {
+      const raw = SYNTHETIC_JMDICT_RECORDS[9]; // 首相 (news1, spec1, nf02)
+      const result = transformJMdictEntry(raw);
