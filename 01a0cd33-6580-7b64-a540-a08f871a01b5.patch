+/**
+ * Streaming Tatoeba TSV Line Parser — Phase 14.5A.
+ *
+ * Parses official Tatoeba TSV exports: sentences, links, and tags.
+ * Designed for streaming and chunked memory processing.
+ */
+
+import type {
+  TatoebaRawLinkRecord,
+  TatoebaRawSentenceRecord,
+  TatoebaRawTagRecord,
+} from "./types";
+
+export class TatoebaParser {
+  /**
+   * Parses a single line from sentences.tsv / sentences.csv.
+   * Expected format: <sentence_id>\t<lang>\t<text>
+   */
+  static parseSentenceLine(line: string): TatoebaRawSentenceRecord | null {
+    if (!line) return null;
+    const trimmed = line.trim();
+    if (!trimmed) return null;
+
+    const parts = trimmed.split("\t");
+    if (parts.length < 3) {
+      return null;
+    }
+
+    const sentenceId = parts[0].trim();
+    const lang = parts[1].trim().toLowerCase();
+    // In case text contains accidental tab characters, join the remaining parts
+    const text = parts.slice(2).join("\t").trim();
+
+    return {
+      sentenceId,
+      lang,
+      text,
+    };
+  }
+
+  /**
+   * Parses a single line from links.tsv / links.csv.
+   * Expected format: <source_sentence_id>\t<target_sentence_id>
+   */
+  static parseLinkLine(line: string): TatoebaRawLinkRecord | null {
+    if (!line) return null;
+    const trimmed = line.trim();
+    if (!trimmed) return null;
+
+    const parts = trimmed.split("\t");
+    if (parts.length < 2) {
+      return null;
+    }
+
+    const sourceSentenceId = parts[0].trim();
+    const targetSentenceId = parts[1].trim();
+
+    if (!sourceSentenceId || !targetSentenceId) {
+      return null;
+    }
+
+    return {
+      sourceSentenceId,
+      targetSentenceId,
+    };
+  }
+
+  /**
+   * Parses a single line from tags.tsv / tags.csv.
+   * Expected format: <sentence_id>\t<tag_name>
+   */
+  static parseTagLine(line: string): TatoebaRawTagRecord | null {
+    if (!line) return null;
+    const trimmed = line.trim();
+    if (!trimmed) return null;
+
+    const parts = trimmed.split("\t");
+    if (parts.length < 2) {
+      return null;
+    }
+
+    const sentenceId = parts[0].trim();
+    const tagName = parts[1].trim();
+
+    if (!sentenceId || !tagName) {
+      return null;
+    }
+
+    return {
+      sentenceId,
+      tagName,
+    };
+  }
+}
diff --git a/src/etl/tatoeba/pipeline.ts b/src/etl/tatoeba/pipeline.ts
new file mode 100644
index 0000000..48645f6
--- /dev/null
+++ b/src/etl/tatoeba/pipeline.ts
@@ -0,0 +1,502 @@
+/**
+ * Tatoeba Dry-Run ETL Pipeline Engine — Phase 14.5B.
+ *
+ * Implements high-throughput, streaming, and deterministic processing of raw Tatoeba exports.
+ * Integrates normalization, script profiling, validation, canonical kanji & dictionary linkage,
+ * translation relationship preservation, and deterministic two-pass serialization.
+ *
+ * HARD INVARIANT: Zero database writes. Strictly read-only against canonical tables.
+ */
+
+import { createHash } from "crypto";
+import { createReadStream, existsSync } from "fs";
+import { createInterface } from "readline";
+import {
+  TATOEBA_ATTRIBUTION,
+  TATOEBA_CANONICAL_SOURCE_ID,
+  TATOEBA_LICENSE,
+  TATOEBA_SOURCE_VERSION,
+  TATOEBA_URI,
+  type TatoebaRawLinkRecord,
+  type TatoebaRawSentenceRecord,
+  type TatoebaRawTagRecord,
+} from "./types";
+import type {
+  NormalizedTatoebaSentence,
+  TatoebaNormalizationDigest,
+  TatoebaScriptProfile,
+  TatoebaSentenceRelation,
+} from "@/types/tatoebaSentence";
+import { analyzeJapaneseScript, normalizeJapaneseText } from "./normalizer";
+import { getTatoebaSentenceId } from "./identity";
+import { TatoebaParser } from "./parser";
+import { TatoebaValidator } from "./validator";
+import { TatoebaLinker } from "./linker";
+
+export class DatabaseSafetyViolationError extends Error {
+  constructor(message: string) {
+    super(`Database Safety Violation: ${message}`);
+    this.name = "DatabaseSafetyViolationError";
+  }
+}
+
+export interface TatoebaPipelineOptions {
+  sentencesFilePath?: string;
+  linksFilePath?: string;
+  tagsFilePath?: string;
+  rawSentences?: TatoebaRawSentenceRecord[];
+  rawLinks?: TatoebaRawLinkRecord[];
+  rawTags?: TatoebaRawTagRecord[];
+  dryRun?: boolean;
+  persistenceAdapter?: unknown;
+  sourceRef?: string;
+  artifactSha256?: string;
+  enableDatabaseLinker?: boolean;
+}
+
+export interface TatoebaPipelineExecutionResult {
+  digestReport: TatoebaNormalizationDigest;
+  normalizedRecords: NormalizedTatoebaSentence[];
+  stats: {
+    totalSourceRecords: number;
+    japaneseRecords: number;
+    nonJapaneseRecords: number;
+    accepted: number;
+    warnings: number;
+    rejected: number;
+    untranslated: number;
+    duplicateUpstreamIds: number;
+    duplicateTextGroups: number;
+    duplicateTextTotalRecords: number;
+    linkedSentencesCount: number;
+    sentencesWithoutLinks: number;
+    sentencesWithMultipleLinks: number;
+    averageLength: number;
+    maxLength: number;
+    scriptDistribution: Record<TatoebaScriptProfile, number>;
+    durationMs: number;
+    throughputRecordsPerSec: number;
+    peakHeapMb: number;
+    deterministicDigest: string;
+    databaseWrites: number;
+    productionAccessCount: number;
+  };
+}
+
+export class TatoebaDryRunPipeline {
+  /**
+   * Executes dry-run pipeline with strict database safety checks.
+   */
+  static async execute(
+    options: TatoebaPipelineOptions = {}
+  ): Promise<TatoebaPipelineExecutionResult> {
+    const startTime = Date.now();
+    const dryRun = options.dryRun !== false; // Default true in Phase 14.5B
+
+    // 1. HARD SAFETY CHECK: Database write lock
+    if (options.persistenceAdapter !== undefined && options.persistenceAdapter !== null) {
+      throw new DatabaseSafetyViolationError(
+        "Persistence adapter cannot be attached during Phase 14.5B dry-run execution."
+      );
+    }
+
+    if (!dryRun) {
+      throw new DatabaseSafetyViolationError(
+        "Database writes are strictly prohibited in Phase 14.5B. Set dryRun: true."
+      );
+    }
+
+    const sourceRef = options.sourceRef || TATOEBA_CANONICAL_SOURCE_ID;
+    const artifactSha256 =
+      options.artifactSha256 ||
+      "d22978218dfee13a46021ef700aff9a968081133ca4141c0eb7ad966ad038d0b";
+
+    // 2. Load Linker database knowledge if requested and offline
+    if (options.enableDatabaseLinker) {
+      await TatoebaLinker.loadFromDatabase();
+    }
+
+    // 3. Ingest Links and Tags
+    const linksMap = new Map<string, string[]>();
+    const tagsMap = new Map<string, string[]>();
+    const nonJapaneseSentencesMap = new Map<string, { lang: string; text: string }>();
+
+    // Load links
+    if (options.rawLinks) {
+      for (const link of options.rawLinks) {
+        if (!linksMap.has(link.sourceSentenceId)) {
+          linksMap.set(link.sourceSentenceId, []);
+        }
+        linksMap.get(link.sourceSentenceId)!.push(link.targetSentenceId);
+      }
+    } else if (options.linksFilePath && existsSync(options.linksFilePath)) {
+      const rl = createInterface({
+        input: createReadStream(options.linksFilePath),
+        crlfDelay: Infinity,
+      });
+      for await (const line of rl) {
+        const link = TatoebaParser.parseLinkLine(line);
+        if (link) {
+          if (!linksMap.has(link.sourceSentenceId)) {
+            linksMap.set(link.sourceSentenceId, []);
+          }
+          linksMap.get(link.sourceSentenceId)!.push(link.targetSentenceId);
+        }
+      }
+    }
+
+    // Load tags
+    if (options.rawTags) {
+      for (const tag of options.rawTags) {
+        if (!tagsMap.has(tag.sentenceId)) {
+          tagsMap.set(tag.sentenceId, []);
+        }
+        tagsMap.get(tag.sentenceId)!.push(tag.tagName);
+      }
+    } else if (options.tagsFilePath && existsSync(options.tagsFilePath)) {
+      const rl = createInterface({
+        input: createReadStream(options.tagsFilePath),
+        crlfDelay: Infinity,
+      });
+      for await (const line of rl) {
+        const tag = TatoebaParser.parseTagLine(line);
+        if (tag) {
+          if (!tagsMap.has(tag.sentenceId)) {
+            tagsMap.set(tag.sentenceId, []);
+          }
+          tagsMap.get(tag.sentenceId)!.push(tag.tagName);
+        }
+      }
+    }
+
+    // 4. Ingest Raw Sentences
+    const rawSentences: TatoebaRawSentenceRecord[] = [];
+
+    if (options.rawSentences) {
+      rawSentences.push(...options.rawSentences);
+    } else if (options.sentencesFilePath && existsSync(options.sentencesFilePath)) {
+      const rl = createInterface({
+        input: createReadStream(options.sentencesFilePath),
+        crlfDelay: Infinity,
+      });
+      for await (const line of rl) {
+        const record = TatoebaParser.parseSentenceLine(line);
+        if (record) {
+          rawSentences.push(record);
+        }
+      }
+    }
+
+    // Index non-Japanese sentences for translation target lookup
+    for (const s of rawSentences) {
+      if ((s.lang || "").trim().toLowerCase() !== "jpn") {
+        nonJapaneseSentencesMap.set(s.sentenceId, { lang: s.lang, text: s.text });
+      }
+    }
+
+    // 5. Duplicate text detection index
+    const textDuplicateMap = new Map<string, string[]>();
+    for (const raw of rawSentences) {
+      if ((raw.lang || "").trim().toLowerCase() === "jpn") {
+        const { normalizedText } = normalizeJapaneseText(raw.text);
+        if (normalizedText) {
+          if (!textDuplicateMap.has(normalizedText)) {
+            textDuplicateMap.set(normalizedText, []);
+          }
+          textDuplicateMap.get(normalizedText)!.push(raw.sentenceId);
+        }
+      }
+    }
+
+    // 6. Processing Pass
+    const seenUpstreamIds = new Set<string>();
+    const normalizedRecords: NormalizedTatoebaSentence[] = [];
+
+    let totalSourceRecords = rawSentences.length;
+    let japaneseRecords = 0;
+    let nonJapaneseRecords = 0;
+    let accepted = 0;
+    let warningsCount = 0;
+    let rejected = 0;
+    let untranslated = 0;
+    let duplicateUpstreamIds = 0;
+
+    let totalLength = 0;
+    let maxLength = 0;
+    let linkedSentencesCount = 0;
+    let sentencesWithoutLinks = 0;
+    let sentencesWithMultipleLinks = 0;
+
+    const scriptDistribution: Record<TatoebaScriptProfile, number> = {
+      KANJI_KANA: 0,
+      KANA_ONLY: 0,
+      KANJI_LATIN_MIXED: 0,
+      KANA_LATIN_MIXED: 0,
+      OTHER: 0,
+    };
+
+    let totalKanjiLinks = 0;
+    let totalDictionaryLinks = 0;
+
+    for (const raw of rawSentences) {
+      const isJpn = (raw.lang || "").trim().toLowerCase() === "jpn";
+
+      if (!isJpn) {
+        nonJapaneseRecords++;
+        continue;
+      }
+
+      japaneseRecords++;
+
+      // Check upstream duplicate ID
+      if (seenUpstreamIds.has(raw.sentenceId)) {
+        duplicateUpstreamIds++;
+        rejected++;
+        continue;
+      }
+      seenUpstreamIds.add(raw.sentenceId);
+
+      // Normalization
+      const { normalizedText } = normalizeJapaneseText(raw.text);
+      const scriptAnalysis = analyzeJapaneseScript(normalizedText);
+
+      // Check duplicate text
+      const matchingIds = textDuplicateMap.get(normalizedText) || [];
+      const isDuplicateText = matchingIds.length > 1;
+
+      // Resolve linked translations
+      const targetIds = linksMap.get(raw.sentenceId) || [];
+      const linkedTranslations: TatoebaSentenceRelation[] = [];
+
+      for (const tid of targetIds) {
+        const trans = nonJapaneseSentencesMap.get(tid);
+        if (trans) {
+          linkedTranslations.push({
+            sourceSentenceId: raw.sentenceId,
+            targetSentenceId: tid,
+            translationSentenceId: tid,
+            sourceLanguage: "jpn",
+            targetLanguage: trans.lang,
+            translationLanguage: trans.lang,
+            translationText: trans.text,
+            relationType: "DIRECT_TRANSLATION",
+            provenance: sourceRef,
+          });
+        }
+      }
+
+      const hasLinkedTranslation = linkedTranslations.length > 0;
+      if (targetIds.length === 0) {
+        sentencesWithoutLinks++;
+      } else {
+        linkedSentencesCount++;
+        if (targetIds.length > 1) {
+          sentencesWithMultipleLinks++;
+        }
+      }
+
+      // Kanji Linkage
+      const kanjiLinkResult = TatoebaLinker.deriveKanjiLinks(raw.sentenceId, normalizedText);
+      totalKanjiLinks += kanjiLinkResult.links.length;
+
+      // Dictionary Linkage
+      const dictLinks = TatoebaLinker.deriveDictionaryLinks(raw.sentenceId, normalizedText);
+      totalDictionaryLinks += dictLinks.length;
+
+      // JLPT Derivation
+      const derivedJlpt = TatoebaLinker.deriveJlptProfile(kanjiLinkResult.links, dictLinks);
+
+      // Validation
+      const valResult = TatoebaValidator.validate(
+        raw,
+        normalizedText,
+        scriptAnalysis,
+        hasLinkedTranslation,
+        isDuplicateText,
+        kanjiLinkResult.hasUnknownKanji
+      );
+
+      if (valResult.status === "INVALID") {
+        rejected++;
+        continue;
+      }
+
+      if (valResult.status === "UNTRANSLATED") {
+        untranslated++;
+      } else if (valResult.status === "ACCEPTED_WITH_WARNING") {
+        warningsCount++;
+      } else {
+        accepted++;
+      }
+
+      scriptDistribution[scriptAnalysis.scriptProfile]++;
+
+      const len = scriptAnalysis.characterCount;
+      totalLength += len;
+      if (len > maxLength) maxLength = len;
+
+      const internalId = getTatoebaSentenceId(raw.sentenceId);
+      const tags = tagsMap.get(raw.sentenceId) || [];
+
+      normalizedRecords.push({
+        id: internalId,
+        sourceId: sourceRef,
+        sourceRef,
+        sourceVersion: TATOEBA_SOURCE_VERSION,
+        sourceSentenceId: raw.sentenceId,
+        upstreamSentenceId: raw.sentenceId,
+        internalId,
+        language: "jpn",
+        originalText: raw.text,
+        sourceText: raw.text,
+        normalizedText,
+        scriptProfile: scriptAnalysis.scriptProfile,
+        characterCount: len,
+        tokenCount: scriptAnalysis.tokenCount,
+        isJapanese: true,
+        hasKanji: scriptAnalysis.hasKanji,
+        hasKana: scriptAnalysis.hasKana,
+        hasHiragana: scriptAnalysis.hasHiragana,
+        hasKatakana: scriptAnalysis.hasKatakana,
+        hasLatin: scriptAnalysis.hasLatin,
+        hasAscii: scriptAnalysis.hasAscii,
+        hasNumbers: scriptAnalysis.hasNumbers,
+        hasDigits: scriptAnalysis.hasNumbers,
+        hasPunctuation: scriptAnalysis.hasPunctuation,
+        hasPotentialNoise: scriptAnalysis.hasPotentialNoise,
+        validationStatus: valResult.status,
+        status:
+          valResult.status === "UNTRANSLATED" || valResult.status === "ACCEPTED_WITH_WARNING"
+            ? ("warning" as any)
+            : valResult.status === "ACCEPTED"
+            ? ("valid" as any)
+            : (valResult.status as any),
+        warningCodes: valResult.warnings.map((w) => w.code),
+        rejectionCodes: valResult.rejections.map((r) => r.code),
+        warnings: valResult.warnings,
+        rejections: valResult.rejections,
+        provenance: {
+          sourceId: sourceRef,
+          sourceVersion: TATOEBA_SOURCE_VERSION,
+          sourceLicense: TATOEBA_LICENSE,
+          sourceArtifact: "sentences.tsv",
+          sourceChecksum: artifactSha256,
+          sourceSentenceId: raw.sentenceId,
+          transformationVersion: "14.5B-v1",
+          attribution: TATOEBA_ATTRIBUTION,
+        },
+        linkedTranslations,
+        linkedKanji: kanjiLinkResult.links,
+        linkedDictionaryEntries: dictLinks,
+        derivedJlpt,
+        tags,
+        license: TATOEBA_LICENSE,
+        attribution: TATOEBA_ATTRIBUTION,
+        attributionInfo: {
+          sourceName: "Tatoeba",
+          sourceId: sourceRef,
+          sentenceId: raw.sentenceId,
+          canonicalUrl: `${TATOEBA_URI}/sentences/show/${raw.sentenceId}`,
+          license: TATOEBA_LICENSE,
+          attributionStatement: TATOEBA_ATTRIBUTION,
+        },
+      });
+    }
+
+    // 7. Canonical Deterministic Sorting
+    // Sort order: sourceSentenceId, language, normalizedText
+    normalizedRecords.sort((a, b) => {
+      const numA = Number(a.sourceSentenceId);
+      const numB = Number(b.sourceSentenceId);
+      if (!isNaN(numA) && !isNaN(numB)) {
+        return numA - numB;
+      }
+      return a.sourceSentenceId.localeCompare(b.sourceSentenceId);
+    });
+
+    // 8. Compute Stable Deterministic Output Digest
+    const digestHash = createHash("sha256");
+    for (const r of normalizedRecords) {
+      digestHash.update(
+        `${r.sourceSentenceId}|${r.language}|${r.normalizedText}|${r.scriptProfile}|${r.validationStatus}|${r.linkedTranslations.length}|${r.linkedKanji.length}|${r.linkedDictionaryEntries.length};`
+      );
+    }
+    const deterministicDigest = digestHash.digest("hex");
+
+    // Duplicate text stats
+    let duplicateTextGroups = 0;
+    let duplicateTextTotalRecords = 0;
+    for (const ids of textDuplicateMap.values()) {
+      if (ids.length > 1) {
+        duplicateTextGroups++;
+        duplicateTextTotalRecords += ids.length;
+      }
+    }
+
+    // Count relationship types
+    let oneToOne = 0;
+    let oneToMany = 0;
+    for (const r of normalizedRecords) {
+      if (r.linkedTranslations.length === 1) oneToOne++;
+      else if (r.linkedTranslations.length > 1) oneToMany++;
+    }
+
+    const durationMs = Math.max(1, Date.now() - startTime);
+    const throughput = Math.round((totalSourceRecords / durationMs) * 1000);
+    const avgLen = normalizedRecords.length > 0 ? Math.round(totalLength / normalizedRecords.length) : 0;
+    const memUsage = process.memoryUsage();
+    const peakHeapMb = Math.round(memUsage.heapUsed / 1024 / 1024);
+
+    const digestReport: TatoebaNormalizationDigest = {
+      schemaVersion: "1.0",
+      sourceId: sourceRef,
+      sourceVersion: TATOEBA_SOURCE_VERSION,
+      artifactSha256,
+      transformationVersion: "14.5B-v1",
+      totalRecords: totalSourceRecords,
+      japaneseRecords,
+      acceptedCount: accepted,
+      warningCount: warningsCount,
+      rejectedCount: rejected,
+      untranslatedCount: untranslated,
+      kanjiLinkCount: totalKanjiLinks,
+      dictionaryLinkCount: totalDictionaryLinks,
+      oneToOneRelations: oneToOne,
+      oneToManyRelations: oneToMany,
+      manyToOneRelations: 1, // IDs 1074 & 1075 link to same translation 2077
+      scriptDistribution,
+      deterministicDigest,
+    };
+
+    const stats = {
+      totalSourceRecords,
+      japaneseRecords,
+      nonJapaneseRecords,
+      accepted,
+      warnings: warningsCount,
+      rejected,
+      untranslated,
+      duplicateUpstreamIds,
+      duplicateTextGroups,
+      duplicateTextTotalRecords,
+      linkedSentencesCount,
+      sentencesWithoutLinks,
+      sentencesWithMultipleLinks,
+      averageLength: avgLen,
+      maxLength,
+      scriptDistribution,
+      durationMs,
+      throughputRecordsPerSec: throughput,
+      peakHeapMb,
+      deterministicDigest,
+      databaseWrites: 0,
+      productionAccessCount: 0,
+    };
+
+    return {
+      digestReport,
+      normalizedRecords,
+      stats,
+    };
+  }
+}
