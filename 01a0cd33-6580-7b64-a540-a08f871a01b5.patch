diff --git a/src/app/api/kanji/[character]/vocabulary/route.ts b/src/app/api/kanji/[character]/vocabulary/route.ts
new file mode 100644
index 0000000..b2144f1
--- /dev/null
+++ b/src/app/api/kanji/[character]/vocabulary/route.ts
@@ -0,0 +1,82 @@
+import { NextRequest, NextResponse } from "next/server";
+import { kanjiLexicalGraphService } from "@/services/knowledge/kanjiLexicalGraphService";
+
+export const dynamic = "force-dynamic";
+
+/**
+ * GET /api/kanji/[character]/vocabulary
+ * Query vocabulary containing the kanji character, optionally filtered by:
+ * - reading: matching reading token
+ * - level: JLPT level (N5, N4, N3, N2, N1)
+ * - position: "beginsWith" | "endsWith" | "contains" | "middle"
+ * - limit / offset
+ */
+export async function GET(
+  request: NextRequest,
+  { params }: { params: Promise<{ character: string }> }
+) {
+  try {
+    const { character } = await params;
+    const decoded = decodeURIComponent(character);
+    const sp = request.nextUrl.searchParams;
+
+    const level = sp.get("level")?.toUpperCase();
+    const reading = sp.get("reading") || undefined;
+    const position = (sp.get("position") || undefined) as
+      | "beginsWith"
+      | "endsWith"
+      | "contains"
+      | "middle"
+      | undefined;
+    const limit = sp.get("limit") ? Math.min(Math.max(parseInt(sp.get("limit")!, 10), 1), 100) : 25;
+    const offset = sp.get("offset") ? Math.max(parseInt(sp.get("offset")!, 10), 0) : 0;
+
+    const pos =
+      position === "beginsWith"
+        ? ("prefix" as const)
+        : position === "endsWith"
+        ? ("suffix" as const)
+        : ("any" as const);
+
+    let vocabulary;
+    if (level && ["N5", "N4", "N3", "N2", "N1"].includes(level)) {
+      vocabulary = await kanjiLexicalGraphService.getJLPTVocabularyForKanji(
+        decoded,
+        level as "N5" | "N4" | "N3" | "N2" | "N1"
+      );
+      if (reading) {
+        vocabulary = vocabulary.filter((v) => v.wordReading.includes(reading));
+      }
+      if (offset > 0 || vocabulary.length > limit) {
+        vocabulary = vocabulary.slice(offset, offset + limit);
+      }
+    } else if (reading || pos) {
+      vocabulary = await kanjiLexicalGraphService.getKanjiCompounds(decoded, {
+        reading,
+        position: pos,
+        limit: limit + offset,
+      });
+      if (offset > 0) {
+        vocabulary = vocabulary.slice(offset, offset + limit);
+      }
+    } else {
+      vocabulary = await kanjiLexicalGraphService.getKanjiVocabulary(decoded, {
+        limit: limit + offset,
+      });
+      if (offset > 0) {
+        vocabulary = vocabulary.slice(offset, offset + limit);
+      }
+    }
+
+    return NextResponse.json({
+      success: true,
+      character: decoded,
+      total: vocabulary.length,
+      vocabulary,
+    });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : "Failed to load kanji vocabulary";
+    console.error("GET /api/kanji/[character]/vocabulary error:", error);
+    return NextResponse.json({ success: false, error: message }, { status: 500 });
+  }
+}
