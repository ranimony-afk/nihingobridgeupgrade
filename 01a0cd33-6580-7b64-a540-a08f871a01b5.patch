+  });
+
+  // -------------------------------------------------------------
+  // 12. TWO-PASS DETERMINISM & SAFETY (Tests 50-52)
+  // -------------------------------------------------------------
+  describe("12. Two-Pass Determinism & Executable Safety", () => {
