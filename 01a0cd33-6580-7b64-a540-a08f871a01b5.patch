+/**
+ * Tatoeba Two-Pass Determinism & Invariant Verifier — Phase 14.5B.
+ *
+ * Executes two independent normalization runs and verifies zero drift:
+ * Pass 1 Digest === Pass 2 Digest.
+ */
+
+import { resolve } from "path";
+import { TatoebaDryRunPipeline, assertDisposableLocalDatabase } from "../src/etl/tatoeba";
+
+async function main() {
+  console.log("================================================================================");
+  console.log("PHASE 14.5B — TWO-PASS DETERMINISM & INVARIANT VERIFIER");
+  console.log("================================================================================");
+
+  assertDisposableLocalDatabase();
+
+  const sentencesPath = resolve(process.cwd(), "data/tatoeba/sentences.tsv");
+  const linksPath = resolve(process.cwd(), "data/tatoeba/links.tsv");
+  const tagsPath = resolve(process.cwd(), "data/tatoeba/tags.tsv");
+
+  console.log("[PASS 1] Executing first normalization pass...");
+  const pass1 = await TatoebaDryRunPipeline.execute({
+    sentencesFilePath: sentencesPath,
+    linksFilePath: linksPath,
+    tagsFilePath: tagsPath,
+    dryRun: true,
+  });
+
+  console.log(`[PASS 1] Digest: ${pass1.stats.deterministicDigest} (${pass1.stats.totalSourceRecords} records)`);
+
+  console.log("[PASS 2] Executing second normalization pass (Determinism Check)...");
+  const pass2 = await TatoebaDryRunPipeline.execute({
+    sentencesFilePath: sentencesPath,
+    linksFilePath: linksPath,
+    tagsFilePath: tagsPath,
+    dryRun: true,
+  });
+
+  console.log(`[PASS 2] Digest: ${pass2.stats.deterministicDigest} (${pass2.stats.totalSourceRecords} records)`);
+
+  if (pass1.stats.deterministicDigest !== pass2.stats.deterministicDigest) {
+    console.error("[FAIL] HARD STOP — NONDETERMINISM DETECTED BETWEEN PASS 1 AND PASS 2!");
+    console.error(`Pass 1: ${pass1.stats.deterministicDigest}`);
+    console.error(`Pass 2: ${pass2.stats.deterministicDigest}`);
+    process.exit(1);
+  }
+
+  console.log("\n[VERDICT] PASS 1 DIGEST === PASS 2 DIGEST (STRICT ZERO DRIFT CONFIRMED)");
+  console.log(`Digest: ${pass1.stats.deterministicDigest}`);
+}
+
+main().catch((err) => {
+  console.error("[FATAL ERROR]", err);
+  process.exit(1);
+});
