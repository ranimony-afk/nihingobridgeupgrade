+  if (!id) return null;
+  const canonicalId = SOURCE_ALIASES[id] || id;
+  return AUTHORITATIVE_SOURCE_REGISTRY[canonicalId] ?? null;
+}
+
+/**
+ * Retrieve all registered source definitions.
+ */
