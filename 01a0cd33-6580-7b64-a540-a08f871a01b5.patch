+    });
+  });
+
+  // -------------------------------------------------------------
+  // 9. JLPT PROFILE DERIVATION (Tests 43-44)
+  // -------------------------------------------------------------
+  describe("9. JLPT Profile Derivation", () => {
+    beforeEach(() => {
+      TatoebaLinker.seedReferences(
+        [
+          { character: "水", id: "ke-mizu", jlptLevel: "N5" },
+        ],
+        []
+      );
+    });
+
+    it("43. identifies highest and lowest JLPT level from linked entities", () => {
+      const kanjiLinks = [
+        { sentenceId: "1", character: "水", kanjiId: "ke-mizu", isCanonical: true, position: 0, occurrenceIndex: 0, source: "literal_occurrence" as const },
+      ];
+      const dictLinks = [
+        { sentenceId: "1", dictionaryEntryId: "de-n5", headword: "本", reading: "ほん", matchType: "EXACT_HEADWORD" as const, position: 0, jlptLevel: "N5" },
+        { sentenceId: "1", dictionaryEntryId: "de-n3", headword: "試験", reading: "しけん", matchType: "EXACT_HEADWORD" as const, position: 5, jlptLevel: "N3" },
+      ];
+
+      const profile = TatoebaLinker.deriveJlptProfile(kanjiLinks, dictLinks);
+      expect(profile.sentenceJLPTHighest).toBe("N3"); // N3 is more advanced than N5
+      expect(profile.sentenceJLPTLowest).toBe("N5");
