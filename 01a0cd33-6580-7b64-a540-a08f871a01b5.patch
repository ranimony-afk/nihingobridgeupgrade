index 0000000..eec274f
--- /dev/null
+++ b/src/etl/tatoeba/linker.ts
@@ -0,0 +1,304 @@
+/**
+ * Tatoeba Canonical Linkage Engine — Phase 14.5B.
+ *
+ * Implements deterministic derivation of:
+ * 1. Kanji Linkage (positional indexing, canonical verification, unknown character detection).
+ * 2. Dictionary Linkage (exact headword and reading matching against canonical JMdict).
+ * 3. JLPT Profile Derivation (highest, lowest, level counts).
+ *
+ * STRICT INVARIANT: Read-only derivation against canonical tables. Zero mutations.
+ */
+
+import {
+  type DictionaryMatchType,
+  type SentenceDerivedJlpt,
+  type SentenceDictionaryLink,
+  type SentenceKanjiLink,
+} from "@/types/tatoebaSentence";
+
+export const KANJI_CHAR_REGEX = /[\u4E00-\u9FAF\u3400-\u4DBF\uF900-\uFAFF]/;
+
+export interface CanonicalKanjiReference {
+  character: string;
+  id: string;
+  jlptLevel?: string;
+}
+
+export interface CanonicalDictionaryReference {
+  id: string;
+  headword: string;
+  reading: string;
+  jlptLevel?: string;
+}
+
+const JLPT_RANK: Record<string, number> = {
+  N5: 1,
+  N4: 2,
+  N3: 3,
+  N2: 4,
+  N1: 5,
+};
+
+export class TatoebaLinker {
+  private static canonicalKanjiSet = new Set<string>();
+  private static canonicalKanjiMap = new Map<string, CanonicalKanjiReference>();
+  private static canonicalVocabList: CanonicalDictionaryReference[] = [];
+
+  /**
+   * Initializes linker cache with explicit reference data.
+   */
+  static seedReferences(
+    kanjiList: CanonicalKanjiReference[],
+    vocabList: CanonicalDictionaryReference[]
+  ): void {
+    this.canonicalKanjiSet.clear();
+    this.canonicalKanjiMap.clear();
+    for (const k of kanjiList) {
+      this.canonicalKanjiSet.add(k.character);
+      this.canonicalKanjiMap.set(k.character, k);
+    }
+    this.canonicalVocabList = [...vocabList];
+  }
+
+  /**
+   * Loads canonical knowledge from database in read-only mode if available.
+   */
+  static async loadFromDatabase(dbClient?: any): Promise<void> {
+    if (!dbClient) {
+      try {
+        const { db } = await import("@/db");
+        dbClient = db;
+      } catch {
+        return;
+      }
+    }
+
+    try {
+      const { kanjiEntries, dictionaryEntries } = await import("@/db/schema");
+      const kRows = await dbClient
+        .select({
+          character: kanjiEntries.character,
+          id: kanjiEntries.id,
+          jlptLevel: kanjiEntries.jlptLevel,
+        })
+        .from(kanjiEntries);
+
+      this.canonicalKanjiSet.clear();
+      this.canonicalKanjiMap.clear();
+      for (const k of kRows) {
+        this.canonicalKanjiSet.add(k.character);
+        this.canonicalKanjiMap.set(k.character, {
+          character: k.character,
+          id: k.id,
+          jlptLevel: k.jlptLevel || undefined,
+        });
+      }
+
+      const vRows = await dbClient
+        .select({
+          id: dictionaryEntries.id,
+          headword: dictionaryEntries.headword,
+          reading: dictionaryEntries.reading,
+          jlptLevel: dictionaryEntries.jlptLevel,
+        })
+        .from(dictionaryEntries)
+        .limit(50000); // Bounded query for linker performance
+
+      this.canonicalVocabList = vRows.map((v: any) => ({
+        id: v.id,
+        headword: v.headword,
+        reading: v.reading,
+        jlptLevel: v.jlptLevel || undefined,
+      }));
+    } catch {
+      // Offline fallback: retains existing seed references
+    }
+  }
+
+  /**
+   * Derives all kanji occurrences in the sentence with literal positions and canonical status.
+   */
+  static deriveKanjiLinks(
+    sentenceId: string,
+    sentenceText: string
+  ): {
+    links: SentenceKanjiLink[];
+    hasUnknownKanji: boolean;
+    unknownCharacters: string[];
+  } {
+    const links: SentenceKanjiLink[] = [];
+    const unknownCharacters: string[] = [];
+    const occurrenceTracker = new Map<string, number>();
+
+    const codePoints = Array.from(sentenceText);
+
+    for (let pos = 0; pos < codePoints.length; pos++) {
+      const char = codePoints[pos];
+
+      if (KANJI_CHAR_REGEX.test(char)) {
+        const count = occurrenceTracker.get(char) || 0;
+        occurrenceTracker.set(char, count + 1);
+
+        const isCanonical =
+          this.canonicalKanjiSet.size > 0 ? this.canonicalKanjiSet.has(char) : true;
+        const ref = this.canonicalKanjiMap.get(char);
+        const kanjiId = ref ? ref.id : isCanonical ? `ke-${encodeURIComponent(char)}` : null;
+
+        if (!isCanonical) {
+          if (!unknownCharacters.includes(char)) {
+            unknownCharacters.push(char);
+          }
+        }
+
+        links.push({
+          sentenceId,
+          character: char,
+          kanjiId,
+          isCanonical,
+          position: pos,
+          occurrenceIndex: count,
+          source: "literal_occurrence",
+        });
+      }
+    }
+
+    return {
+      links,
+      hasUnknownKanji: unknownCharacters.length > 0,
+      unknownCharacters,
+    };
+  }
+
+  /**
+   * Derives candidate dictionary links via deterministic exact matching.
+   */
+  static deriveDictionaryLinks(
+    sentenceId: string,
+    sentenceText: string
+  ): SentenceDictionaryLink[] {
+    if (this.canonicalVocabList.length === 0) {
+      return [];
+    }
+
+    const links: SentenceDictionaryLink[] = [];
+    const matchedIds = new Set<string>();
+
+    for (const v of this.canonicalVocabList) {
+      // Only match headwords with 2+ characters or containing Kanji to avoid particle false positives
+      const isMultiCharOrKanji =
+        v.headword.length >= 2 || KANJI_CHAR_REGEX.test(v.headword);
+
+      if (isMultiCharOrKanji) {
+        const idx = sentenceText.indexOf(v.headword);
+        if (idx !== -1 && !matchedIds.has(v.id)) {
+          matchedIds.add(v.id);
+          links.push({
+            sentenceId,
+            dictionaryEntryId: v.id,
+            headword: v.headword,
+            reading: v.reading,
+            matchType: "EXACT_HEADWORD",
+            position: idx,
+            jlptLevel: v.jlptLevel || "NONE",
+          });
+        }
+      }
+    }
+
+    return links;
+  }
+
+  /**
+   * Derives sentence JLPT profile from linked vocabulary and kanji.
+   */
+  static deriveJlptProfile(
+    kanjiLinks: SentenceKanjiLink[],
+    dictLinks: SentenceDictionaryLink[]
+  ): SentenceDerivedJlpt {
+    let linkedN5Count = 0;
+    let linkedN4Count = 0;
+    let linkedN3Count = 0;
+    let linkedN2Count = 0;
+    let linkedN1Count = 0;
+    let unclassifiedCount = 0;
+
+    const encounteredRanks: number[] = [];
+
+    // Collect from dictionary links
+    for (const d of dictLinks) {
+      const lvl = (d.jlptLevel || "").toUpperCase();
+      if (lvl === "N5") {
+        linkedN5Count++;
+        encounteredRanks.push(JLPT_RANK.N5);
+      } else if (lvl === "N4") {
+        linkedN4Count++;
+        encounteredRanks.push(JLPT_RANK.N4);
+      } else if (lvl === "N3") {
+        linkedN3Count++;
+        encounteredRanks.push(JLPT_RANK.N3);
+      } else if (lvl === "N2") {
+        linkedN2Count++;
+        encounteredRanks.push(JLPT_RANK.N2);
+      } else if (lvl === "N1") {
+        linkedN1Count++;
+        encounteredRanks.push(JLPT_RANK.N1);
+      } else {
+        unclassifiedCount++;
+      }
+    }
+
+    // Collect from kanji links
+    for (const k of kanjiLinks) {
+      const ref = this.canonicalKanjiMap.get(k.character);
+      if (ref && ref.jlptLevel) {
+        const lvl = ref.jlptLevel.toUpperCase();
+        if (lvl === "N5") {
+          linkedN5Count++;
+          encounteredRanks.push(JLPT_RANK.N5);
+        } else if (lvl === "N4") {
+          linkedN4Count++;
+          encounteredRanks.push(JLPT_RANK.N4);
+        } else if (lvl === "N3") {
+          linkedN3Count++;
+          encounteredRanks.push(JLPT_RANK.N3);
+        } else if (lvl === "N2") {
+          linkedN2Count++;
+          encounteredRanks.push(JLPT_RANK.N2);
+        } else if (lvl === "N1") {
+          linkedN1Count++;
+          encounteredRanks.push(JLPT_RANK.N1);
+        }
+      }
+    }
+
+    let sentenceJLPTHighest: string | null = null;
+    let sentenceJLPTLowest: string | null = null;
+
+    if (encounteredRanks.length > 0) {
+      const maxRank = Math.max(...encounteredRanks);
+      const minRank = Math.min(...encounteredRanks);
+
+      const rankToLevel: Record<number, string> = {
+        1: "N5",
+        2: "N4",
+        3: "N3",
+        4: "N2",
+        5: "N1",
+      };
+
+      sentenceJLPTHighest = rankToLevel[maxRank] || null;
+      sentenceJLPTLowest = rankToLevel[minRank] || null;
+    }
+
+    return {
+      sentenceJLPTHighest,
+      sentenceJLPTLowest,
+      linkedN5Count,
+      linkedN4Count,
+      linkedN3Count,
+      linkedN2Count,
+      linkedN1Count,
+      unclassifiedCount,
+    };
+  }
+}
diff --git a/src/etl/tatoeba/normalizer.ts b/src/etl/tatoeba/normalizer.ts
new file mode 100644
index 0000000..0790fcd
--- /dev/null
+++ b/src/etl/tatoeba/normalizer.ts
@@ -0,0 +1,264 @@
+/**
+ * Japanese Sentence Normalizer & Script Analyzer — Phase 14.5B.
+ *
+ * Implements non-destructive Unicode NFC normalization, fine-grained script
+ * decomposition, script profiling, heuristic token counting, and noise detection.
+ */
+
+import type { TatoebaScriptProfile } from "@/types/tatoebaSentence";
+
+// Unicode Character Class Ranges
+const HIRAGANA_REGEX = /[\u3040-\u309F]/g;
+const KATAKANA_REGEX = /[\u30A0-\u30FF\u31F0-\u31FF]/g;
+const KANJI_REGEX = /[\u4E00-\u9FAF\u3400-\u4DBF\uF900-\uFAFF]/g;
+const LATIN_REGEX = /[a-zA-Z\uFF21-\uFF3A\uFF41-\uFF5A]/g;
+const ASCII_REGEX = /[\u0020-\u007E]/g;
+const DIGIT_REGEX = /[0-9\uFF10-\uFF19]/g;
+const JAPANESE_PUNCTUATION_REGEX = /[\u3001\u3002\u300C\u300D\u300E\u300F\u30FB\u2026\u301C~！？]/g;
+const GENERAL_PUNCTUATION_REGEX = /[.,:;!?'"()（）[\]{}<>\/\\-]/g;
+const SYMBOLS_REGEX = /[¥$€%&@#*+=\|^_~`]/g;
+const CONTROL_CHARS_REGEX = /[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]/g;
+const REPLACEMENT_CHAR_REGEX = /\uFFFD/g;
+const SUSPICIOUS_MARKUP_REGEX = /<[a-zA-Z\/][^>]*>|&(?:amp|lt|gt|quot|#\d+);/g;
+const REPEATED_PUNCT_REGEX = /(?:[!?！？。、]){3,}/g;
+const PRIVATE_USE_REGEX = /[\uE000-\uF8FF]/g;
+
+export interface EnhancedScriptAnalysis {
+  characterCount: number;
+  tokenCount: number;
+  hasKanji: boolean;
+  hasKana: boolean;
+  hasHiragana: boolean;
+  hasKatakana: boolean;
+  hasLatin: boolean;
+  hasAscii: boolean;
+  hasNumbers: boolean;
+  hasDigits: boolean;
+  hasPunctuation: boolean;
+  hasJapanesePunctuation: boolean;
+  hasSymbols: boolean;
+  hasControlChars: boolean;
+  hasReplacementChar: boolean;
+  hasSuspiciousMarkup: boolean;
+  hasRepeatedPunctuation: boolean;
+  hasUnusualUnicode: boolean;
+  hasPotentialNoise: boolean;
+  kanjiCharacters: string[];
+  scriptProfile: TatoebaScriptProfile;
+  counts: {
+    kanji: number;
+    hiragana: number;
+    katakana: number;
+    latin: number;
+    digits: number;
+    japanesePunct: number;
+    generalPunct: number;
+    symbols: number;
+  };
+}
+
+/**
+ * Normalizes raw Japanese sentence text deterministically using Unicode NFC.
+ * Preserves original text, authentic Japanese full-width characters, and punctuation.
+ */
+export function normalizeJapaneseText(sourceText: string | null | undefined): {
+  normalizedText: string;
+  isModified: boolean;
+  hasControlChars: boolean;
+} {
+  if (sourceText === null || sourceText === undefined) {
+    return { normalizedText: "", isModified: false, hasControlChars: false };
+  }
+
+  // 1. Detect and strip non-printable control characters
+  const hasControlChars = CONTROL_CHARS_REGEX.test(sourceText);
+  const cleaned = sourceText.replace(CONTROL_CHARS_REGEX, "");
+
+  // 2. Canonical Unicode NFC composition (preserves full-width characters and Japanese punctuation)
+  const nfc = cleaned.normalize("NFC");
+
+  // 3. Canonical whitespace handling (collapse consecutive spaces, trim edges)
+  const collapsed = nfc.replace(/[\r\n\t]+/g, " ").replace(/\s{2,}/g, " ");
+  const normalizedText = collapsed.trim();
+
+  const isModified = normalizedText !== sourceText;
+
+  return {
+    normalizedText,
+    isModified,
+    hasControlChars,
+  };
+}
+
+/**
+ * Estimates token count deterministically based on script transition boundaries.
+ */
+export function estimateTokenCount(text: string): number {
+  if (!text) return 0;
+  const chars = Array.from(text);
+  if (chars.length === 0) return 0;
+
+  let tokens = 1;
+  let lastScript = getCharacterScriptCategory(chars[0]);
+
+  for (let i = 1; i < chars.length; i++) {
+    const currentScript = getCharacterScriptCategory(chars[i]);
+    if (currentScript === "whitespace") {
+      // Whitespace explicitly separates tokens
+      tokens++;
+      lastScript = "whitespace";
+    } else if (currentScript !== lastScript && lastScript !== "whitespace") {
+      tokens++;
+      lastScript = currentScript;
+    } else if (lastScript === "whitespace") {
+      lastScript = currentScript;
+    }
+  }
+
+  return tokens;
+}
+
+function getCharacterScriptCategory(char: string): string {
+  if (/\s/.test(char)) return "whitespace";
+  if (KANJI_REGEX.test(char)) return "kanji";
+  if (HIRAGANA_REGEX.test(char)) return "hiragana";
+  if (KATAKANA_REGEX.test(char)) return "katakana";
+  if (LATIN_REGEX.test(char)) return "latin";
+  if (DIGIT_REGEX.test(char)) return "digit";
+  if (JAPANESE_PUNCTUATION_REGEX.test(char) || GENERAL_PUNCTUATION_REGEX.test(char)) return "punct";
+  return "other";
+}
+
+/**
+ * Comprehensive Japanese script and quality analysis.
+ */
+export function analyzeJapaneseScript(text: string): EnhancedScriptAnalysis {
+  if (!text) {
+    return {
+      characterCount: 0,
+      tokenCount: 0,
+      hasKanji: false,
+      hasKana: false,
+      hasHiragana: false,
+      hasKatakana: false,
+      hasLatin: false,
+      hasAscii: false,
+      hasNumbers: false,
+      hasDigits: false,
+      hasPunctuation: false,
+      hasJapanesePunctuation: false,
+      hasSymbols: false,
+      hasControlChars: false,
+      hasReplacementChar: false,
+      hasSuspiciousMarkup: false,
+      hasRepeatedPunctuation: false,
+      hasUnusualUnicode: false,
+      hasPotentialNoise: false,
+      kanjiCharacters: [],
+      scriptProfile: "OTHER",
+      counts: {
+        kanji: 0,
+        hiragana: 0,
+        katakana: 0,
+        latin: 0,
+        digits: 0,
+        japanesePunct: 0,
+        generalPunct: 0,
+        symbols: 0,
+      },
+    };
+  }
+
+  const chars = Array.from(text);
+  const characterCount = chars.length;
+  const tokenCount = estimateTokenCount(text);
+
+  const kanjiMatches = text.match(KANJI_REGEX) || [];
+  const hiraganaMatches = text.match(HIRAGANA_REGEX) || [];
+  const katakanaMatches = text.match(KATAKANA_REGEX) || [];
+  const latinMatches = text.match(LATIN_REGEX) || [];
+  const asciiMatches = text.match(ASCII_REGEX) || [];
+  const digitMatches = text.match(DIGIT_REGEX) || [];
+  const jpnPunctMatches = text.match(JAPANESE_PUNCTUATION_REGEX) || [];
+  const genPunctMatches = text.match(GENERAL_PUNCTUATION_REGEX) || [];
+  const symbolMatches = text.match(SYMBOLS_REGEX) || [];
+
+  const hasKanji = kanjiMatches.length > 0;
+  const hasHiragana = hiraganaMatches.length > 0;
+  const hasKatakana = katakanaMatches.length > 0;
+  const hasKana = hasHiragana || hasKatakana;
+  const hasLatin = latinMatches.length > 0;
+  const hasAscii = asciiMatches.length > 0;
+  const hasNumbers = digitMatches.length > 0;
+  const hasJapanesePunctuation = jpnPunctMatches.length > 0;
+  const hasPunctuation = hasJapanesePunctuation || genPunctMatches.length > 0;
+  const hasSymbols = symbolMatches.length > 0;
+
+  // Noise diagnostics
+  const hasControlChars = CONTROL_CHARS_REGEX.test(text);
+  const hasReplacementChar = REPLACEMENT_CHAR_REGEX.test(text);
+  const hasSuspiciousMarkup = SUSPICIOUS_MARKUP_REGEX.test(text);
+  const hasRepeatedPunctuation = REPEATED_PUNCT_REGEX.test(text);
+  const hasUnusualUnicode = PRIVATE_USE_REGEX.test(text);
+
+  const hasPotentialNoise =
+    hasControlChars ||
+    hasReplacementChar ||
+    hasSuspiciousMarkup ||
+    hasRepeatedPunctuation ||
+    hasUnusualUnicode;
+
+  // Derive unique kanji characters preserving first appearance order
+  const uniqueKanji: string[] = [];
+  for (const c of chars) {
+    if (KANJI_REGEX.test(c) && !uniqueKanji.includes(c)) {
+      uniqueKanji.push(c);
+    }
+  }
+
+  // Derive Script Profile
+  let scriptProfile: TatoebaScriptProfile = "OTHER";
+  if (hasKanji && hasKana && !hasLatin) {
+    scriptProfile = "KANJI_KANA";
+  } else if (!hasKanji && hasKana && !hasLatin) {
+    scriptProfile = "KANA_ONLY";
+  } else if (hasKanji && hasLatin) {
+    scriptProfile = "KANJI_LATIN_MIXED";
+  } else if (!hasKanji && hasKana && hasLatin) {
+    scriptProfile = "KANA_LATIN_MIXED";
+  }
+
+  return {
+    characterCount,
+    tokenCount,
+    hasKanji,
+    hasKana,
+    hasHiragana,
+    hasKatakana,
+    hasLatin,
+    hasAscii,
+    hasNumbers,
+    hasDigits: hasNumbers,
+    hasPunctuation,
+    hasJapanesePunctuation,
+    hasSymbols,
+    hasControlChars,
+    hasReplacementChar,
+    hasSuspiciousMarkup,
+    hasRepeatedPunctuation,
+    hasUnusualUnicode,
+    hasPotentialNoise,
+    kanjiCharacters: uniqueKanji,
+    scriptProfile,
+    counts: {
+      kanji: kanjiMatches.length,
+      hiragana: hiraganaMatches.length,
+      katakana: katakanaMatches.length,
+      latin: latinMatches.length,
+      digits: digitMatches.length,
+      japanesePunct: jpnPunctMatches.length,
+      generalPunct: genPunctMatches.length,
+      symbols: symbolMatches.length,
+    },
+  };
+}
