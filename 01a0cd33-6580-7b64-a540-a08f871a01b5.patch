+  // -------------------------------------------------------------
+  // 7. KANJI LINKAGE & POSITIONAL INDEXING (Tests 36-39)
+  // -------------------------------------------------------------
+  describe("7. Kanji Linkage & Positional Indexing", () => {
+    it("36. derives unique kanji characters literally occurring in sentence", () => {
