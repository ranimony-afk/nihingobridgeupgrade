+    try {
+      keigo = await kanjiLexicalGraphService.getKeigoRelations(resolvedEntry.id);
+    } catch {
+      keigo = [];
+    }
+
+    // 7. Fetch Related Vocabulary from shared kanji
+    let relatedVocabulary: any[] = [];
+    try {
+      if (kanjiChars.length > 0) {
+        const firstKanji = kanjiChars[0];
+        const compounds = await kanjiLexicalGraphService.getKanjiCompounds(firstKanji, { limit: 6 });
+        relatedVocabulary = compounds
+          .filter((c) => c.entryId !== resolvedEntry.id)
+          .slice(0, 5);
+      }
+    } catch {
+      relatedVocabulary = [];
+    }
+
     return {
       entry: resolvedEntry,
       source,
       kanji: relatedKanji,
       sentences,
       relatedGrammar,
+      translations,
+      keigo,
+      relatedVocabulary,
     };
   }
 }
