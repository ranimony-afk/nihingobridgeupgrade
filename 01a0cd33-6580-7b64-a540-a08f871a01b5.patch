diff --git a/src/etl/tatoeba/validator.ts b/src/etl/tatoeba/validator.ts
new file mode 100644
index 0000000..84551f9
--- /dev/null
+++ b/src/etl/tatoeba/validator.ts
@@ -0,0 +1,239 @@
+/**
+ * Tatoeba Sentence Validator & Quality Classifier — Phase 14.5B.
+ *
+ * Implements deterministic quality classification:
+ * - ACCEPTED
+ * - ACCEPTED_WITH_WARNING
+ * - UNTRANSLATED
+ * - RELATIONSHIP_ONLY
+ * - INVALID
+ */
+
+import type {
+  TatoebaQualityCategory,
+  TatoebaRawSentenceRecord,
+  TatoebaRejectionCode,
+  TatoebaWarningCode,
+} from "./types";
+import type { EnhancedScriptAnalysis } from "./normalizer";
+
+export interface TatoebaWarningIssue {
+  code: TatoebaWarningCode;
+  message: string;
+  field?: string;
+  value?: unknown;
+}
+
+export interface TatoebaRejectionIssue {
+  code: TatoebaRejectionCode;
+  message: string;
+  field?: string;
+  value?: unknown;
+}
+
+export interface TatoebaValidationResult {
+  status: TatoebaQualityCategory;
+  rejections: TatoebaRejectionIssue[];
+  warnings: TatoebaWarningIssue[];
+}
+
+export class TatoebaValidator {
+  /**
+   * Validates a raw sentence candidate and its script analysis.
+   */
+  static validate(
+    raw: TatoebaRawSentenceRecord,
+    normalizedText: string,
+    scriptAnalysis: EnhancedScriptAnalysis,
+    hasLinkedTranslation: boolean = true,
+    isDuplicateText: boolean = false,
+    hasUnknownKanji: boolean = false
+  ): TatoebaValidationResult {
+    const rejections: TatoebaRejectionIssue[] = [];
+    const warnings: TatoebaWarningIssue[] = [];
+
+    // --- 1. FATAL STRUCTURAL REJECTIONS ---
+
+    // A. Missing or invalid upstream sentence ID
+    if (!raw.sentenceId || typeof raw.sentenceId !== "string" || !raw.sentenceId.trim()) {
+      rejections.push({
+        code: "MISSING_UPSTREAM_ID",
+        message: "Missing or invalid upstream sentence ID",
+        field: "sentenceId",
+        value: raw.sentenceId,
+      });
+    } else if (!/^[0-9]+$/.test(raw.sentenceId.trim())) {
+      rejections.push({
+        code: "INVALID_RECORD",
+        message: `Upstream sentence ID "${raw.sentenceId}" is non-numeric`,
+        field: "sentenceId",
+        value: raw.sentenceId,
+      });
+    }
+
+    // B. Language validation
+    const lang = (raw.lang || "").trim().toLowerCase();
+    if (!lang) {
+      rejections.push({
+        code: "INVALID_RECORD",
+        message: "Missing language code",
+        field: "lang",
+      });
+    } else if (lang !== "jpn") {
+      // Non-Japanese sentences are not Japanese learners, but can be RELATIONSHIP_ONLY targets
+      return {
+        status: "RELATIONSHIP_ONLY",
+        rejections: [],
+        warnings: [],
+      };
+    }
+
+    // C. Empty text validation
+    if (!raw.text || !raw.text.trim() || !normalizedText) {
+      rejections.push({
+        code: "EMPTY_TEXT",
+        message: "Sentence text is empty or contains only whitespace",
+        field: "text",
+        value: raw.text,
+      });
+    }
+
+    if (rejections.length > 0) {
+      return {
+        status: "INVALID",
+        rejections,
+        warnings,
+      };
+    }
+
+    // --- 2. PEDAGOGICAL & ORTHOGRAPHIC WARNINGS ---
+
+    // A. Control characters
+    if (scriptAnalysis.hasControlChars) {
+      warnings.push({
+        code: "CONTROL_CHARACTER",
+        message: "Source text contained non-printable control characters that were stripped",
+        field: "text",
+      });
+    }
+
+    // B. Replacement characters (Unicode \uFFFD)
+    if (scriptAnalysis.hasReplacementChar) {
+      warnings.push({
+        code: "REPLACEMENT_CHARACTER",
+        message: "Source text contains Unicode replacement character (U+FFFD)",
+        field: "text",
+      });
+    }
+
+    // C. Suspicious HTML/XML markup
+    if (scriptAnalysis.hasSuspiciousMarkup) {
+      warnings.push({
+        code: "SUSPICIOUS_MARKUP",
+        message: "Source text contains potential HTML/XML tags or unescaped entities",
+        field: "text",
+      });
+    }
+
+    // D. Repeated excessive punctuation
+    if (scriptAnalysis.hasRepeatedPunctuation) {
+      warnings.push({
+        code: "REPEATED_PUNCTUATION",
+        message: "Source text contains clusters of repeated punctuation marks",
+        field: "text",
+      });
+    }
+
+    // E. Unusual Unicode private-use area
+    if (scriptAnalysis.hasUnusualUnicode) {
+      warnings.push({
+        code: "UNUSUAL_UNICODE",
+        message: "Source text contains private-use area Unicode codepoints",
+        field: "text",
+      });
+    }
+
+    // F. Excessive non-linguistic symbols
+    if (scriptAnalysis.counts.symbols > 5) {
+      warnings.push({
+        code: "EXCESSIVE_SYMBOLS",
+        message: `Sentence contains an unusually high number of symbols (${scriptAnalysis.counts.symbols})`,
+        field: "text",
+        value: scriptAnalysis.counts.symbols,
+      });
+    }
+
+    // G. Length boundaries
+    const len = scriptAnalysis.characterCount;
+    if (len > 120) {
+      warnings.push({
+        code: "LONG_SENTENCE",
+        message: `Sentence exceeds standard pedagogical length (${len} characters)`,
+        field: "text",
+        value: len,
+      });
+    } else if (len < 3) {
+      warnings.push({
+        code: "SHORT_SENTENCE",
+        message: `Sentence is unusually short (${len} characters)`,
+        field: "text",
+        value: len,
+      });
+    }
+
+    // H. Mixed script with heavy Latin text
+    if (scriptAnalysis.hasLatin && scriptAnalysis.counts.latin > 5) {
+      warnings.push({
+        code: "MIXED_SCRIPT",
+        message: `Sentence contains substantial Latin alphabet text (${scriptAnalysis.counts.latin} characters)`,
+        field: "text",
+        value: scriptAnalysis.counts.latin,
+      });
+    }
+
+    // I. Duplicate text diagnostic
+    if (isDuplicateText) {
+      warnings.push({
+        code: "DUPLICATE_TEXT",
+        message: "Identical Japanese text appears in multiple upstream sentence records",
+        field: "text",
+        value: normalizedText,
+      });
+    }
+
+    // J. Unknown kanji character
+    if (hasUnknownKanji) {
+      warnings.push({
+        code: "UNKNOWN_KANJI_CHARACTER",
+        message: "Sentence contains kanji characters not present in canonical kanji_entries",
+        field: "linkedKanji",
+      });
+    }
+
+    // K. Missing translation
+    if (!hasLinkedTranslation) {
+      warnings.push({
+        code: "MISSING_TRANSLATION",
+        message: "Sentence has no linked translation in the target language",
+        field: "linkedTranslations",
+      });
+    }
+
+    // --- 3. CATEGORY RESOLUTION ---
+    let status: TatoebaQualityCategory;
+
+    if (!hasLinkedTranslation) {
+      status = "UNTRANSLATED";
+    } else if (warnings.length > 0) {
+      status = "ACCEPTED_WITH_WARNING";
+    } else {
+      status = "ACCEPTED";
+    }
+
+    return {
+      status,
+      rejections,
+      warnings,
+    };
+  }
+}
