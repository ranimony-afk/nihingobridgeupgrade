+/**
+ * Tatoeba Acquisition & Local Artifact Verification — Phase 14.5A.
+ *
+ * Enforces strict SHA-256 integrity verification, safe path resolution,
+ * and manifest compliance for local raw Tatoeba exports.
+ */
+
+import { createHash } from "crypto";
+import { createReadStream, existsSync, statSync } from "fs";
+import { isAbsolute, normalize, resolve } from "path";
+import type { TatoebaAcquisitionManifest } from "./types";
+
+export interface ArtifactVerificationResult {
+  isValid: boolean;
+  filePath: string;
+  fileSizeBytes: number;
+  actualSha256: string;
+  expectedSha256?: string;
+  error?: string;
+}
+
+export class TatoebaAcquisitionManager {
+  private allowedBaseDir: string;
+
+  constructor(allowedBaseDir?: string) {
+    this.allowedBaseDir = allowedBaseDir || resolve(process.cwd(), "data/tatoeba");
+  }
+
+  /**
+   * Safely resolves and validates a file path inside the allowed directory.
+   * Throws on path traversal attempts or attempts to break outside the base directory.
+   */
+  resolveSafePath(targetPath: string): string {
+    if (!targetPath) {
+      throw new Error("Target file path cannot be empty");
+    }
+
+    // Reject absolute paths that don't start with base dir
+    const resolved = isAbsolute(targetPath)
+      ? normalize(targetPath)
+      : resolve(this.allowedBaseDir, targetPath);
+
+    const normalizedBase = normalize(this.allowedBaseDir);
+
+    if (!resolved.startsWith(normalizedBase)) {
+      throw new Error(
+        `Path traversal violation: Target "${targetPath}" resolves outside allowed directory "${this.allowedBaseDir}"`
+      );
+    }
+
+    return resolved;
+  }
+
+  /**
+   * Computes the SHA-256 hash of a local file via streaming.
+   */
+  async computeFileSha256(filePath: string): Promise<string> {
+    const safePath = this.resolveSafePath(filePath);
+
+    if (!existsSync(safePath)) {
+      throw new Error(`File not found for hash calculation: ${safePath}`);
+    }
+
+    return new Promise((resolveHash, reject) => {
+      const hash = createHash("sha256");
+      const stream = createReadStream(safePath);
+
+      stream.on("data", (chunk) => hash.update(chunk));
+      stream.on("end", () => resolveHash(hash.digest("hex")));
+      stream.on("error", (err) => reject(err));
+    });
+  }
+
+  /**
+   * Verifies an artifact's integrity against expected size and SHA-256.
+   */
+  async verifyArtifact(
+    filePath: string,
+    expectedSha256?: string
+  ): Promise<ArtifactVerificationResult> {
+    const safePath = this.resolveSafePath(filePath);
+
+    if (!existsSync(safePath)) {
+      return {
+        isValid: false,
+        filePath: safePath,
+        fileSizeBytes: 0,
+        actualSha256: "",
+        expectedSha256,
+        error: `Artifact file does not exist at "${safePath}"`,
+      };
+    }
+
+    const stats = statSync(safePath);
+    const actualSha256 = await this.computeFileSha256(safePath);
+
+    if (expectedSha256 && actualSha256.toLowerCase() !== expectedSha256.toLowerCase()) {
+      return {
+        isValid: false,
+        filePath: safePath,
+        fileSizeBytes: stats.size,
+        actualSha256,
+        expectedSha256,
+        error: `ARTIFACT INTEGRITY MISMATCH: Expected SHA-256 "${expectedSha256}", got "${actualSha256}"`,
+      };
+    }
+
+    return {
+      isValid: true,
+      filePath: safePath,
+      fileSizeBytes: stats.size,
+      actualSha256,
+      expectedSha256,
+    };
+  }
+
+  /**
+   * Validates a local artifact against a formal Tatoeba Acquisition Manifest.
+   */
+  async verifyManifest(
+    manifest: TatoebaAcquisitionManifest,
+    artifactPath: string
+  ): Promise<ArtifactVerificationResult> {
+    return this.verifyArtifact(artifactPath, manifest.source.artifact_sha256);
+  }
+}
