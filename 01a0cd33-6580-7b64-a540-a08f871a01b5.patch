+      const mizuLink = links.find((l) => l.headword === "水");
+      expect(mizuLink?.position).toBe(3);
+    });
+
+    it("42. returns empty dictionary links when headword is absent", () => {
+      const links = TatoebaLinker.deriveDictionaryLinks("1001", "走りました。");
