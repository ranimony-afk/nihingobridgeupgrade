+/**
+ * Tatoeba Deterministic Identity Generator — Phase 14.5A.
+ *
+ * Enforces stable, collision-resistant, and idempotent mapping from upstream Tatoeba IDs
+ * to canonical NihongoBridge sentence IDs.
+ */
+
+/**
+ * Returns the canonical internal sentence ID for an upstream Tatoeba sentence ID.
+ *
+ * Invariants:
+ * 1. Deterministic: f(x) === f(x) across any run, platform, or environment.
+ * 2. Injective: x !== y ==> f(x) !== f(y).
+ * 3. Sanitized: Whitespace is trimmed; invalid/empty IDs throw descriptive errors.
+ */
+export function getTatoebaSentenceId(
+  upstreamSentenceId: string | number | null | undefined
+): string {
+  if (upstreamSentenceId === null || upstreamSentenceId === undefined) {
+    throw new Error("Cannot generate Tatoeba sentence ID: upstream ID is null or undefined");
+  }
+
+  const rawStr = String(upstreamSentenceId).trim();
+  if (!rawStr) {
+    throw new Error("Cannot generate Tatoeba sentence ID: upstream ID is empty");
+  }
+
+  // Tatoeba IDs are positive integers in upstream exports.
+  // Validate basic format (digits or safe alphanumeric)
+  if (!/^[a-zA-Z0-9_-]+$/.test(rawStr)) {
+    throw new Error(
+      `Cannot generate Tatoeba sentence ID: invalid characters in upstream ID "${rawStr}"`
+    );
+  }
+
+  return `es-tat-${rawStr}`;
+}
