+      expect(entry.tags).toContain("misc:uk");
+      expect(entry.tags).toContain("dialect:ksb");
+    });
+
+    it("Case 9: preserves multilingual glosses in tags", () => {
+      const raw = SYNTHETIC_JMDICT_RECORDS[8]; // 猫 (eng, ger, fre)
