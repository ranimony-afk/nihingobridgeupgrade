+      expect(res.unknownCharacters).toContain("月");
+    });
+  });
+
+  // -------------------------------------------------------------
+  // 8. CANONICAL DICTIONARY LINKAGE (Tests 40-42)
+  // -------------------------------------------------------------
+  describe("8. Canonical Dictionary Linkage", () => {
+    beforeEach(() => {
+      TatoebaLinker.seedReferences(
+        [
+          { character: "水", id: "ke-mizu", jlptLevel: "N5" },
+          { character: "飲", id: "ke-nomu", jlptLevel: "N5" },
