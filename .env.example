# Database Connection (Supabase PostgreSQL / AWS RDS / Neon / Local pg)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:password@db.projectref.supabase.co:5432/postgres?sslmode=require"

# NextAuth.js Authentication Configuration
# NEXTAUTH_URL should be the full canonical URL of your deployed application
NEXTAUTH_URL="https://your-production-domain.com"
# A 32-character random secret string used to encrypt session cookies and tokens
NEXTAUTH_SECRET="your-32-character-random-secret"

# Mobile JWT Authentication Signing Key
# Used by /api/v1/mobile/auth to sign and verify HMAC SHA-256 tokens for Flutter / Native mobile apps
JWT_SECRET="your-mobile-jwt-signing-secret"

# Supabase Storage & PostgreSQL API Integration
# The REST URL and storage endpoint for your Supabase project
SUPABASE_URL="https://your-project-id.supabase.co"
# Anonymous public API key for client-side queries (safe to expose if RLS is enabled)
SUPABASE_ANON_KEY="your-supabase-anon-key"
# Service role API key with admin privileges (server-side only, NEVER commit or expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
