# ---------------------------------------------------------------------------
# NihongoBridge environment variables — copy to .env (local) / Vercel (prod)
# Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required).
# Local:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Hosted examples (keep sslmode=require for Supabase / Neon / RDS):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require

# Maximum connections per serverless instance (optional, default 5).
DATABASE_POOL_MAX=5

# Per-server-instance API search requests per minute (optional, default 240).
API_RATE_LIMIT=240

# Signs the anonymous learner-progress cookie. Set a long random value in
# production; a development fallback is derived from DATABASE_URL.
LEARNER_SESSION_SECRET=

# Public site URL used for metadata / callbacks (optional).
# NEXT_PUBLIC_SITE_URL=https://nihongobridge.vercel.app

# Future phases (not required for the knowledge platform):
# OPENAI_API_KEY=
# NEXTAUTH_SECRET=
# STRIPE_SECRET_KEY=
