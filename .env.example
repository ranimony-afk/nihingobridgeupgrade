# Canonical NihongoBridge environment
# Copy to .env.local for local development. Never commit secrets.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Phase 14.3D target classification. Loopback is not authorization.
# disposable is for an explicit local/test database only.
# production is refused by Phase 14.3D-R even if set; a separate gate is required.
# NIHONGO_DB_TARGET_CLASS=disposable
# NIHONGO_DB_EXPECTED_DATABASE=app_db

# Phase 13 AI contract (runtime integration is deferred until Phase 13.2+).
# Use mock only for local tests; production must use an explicit configured adapter.
AI_PROVIDER=mock
AI_PROMPT_VERSION=hana-v1
AI_REQUEST_TIMEOUT_MS=45000

# Server-only provider settings. Keep blank until the Anthropic adapter is implemented.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# Supabase Auth foundation (Phase 13.4C-1).
# BROWSER-SAFE: the project URL and publishable key are designed for exposure
# in client bundles. They identify the project; they grant no privileges.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER-ONLY: this foundation uses no service-role key. Never add one here,
# never reference one from browser code, and never commit real values.
