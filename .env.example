# =========================================================================
# NihongoBridge — environment template
# Copy to .env and fill in. NEVER commit .env or real secrets.
# =========================================================================

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# =========================================================================
# PHASE 04.2 — JMdict ETL
# The pipeline is fixture-first: it will NOT reach the network unless
# ETL_ALLOW_NETWORK=true is set explicitly.
# =========================================================================

# --- Source --------------------------------------------------------------
JMDICT_URL=https://www.edrdg.org/pub/Nihongo/JMdict_e.gz
JMDICT_FIXTURE_PATH=etl/fixtures/jmdict-sample.xml

# Enable real downloads (off by default so imports stay reproducible/offline).
ETL_ALLOW_NETWORK=false

# --- Integrity -----------------------------------------------------------
# Trusted SHA-256 of the upstream archive (64 hex chars). Strongly recommended
# for production: a mismatch aborts the import before any row is written.
JMDICT_SHA256=
# Refuse to ingest at all unless a trusted digest above is supplied.
REQUIRE_SOURCE_CHECKSUM=false

# --- Licensing / provenance (Rule 9) -------------------------------------
JMDICT_LICENSE=CC BY-SA 4.0
JMDICT_SOURCE_ATTRIBUTION=JMdict/EDICT — Electronic Dictionary Research and Development Group (EDRDG), CC BY-SA 4.0

# =========================================================================
# PHASE 04.3 — KANJIDIC2 ETL
# Shares the pipeline framework, provenance table and integrity policy
# with the JMdict pipeline above.
# =========================================================================

KANJIDIC2_URL=http://www.edrdg.org/kanjidic/kanjidic2.xml.gz
KANJIDIC2_FIXTURE_PATH=etl/fixtures/kanjidic2-sample.xml

# Trusted SHA-256 of the upstream archive. Mismatch aborts before any write.
KANJIDIC2_SHA256=

KANJIDIC2_LICENSE=CC BY-SA 4.0
KANJIDIC2_SOURCE_ATTRIBUTION=KANJIDIC2 — Electronic Dictionary Research and Development Group (EDRDG), CC BY-SA 4.0

# =========================================================================
# PHASE 04.4 — TATOEBA ETL (sentences)
#
# LICENSING (verified — see reports/phase-04/TATOEBA-LICENSING-AND-SCHEMA-
# VERIFICATION.md): Tatoeba text is CC BY 2.0 FR, which REQUIRES citing each
# sentence's author. We therefore ingest sentences_detailed (which carries
# `username`), NOT sentences.csv (which does not).
#
# AUDIO IS OUT OF SCOPE: Tatoeba audio has a different, wider licence range,
# and where the licence field is empty it may NOT be reused off-site.
# =========================================================================

TATOEBA_SENTENCES_URL=https://downloads.tatoeba.org/exports/sentences_detailed.tar.bz2
TATOEBA_FIXTURE_PATH=etl/fixtures/tatoeba-sentences-sample.tsv
TATOEBA_LINKS_FIXTURE_PATH=etl/fixtures/tatoeba-links-sample.tsv

# Trusted SHA-256 of the upstream archive. Mismatch aborts before any write.
TATOEBA_SENTENCES_SHA256=

TATOEBA_LICENSE=CC BY 2.0 FR
TATOEBA_SOURCE_ATTRIBUTION=Example sentences from Tatoeba (https://tatoeba.org), released under CC BY 2.0 FR. Individual sentences are attributed to their contributors.

# Languages to ingest (comma-separated ISO 639-3; "" = all).
# Keep the translation side (eng) or every sentence link will dangle.
TATOEBA_FILTER_LANG=jpn,eng
# Reject jpn-tagged sentences that contain no Japanese script.
TATOEBA_ENFORCE_SCRIPT=true

# =========================================================================
# PHASE 04.5 — ENRICHMENT PROVENANCE POLICY
#
# Native enrichments (furigana, direct KANJIDIC2 frequency/radicals/strokes,
# and conservative JMdict POS conjugations) require a successful, checksummed,
# non-fixture EDRDG import in production.
#
# JLPT: the current JLPT does not publish an official fixed item list. Any
# imported levels are labelled source-curated, NOT official, and need a source
# review.
# Pitch: no production-safe source is approved until its licence (including
# commercial/subscription use) is independently documented and reviewed.
# =========================================================================

# TEST ONLY. Must remain false in every deploy environment.
ETL_ALLOW_FIXTURE_PROVENANCE=false

# Explicit human-reviewed source URLs allowed for JLPT/pitch feed ingestion.
# Empty = fail closed (the safe production default).
ENRICHMENT_APPROVED_SOURCE_URLS=

# KRADFILE has EDRDG CC BY-SA provenance and supplies actual
# kanji-to-component relationships. Fixture is the safe default in this phase.
# Its official artifact is a ZIP archive; network mode is intentionally BLOCKED
# until an archive extraction stage is separately implemented and tested.
KRADFILE_URL=https://ftp.edrdg.org/pub/Nihongo/kradzip.zip
KRADFILE_FIXTURE_PATH=etl/fixtures/kradfile-sample.txt
KRADFILE_SHA256=
KRADFILE_LICENSE=CC BY-SA 4.0
KRADFILE_SOURCE_ATTRIBUTION=KRADFILE/RADKFILE — Electronic Dictionary Research and Development Group (EDRDG), CC BY-SA 4.0

# =========================================================================
# PHASE 05.3 — DICTIONARY UI
# =========================================================================

# Fixture-derived enrichments (furigana, conjugation, JLPT labels) are hidden
# whenever NODE_ENV=production. Set this ONLY for a preview/test stack that
# deliberately runs the synthetic fixture corpus in production mode (the
# Playwright gate sets it on its own test server). Leave UNSET in production.
DICTIONARY_SHOW_FIXTURE_ENRICHMENTS=

# --- Production ETL operations (shared by all pipelines) -----------------
# Batch writes are transactional. Checkpoints advance only after a batch and
# its dead letters are durable, so interrupted work replays safely.
BATCH_SIZE=200
# Resume the most recent incomplete run ONLY when source checksum matches.
ETL_RESUME=true
# Bounded retry settings for transient network source failures (408/429/5xx).
ETL_DOWNLOAD_RETRIES=3
ETL_DOWNLOAD_BACKOFF_MS=500
# Safety valve. Fixture loads stay bounded; raise deliberately for a reviewed
# production source run.
ETL_MAX_ENTRIES=1000
VALIDATION_ERROR_SAMPLE_LIMIT=100
ETL_DRY_RUN=false
HTTP_TIMEOUT_MS=120000
