# ═══════════════════════════════════════════════════════════════
# NihongoBridge — environment template
#
# Copy to .env and fill in real values:   cp .env.example .env
#
# NEVER commit .env. This template documents variable NAMES and safe
# defaults only; it must never contain a real secret.
#
# Validate at any time:   npm run validate:env
# The build runs the same check automatically (prebuild hook).
# ═══════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────
# DATABASE — required
# ───────────────────────────────────────────────────────────────
# The only variable required to boot. Everything below has a safe
# default or degrades to a reduced mode.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Maximum pooled connections (1–100). Keep low on serverless.
# DATABASE_POOL_MAX=10

# TLS for the database connection.
# Defaults: off for localhost, on for every other host.
# DATABASE_SSL=true


# ───────────────────────────────────────────────────────────────
# APPLICATION
# ───────────────────────────────────────────────────────────────

# Public origin, used for absolute URLs and CORS. No trailing slash.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# APP_NAME=NihongoBridge

# debug | info | warn | error
# LOG_LEVEL=info


# ───────────────────────────────────────────────────────────────
# AUTHENTICATION
# ───────────────────────────────────────────────────────────────
# Identity is owned by this repository (ARCHITECTURE_FREEZE §3).
# No external identity provider is required.
#
# AUTH_SESSION_SECRET is OPTIONAL in development (an ephemeral key is
# generated, so sessions end on restart) and REQUIRED in production —
# the server refuses to start without it.
#
# Generate one:  openssl rand -base64 48

# AUTH_SESSION_SECRET=

# Session cookie name.
# AUTH_COOKIE_NAME=nb_session

# Web session lifetime in seconds (default 30 days).
# AUTH_SESSION_TTL_SECONDS=2592000

# Mobile bearer token lifetimes in seconds (default 15 min / 60 days).
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# AUTH_REFRESH_TOKEN_TTL_SECONDS=5184000


# ───────────────────────────────────────────────────────────────
# AI — optional
# ───────────────────────────────────────────────────────────────
# With no provider key the tutor uses a deterministic mock provider.
# It never invents dictionary or grammar facts.

# auto | openai | anthropic | mock   (auto picks whichever key is set)
# AI_PROVIDER=auto

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Override the default model for the selected provider.
# AI_MODEL=

# AI_REQUEST_TIMEOUT_MS=30000
# AI_MAX_OUTPUT_TOKENS=1024


# ───────────────────────────────────────────────────────────────
# STORAGE — optional
# ───────────────────────────────────────────────────────────────
# Object storage for audio and images. Disabled by default; media
# features stay off until a driver is selected.
#
# none  = disabled (default)
# local = filesystem, development only
# s3    = S3 or any S3-compatible endpoint

# STORAGE_DRIVER=none

# Required when STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./.storage

# All four required when STORAGE_DRIVER=s3
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# Custom endpoint for S3-compatible providers.
# STORAGE_ENDPOINT=

# Public base URL objects are served from (CDN or bucket origin).
# STORAGE_PUBLIC_URL=


# ───────────────────────────────────────────────────────────────
# SEARCH — optional tuning
# ───────────────────────────────────────────────────────────────
# Search is PostgreSQL full-text + pg_trgm (ARCHITECTURE_FREEZE §6).
# There is no external search service to configure.

# pg_trgm similarity cut-off for fuzzy matches (0.05–1.0).
# Lower = more permissive, slower.
# SEARCH_TRIGRAM_THRESHOLD=0.3

# Hard cap on rows returned by a single search.
# SEARCH_MAX_RESULTS=100

# Attempt CREATE EXTENSION pg_trgm during migration.
# Set false if the database user lacks the privilege.
# SEARCH_AUTO_CREATE_EXTENSIONS=true


# ═══════════════════════════════════════════════════════════════
# REJECTED BY THE ARCHITECTURE FREEZE — do not add
#
#   ALLOW_INSECURE_USER_HEADER  authentication bypass. Fatal if set.
#   ADMIN_DEMO_MODE             grants admin without login. Fatal if set.
#   SUPABASE_*                  identity is owned here (DEC-0011). Ignored.
#   MEILISEARCH_*               search is PostgreSQL in v1 (DEC-0012). Ignored.
#   MINIO_*                     use STORAGE_* instead.
#
# The first two abort validation. The rest are ignored with a warning.
# ═══════════════════════════════════════════════════════════════
