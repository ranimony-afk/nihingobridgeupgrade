# =========================================================================
# NihongoBridge — environment template
# Copy to .env and fill in. NEVER commit .env or real secrets.
# =========================================================================

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# =========================================================================
# PHASE 04.2 — JMdict ETL
# The pipeline is fixture-first: it will NOT reach the network unless
# ETL_ALLOW_NETWORK=true is set explicitly.
# =========================================================================

# --- Source --------------------------------------------------------------
JMDICT_URL=https://www.edrdg.org/pub/Nihongo/JMdict_e.gz
JMDICT_FIXTURE_PATH=etl/fixtures/jmdict-sample.xml

# Enable real downloads (off by default so imports stay reproducible/offline).
ETL_ALLOW_NETWORK=false

# --- Integrity -----------------------------------------------------------
# Trusted SHA-256 of the upstream archive (64 hex chars). Strongly recommended
# for production: a mismatch aborts the import before any row is written.
JMDICT_SHA256=
# Refuse to ingest at all unless a trusted digest above is supplied.
REQUIRE_SOURCE_CHECKSUM=false

# --- Licensing / provenance (Rule 9) -------------------------------------
JMDICT_LICENSE=CC BY-SA 4.0
JMDICT_SOURCE_ATTRIBUTION=JMdict/EDICT — Electronic Dictionary Research and Development Group (EDRDG), CC BY-SA 4.0

# --- Pipeline behaviour --------------------------------------------------
BATCH_SIZE=200
# Safety valve. Phase 04.2 loads a small fixture only; raise deliberately.
ETL_MAX_ENTRIES=1000
VALIDATION_ERROR_SAMPLE_LIMIT=100
ETL_DRY_RUN=false
HTTP_TIMEOUT_MS=120000
