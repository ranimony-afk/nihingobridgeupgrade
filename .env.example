# Core runtime
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/nihongobridge
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Auth.js sessions (generate with: openssl rand -base64 48)
AUTH_SECRET=
AUTH_TRUST_HOST=false
AUTH_SESSION_MAX_AGE_DAYS=30

# OAuth callbacks: <NEXT_PUBLIC_APP_URL>/api/auth/callback/github|google
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# Transactional email / magic links / verification / password reset
RESEND_API_KEY=
EMAIL_FROM=accounts@your-verified-domain.example

# Flutter JWT and rotating refresh tokens (generate independent 48-byte secret)
MOBILE_JWT_SECRET=
MOBILE_JWT_ISSUER=http://localhost:3000
MOBILE_JWT_AUDIENCE=nihongobridge-mobile
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# AES-256-GCM MFA secret encryption key (generate with: openssl rand -base64 48)
MFA_ENCRYPTION_KEY=

# Payments — Stripe (Checkout, Billing Portal, Flutter PaymentSheet, signed webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Payments — Razorpay (Orders, Subscriptions, Refunds, signed webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# GST / billing identity
GST_DEFAULT_RATE_BPS=1800
GST_SUPPLY_STATE=
BILLING_LEGAL_NAME=
BILLING_GSTIN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis
REDIS_URL=redis://localhost:6379
RATE_LIMIT_ALLOW_MEMORY_FALLBACK=true

# Error tracking
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Operations
HEALTHCHECK_TOKEN=
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=

# Vercel deployment
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
