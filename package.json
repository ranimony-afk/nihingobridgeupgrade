{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:env",
    "build": "next build",
    "start": "next start",
    "validate:env": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-env.mjs",
    "validate:env:runtime": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-env.mjs --runtime",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/integration/**/*.test.ts\"",
    "test:api": "node scripts/run-server-tests.mjs tests/api",
    "test:smoke": "node scripts/run-server-tests.mjs tests/smoke",
    "test:server": "node scripts/run-server-tests.mjs tests/api tests/smoke",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:server",
    "check:structure": "node scripts/check-structure.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.mjs",
    "db:status": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.mjs --status",
    "db:rollback": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.mjs --rollback",
    "db:test-migrations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-migrations.mjs",
    "db:studio": "drizzle-kit studio",
    "db:push:unsafe": "drizzle-kit push",
    "verify": "npm run check:structure && npm run validate:env && npm run lint && npm run typecheck && npm run db:test-migrations && npm run test:all"
  },
  "dependencies": {
    "@playwright/test": "^1.63.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "^16.3.5",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.5",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
