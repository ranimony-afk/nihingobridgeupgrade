diff --git a/scripts/inspect-k012-windows-sources.ps1 b/scripts/inspect-k012-windows-sources.ps1
new file mode 100644
index 0000000..5048929
--- /dev/null
+++ b/scripts/inspect-k012-windows-sources.ps1
@@ -0,0 +1,210 @@
+<#
+.SYNOPSIS
+Read-only Windows inventory for NihongoBridge source artifacts.
+
+.DESCRIPTION
+Searches only the explicitly supplied project roots. It records path, name,
+size, last-write time, extension-based type, and SHA-256. It does not open PDF,
+JSON, CSV/TSV, workbook-cell, or XML content; it does not extract or modify
+source files. With -ListArchiveEntries, it lists container entry names only
+for ZIP-family files using .NET, and for tar.bz2/7z only if 7-Zip is detected
+at runtime. Archive entry listing never extracts data.
+
+Pass narrow project/data directories. Do not pass a drive root or the whole
+user profile. Output is JSON on stdout; the script creates no output file.
+#>
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory = $true)]
+    [ValidateNotNullOrEmpty()]
+    [string[]]$ProjectRoots,
+
+    [switch]$ListArchiveEntries
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+if (-not (Get-Command -Name Get-FileHash -ErrorAction SilentlyContinue)) {
+    throw 'Required built-in Get-FileHash cmdlet is not available; stop without scanning.'
+}
+
+$excludedDirectoryNames = @(
+    '.git', 'node_modules', '.next', '.nuxt', '.output', '.venv', 'venv',
+    'build', 'dist', 'coverage', 'target', 'out', '.cache', '.tox'
+)
+$sourceNamePattern = '(?i)(kanji.?2500|2500.?kanji|ocr|takoboto|radical|kanjidic2|kanjivg|tatoeba|jmdict|source.?lock|source.?manifest|rights|provenance|acquisition|licen[cs]e|copyright|terms)'
+$artifactExtensions = @(
+    '.pdf', '.xlsx', '.xlsm', '.xls', '.br', '.xml', '.tar', '.bz2', '.zip',
+    '.7z', '.csv', '.tsv'
+)
+$namedEvidenceExtensions = @('.json', '.md', '.txt', '.html', '.htm', '.xml')
+$files = [System.Collections.Generic.List[object]]::new()
+$issues = [System.Collections.Generic.List[object]]::new()
+$rootResults = [System.Collections.Generic.List[object]]::new()
+$seenPaths = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::OrdinalIgnoreCase)
+
+function Get-ExtensionType {
+    param([string]$Extension)
+    switch ($Extension.ToLowerInvariant()) {+        '.pdf' { return 'PDF (extension-based; contents not opened)' }
+        { $_ -in '.xlsx', '.xlsm', '.xls' } { return 'Excel workbook (extension-based; cells not opened)' }
+        '.br' { return 'Brotli-compressed file (extension-based; not decompressed)' }
+        '.tar' { return 'TAR archive (extension-based; not extracted)' }
+        '.bz2' { return 'BZip2/archive file (extension-based; not decompressed)' }
+        { $_ -in '.zip', '.7z' } { return 'Archive (extension-based; not extracted)' }
+        '.xml' { return 'XML (extension-based; contents not opened)' }
+        '.csv' { return 'CSV (extension-based; contents not opened)' }
+        '.tsv' { return 'TSV (extension-based; contents not opened)' }
+        '.json' { return 'JSON (extension-based; contents not opened)' }
+        '.md' { return 'Markdown (extension-based; contents not opened)' }
+        { $_ -in '.html', '.htm' } { return 'HTML (extension-based; contents not opened)' }
+        '.txt' { return 'Text (extension-based; contents not opened)' }
+        default { return 'Unknown/other (extension-based)' }
+    }
+}
+
+function Get-ZipEntryNamesReadOnly {
+    param([string]$LiteralPath)
+    $result = [ordered]@{ status = 'NOT_REQUESTED'; entryNames = @(); truncated = $false }
+    if (-not $ListArchiveEntries) { return $result }
+    try {
+        Add-Type -AssemblyName System.IO.Compression.FileSystem -ErrorAction Stop
+        $archive = [System.IO.Compression.ZipFile]::OpenRead($LiteralPath)
+        try {
+            $names = [System.Collections.Generic.List[string]]::new()
+            foreach ($entry in $archive.Entries) {
+                if ($names.Count -ge 500) {
+                    $result.truncated = $true
+                    break
+                }
+                $names.Add($entry.FullName)
+            }
+            $result.status = 'LISTED_ZIP_DIRECTORY_ONLY'
+            $result.entryNames = $names.ToArray()
+        }
+        finally {
+            $archive.Dispose()
+        }
+    }
+    catch {
+        $result.status = 'UNAVAILABLE_OR_NOT_A_VALID_ZIP'
+        $result.error = $_.Exception.Message
+    }
+    return $result
+}
+
+$sevenZip = $null
+if ($ListArchiveEntries) {
+    $sevenZip = Get-Command -Name '7z.exe', '7z', '7za.exe' -ErrorAction SilentlyContinue | Select-Object -First 1
+}
+
+foreach ($requestedRoot in $ProjectRoots) {
+    try {
+        $resolvedRoot = (Resolve-Path -LiteralPath $requestedRoot -ErrorAction Stop).Path
+        $rootItem = Get-Item -LiteralPath $resolvedRoot -ErrorAction Stop
+        if (-not $rootItem.PSIsContainer) {
+            $issues.Add([pscustomobject]@{ path = $requestedRoot; issue = 'Search root is not a directory.' })
+            $rootResults.Add([pscustomobject]@{ requested = $requestedRoot; resolved = $resolvedRoot; status = 'NOT_A_DIRECTORY' })
+            continue
+        }
+        $rootResults.Add([pscustomobject]@{ requested = $requestedRoot; resolved = $resolvedRoot; status = 'SEARCHED' })
+        $pending = [System.Collections.Generic.Stack[string]]::new()
+        $pending.Push($resolvedRoot)
+        while ($pending.Count -gt 0) {
+            $currentDirectory = $pending.Pop()
+            try {
+                $children = Get-ChildItem -LiteralPath $currentDirectory -Force -ErrorAction Stop
+            }
+            catch {
+                $issues.Add([pscustomobject]@{ path = $currentDirectory; issue = $_.Exception.Message })
+                continue
+            }
+            foreach ($child in $children) {
+                if ($child.PSIsContainer) {
+                    if ($excludedDirectoryNames -contains $child.Name) { continue }
+                    if (($child.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) { continue }
+                    $pending.Push($child.FullName)
+                    continue
+                }
+                $extension = $child.Extension.ToLowerInvariant()
+                $typeMatch = $artifactExtensions -contains $extension
+                $namedEvidenceMatch = ($namedEvidenceExtensions -contains $extension) -and ($child.FullName -match $sourceNamePattern)
+                if (-not ($typeMatch -or $namedEvidenceMatch)) { continue }
+                if (-not $seenPaths.Add($child.FullName)) { continue }
+
+                $hash = $null
+                $hashError = $null
+                try {
+                    $hash = (Get-FileHash -LiteralPath $child.FullName -Algorithm SHA256 -ErrorAction Stop).Hash.ToLowerInvariant()
+                }
+                catch {
+                    $hashError = $_.Exception.Message
+                }
+
+                $archiveListing = [ordered]@{ status = 'NOT_APPLICABLE'; entryNames = @(); truncated = $false }
+                if ($ListArchiveEntries -and $extension -in @('.zip', '.xlsx', '.xlsm')) {
+                    $archiveListing = Get-ZipEntryNamesReadOnly -LiteralPath $child.FullName
+                }
+                elseif ($ListArchiveEntries -and $extension -in @('.7z', '.tar', '.bz2')) {
+                    if ($sevenZip) {
+                        try {
+                            $listingLines = & $sevenZip.Source l -slt $child.FullName 2>&1
+                            $exitCode = $LASTEXITCODE
+                            $entryNames = [System.Collections.Generic.List[string]]::new()
+                            foreach ($line in $listingLines) {
+                                if ($line -match '^Path = (.+)$' -and $Matches[1] -ne $child.FullName) {
+                                    if ($entryNames.Count -lt 500) { $entryNames.Add($Matches[1]) }
+                                    else { $archiveListing.truncated = $true }
+                                }
+                            }
+                            $archiveListing.status = if ($exitCode -eq 0) { 'LISTED_BY_DETECTED_7ZIP_NO_EXTRACTION' } else { '7ZIP_LIST_FAILED' }
+                            $archiveListing.entryNames = $entryNames.ToArray()
+                            if ($exitCode -ne 0) { $archiveListing.error = "7-Zip listing exit code $exitCode" }
+                        }
+                        catch {
+                            $archiveListing.status = '7ZIP_LIST_FAILED'
+                            $archiveListing.error = $_.Exception.Message
+                        }
+                    }
+                    else {
+                        $archiveListing.status = 'SKIPPED_7ZIP_NOT_DETECTED'
+                    }
+                }
+
+                $files.Add([pscustomobject]@{
+                    fullPath = $child.FullName
+                    fileName = $child.Name
+                    sizeBytes = $child.Length
+                    lastWriteTimeUtc = $child.LastWriteTimeUtc.ToString('o')
+                    extension = $extension
+                    fileType = Get-ExtensionType -Extension $extension
+                    sha256 = $hash
+                    hashError = $hashError
+                    archiveDirectoryListing = $archiveListing
+                })
+            }
+        }
+    }
+    catch {
+        $issues.Add([pscustomobject]@{ path = $requestedRoot; issue = $_.Exception.Message })
+        $rootResults.Add([pscustomobject]@{ requested = $requestedRoot; resolved = $null; status = 'ROOT_UNAVAILABLE' })
+    }
+}
+
+$report = [ordered]@{
+    schemaVersion = 'nihongobridge-k012-windows-source-metadata@1'
+    generatedAtUtc = [DateTime]::UtcNow.ToString('o')
+    readOnly = $true
+    windowsEnvironmentInspectedByArena = $false
+    roots = $rootResults.ToArray()
+    files = $files.ToArray()
+    issues = $issues.ToArray()
+    notes = @(
+        'Only the explicitly supplied project roots were searched; the script does not scan the whole user profile or a drive root.',
+        'SHA-256 reads file bytes for hashing; no PDF/OCR/JSON/CSV/TSV/workbook-cell/XML contents are parsed.',
+        'ZIP entry listing, if requested, reads directory metadata only and extracts nothing.',
+        'TAR/BZip2 entry listing is attempted only when -ListArchiveEntries is set and 7-Zip is detected at runtime; otherwise it is explicitly skipped.',
+        'The script creates no files and changes no source artifact.'
+    )
+}
+$report | ConvertTo-Json -Depth 10
