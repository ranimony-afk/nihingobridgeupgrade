--- /dev/null
+++ b/src/lib/api/noStoreJsonResponse.ts
@@ -0,0 +1,8 @@
+import { NextResponse } from "next/server";
+
+/** Build JSON responses that must not be retained by browsers or shared proxies. */
+export function noStoreJsonResponse(body: unknown, init?: ResponseInit): NextResponse {
+  const headers = new Headers(init?.headers);
+  headers.set("Cache-Control", "no-store");
+  return NextResponse.json(body, { ...init, headers });
+}
diff --git a/src/lib/api/rightsRestrictedResponse.ts b/src/lib/api/rightsRestrictedResponse.ts
new file mode 100644
index 0000000..0989eb7
--- /dev/null
+++ b/src/lib/api/rightsRestrictedResponse.ts
@@ -0,0 +1,79 @@
+import { NextResponse } from "next/server";
+import { dictionaryRightsWithheldPayload } from "@/lib/dictionary/publicRights";
+import {
+  LEGACY_KANJI_API_SOURCE_REFS,
+  resolveCurrentKanjiDeliveryPolicySnapshot,
+  isKanjiRightsDeliveryDeniedError,
+} from "@/lib/kanji/mindtreePublicDelivery";
+import {
+  runWithKanjiDeliveryPolicySnapshot,
+  type KanjiDeliveryPolicySnapshot,
+} from "@/lib/kanji/deliveryPolicySnapshot";
+
+/** No-store response for the established dictionary rights gate. */
+export function rightsRestrictedResponse() {
+  return NextResponse.json(dictionaryRightsWithheldPayload(), {
+    status: 451,
+    headers: { "Cache-Control": "no-store" },
+  });
+}
+
+/** Learner-safe Kanji pending response: no source names or internal policy detail. */
+export function kanjiRightsRestrictedResponse() {
+  return NextResponse.json({
+    success: false,
+    error: {
+      code: "CONTENT_UNAVAILABLE",
+      message: "This content is temporarily unavailable.",
+    },
+  }, {
+    status: 451,
+    headers: { "Cache-Control": "no-store" },
+  });
+}
+
+/**
+ * The shared server-side policy boundary. The resolver is trusted composition
+ * state, never request input. The same boundary is used in production and by
+ * synthetic-only transition tests; it checks policy on both sides of the read
+ * and discards output if the effective snapshot changes while work is running.
+ */
+export function withPolicySnapshotResponseBoundary<Args extends unknown[]>(input: {
+  handler: (...args: Args) => Response | Promise<Response>;
+  resolveSnapshot: () => KanjiDeliveryPolicySnapshot;
+  sourceRefs: readonly string[];
+  character?: string;
+  editorialRecordId?: string;
+}): (...args: Args) => Promise<Response> {
+  return async (...args: Args) => {
+    try {
+      const response = await runWithKanjiDeliveryPolicySnapshot({
+        resolveSnapshot: input.resolveSnapshot,
+        sourceRefs: input.sourceRefs,
+        character: input.character,
+        editorialRecordId: input.editorialRecordId,
+        read: () => input.handler(...args),
+      });
+      response.headers.set("Cache-Control", "no-store");
+      return response;
+    } catch (error) {
+      if (isKanjiRightsDeliveryDeniedError(error)) return kanjiRightsRestrictedResponse();
+      throw error;
+    }
+  };
+}
+
+/**
+ * Route adapter for read paths whose serialized payload can contain Kanji.
+ * Production always supplies the immutable trusted snapshot above; there is no
+ * route parameter or live rights provider that can grant delivery.
+ */
+export function withKanjiPublicDeliveryGate<Args extends unknown[]>(
+  handler: (...args: Args) => Response | Promise<Response>,
+): (...args: Args) => Promise<Response> {
+  return withPolicySnapshotResponseBoundary({
+    handler,
+    resolveSnapshot: resolveCurrentKanjiDeliveryPolicySnapshot,
+    sourceRefs: LEGACY_KANJI_API_SOURCE_REFS,
+  });
+}
