index 0000000..00dc9d1
--- /dev/null
+++ b/src/services/knowledge/editorial/kanjiMembership.ts
@@ -0,0 +1,102 @@
+import { publicDistributionDecision, type RightsHistoryEvent } from "../provenance/rightsPolicy";
+
+export const KANJI_MEMBERSHIP_SCHEMA = "nihongobridge-kanji-membership@1" as const;
+export const KANJI_MEMBERSHIP_SCHEMA_V2 = "nihongobridge-kanji-membership@2" as const;
+export const KANJI_SELECTION_GOALS = [
+  "japanese_literacy",
+  "general_reading_coverage",
+  "learner_progression",
+  "comprehensive_reference",
+] as const;
+export type KanjiSelectionGoal = (typeof KANJI_SELECTION_GOALS)[number];
+export type KanjiMembershipState = "candidate" | "approved" | "published" | "excluded" | "deferred" | "withdrawn";
+export const KANJI_QUOTA_POLICY = "no_equal_quotas_without_owner_approval" as const;
+
+/** Membership events are independent of canonical identity and source assertions. */
+export interface KanjiMembershipEvent {
+  schemaVersion: typeof KANJI_MEMBERSHIP_SCHEMA | typeof KANJI_MEMBERSHIP_SCHEMA_V2;
+  eventId: string;
+  identityId: string;
+  exactCharacter: string;
+  goal: KanjiSelectionGoal;
+  state: KanjiMembershipState;
+  sequence: number;
+  previousEventId: string | null;
+  sourceAssertionIds: string[];
+  sourceRefs: string[];
+  decisionEvidenceRef: string;
+  decisionAuthority: string;
+  decisionTrust: "unverified_local_attribution" | "authenticated_external";
+  authenticationEvidenceRef: string | null;
+  authenticationEvidenceSha256: string | null;
+}
+
+export function validateKanjiMembershipHistory(events: readonly KanjiMembershipEvent[]): { valid: boolean; issues: string[] } {
+  const issues: string[] = [];
+  const ids = new Set<string>();
+  const streams = new Map<string, KanjiMembershipEvent[]>();
+  for (const event of events) {
+    if (!event || ![KANJI_MEMBERSHIP_SCHEMA, KANJI_MEMBERSHIP_SCHEMA_V2].includes(event.schemaVersion)) { issues.push("unsupported membership event schema"); continue; }
+    if (!event.eventId.trim() || ids.has(event.eventId)) issues.push(`missing or duplicate membership event ID ${event.eventId}`);
+    ids.add(event.eventId);
+    if (!event.identityId.trim() || [...event.exactCharacter].length !== 1) issues.push(`${event.eventId}: exact canonical identity is required`);
+    if (!KANJI_SELECTION_GOALS.includes(event.goal)) issues.push(`${event.eventId}: unsupported selection goal`);
+    const allowedStates = event.schemaVersion === KANJI_MEMBERSHIP_SCHEMA
+      ? ["candidate", "approved", "published", "withdrawn"]
+      : ["candidate", "approved", "published", "excluded", "deferred", "withdrawn"];
+    if (!allowedStates.includes(event.state)) issues.push(`${event.eventId}: unsupported membership state for ${event.schemaVersion}`);
+    if (!Number.isInteger(event.sequence) || event.sequence < 1) issues.push(`${event.eventId}: sequence must be positive`);
+    if (!Array.isArray(event.sourceAssertionIds) || !event.sourceAssertionIds.length || event.sourceAssertionIds.some((id) => !id.trim())) issues.push(`${event.eventId}: membership needs explicit source assertion references`);
+    if (!Array.isArray(event.sourceRefs) || !event.sourceRefs.length || event.sourceRefs.some((ref) => !ref.trim())) issues.push(`${event.eventId}: membership needs sourceRefs for rights resolution`);
+    if (!event.decisionEvidenceRef.trim() || !event.decisionAuthority.trim()) issues.push(`${event.eventId}: decision evidence and authority are required`);
+    if (event.decisionTrust === "authenticated_external") {
+      if (!event.authenticationEvidenceRef?.trim() || !/^[0-9a-f]{64}$/u.test(event.authenticationEvidenceSha256 ?? "")) issues.push(`${event.eventId}: authenticated membership requires pinned external evidence`);
+    } else if (event.authenticationEvidenceRef !== null || event.authenticationEvidenceSha256 !== null) {
+      issues.push(`${event.eventId}: local attribution cannot carry asserted authentication evidence`);
+    }
+    const key = `${event.identityId}\u0000${event.goal}`;
+    const stream = streams.get(key) ?? [];
+    stream.push(event);
+    streams.set(key, stream);
+  }
+  for (const [key, stream] of streams) {
+    stream.sort((a, b) => a.sequence - b.sequence);
+    for (let index = 0; index < stream.length; index++) {
+      const event = stream[index];
+      if (event.sequence !== index + 1) issues.push(`${key}: membership sequence must be contiguous`);
+      if (event.previousEventId !== (stream[index - 1]?.eventId ?? null)) issues.push(`${event.eventId}: membership event chain is broken`);
+      const prior = stream[index - 1];
+      const allowed = prior === undefined
+        ? event.state === "candidate"
+        : prior.state === "candidate" ? ["approved", "excluded", "deferred", "withdrawn"].includes(event.state)
+          : prior.state === "approved" ? ["published", "excluded", "deferred", "withdrawn"].includes(event.state)
+            : prior.state === "published" ? ["excluded", "withdrawn"].includes(event.state)
+              : prior.state === "deferred" ? ["candidate", "approved", "excluded", "withdrawn"].includes(event.state)
+                : prior.state === "excluded" || prior.state === "withdrawn" ? event.state === "candidate"
+                  : false;
+      if (!allowed) issues.push(`${event.eventId}: invalid ${prior?.state ?? "start"} → ${event.state} membership transition`);
+      if (prior && prior.exactCharacter !== event.exactCharacter) issues.push(`${event.eventId}: exact character identity changed within membership history`);
+      if (prior && prior.sourceAssertionIds.some((id) => !event.sourceAssertionIds.includes(id))) issues.push(`${event.eventId}: source assertion history cannot be silently removed`);
+      if (prior && prior.sourceRefs.some((ref) => !event.sourceRefs.includes(ref))) issues.push(`${event.eventId}: source references cannot be silently removed`);
+    }
+  }
+  return { valid: issues.length === 0, issues: [...new Set(issues)].sort() };
+}
+
+/** Candidate/approved/published membership is not rights clearance or a source assertion. */
+export function mayAppearInPublicCorpus(input: {
+  latestEvent: KanjiMembershipEvent | null;
+  rightsHistory: readonly RightsHistoryEvent[];
+  /** Must be set only by a trusted server-side verifier; local evidence is not sufficient. */
+  membershipEvidenceVerified: boolean;
+}): { allowed: boolean; reason: string } {
+  if (!input.latestEvent || input.latestEvent.state !== "published") return { allowed: false, reason: "membership_not_published" };
+  if (!input.membershipEvidenceVerified || input.latestEvent.decisionTrust !== "authenticated_external") return { allowed: false, reason: "membership_authority_unverified" };
+  const decision = publicDistributionDecision(input.rightsHistory, input.latestEvent.sourceRefs);
+  return decision.allowed
+    ? { allowed: true, reason: "published_membership_and_all_sources_cleared" }
+    : { allowed: false, reason: "source_rights_not_cleared" };
+}
+
+/** No 2,501 manifest or approved membership records are included in K0.5A. */
+export const KANJI_MEMBERSHIP_BASELINE: readonly KanjiMembershipEvent[] = Object.freeze([]);
