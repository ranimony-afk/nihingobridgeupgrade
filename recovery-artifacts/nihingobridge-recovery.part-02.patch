diff --git a/src/components/kanji-foundation/KanjiFoundationStudio.tsx b/src/components/kanji-foundation/KanjiFoundationStudio.tsx
new file mode 100644
index 0000000..1dc5048
--- /dev/null
+++ b/src/components/kanji-foundation/KanjiFoundationStudio.tsx
@@ -0,0 +1,474 @@
+"use client";
+
+import Link from "next/link";
+import { useCallback, useEffect, useMemo, useState } from "react";
+import type { FormEvent, ReactNode } from "react";
+import { ArrowLeft, Check, CircleAlert, FilePlus2, LockKeyhole, RefreshCw, Send, ShieldCheck } from "lucide-react";
+import type { FoundationFieldPayload, FoundationIdentityPayload, ProvisionalCohort } from "@/services/knowledge/editorial/kanjiFoundation";
+
+type CmsItem = {
+  id: string;
+  title: string;
+  status: string;
+  currentVersion: number;
+  authorId: string;
+  reviewerId: string | null;
+  stagedPayload: unknown;
+  createdAt: string;
+  updatedAt: string;
+};
+type InternalRecord = { item: CmsItem; versions: unknown[]; audits: Array<{ action: string; occurredAt: string; actorId: string; details: Record<string, unknown> }> };
+type StudioResponse = {
+  cohort: ProvisionalCohort;
+  records: InternalRecord[];
+  publicDelivery: Array<{ identityId: string; fieldKeys: string[] }>;
+};
+type Envelope = { success?: boolean; data?: StudioResponse; error?: { message?: string; code?: string } };
+
+const FIELD_OPTIONS = [
+  { value: "meaning", label: "Meaning note" },
+  { value: "reading.on", label: "On reading note" },
+  { value: "reading.kun", label: "Kun reading note" },
+  { value: "mnemonic", label: "Memory note" },
+  { value: "vocabulary", label: "Vocabulary list (JSON)" },
+  { value: "decomposition", label: "Component analysis (Mind Tree JSON)" },
+] as const;
+const RIGHTS_SCOPES = ["retention", "internal_analysis", "derivation", "public_distribution"] as const;
+const RIGHTS_STATES = ["UNKNOWN", "CONDITIONAL", "BLOCKED", "CLEARED"] as const;
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+function identityPayload(record: InternalRecord | undefined): FoundationIdentityPayload | null {
+  if (!record || !isObject(record.item.stagedPayload) || record.item.stagedPayload.kind !== "identity") return null;
+  return record.item.stagedPayload as unknown as FoundationIdentityPayload;
+}
+function fieldPayload(record: InternalRecord): FoundationFieldPayload | null {
+  if (!isObject(record.item.stagedPayload) || record.item.stagedPayload.kind !== "field") return null;
+  return record.item.stagedPayload as unknown as FoundationFieldPayload;
+}
+function label(status: string): string {
+  if (status === "draft") return "DRAFT";
+  if (status === "review") return "IN REVIEW";
+  if (status === "approved" || status === "scheduled") return "APPROVED · UNPUBLISHED";
+  if (status === "published") return "PUBLISHED";
+  if (status === "archived") return "BLOCKED · ARCHIVED";
+  return "NO DATA";
+}
+function fieldRights(payload: FoundationFieldPayload): string {
+  const states = payload.provenance.sourceRefs.flatMap((sourceRef) => (["derivation", "public_distribution"] as const).map((scope) =>
+    payload.rightsHistory.filter((event) => event.sourceRef === sourceRef && event.scope === scope).sort((a, b) => b.sequence - a.sequence)[0]?.state ?? "UNKNOWN"));
+  if (states.length > 0 && states.every((state) => state === "CLEARED")) return "CLEARED";
+  if (states.includes("BLOCKED")) return "BLOCKED";
+  if (states.includes("CONDITIONAL")) return "CONDITIONAL";
+  return "UNKNOWN";
+}
+function badgeTone(status: string): string {
+  if (status === "published") return "border-emerald-200 bg-emerald-50 text-emerald-800";
+  if (status === "review") return "border-amber-200 bg-amber-50 text-amber-900";
+  if (status === "approved" || status === "scheduled") return "border-sky-200 bg-sky-50 text-sky-900";
+  if (status === "archived") return "border-rose-200 bg-rose-50 text-rose-900";
+  return "border-slate-200 bg-slate-100 text-slate-700";
+}
+function latestRecords(records: InternalRecord[]) {
+  const sorted = [...records].sort((a, b) => a.item.updatedAt.localeCompare(b.item.updatedAt));
+  const identities = new Map<string, InternalRecord>();
+  const fields = new Map<string, InternalRecord>();
+  for (const record of sorted) {
+    const payload = record.item.stagedPayload;
+    if (!isObject(payload)) continue;
+    if (payload.kind === "identity" && isObject(payload.identity) && typeof payload.identity.identityId === "string") identities.set(payload.identity.identityId, record);
+    if (payload.kind === "field" && typeof payload.identityId === "string" && typeof payload.fieldKey === "string") {
+      const key = `${payload.identityId}\u0000${payload.fieldKey}`;
+      const prior = fields.get(key);
+      const priorPayload = prior ? fieldPayload(prior) : null;
+      if (!priorPayload || Number(payload.revisionNumber) > priorPayload.revisionNumber) fields.set(key, record);
+    }
+  }
+  return { identities, fields: [...fields.values()] };
+}
+
+function useFoundationStudio() {
+  const [response, setResponse] = useState<StudioResponse | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const [unauthorized, setUnauthorized] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [notice, setNotice] = useState<string | null>(null);
+
+  const load = useCallback(async () => {
+    try {
+      const result = await fetch("/api/cms/kanji-foundation", { cache: "no-store" });
+      const json = await result.json() as Envelope;
+      if (result.status === 401 || result.status === 403) {
+        setUnauthorized(true);
+        setResponse(null);
+        setError(null);
+        return;
+      }
+      if (!result.ok || !json.success || !json.data) throw new Error(json.error?.message ?? "Editorial preview could not be loaded.");
+      setUnauthorized(false);
+      setResponse(json.data);
+      setError(null);
+    } catch (cause) {
+      setResponse(null);
+      setError(cause instanceof Error ? cause.message : "Editorial preview could not be loaded.");
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => { void load(); }, [load]);
+
+  const mutate = useCallback(async (path: string, method: "POST" | "GET" = "POST", body?: unknown) => {
+    setBusy(true);
+    setNotice(null);
+    try {
+      const result = await fetch(path, {
+        method,
+        cache: "no-store",
+        headers: body === undefined ? undefined : { "Content-Type": "application/json" },
+        body: body === undefined ? undefined : JSON.stringify(body),
+      });
+      const json = await result.json() as { success?: boolean; data?: unknown; error?: { message?: string } };
+      if (!result.ok || !json.success) throw new Error(json.error?.message ?? "Editorial action was not accepted.");
+      setNotice("Saved to the authenticated CMS workflow. A new immutable version and audit event are recorded.");
+      await load();
+      return json.data;
+    } catch (cause) {
+      setNotice(cause instanceof Error ? cause.message : "Editorial action was not accepted.");
+      return null;
+    } finally {
+      setBusy(false);
+    }
+  }, [load]);
+
+  return { response, loading, error, unauthorized, busy, notice, setNotice, load, mutate };
+}
+
+export function KanjiFoundationStudio() {
+  const { response, loading, error, unauthorized, busy, notice, setNotice, load, mutate } = useFoundationStudio();
+  const [selectedIdentity, setSelectedIdentity] = useState("");
+  const [newCharacter, setNewCharacter] = useState("");
+  const [fieldKey, setFieldKey] = useState<string>("meaning");
+  const [fieldText, setFieldText] = useState("");
+  const [sourceAssertionsText, setSourceAssertionsText] = useState("");
+  const [creationMethod, setCreationMethod] = useState("human_draft");
+  const [provenanceEvidence, setProvenanceEvidence] = useState("");
+  const [provenanceHash, setProvenanceHash] = useState("");
+  const [rightsScope, setRightsScope] = useState<string>("public_distribution");
+  const [rightsState, setRightsState] = useState<string>("UNKNOWN");
+  const [rightsSourceRef, setRightsSourceRef] = useState("");
+  const [rightsEvidenceClass, setRightsEvidenceClass] = useState<string>("owner_authorization");
+  const [rightsEvidence, setRightsEvidence] = useState("");
+  const [rightsHash, setRightsHash] = useState("");
+  const [qualifiedReviewRef, setQualifiedReviewRef] = useState("");
+  const [qualifiedReviewHash, setQualifiedReviewHash] = useState("");
+  const [rightsRationale, setRightsRationale] = useState("");
+  const [membershipJson, setMembershipJson] = useState("");
+  const [membershipEvidence, setMembershipEvidence] = useState("");
+  const [membershipHash, setMembershipHash] = useState("");
+  const [requestReason, setRequestReason] = useState("Please revise this field; see the review discussion.");
+
+  const { identities, fields } = useMemo(() => latestRecords(response?.records ?? []), [response?.records]);
+  useEffect(() => {
+    if (!selectedIdentity && response?.cohort.records.length) setSelectedIdentity(response.cohort.records[0].identityId);
+  }, [response, selectedIdentity]);
+
+  const identityRecords = [...identities.values()];
+  const cohortIdentityIds = new Set(response?.cohort.records.map((seed) => seed.identityId) ?? []);
+  const identitySeeds = [
+    ...(response?.cohort.records.map((seed) => ({ ...seed, isCohort: true })) ?? []),
+    ...identityRecords.flatMap((record) => {
+      const payload = identityPayload(record);
+      if (!payload || cohortIdentityIds.has(payload.identity.identityId)) return [];
+      return [{ identityId: payload.identity.identityId, character: payload.identity.character, codePoint: payload.identity.codePoint, isCohort: false }];
+    }),
+  ];
+  const identityRecord = identities.get(selectedIdentity);
+  const identity = identityPayload(identityRecord);
+
+  const createNewIdentity = async (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    if ([...newCharacter].length !== 1) { setNotice("Enter exactly one Han character; variant and membership decisions remain separate."); return; }
+    const result = await mutate("/api/cms/kanji-foundation", "POST", { character: newCharacter });
+    if (result) setNewCharacter("");
+  };
+
+  const createField = async (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    if (!selectedIdentity || !fieldText.trim()) return;
+    let value: unknown = fieldText.trim();
+    if (fieldKey === "vocabulary" || fieldKey === "decomposition") {
+      try { value = JSON.parse(fieldText); }
+      catch { setNotice("This field requires valid JSON."); return; }
+    }
+    let sourceAssertions: unknown[] | undefined;
+    if (sourceAssertionsText.trim()) {
+      try {
+        const parsed: unknown = JSON.parse(sourceAssertionsText);
+        if (!Array.isArray(parsed)) throw new Error("Source assertions must be a JSON array.");
+        sourceAssertions = parsed;
+      } catch (cause) {
+        setNotice(cause instanceof Error ? cause.message : "Source assertions must be valid JSON.");
+        return;
+      }
+    }
+    const result = await mutate("/api/cms/kanji-foundation/fields", "POST", {
+      identityId: selectedIdentity,
+      fieldKey,
+      value,
+      creationMethod,
+      ...(sourceAssertions ? { sourceAssertions } : {}),
+    });
+    if (result) { setFieldText(""); setSourceAssertionsText(""); }
+  };
+
+  if (loading) return <div className="min-h-screen bg-[#f7f5f0] px-5 py-16"><div className="mx-auto max-w-5xl animate-pulse rounded-3xl bg-white p-12 text-slate-500">Loading authorized editorial preview…</div></div>;
+
+  return (
+    <main className="min-h-screen bg-[#f7f5f0] px-5 py-8 text-slate-900 sm:px-8 sm:py-12">
+      <div className="mx-auto max-w-7xl">
+        <Link href="/kanji-foundation" className="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-rose-800"><ArrowLeft className="h-4 w-4" />Learner library</Link>
+        <header className="mt-7 overflow-hidden rounded-[2rem] bg-slate-950 p-7 text-white sm:p-10">
+          <div className="flex flex-wrap items-start justify-between gap-6">
+            <div className="max-w-3xl">
+              <p className="text-xs font-semibold uppercase tracking-[0.24em] text-rose-200">Authorized editorial preview · K0.9</p>
+              <h1 className="mt-4 font-serif text-4xl leading-tight sm:text-5xl">First-party Kanji studio</h1>
+              <p className="mt-4 text-sm leading-6 text-slate-300">Identity, provenance, rights, editorial review, membership and delivery remain separate. Learner APIs never read this workspace.</p>
+            </div>
+            <button onClick={() => void load()} className="inline-flex items-center gap-2 rounded-full border border-white/20 px-4 py-2 text-sm font-semibold text-white hover:bg-white/10"><RefreshCw className="h-4 w-4" />Refresh preview</button>
+          </div>
+        </header>
+
+        {unauthorized ? (
+          <div className="mt-7 rounded-3xl border border-amber-300 bg-amber-50 p-8"><h2 className="font-serif text-2xl">Editorial access required</h2><p className="mt-3 max-w-2xl text-sm leading-6 text-amber-950">Sign in with a NihongoBridge account holding CMS read permission. Draft shells, review notes and rights evidence are not available to learners.</p></div>
+        ) : error ? (
+          <div role="alert" className="mt-7 rounded-3xl border border-rose-300 bg-rose-50 p-8 text-rose-950">{error}</div>
+        ) : response ? (
+          <>
+            {notice && <div role="status" className="mt-6 rounded-2xl border border-slate-300 bg-white px-5 py-4 text-sm text-slate-800">{notice}</div>}
