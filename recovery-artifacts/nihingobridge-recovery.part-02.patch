+import "server-only";
+
+import { randomUUID } from "node:crypto";
+import cohortData from "@/data/kanji-foundation/provisional-draft-shells.json";
+import { requirePermission, requireRole } from "@/lib/auth";
+import { CmsError, getCmsService, type CmsService } from "@/services/cms";
+import type { CmsItemRecord, CmsStatus } from "@/services/cms/types";
+import {
+  KANJI_FOUNDATION_SOURCE_REF,
+  appendFoundationIdentityRightsDecision,
+  appendFoundationMembershipDecision,
+  appendFoundationRightsDecision,
+  buildKanjiFoundationPublicProjection,
+  createFoundationFieldPayload,
+  createIdentityDraftPayload,
