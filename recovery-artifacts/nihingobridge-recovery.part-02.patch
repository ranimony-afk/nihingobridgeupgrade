+    return <div className="mt-4 grid gap-3">{field.value.map((row, index) => {
+      if (!row || typeof row !== "object") return null;
+      const decomposition = row as { character?: unknown; occurrences?: unknown; relations?: unknown };
+      const occurrences = Array.isArray(decomposition.occurrences) ? decomposition.occurrences : [];
+      const relations = Array.isArray(decomposition.relations) ? decomposition.relations : [];
+      return <div key={`${String(decomposition.character)}-${index}`} className="rounded-2xl bg-white p-4 ring-1 ring-slate-200"><p className="font-serif text-2xl">{String(decomposition.character ?? "")}</p><div className="mt-3 flex flex-wrap gap-2">{occurrences.map((occurrence, occurrenceIndex) => {
