+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { GET as listGet } from "@/app/api/kanji-foundation/route";
+import { GET as detailGet } from "@/app/api/kanji-foundation/[identityId]/route";
+import { GET as versionGet } from "@/app/api/kanji-foundation/version/route";
+import { K0_5A_INITIAL_RIGHTS_HISTORY } from "@/services/knowledge/provenance/rightsPolicy";
+import { readKanjiFoundationSnapshot } from "@/services/knowledge/editorial/kanjiFoundationRepository";
+import type { FoundationCmsSnapshot } from "@/services/knowledge/editorial/kanjiFoundation";
+
+vi.mock("@/services/knowledge/editorial/kanjiFoundationRepository", () => ({
+  readKanjiFoundationSnapshot: vi.fn(),
+}));
+
+const emptySnapshot: FoundationCmsSnapshot = {
+  schemaVersion: "nihongobridge-kanji-foundation-export@1",
+  items: [],
+  rightsHistory: [...K0_5A_INITIAL_RIGHTS_HISTORY],
+};
+const readSnapshotMock = vi.mocked(readKanjiFoundationSnapshot);
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  readSnapshotMock.mockResolvedValue(emptySnapshot);
+});
+
+describe("K0.9 learner read routes", () => {
+  it("serves only the eligible projection with no-store headers and a policy digest", async () => {
+    const response = await listGet(new Request("https://nihongo.test/api/kanji-foundation?q=%E7%94%B2"));
+    const body = await response.json() as { success: boolean; data: { kanji: unknown[]; contentDigest: string } };
+    expect(response.status).toBe(200);
+    expect(response.headers.get("cache-control")).toContain("no-store");
+    expect(response.headers.get("x-kanji-foundation-version")).toBe(body.data.contentDigest);
+    expect(body.data.kanji).toEqual([]);
+  });
+
+  it("bounds search input and keeps validation responses uncached", async () => {
+    const response = await listGet(new Request(`https://nihongo.test/api/kanji-foundation?q=${"x".repeat(81)}`));
+    expect(response.status).toBe(400);
+    expect(response.headers.get("cache-control")).toContain("no-store");
+  });
+
+  it("does not resolve unpublished identities through the detail endpoint", async () => {
+    const response = await detailGet(new Request("https://nihongo.test/api/kanji-foundation/kanji-u7532"), {
+      params: Promise.resolve({ identityId: "kanji-u7532" }),
+    });
+    expect(response.status).toBe(404);
+    expect(response.headers.get("cache-control")).toContain("no-store");
+    expect(await response.json()).toMatchObject({ success: false, error: { code: "NOT_FOUND" } });
+  });
+
+  it("exposes only the active projection digest for client cache-coherence checks", async () => {
+    const response = await versionGet();
+    const body = await response.json() as { success: boolean; data: { contentDigest: string } };
+    expect(response.status).toBe(200);
+    expect(response.headers.get("cache-control")).toContain("no-store");
+    expect(response.headers.get("x-kanji-foundation-version")).toBe(body.data.contentDigest);
+    expect(Object.keys(body.data)).toEqual(["contentDigest"]);
+  });
+});
diff --git a/tests/kanji-foundation.test.ts b/tests/kanji-foundation.test.ts
