+#!/usr/bin/env python3
+"""Read-only aggregate simulation for the pinned K0.3 KANJIDIC2 source.
+
+This tool verifies the exact source bytes and prints aggregate candidate-set,
+overlap, and scenario counts as JSON. It deliberately never emits character
+rows or a membership manifest; unresolved KANJIDIC2 rights remain a blocker for
+redistributing source-derived candidate data.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import itertools
+import json
+import sys
+from pathlib import Path
+from typing import Any
+from xml.etree import ElementTree as ET
+
+SOURCE_ID = "upstream:kanjidic2:2023-08"
+EXPECTED_XML_SHA256 = "260e6119fcc78cde438de7d7f8227d1c13260469d10ae36a01d866c61f7cc781"
+EXPECTED_XML_BYTES = 15_643_593
+EXPECTED_RECORDS = 13_108
+EXPECTED_RELEASE = "2023-08-20"
+EXPECTED_DATABASE_VERSION = "2023-232"
+EXPECTED_FILE_VERSION = "4"
+TARGET_COUNT = 2_501
+SIGNAL_KEYS = ("literacy_grade_proxy", "frequency_rank", "legacy_jlpt", "name_grade_proxy")
+
+
+def calculate_summary(records: dict[str, dict[str, Any]], target_count: int = TARGET_COUNT) -> dict[str, Any]:
+    """Calculate aggregate-only scenarios from exact-character source fields."""
+    if target_count < 1:
+        raise ValueError("target_count must be positive")
+    if len(records) != len(set(records)):
+        raise ValueError("duplicate character identity")
+
+    literacy = {
+        char for char, row in records.items()
+        if row.get("grade") in {1, 2, 3, 4, 5, 6, 8}
+    }
+    name_grade = {
+        char for char, row in records.items()
+        if row.get("grade") in {9, 10}
+    }
+    frequency = {
+        char for char, row in records.items()
+        if row.get("freq") is not None
+    }
+    legacy_jlpt = {
+        char for char, row in records.items()
+        if row.get("jlpt") is not None
+    }
+    nanori = {
+        char for char, row in records.items()
+        if row.get("nanori")
+    }
+    sets = (literacy, frequency, legacy_jlpt, name_grade)
+    ranks = [records[char]["freq"] for char in frequency]
+    if len(ranks) != len(set(ranks)):
+        raise ValueError("frequency rank values are not unique")
+
+    def coverage(candidate_set: set[str]) -> dict[str, int]:
+        return {
+            key: len(candidate_set & evidence_set)
+            for key, evidence_set in zip(SIGNAL_KEYS, sets)
+        }
+
+    def scenario(name: str, candidate_set: set[str], interpretation: str) -> dict[str, Any]:
+        return {
+            "name": name,
+            "candidate_count": len(candidate_set),
+            "difference_from_target": len(candidate_set) - target_count,
+            "proxy_coverage_counts": coverage(candidate_set),
+            "interpretation": interpretation,
+        }
+
+    rank_bands = []
+    for start, end in ((1, 500), (501, 1000), (1001, 1500), (1501, 2000), (2001, 2501)):
+        band = {
+            char for char in frequency
+            if start <= records[char]["freq"] <= end
+        }
+        rank_bands.append({
+            "rank_start": start,
+            "rank_end": end,
+            "all_frequency": len(band),
+            "literacy_grade_proxy": len(band & literacy),
+            "frequency_outside_literacy_proxy": len(band - literacy),
+        })
+
+    extension_slots = max(0, target_count - len(literacy))
+    outsiders = sorted(frequency - literacy, key=lambda char: records[char]["freq"])
+    selected_outsiders = set(outsiders[:extension_slots])
+    sensitivity_set = literacy | selected_outsiders
+    cutoff_rank = records[outsiders[extension_slots - 1]]["freq"] if extension_slots and len(outsiders) >= extension_slots else None
+    sensitivity_status = (
+        "SIMULATED_ONLY_NOT_APPROVED"
+        if len(literacy) <= target_count and len(outsiders) >= extension_slots
+        else "BLOCKED_INSUFFICIENT_OR_OVERSIZED_SOURCE_PROXY_SET"
+    )
+
+    pattern_counts: dict[str, int] = {}
+    for char in records:
+        pattern = "".join("1" if char in evidence else "0" for evidence in sets)
+        pattern_counts[pattern] = pattern_counts.get(pattern, 0) + 1
+    cohort_patterns = [
+        {"signals_literacy_frequency_legacy_jlpt_name": pattern, "count": pattern_counts.get(pattern, 0)}
+        for pattern in ("".join(bits) for bits in itertools.product("01", repeat=4))
+        if pattern_counts.get(pattern, 0)
+    ]
+
+    source_union = set().union(*sets)
+    reference_proxy = literacy | name_grade
+    scenarios = [
+        scenario(
+            "literacy_first_proxy",
+            literacy,
+            "KANJIDIC2 grades 1-6/8 only; not an independently verified official Joyo set.",
+        ),
+        scenario(
+            "frequency_first_proxy",
+            frequency,
+            "All records carrying this pinned source's newspaper-based <freq> rank; not a universal reading corpus.",
+        ),
+        scenario(
+            "learner_first_legacy_jlpt_proxy",
+            legacy_jlpt,
+            "All old KANJIDIC2 JLPT 1-4 tags; not current N1-N5 lists or an official modern Kanji curriculum.",
+        ),
+        scenario(
+            "comprehensive_reference_name_grade_proxy",
+            reference_proxy,
+            "Literacy-grade proxy union grade-9/10 name-related proxy; specialist and comprehensive-source coverage is absent.",
+        ),
+        scenario(
+            "balanced_hybrid_evidence_union_proxy",
+            source_union,
+            "Union of four KANJIDIC2-coded signals; indicators share one source and are not independent validation.",
+        ),
+    ]
+
+    jlpt_levels = {
+        str(level): sum(1 for row in records.values() if row.get("jlpt") == level)
+        for level in (1, 2, 3, 4)
+    }
+    return {
+        "target_count": target_count,
+        "source_record_count": len(records),
+        "dimension_proxy_counts": {
+            "literacy_grade_1_6_or_8": len(literacy),
+            "frequency_rank_present": len(frequency),
+            "legacy_jlpt_present": len(legacy_jlpt),
+            "name_grade_9_or_10": len(name_grade),
+            "any_grade": sum(1 for row in records.values() if row.get("grade") is not None),
+            "nanori_present": len(nanori),
+        },
+        "intersections": {
+            "literacy_and_frequency": len(literacy & frequency),
+            "literacy_and_legacy_jlpt": len(literacy & legacy_jlpt),
+            "literacy_and_name_grade": len(literacy & name_grade),
+            "frequency_and_legacy_jlpt": len(frequency & legacy_jlpt),
+            "frequency_and_name_grade": len(frequency & name_grade),
+            "legacy_jlpt_and_name_grade": len(legacy_jlpt & name_grade),
+        },
+        "union_counts": {
+            "literacy_or_frequency": len(literacy | frequency),
+            "literacy_or_name_grade": len(reference_proxy),
+            "all_four_signals": len(source_union),
+            "source_records_with_none_of_the_four_signals": len(records) - len(source_union),
+            "legacy_jlpt_adds_no_members_beyond_literacy_or_name_grade": len(legacy_jlpt - (literacy | name_grade)) == 0,
+        },
+        "missing_rank_counts": {
+            "literacy_proxy_without_frequency": len(literacy - frequency),
+            "name_grade_proxy_without_frequency": len(name_grade - frequency),
+        },
+        "legacy_jlpt_level_counts": jlpt_levels,
+        "frequency_rank_bands": rank_bands,
+        "scenarios": scenarios,
+        "literacy_core_plus_top_ranked_frequency_outsiders_sensitivity": {
+            "status": sensitivity_status,
+            "extension_slots_derived_from_target_minus_literacy_proxy": extension_slots,
+            "candidate_count": len(sensitivity_set),
+            "cutoff_frequency_rank": cutoff_rank,
+            "ranked_members": len(sensitivity_set & frequency),
+            "legacy_jlpt_members": len(sensitivity_set & legacy_jlpt),
+            "name_grade_proxy_members_in_extension": len(selected_outsiders & name_grade),
+            "nanori_members_in_extension": len(selected_outsiders & nanori),
+            "legacy_jlpt_members_in_extension": len(selected_outsiders & legacy_jlpt),
+            "no_grade_members_in_extension": sum(1 for char in selected_outsiders if records[char].get("grade") is None),
+            "interpretation": "Deterministic frequency-priority sensitivity only; not a chosen precedence, approved membership, or final manifest.",
+        },
+        "signal_cohort_counts_only": cohort_patterns,
+        "source_validation": {
+            "frequency_rank_values_unique": True,
+            "frequency_rank_count": len(ranks),
+            "frequency_rank_min": min(ranks) if ranks else None,+            "frequency_rank_max": max(ranks) if ranks else None,
+        },
+    }
+
+
+def parse_pinned_source(xml_path: Path) -> tuple[dict[str, dict[str, Any]], dict[str, Any]]:
+    """Verify pinned bytes/headers/identities and parse only needed raw fields."""
+    raw = xml_path.read_bytes()
+    digest = hashlib.sha256(raw).hexdigest()
+    if len(raw) != EXPECTED_XML_BYTES or digest != EXPECTED_XML_SHA256:
+        raise ValueError(
+            f"KANJIDIC2 XML pin mismatch: got {len(raw)} bytes / {digest}; "
+            f"expected {EXPECTED_XML_BYTES} bytes / {EXPECTED_XML_SHA256}"
+        )
+
+    root = ET.fromstring(raw)
+    if root.tag != "kanjidic2":
+        raise ValueError(f"unexpected XML root: {root.tag}")
+    header = root.find("header")
+    if header is None:
+        raise ValueError("missing KANJIDIC2 header")
+    metadata = {
+        "date_of_creation": header.findtext("date_of_creation"),
+        "database_version": header.findtext("database_version"),
+        "file_version": header.findtext("file_version"),
+    }
+    expected = {
+        "date_of_creation": EXPECTED_RELEASE,
+        "database_version": EXPECTED_DATABASE_VERSION,
+        "file_version": EXPECTED_FILE_VERSION,
+    }
+    if metadata != expected:
+        raise ValueError(f"KANJIDIC2 header mismatch: {metadata!r}")
+
+    records: dict[str, dict[str, Any]] = {}
+    for character in root.findall("character"):
+        literal = character.findtext("literal")
+        ucs_values = [
+            item.text for item in character.findall("./codepoint/cp_value")
+            if item.attrib.get("cp_type") == "ucs"
+        ]
+        if literal is None or len(literal) != 1 or len(ucs_values) != 1 or not ucs_values[0]:
+            raise ValueError("record missing a one-scalar literal or one UCS code point")
+        try:
+            codepoint = int(ucs_values[0], 16)
+        except ValueError as error:
+            raise ValueError("invalid UCS code point") from error
+        if ord(literal) != codepoint:
+            raise ValueError("literal and UCS code point do not match")
+        if literal in records:
+            raise ValueError("duplicate literal identity")
+
+        misc = character.find("misc")
+        grades = misc.findall("grade") if misc is not None else []
+        freqs = misc.findall("freq") if misc is not None else []
+        jlpts = misc.findall("jlpt") if misc is not None else []
+        if len(grades) > 1 or len(freqs) > 1 or len(jlpts) > 1:
+            raise ValueError("unexpected repeated grade/frequency/JLPT source field")
+        try:
+            grade = int(grades[0].text) if grades and grades[0].text else None
+            freq = int(freqs[0].text) if freqs and freqs[0].text else None
+            jlpt = int(jlpts[0].text) if jlpts and jlpts[0].text else None
+        except ValueError as error:
+            raise ValueError("non-integer grade/frequency/JLPT source field") from error
+        if grade is not None and grade not in range(1, 11):
+            raise ValueError("grade outside documented 1-10 source domain")
+        if jlpt is not None and jlpt not in range(1, 5):
+            raise ValueError("legacy JLPT value outside documented 1-4 source domain")
+        if freq is not None and freq < 1:
+            raise ValueError("frequency rank must be positive")
+
+        records[literal] = {
+            "codepoint": codepoint,
+            "grade": grade,
+            "freq": freq,
+            "jlpt": jlpt,
+            "nanori": bool(character.findall("./reading_meaning/nanori")),
+        }
+
+    if len(records) != EXPECTED_RECORDS:
+        raise ValueError(f"record count mismatch: got {len(records)}, expected {EXPECTED_RECORDS}")
+    frequency_ranks = [row["freq"] for row in records.values() if row["freq"] is not None]
+    if sorted(frequency_ranks) != list(range(1, TARGET_COUNT + 1)):
+        raise ValueError("frequency ranks are not exactly the unique contiguous range 1-2501")
+
+    source_lock = {
+        "source_id": SOURCE_ID,
+        "release": EXPECTED_RELEASE,
+        "database_version": EXPECTED_DATABASE_VERSION,
+        "file_version": EXPECTED_FILE_VERSION,
+        "xml_bytes": len(raw),
+        "xml_sha256": digest,
+        "record_count": len(records),
+        "rights_clearance": "BLOCKED_PRIMARY_EDRDG_TERMS_NOT_RECONFIRMED_FOR_PINNED_RELEASE",
+        "candidate_rows_emitted": False,
+    }
+    return records, source_lock
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--xml", required=True, type=Path, help="path to exact pinned KANJIDIC2 2023-08 XML")
+    args = parser.parse_args()
+    try:
+        records, source_lock = parse_pinned_source(args.xml)
+        summary = calculate_summary(records)
+    except (OSError, ET.ParseError, ValueError) as error:
+        print(f"K0.3 candidate analysis blocked: {error}", file=sys.stderr)
+        return 2
+    output = {"source_lock": source_lock, "analysis": summary}
+    json.dump(output, sys.stdout, ensure_ascii=False, indent=2, sort_keys=True)
+    sys.stdout.write("\n")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
