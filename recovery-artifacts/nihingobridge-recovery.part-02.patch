new file mode 100644
index 0000000..966d1ca
--- /dev/null
+++ b/src/app/api/cms/kanji-foundation/fields/route.ts
@@ -0,0 +1,38 @@
+import { NextResponse } from "next/server";
+import { CmsError } from "@/services/cms";
+import { cmsErrorResponse, parseJsonBody } from "@/app/api/cms/_shared";
+import { kanjiFoundationWorkflow } from "@/services/knowledge/editorial/kanjiFoundationWorkflow";
+import type { FoundationCreationMethod } from "@/services/knowledge/editorial/kanjiFoundation";
+import type { SourceAssertion } from "@/services/knowledge/editorial/fieldProvenance";
+
+export const dynamic = "force-dynamic";
+export const revalidate = 0;
+
+export async function POST(request: Request): Promise<NextResponse> {
+  try {
+    const body = await parseJsonBody(request);
+    if (typeof body.identityId !== "string" || typeof body.fieldKey !== "string" || !Object.prototype.hasOwnProperty.call(body, "value")) {
+      throw CmsError.validation("identityId, fieldKey and value are required.");
+    }
+    const method = body.creationMethod ?? "human_draft";
+    if (!["human_draft", "ai_assisted_draft", "source_derived"].includes(String(method))) {
+      throw CmsError.validation("Unsupported field creation method.");
+    }
+    const sourceAssertions = body.sourceAssertions;
+    if (sourceAssertions !== undefined && (!Array.isArray(sourceAssertions) || sourceAssertions.some((row) => !row || typeof row !== "object" || Array.isArray(row)))) {
+      throw CmsError.validation("sourceAssertions must be an array of pinned source assertion records.");
+    }
+    const item = await kanjiFoundationWorkflow.createField({
+      identityId: body.identityId,
+      fieldKey: body.fieldKey,
+      value: body.value,
+      creationMethod: method as FoundationCreationMethod,
+      sourceAssertions: sourceAssertions as SourceAssertion[] | undefined,
+    });
+    return NextResponse.json({ success: true, data: item }, { status: 201, headers: { "Cache-Control": "private, no-store, max-age=0" } });
+  } catch (error) {
+    const response = cmsErrorResponse(error);
+    response.headers.set("Cache-Control", "private, no-store, max-age=0");
+    return response;
+  }
+}
