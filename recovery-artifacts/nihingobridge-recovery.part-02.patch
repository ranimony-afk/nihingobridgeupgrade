@@ -0,0 +1,122 @@
+import { createHash } from "node:crypto";
+import { KANJI, KANJI_SOURCE_REF } from "@/data/kanji";
+import kanjivgSliceJson from "@/data/kanji-mindtree/kanjivg-structure-slice.json";
+import {
+  K0_5A_INITIAL_RIGHTS_HISTORY,
+  RIGHTS_POLICY_VERSION,
+} from "@/services/knowledge/provenance/rightsPolicy";
+import {
+  KANJI_MEMBERSHIP_BASELINE,
+  KANJI_MEMBERSHIP_SCHEMA,
+} from "@/services/knowledge/editorial/kanjiMembership";
+import { MINDTREE_MNEMONIC_RECORDS } from "@/lib/kanji/mindtreeMnemonicContent";
+import {
+  KANJIDIC2_MINDTREE_SLICE_SHA256,
+  KANJIDIC2_MINDTREE_SOURCE_REF,
+} from "@/lib/kanji/kanjidic2MindtreeFacts";
+import {
+  KANJIVG_ARCHIVE_SHA256,
+  KANJIVG_SOURCE_VERSION,
+  KANJIVG_TRANSFORMATION_VERSION,
