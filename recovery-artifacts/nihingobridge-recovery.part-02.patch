+        return <span key={`${String(component.renderedAs)}-${occurrenceIndex}`} className="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-700">{String(component.renderedAs ?? "")}{component.position ? ` · ${String(component.position)}` : ""}</span>;
+      })}</div>{relations.length > 0 && <ul className="mt-4 grid gap-2 border-t border-slate-100 pt-3">{relations.map((relation, relationIndex) => {
+        if (!relation || typeof relation !== "object") return null;
+        const edge = relation as { from?: unknown; relation?: unknown; componentRole?: unknown; to?: unknown; claim?: unknown };
+        const role = typeof edge.componentRole === "string" ? edge.componentRole.replaceAll("_", " ") : null;
+        const label = role ? `${String(edge.relation ?? "relation").replaceAll("_", " ")} · ${role}` : String(edge.relation ?? "relation").replaceAll("_", " ");
