diff --git a/src/components/layout/PolicyVersionGuard.tsx b/src/components/layout/PolicyVersionGuard.tsx
new file mode 100644
index 0000000..d2fa2b5
--- /dev/null
+++ b/src/components/layout/PolicyVersionGuard.tsx
@@ -0,0 +1,83 @@
+"use client";
+
+import { useEffect, useState } from "react";
+
+const RELOAD_MARKER_PREFIX = "nihongobridge:policy-version-reload:";
+
+/**
+ * Watches the opaque server policy fingerprint for long-lived App Router tabs.
+ * On a change, it covers the old DOM and reloads so React-held learner data and
+ * prefetched route state from an earlier policy cannot remain visible.
+ */
+export function PolicyVersionGuard({ initialVersion }: { initialVersion: string | null }) {
+  const [unavailable, setUnavailable] = useState(false);
+
+  useEffect(() => {
+    let active = true;
+    let inFlight = false;
+
+    const check = async () => {
+      if (!active || inFlight || document.visibilityState === "hidden") return;
+      inFlight = true;
+      try {
+        const response = await fetch("/api/kanji/policy-version", { cache: "no-store" });
+        if (!active) return;
+        if (!response.ok) {
+          setUnavailable(true);
+          return;
+        }
+        const body: unknown = await response.json();
+        const version = body && typeof body === "object" && "version" in body &&
+          typeof body.version === "string" ? body.version : null;
+        if (!version || !initialVersion) {
+          setUnavailable(true);
+          return;
+        }
+        if (version !== initialVersion) {
+          setUnavailable(true);
+          const marker = `${RELOAD_MARKER_PREFIX}${version}`;
+          if (sessionStorage.getItem(marker) !== "1") {
+            sessionStorage.setItem(marker, "1");
+            window.location.reload();
+          }
+          return;
+        }
+        for (let index = sessionStorage.length - 1; index >= 0; index -= 1) {
+          const key = sessionStorage.key(index);
+          if (key?.startsWith(RELOAD_MARKER_PREFIX)) sessionStorage.removeItem(key);
+        }
+        setUnavailable(false);
+      } catch {
+        if (active) setUnavailable(true);
+      } finally {
+        inFlight = false;
+      }
+    };
+
+    const onVisible = () => {
+      if (document.visibilityState === "visible") void check();
+    };
+    const interval = window.setInterval(() => void check(), 5_000);
+    document.addEventListener("visibilitychange", onVisible);
+    window.addEventListener("focus", onVisible);
+    void check();
+
+    return () => {
+      active = false;
+      window.clearInterval(interval);
+      document.removeEventListener("visibilitychange", onVisible);
+      window.removeEventListener("focus", onVisible);
+    };
+  }, [initialVersion]);
+
+  if (!unavailable) return null;
+  return (
+    <div
+      className="fixed inset-0 z-[10000] flex items-center justify-center bg-white px-6 text-center text-slate-700"
+      role="alert"
+      aria-live="assertive"
+    >
+      <p>This content is temporarily unavailable. Refresh the page to continue.</p>
+    </div>
+  );
+}
