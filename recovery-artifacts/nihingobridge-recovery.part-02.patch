new file mode 100644
index 0000000..18a0bb4
--- /dev/null
+++ b/src/components/kanji/SyntheticStrokeAssetPlayer.tsx
@@ -0,0 +1,65 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { validateStrokeAsset, type StrokeAsset } from "@/lib/kanji/strokeAssetContract";
+
+export function SyntheticStrokeAssetPlayer({ asset: rawAsset }: { asset: StrokeAsset }) {
+  const validation = validateStrokeAsset(rawAsset);
+  const asset = validation.asset;
+  const [visibleCount, setVisibleCount] = useState(0);
+  const [playing, setPlaying] = useState(false);
+  const [reducedMotion, setReducedMotion] = useState(false);
+
+  useEffect(() => {
+    const query = window.matchMedia("(prefers-reduced-motion: reduce)");
+    const update = () => setReducedMotion(query.matches);
+    update();
+    query.addEventListener?.("change", update);
+    return () => query.removeEventListener?.("change", update);
+  }, []);
+
+  useEffect(() => {
+    if (!playing || !asset) return;
+    const timer = window.setTimeout(() => {
+      const nextCount = Math.min(asset.strokes.length, visibleCount + 1);
+      setVisibleCount(nextCount);
+      if (nextCount >= asset.strokes.length) setPlaying(false);
+    }, 700);
+    return () => window.clearTimeout(timer);
+  }, [asset, playing, visibleCount]);
+
+  if (!asset) return <p role="alert" className="text-sm text-rose-800">Stroke asset rejected: {validation.issues.join("; ")}</p>;
+  const count = Math.min(visibleCount, asset.strokes.length);
+  const stepNext = () => setVisibleCount((current) => Math.min(asset.strokes.length, current + 1));
+  const stepPrevious = () => setVisibleCount((current) => Math.max(0, current - 1));
+  const togglePlayback = () => {
+    if (playing) setPlaying(false);
+    else if (reducedMotion) setVisibleCount(asset.strokes.length);
+    else setPlaying(true);
+  };
+
+  return (
+    <section aria-labelledby="synthetic-stroke-player-title" className="rounded-2xl border border-slate-200 bg-white p-5">
+      <h2 id="synthetic-stroke-player-title" className="font-bold text-slate-900">Accessible stroke playback · synthetic demo</h2>
+      <p className="mt-2 text-sm text-amber-900">This is synthetic practice geometry, not a Kanji drawing or linguistic fact. No third-party stroke asset is loaded.</p>
+      <figure className="mt-4 flex flex-col items-center gap-3">
+        <svg viewBox="0 0 100 100" role="img" aria-label={`${asset.label}; ${count} of ${asset.strokes.length} strokes shown`} className="h-40 w-40 rounded-xl border border-slate-200 bg-slate-50 p-2">
+          {asset.strokes.slice(0, count).map((stroke) => (
+            <path key={stroke.id} d={stroke.pathData} fill="none" stroke="#172554" strokeWidth="5" strokeLinecap="round" strokeLinejoin="round" />
+          ))}
+        </svg>
+        <figcaption className="text-center text-sm text-slate-700">{asset.label}. {count} of {asset.strokes.length} synthetic strokes shown.</figcaption>
+      </figure>
+      <p role="status" aria-live="polite" className="mt-3 min-h-6 text-sm font-medium text-slate-800">
+        {count === 0 ? "Ready. No strokes shown." : count === asset.strokes.length ? `Complete: all ${asset.strokes.length} strokes shown.` : `Stroke ${count} of ${asset.strokes.length} shown: ${asset.strokes[count - 1]?.description}`}
+      </p>
+      <div className="mt-3 flex flex-wrap gap-2">
+        <button type="button" onClick={stepPrevious} disabled={count === 0 || playing} className="min-h-10 rounded-lg border px-3 text-sm disabled:opacity-50">Previous stroke</button>
+        <button type="button" onClick={stepNext} disabled={count === asset.strokes.length || playing} className="min-h-10 rounded-lg border px-3 text-sm disabled:opacity-50">Next stroke</button>
+        <button type="button" onClick={() => { setVisibleCount(0); setPlaying(false); }} className="min-h-10 rounded-lg border px-3 text-sm">Reset</button>
+        <button type="button" aria-pressed={playing} onClick={togglePlayback} disabled={count === asset.strokes.length} className="min-h-10 rounded-lg border px-3 text-sm disabled:opacity-50">{playing ? "Pause playback" : "Play strokes"}</button>
+      </div>
+      {reducedMotion && <p className="mt-2 text-xs text-slate-600">Reduced-motion preference detected; Play displays the complete shape without timed playback.</p>}
+    </section>
+  );
+}
