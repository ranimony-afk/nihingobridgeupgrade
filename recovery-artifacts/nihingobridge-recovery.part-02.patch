+import { NextResponse } from "next/server";
+import { CmsError } from "@/services/cms";
+import { cmsErrorResponse, parseJsonBody } from "@/app/api/cms/_shared";
+import { kanjiFoundationWorkflow } from "@/services/knowledge/editorial/kanjiFoundationWorkflow";
+
+export const dynamic = "force-dynamic";
+export const revalidate = 0;
+
+function noStore(data: unknown, status = 200): NextResponse {
+  return NextResponse.json({ success: true, data }, { status, headers: { "Cache-Control": "private, no-store, max-age=0" } });
+}
+
+export async function GET(): Promise<NextResponse> {
+  try {
+    return noStore(await kanjiFoundationWorkflow.listInternal());
+  } catch (error) {
+    const response = cmsErrorResponse(error);
+    response.headers.set("Cache-Control", "private, no-store, max-age=0");
+    return response;
+  }
+}
+
+export async function POST(request: Request): Promise<NextResponse> {
+  try {
+    const body = await parseJsonBody(request);
+    let item;
+    if (typeof body.identityId === "string") item = await kanjiFoundationWorkflow.createCohortShell(body.identityId);
+    else if (typeof body.character === "string") item = await kanjiFoundationWorkflow.createNewIdentityShell(body.character);
+    else throw CmsError.validation("Provide an identityId from the provisional cohort or one exact Han character.");
+    return noStore(item, 201);
+  } catch (error) {
+    const response = cmsErrorResponse(error);
+    response.headers.set("Cache-Control", "private, no-store, max-age=0");
+    return response;
+  }
+}
