+
+export function canonicalFoundationJson(value: unknown): string {
+  if (value === null || typeof value === "string" || typeof value === "boolean") return JSON.stringify(value);
+  if (typeof value === "number") {
+    if (!Number.isFinite(value)) throw new Error("Non-finite number is not valid foundation content.");
+    return JSON.stringify(value);
+  }
+  if (Array.isArray(value)) return `[${value.map(canonicalFoundationJson).join(",")}]`;
+  if (typeof value === "object") {
+    const record = value as Record<string, unknown>;
+    return `{${Object.keys(record).sort().map((key) => `${JSON.stringify(key)}:${canonicalFoundationJson(record[key])}`).join(",")}}`;
+  }
+  throw new Error(`Foundation content contains unsupported ${typeof value}.`);
+}
+
+export function sha256Foundation(value: unknown): string {
+  return createHash("sha256").update(canonicalFoundationJson(value), "utf8").digest("hex");
+}
+
+export function identitySourceRef(identityId: string, character: string): string {
+  return `${KANJI_FOUNDATION_SOURCE_REF}:identity:${identityId}:${sha256Foundation({ identityId, character })}`;
+}
+
+export function identityCmsItemId(identityId: string): string { return `k09-identity-${identityId}`; }
+export function fieldCmsItemId(identityId: string, fieldKey: string, revisionNumber: number): string {
+  const slug = createHash("sha256").update(fieldKey, "utf8").digest("hex").slice(0, 16);
+  return `k09-field-${identityId}-${slug}-r${revisionNumber}`;
+}
+export function identityCmsTitle(identityId: string): string { return `K09|identity|${identityId}`; }
+export function fieldCmsTitle(identityId: string, fieldKey: string, revisionNumber: number): string {
+  return `K09|field|${identityId}|${fieldKey}|r${revisionNumber}`;
+}
+
+function rightsBaseline(sourceRef: string, stem: string, recordedAt: string): RightsHistoryEvent[] {
+  const date = recordedAt.slice(0, 10);
+  return FOUNDATION_RIGHTS_SCOPES.reduce<RightsHistoryEvent[]>((history, scope) => appendRightsEvent(history, {
+    eventId: `${stem}:${scope}`,
+    sourceRef,
+    scope,
+    state: "UNKNOWN",
+    recordedOn: date,
+    actor: "system:k09-bootstrap",
+    rationale: "Conservative K0.9 default; this event records no legal conclusion and no permission.",
+    evidenceRef: "reports/gates/PHASE-K0.9-IMPLEMENTATION-DECISIONS.json",
+    evidenceClass: "project_gate_record",
+    evidenceSha256: null,
+  }), []);
+}
+
+export function validateProvisionalCohort(value: unknown): { valid: boolean; issues: string[] } {
+  const issues: string[] = [];
+  if (!value || typeof value !== "object" || Array.isArray(value)) return { valid: false, issues: ["cohort must be an object"] };
+  const cohort = value as Partial<ProvisionalCohort>;
+  if (cohort.schemaVersion !== "nihongobridge-kanji-foundation-shells@1") issues.push("unsupported shell cohort schema");
+  if (!Array.isArray(cohort.records) || cohort.records.length !== 5) issues.push("exactly five provisional identity shells are required");
+  const ids = new Set<string>();
+  const characters = new Set<string>();
+  const rows = Array.isArray(cohort.records) ? cohort.records : [];
+  for (const row of rows) {
+    if (!row || typeof row !== "object" || Array.isArray(row)) { issues.push("cohort contains a malformed shell"); continue; }
+    if (typeof row.identityId !== "string" || !ID.test(row.identityId) || ids.has(row.identityId)) issues.push(`${String(row.identityId)}: invalid or duplicate identity ID`);
+    if (typeof row.identityId === "string") ids.add(row.identityId);
+    if (typeof row.character !== "string") {
+      issues.push(`${String(row.identityId)}: character must be one unique exact Unicode scalar`);
+      continue;
+    }
+    if ([...row.character].length !== 1 || characters.has(row.character)) issues.push(`${String(row.identityId)}: character must be one unique exact Unicode scalar`);
+    characters.add(row.character);
+    if (row.codePoint !== `U+${row.character.codePointAt(0)?.toString(16).toUpperCase().padStart(4, "0")}`) issues.push(`${String(row.identityId)}: code point does not match exact character`);
+    if (row.variantRelationship !== "UNASSESSED" || row.membershipState !== "CANDIDATE" || row.editorialStatus !== "DRAFT") issues.push(`${row.identityId}: shell must remain unassessed, candidate and draft`);
+    if (row.createdBy !== null || row.creationMethod !== "K0.9 identity-only provisional shell") issues.push(`${row.identityId}: creator attribution or creation method is invalid`);
+    if (!row.fields || Object.keys(row.fields).length !== 0) issues.push(`${row.identityId}: provisional shell must contain no content fields`);
+    if (!row.createdAt || Number.isNaN(Date.parse(row.createdAt))) issues.push(`${row.identityId}: actual seed shell creation time is required`);
+  }
+  if (characters.size !== 5 || !["明", "休", "道", "新", "話"].every((character) => characters.has(character))) issues.push("cohort must be exactly 明, 休, 道, 新, 話");
+  if (cohort.creatorAttribution?.actorId !== null || cohort.creatorAttribution?.authorshipClaimed !== false) issues.push("seed cohort cannot assert a named creator or authorship");
+  return { valid: issues.length === 0, issues: [...new Set(issues)].sort() };
+}
+
+export function createIdentityDraftPayload(seed: ProvisionalIdentitySeed, createdAt: string): FoundationIdentityPayload {
+  if (!ID.test(seed.identityId) || [...seed.character].length !== 1 || !/\p{Script=Han}/u.test(seed.character)
+    || seed.identityId !== `kanji-u${seed.character.codePointAt(0)?.toString(16).toLowerCase()}` || seed.fields == null || Object.keys(seed.fields).length) {
+    throw new Error("Only an empty identity-only K0.9 shell can be bootstrapped.");
+  }
+  const sourceRef = identitySourceRef(seed.identityId, seed.character);
+  const withoutDigest = {
+    schemaVersion: KANJI_FOUNDATION_ITEM_SCHEMA,
+    kind: "identity" as const,
+    identity: {
+      identityId: seed.identityId,
+      character: seed.character,
+      codePoint: seed.codePoint,
+      variantRelationship: "UNASSESSED" as const,
+      variantTargetIdentityId: null,
+    },
+    identitySourceRef: sourceRef,
+    identityRightsHistory: rightsBaseline(sourceRef, `k09-identity-baseline:${seed.identityId}`, createdAt),
+    membership: { state: "CANDIDATE" as const, history: [] as KanjiMembershipEvent[], evidenceVerification: null },
+    provenance: {
+      state: "PROVISIONAL_IDENTITY_ONLY" as const,
+      method: "K0.9 identity-only provisional shell" as const,
+      actorId: null,
+      identityTrust: "unverified_local_attribution" as const,
+      sourceAssertions: [] as SourceAssertion[],
+    },
+    createdAt,
+    seedPreparedAt: seed.createdAt,
+    revisionNumber: 1,
+  };
+  return { ...withoutDigest, revisionDigest: sha256Foundation(withoutDigest) };
+}
+
+function isFoundationFieldKey(value: string): value is FoundationPublicFieldKey {
+  return (FOUNDATION_PUBLIC_FIELD_KEYS as readonly string[]).includes(value);
+}
+
+function assertNoDeniedSource(sourceRefs: readonly string[]): void {
+  const blocked = sourceRefs.find((sourceRef) => SOURCE_DENYLIST.some((denied) => sourceRef === denied || sourceRef.startsWith(`${denied}:`)));
+  if (blocked) throw new Error(`K0.9 cannot author, transform or publish from blocked source ${blocked}.`);
+}
+
+function fieldValueDigest(identityId: string, fieldKey: string, value: unknown, method: FoundationCreationMethod, sourceAssertions: readonly SourceAssertion[]): string {
+  return sha256Foundation({
+    schemaVersion: EDITORIAL_CONTENT_SCHEMA,
+    identityId,
+    fieldKey,
+    value,
+    creationMethod: method,
+    sourceAssertions: sourceAssertions.map(({ id, sourceRef, sourceVersion, sourceRecordRef, evidenceRef, assertedFields }) => ({ id, sourceRef, sourceVersion, sourceRecordRef, evidenceRef, assertedFields: [...assertedFields] })),
+  });
+}
+
+export function createFoundationFieldPayload(input: {
+  identityId: string;
+  character: string;
+  fieldKey: string;
+  value: unknown;
+  creationMethod: FoundationCreationMethod;
+  contributorId: string;
+  recordedAt: string;
+  sourceAssertions?: SourceAssertion[];
+  previous?: FoundationFieldPayload;
+}): FoundationFieldPayload {
+  if (!ID.test(input.identityId) || [...input.character].length !== 1 || !/\p{Script=Han}/u.test(input.character)
+    || input.identityId !== `kanji-u${input.character.codePointAt(0)?.toString(16).toLowerCase()}`) throw new Error("Field must bind to a single exact Han identity.");
+  if (!isFoundationFieldKey(input.fieldKey)) throw new Error(`Unsupported K0.9 field ${input.fieldKey}.`);
+  if (safePublicValue(input.fieldKey, input.value) === null) throw new Error(`K0.9 ${input.fieldKey} value does not match its explicit public field schema.`);
+  if (!input.contributorId.trim()) throw new Error("Authenticated CMS contributor is required.");
+  if (!input.recordedAt || Number.isNaN(Date.parse(input.recordedAt))) throw new Error("Field revision timestamp is required.");
+  const assertions = input.sourceAssertions ?? [];
+  if (input.creationMethod === "source_derived" && assertions.length === 0) throw new Error("Source-derived fields require pinned source assertions.");
+  if (input.creationMethod !== "source_derived" && assertions.some((assertion) => !assertion.sourceRef.startsWith(`${KANJI_FOUNDATION_SOURCE_REF}:`))) {
+    throw new Error("Non-first-party source assertions require the source-derived workflow.");
+  }
+  for (const assertion of assertions) {
+    if (!assertion.id.trim() || !assertion.sourceVersion.trim() || !assertion.sourceRecordRef.trim() || !assertion.evidenceRef.trim() || !assertion.assertedFields.includes(input.fieldKey)) {
+      throw new Error("Every source assertion must pin a source release, record, evidence location, and exact field path.");
+    }
+  }
+  const sourceRefs = assertions.map((assertion) => assertion.sourceRef);
+  assertNoDeniedSource(sourceRefs);
+  for (const sourceRef of sourceRefs) {
+    if (sourceRef.startsWith(`${KANJI_FOUNDATION_SOURCE_REF}:`)) continue;
+    const operation = sourceOperationDecision(K0_5A_INITIAL_RIGHTS_HISTORY, sourceRef);
+    if (!operation.allowed) throw new Error(`Source-derived draft denied for ${sourceRef}; retention, internal analysis and derivation rights must already be cleared.`);
+  }
+  if (input.fieldKey === "decomposition") {
+    const graph = input.value as MindTreeEvidenceGraph;
+    const validation = validateMindTreeEvidenceGraph(graph);
+    if (!validation.valid) throw new Error(`Mind Tree decomposition is invalid: ${validation.issues.join("; ")}`);
+    if (!graph.identities.some((identity) => identity.id === input.identityId && identity.character === input.character)
+      || graph.decompositions.some((decomposition) => decomposition.glyphIdentityId !== input.identityId)) {
+      throw new Error("Mind Tree decompositions must bind only to the exact first-party identity being authored.");
+    }
+    assertNoDeniedSource(graph.sourceAssertions.map((assertion) => assertion.sourceRef));
+    if (graph.sourceAssertions.length !== assertions.length) throw new Error("Mind Tree graph and field provenance must contain the same pinned source assertions.");
+    for (const graphAssertion of graph.sourceAssertions) {
+      const fieldAssertion = assertions.find((assertion) => assertion.id === graphAssertion.id);
+      if (!fieldAssertion || fieldAssertion.sourceRef !== graphAssertion.sourceRef || fieldAssertion.sourceVersion !== graphAssertion.sourceVersion
+        || fieldAssertion.sourceRecordRef !== graphAssertion.sourceRecordRef || fieldAssertion.evidenceRef !== graphAssertion.evidenceRef) {
+        throw new Error(`Mind Tree graph source assertion ${graphAssertion.id} does not match the field-level provenance record.`);
+      }
+    }
+  }
+  const contentDigest = fieldValueDigest(input.identityId, input.fieldKey, input.value, input.creationMethod, assertions);
+  const fieldSource = `${KANJI_FOUNDATION_SOURCE_REF}:field:${input.identityId}:${input.fieldKey}:${contentDigest}`;
+  const priorHistory = input.previous?.rightsHistory ?? [];
+  const rights = input.previous?.fieldSourceRef === fieldSource
+    ? [...priorHistory]
+    : rightsBaseline(fieldSource, `k09-field-baseline:${input.identityId}:${contentDigest}`, input.recordedAt);
+  if (!validateRightsHistory([...K0_5A_INITIAL_RIGHTS_HISTORY, ...rights]).valid) throw new Error("Field rights history is invalid.");
+  const revisionNumber = (input.previous?.revisionNumber ?? 0) + 1;
+  const editorialVersion = (input.previous?.editorialRevision.version ?? 0) + 1;
+  const revisionId = `editorial:${input.identityId}:${createHash("sha256").update(input.fieldKey, "utf8").digest("hex").slice(0, 12)}:r${editorialVersion}`;
+  const contentSnapshot = { [input.fieldKey]: input.value };
+  const revisionBody: Omit<FirstPartyEditorialRevision, "revisionDigest"> = {
+    id: revisionId,
+    contentId: `${input.identityId}:${input.fieldKey}`,
+    version: editorialVersion,
+    previousRevisionId: input.previous?.editorialRevision.id ?? null,
+    recordedOn: input.recordedAt.slice(0, 10),
+    authorAttribution: input.contributorId,
+    identityTrust: "unverified_local_attribution",
+    changeSummary: input.previous ? `K0.9 field revision ${editorialVersion}` : "K0.9 first-party editorial draft",
+    changedFields: [input.fieldKey],
+    contentSnapshot,
+    contentDigest: digestEditorialContent(contentSnapshot),
+  };
+  const editorialRevision: FirstPartyEditorialRevision = {
+    ...revisionBody,
+    revisionDigest: editorialRevisionDigest(revisionBody),
+  };
+  const provenanceState: FoundationProvenanceState = input.creationMethod === "human_draft" ? "ASSERTED"
+    : input.creationMethod === "source_derived" ? "SOURCE_DERIVED" : "UNKNOWN";
+  const base = {
+    schemaVersion: KANJI_FOUNDATION_ITEM_SCHEMA,
+    kind: "field" as const,
+    identityId: input.identityId,
+    character: input.character,
+    fieldKey: input.fieldKey,
+    field: { value: input.value, provenance: input.creationMethod === "source_derived"
+      ? { kind: "source_assertion" as const, id: assertions[0].id }
+      : { kind: "editorial_revision" as const, id: revisionId } } satisfies FieldValue<unknown>,
+    creationMethod: input.creationMethod,
+    provenance: {
+      state: provenanceState,
+      sourceAssertions: assertions,
+      sourceRefs: [...new Set([fieldSource, ...sourceRefs])],
+      contributorId: input.contributorId,
+      identityTrust: "unverified_local_attribution" as const,
+      verification: null,
+    },
+    fieldValueDigest: contentDigest,
+    fieldSourceRef: fieldSource,
+    rightsHistory: rights,
+    editorialRevision,
+    revisionNumber,
+  };
+  return { ...base, revisionDigest: sha256Foundation(base) };
+}
+
+export function verifyFoundationFieldProvenance(input: {
+  payload: FoundationFieldPayload;
+  reviewerId: string;
+  evidenceRef: string;
+  evidenceSha256: string;
+  verifiedAt: string;
+}): FoundationFieldPayload {
+  if (!SHA256.test(input.evidenceSha256)) throw new Error("Provenance verification requires a SHA-256 evidence digest.");
+  if (!input.evidenceRef.trim() || !input.reviewerId.trim()) throw new Error("Reviewer and evidence reference are required.");
+  const base = {
+    ...input.payload,
+    provenance: {
+      ...input.payload.provenance,
+      state: "VERIFIED" as const,
+      verification: {
+        revisionDigest: input.payload.editorialRevision.revisionDigest,
+        reviewerId: input.reviewerId,
+        evidenceRef: input.evidenceRef,
+        evidenceSha256: input.evidenceSha256,
+        verifiedAt: input.verifiedAt,
+      },
+    },
+  };
+  const { revisionDigest: _oldDigest, ...digestable } = base;
+  return { ...base, revisionDigest: sha256Foundation(digestable) };
+}
+
+export function appendFoundationIdentityRightsDecision(input: {
+  payload: FoundationIdentityPayload;
+  scope: RightsScope;
+  state: RightsState;
+  actorId: string;
+  recordedAt: string;
+  evidenceRef: string;
+  evidenceClass: "owner_authorization" | "project_gate_record";
+  evidenceSha256: string | null;
+  rationale: string;
+}): FoundationIdentityPayload {
+  if (!input.payload.identitySourceRef.startsWith(`${KANJI_FOUNDATION_SOURCE_REF}:identity:`)) throw new Error("K0.9 identity rights events may not rewrite a legacy source state.");
+  if (input.state === "CLEARED" && input.evidenceClass !== "owner_authorization") throw new Error("First-party identity clearance requires owner authorization evidence.");
+  const history = appendRightsEvent([...K0_5A_INITIAL_RIGHTS_HISTORY, ...input.payload.identityRightsHistory], {
+    eventId: `k09-identity-rights:${sha256Foundation(input.payload.identitySourceRef)}:${input.scope}:${input.payload.identityRightsHistory.filter((item) => item.scope === input.scope).length + 1}`,
+    sourceRef: input.payload.identitySourceRef,
+    scope: input.scope,
+    state: input.state,
+    recordedOn: input.recordedAt.slice(0, 10),
+    actor: input.actorId,
+    rationale: input.rationale,
+    evidenceRef: input.evidenceRef,
+    evidenceClass: input.evidenceClass,
+    evidenceSha256: input.evidenceSha256,
+  });
+  const identityRightsHistory = history.filter((event) => !K0_5A_INITIAL_RIGHTS_HISTORY.some((baseline) => baseline.eventId === event.eventId));
+  const base = { ...input.payload, identityRightsHistory, revisionNumber: input.payload.revisionNumber + 1 };
+  const { revisionDigest: _oldDigest, ...digestable } = base;
+  return { ...base, revisionDigest: sha256Foundation(digestable) };
+}
+
+export function appendFoundationRightsDecision(input: {
+  payload: FoundationFieldPayload;
+  sourceRef?: string;
+  scope: RightsScope;
+  state: RightsState;
+  actorId: string;
+  recordedAt: string;
+  evidenceRef: string;
+  evidenceClass: "owner_authorization" | "primary_license" | "qualified_review" | "project_gate_record";
+  evidenceSha256: string | null;
+  qualifiedReviewRef?: string | null;
+  qualifiedReviewSha256?: string | null;
+  rationale: string;
+}): FoundationFieldPayload {
+  const sourceRef = input.sourceRef ?? input.payload.fieldSourceRef;
+  if (!input.payload.provenance.sourceRefs.includes(sourceRef)) throw new Error("K0.9 rights events may update only a source ref explicitly attached to this field revision.");
+  if (sourceRef.startsWith("first-party:") && input.state === "CLEARED" && input.evidenceClass !== "owner_authorization") {
+    throw new Error("First-party field clearance requires owner authorization evidence.");
+  }
+  const history = appendRightsEvent([...K0_5A_INITIAL_RIGHTS_HISTORY, ...input.payload.rightsHistory], {
+    eventId: `k09-rights:${sha256Foundation(sourceRef)}:${input.scope}:${input.payload.rightsHistory.filter((item) => item.sourceRef === sourceRef && item.scope === input.scope).length + 1}`,
+    sourceRef,
+    scope: input.scope,
+    state: input.state,
+    recordedOn: input.recordedAt.slice(0, 10),
+    actor: input.actorId,
+    rationale: input.rationale,
+    evidenceRef: input.evidenceRef,
+    evidenceClass: input.evidenceClass,
+    evidenceSha256: input.evidenceSha256,
+    qualifiedReviewRef: input.qualifiedReviewRef ?? null,
+    qualifiedReviewSha256: input.qualifiedReviewSha256 ?? null,
+  });
+  const fieldHistory = history.filter((event) => !K0_5A_INITIAL_RIGHTS_HISTORY.some((baseline) => baseline.eventId === event.eventId));
+  const base = { ...input.payload, rightsHistory: fieldHistory };
+  const { revisionDigest: _oldDigest, ...digestable } = base;
+  return { ...base, revisionDigest: sha256Foundation(digestable) };
+}
+
+export function latestFoundationMembershipEvents(history: readonly KanjiMembershipEvent[]): KanjiMembershipEvent[] {
+  const latest = new Map<string, KanjiMembershipEvent>();
+  for (const event of history) {
+    const key = `${event.identityId}::${event.goal}`;
+    const current = latest.get(key);
+    if (!current || event.sequence > current.sequence) latest.set(key, event);
+  }
+  return [...latest.values()].sort((a, b) => a.identityId.localeCompare(b.identityId) || a.goal.localeCompare(b.goal));
+}
