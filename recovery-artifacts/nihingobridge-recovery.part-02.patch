+++ b/src/services/knowledge/provenance/sourceAlternatives.ts
@@ -0,0 +1,51 @@
+import { currentRightsState, publicDistributionDecision, validateRightsHistory, type RightsHistoryEvent, type RightsScope, type RightsState } from "./rightsPolicy";
+
+/** Caller-declared alternative; coverage is never inferred from a source name. */
+export interface SourceAlternativeDescriptor {
+  sourceRef: string;
+  label: string;
+  declaredCoverageFields: readonly string[];
+  coverageEvidenceRef: string | null;
+  independence: "first_party_original" | "independent_third_party" | "unknown";
+}
+export interface SourceAlternativeComparisonRow {
+  sourceRef: string;
+  label: string;
+  declaredCoverageFields: string[];
+  coverageEvidenceRef: string | null;
+  coverageEvidenceStatus: "provided" | "not_provided";
+  rightsByScope: Record<RightsScope, RightsState>;
+  publicDistributionAllowed: boolean;
+  blockers: Array<{ scope: RightsScope; state: RightsState }>;
+  independence: SourceAlternativeDescriptor["independence"];
+}
+
+/**
+ * Side-by-side factual gate comparison. No recommendation/ranking is produced:
+ * scope coverage and quality require separate owner/source evidence.
+ */
+export function compareSourceAlternatives(
+  candidates: readonly SourceAlternativeDescriptor[],
+  history: readonly RightsHistoryEvent[],
+): { comparisonOnly: true; recommendation: null; alternatives: SourceAlternativeComparisonRow[] } {
+  const historyValid = validateRightsHistory(history).valid;
+  const alternatives = candidates.map((candidate) => {
+    const refs = [candidate.sourceRef];
+    const distribution = publicDistributionDecision(history, refs);
+    const rightsByScope = Object.fromEntries(([
+      "retention", "internal_analysis", "derivation", "public_distribution",
+    ] as const).map((scope) => [scope, historyValid ? currentRightsState(history, candidate.sourceRef, scope) : "UNKNOWN"])) as Record<RightsScope, RightsState>;
+    return {
+      sourceRef: candidate.sourceRef,
+      label: candidate.label,
+      declaredCoverageFields: [...new Set(candidate.declaredCoverageFields)].sort(),
+      coverageEvidenceRef: candidate.coverageEvidenceRef,
+      coverageEvidenceStatus: candidate.coverageEvidenceRef ? "provided" as const : "not_provided" as const,
+      rightsByScope,
+      publicDistributionAllowed: distribution.allowed,
+      blockers: distribution.blockers.map(({ scope, state }) => ({ scope, state })),
+      independence: candidate.independence,
+    };
+  }).sort((a, b) => a.sourceRef.localeCompare(b.sourceRef));
+  return { comparisonOnly: true, recommendation: null, alternatives };
+}
