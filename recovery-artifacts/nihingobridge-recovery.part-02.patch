+import { NextRequest } from "next/server";
+import { describe, expect, it, vi } from "vitest";
+
+vi.mock("@/services/knowledge/knowledgeService", () => ({
+  KnowledgeService: { getKanjiDetail: vi.fn(), listKanji: vi.fn(), listElements: vi.fn() },
+}));
+
+import { GET as getKanjiDetailRoute } from "@/app/api/kanji/[character]/route";
+import { GET as getKanjiListRoute } from "@/app/api/kanji/route";
+import { KnowledgeService } from "@/services/knowledge/knowledgeService";
+
+const getKanjiDetail = vi.mocked(KnowledgeService.getKanjiDetail);
+const listKanji = vi.mocked(KnowledgeService.listKanji);
+function request(character: string) {
+  return new NextRequest(`http://localhost/api/kanji/${encodeURIComponent(character)}`);
+}
+
+describe("GET /api/kanji/[character] rights/provenance gate", () => {
+  it("rejects malformed identities before any source-backed read", async () => {
+    const response = await getKanjiDetailRoute(request("日本"), { params: Promise.resolve({ character: "日本" }) });
+    expect(response.status).toBe(400);
+    expect(await response.json()).toMatchObject({ errorCode: "INVALID_KANJI" });
+    expect(getKanjiDetail).not.toHaveBeenCalled();
+  });
+
+  it("withholds the legacy denormalized detail aggregate before querying data", async () => {
+    const response = await getKanjiDetailRoute(request("水"), { params: Promise.resolve({ character: "水" }) });
+    const body = await response.json();
+    expect(response.status).toBe(451);
+    expect(response.headers.get("cache-control")).toBe("no-store");
+    expect(body).toEqual({
+      success: false,
+      error: { code: "CONTENT_UNAVAILABLE", message: "This content is temporarily unavailable." },
+    });
+    expect(JSON.stringify(body)).not.toMatch(/KANJIDIC2|KanjiVG|sourceRef|public_distribution/i);
+    expect(body).not.toHaveProperty("kanji");
+    expect(getKanjiDetail).not.toHaveBeenCalled();
+  });
+
+  it("withholds the mixed-source Kanji catalog before running a database query", async () => {
+    const response = await getKanjiListRoute(new NextRequest("http://localhost/api/kanji?includeElements=1"));
+    const body = await response.json();
+    expect(response.status).toBe(451);
+    expect(body).toEqual({
+      success: false,
+      error: { code: "CONTENT_UNAVAILABLE", message: "This content is temporarily unavailable." },
+    });
+    expect(JSON.stringify(body)).not.toMatch(/KANJIDIC2|KanjiVG|sourceRef|public_distribution/i);
+    expect(body).not.toHaveProperty("kanji");
+    expect(listKanji).not.toHaveBeenCalled();
+  });
+});
