diff --git a/src/app/api/cms/kanji-foundation/[id]/[action]/route.ts b/src/app/api/cms/kanji-foundation/[id]/[action]/route.ts
new file mode 100644
index 0000000..f6af089
--- /dev/null
+++ b/src/app/api/cms/kanji-foundation/[id]/[action]/route.ts
@@ -0,0 +1,135 @@
+import { NextResponse } from "next/server";
+import { CmsError } from "@/services/cms";
+import { cmsErrorResponse, parseJsonBody } from "@/app/api/cms/_shared";
+import { kanjiFoundationWorkflow } from "@/services/knowledge/editorial/kanjiFoundationWorkflow";
+import type { SourceAssertion } from "@/services/knowledge/editorial/fieldProvenance";
+
+export const dynamic = "force-dynamic";
+export const revalidate = 0;
+
+type Params = { params: Promise<{ id: string; action: string }> };
+function stringValue(body: Record<string, unknown>, field: string, optional = false): string | undefined {
+  const value = body[field];
+  if (optional && value === undefined) return undefined;
+  if (typeof value !== "string" || !value.trim()) throw CmsError.validation(`${field} must be a non-empty string.`, { field });
+  return value;
+}
+function shaOrNull(body: Record<string, unknown>, field: string): string | null {
+  const value = body[field];
+  if (value === null) return null;
+  if (typeof value !== "string" || !/^[0-9a-f]{64}$/u.test(value)) throw CmsError.validation(`${field} must be a lowercase SHA-256 digest or null.`, { field });
+  return value;
+}
+function noStore(data: unknown): NextResponse {
+  return NextResponse.json({ success: true, data }, { headers: { "Cache-Control": "private, no-store, max-age=0" } });
+}
+
+export async function POST(request: Request, { params }: Params): Promise<NextResponse> {
+  try {
+    const { id, action } = await params;
+    const body = await parseJsonBody(request);
+    let result;
+    switch (action) {
+      case "submit":
+        result = await kanjiFoundationWorkflow.submitReview(id);
+        break;
+      case "approve":
+        result = await kanjiFoundationWorkflow.approve(id);
+        break;
+      case "request-changes":
+        result = await kanjiFoundationWorkflow.requestChanges(id, stringValue(body, "reason")!);
+        break;
+      case "publish":
+        result = await kanjiFoundationWorkflow.publish(id);
+        break;
+      case "archive":
+        result = await kanjiFoundationWorkflow.archive(id);
+        break;
+      case "verify-provenance":
+        result = await kanjiFoundationWorkflow.verifyField(id, stringValue(body, "evidenceRef")!, stringValue(body, "evidenceSha256")!);
+        break;
+      case "rights": {
+        const scope = stringValue(body, "scope")!;
+        const state = stringValue(body, "state")!;
+        const evidenceClass = stringValue(body, "evidenceClass")!;
+        if (!["retention", "internal_analysis", "derivation", "public_distribution"].includes(scope)) throw CmsError.validation("Unsupported rights scope.");
+        if (!["CLEARED", "CONDITIONAL", "BLOCKED", "UNKNOWN"].includes(state)) throw CmsError.validation("Unsupported rights state.");
+        if (!["owner_authorization", "primary_license", "qualified_review", "project_gate_record"].includes(evidenceClass)) throw CmsError.validation("Unsupported K0.9 rights evidence class.");
+        result = await kanjiFoundationWorkflow.setFieldRights({
+          itemId: id,
+          sourceRef: stringValue(body, "sourceRef", true),
+          scope: scope as "retention" | "internal_analysis" | "derivation" | "public_distribution",
+          state: state as "CLEARED" | "CONDITIONAL" | "BLOCKED" | "UNKNOWN",
+          evidenceRef: stringValue(body, "evidenceRef")!,
+          evidenceClass: evidenceClass as "owner_authorization" | "primary_license" | "qualified_review" | "project_gate_record",
+          evidenceSha256: shaOrNull(body, "evidenceSha256"),
+          qualifiedReviewRef: body.qualifiedReviewRef === undefined ? null : stringValue(body, "qualifiedReviewRef")!,
+          qualifiedReviewSha256: body.qualifiedReviewSha256 === undefined ? null : shaOrNull(body, "qualifiedReviewSha256"),
+          rationale: stringValue(body, "rationale")!,
+        });
+        break;
+      }
+      case "identity-rights": {
+        const scope = stringValue(body, "scope")!;
+        const state = stringValue(body, "state")!;
+        const evidenceClass = stringValue(body, "evidenceClass")!;
+        if (!["retention", "internal_analysis", "derivation", "public_distribution"].includes(scope)) throw CmsError.validation("Unsupported rights scope.");
+        if (!["CLEARED", "CONDITIONAL", "BLOCKED", "UNKNOWN"].includes(state)) throw CmsError.validation("Unsupported rights state.");
+        if (!["owner_authorization", "project_gate_record"].includes(evidenceClass)) throw CmsError.validation("K0.9 may only record first-party owner authorization or project-gate evidence.");
+        result = await kanjiFoundationWorkflow.setIdentityRights({
+          identityId: id,
+          scope: scope as "retention" | "internal_analysis" | "derivation" | "public_distribution",
+          state: state as "CLEARED" | "CONDITIONAL" | "BLOCKED" | "UNKNOWN",
+          evidenceRef: stringValue(body, "evidenceRef")!,
+          evidenceClass: evidenceClass as "owner_authorization" | "project_gate_record",
+          evidenceSha256: shaOrNull(body, "evidenceSha256"),
+          rationale: stringValue(body, "rationale")!,
+        });
+        break;
+      }
+      case "membership": {
+        const sourceAssertions = body.sourceAssertions;
+        if (!Array.isArray(sourceAssertions) || sourceAssertions.some((row) => !row || typeof row !== "object" || Array.isArray(row))) {
+          throw CmsError.validation("Membership sourceAssertions must be an explicit array.");
+        }
+        const sourceAssertionIds = body.sourceAssertionIds;
+        const sourceRefs = body.sourceRefs;
+        if (!Array.isArray(sourceAssertionIds) || sourceAssertionIds.some((value) => typeof value !== "string")
+          || !Array.isArray(sourceRefs) || sourceRefs.some((value) => typeof value !== "string")) {
+          throw CmsError.validation("Membership sourceAssertionIds and sourceRefs must be explicit arrays.");
+        }
+        const goal = stringValue(body, "goal")!;
+        const state = stringValue(body, "state")!;
+        const decisionTrust = stringValue(body, "decisionTrust")!;
+        if (!["japanese_literacy", "general_reading_coverage", "learner_progression", "comprehensive_reference"].includes(goal)) throw CmsError.validation("Unsupported membership goal.");
+        if (!["candidate", "approved", "published", "excluded", "deferred", "withdrawn"].includes(state)) throw CmsError.validation("Unsupported membership state.");
+        if (!["unverified_local_attribution", "authenticated_external"].includes(decisionTrust)) throw CmsError.validation("Unsupported membership trust state.");
+        result = await kanjiFoundationWorkflow.appendMembershipDecision({
+          identityId: id,
+          goal: goal as "japanese_literacy" | "general_reading_coverage" | "learner_progression" | "comprehensive_reference",
+          state: state as "candidate" | "approved" | "published" | "excluded" | "deferred" | "withdrawn",
+          eventId: stringValue(body, "eventId")!,
+          sourceAssertionIds: sourceAssertionIds as string[],
+          sourceAssertions: sourceAssertions as SourceAssertion[],
+          sourceRefs: sourceRefs as string[],
+          decisionEvidenceRef: stringValue(body, "decisionEvidenceRef")!,
+          decisionAuthority: stringValue(body, "decisionAuthority")!,
+          decisionTrust: decisionTrust as "unverified_local_attribution" | "authenticated_external",
+          authenticationEvidenceRef: body.authenticationEvidenceRef === null ? null : stringValue(body, "authenticationEvidenceRef")!,
+          authenticationEvidenceSha256: body.authenticationEvidenceSha256 === null ? null : stringValue(body, "authenticationEvidenceSha256")!,
+        });
+        break;
+      }
+      case "verify-membership":
+        result = await kanjiFoundationWorkflow.verifyMembership(id, stringValue(body, "evidenceRef")!, stringValue(body, "evidenceSha256")!);
+        break;
+      default:
+        throw CmsError.notFound("K0.9 CMS action", action);
+    }
+    return noStore(result);
+  } catch (error) {
+    const response = cmsErrorResponse(error);
