diff --git a/src/services/knowledge/provenance/rightsAwareExport.ts b/src/services/knowledge/provenance/rightsAwareExport.ts
new file mode 100644
index 0000000..f9d9f94
--- /dev/null
+++ b/src/services/knowledge/provenance/rightsAwareExport.ts
@@ -0,0 +1,129 @@
+import { createHash } from "node:crypto";
+import {
+  K0_5A_INITIAL_RIGHTS_HISTORY,
+  publicDistributionDecision,
+  validateRightsHistory,
+  type RightsHistoryEvent,
+  type RightsScope,
+  type RightsState,
+} from "./rightsPolicy";
+
+export const RIGHTS_AWARE_EXPORT_SCHEMA = "nihongobridge-rights-aware-export@1" as const;
+
+export interface RightsAwareExportRow<T = unknown> {
+  contentId: string;
+  /** Every field/source contributing to the row must appear here. Empty provenance fails closed. */
+  provenanceRefs: readonly string[];
+  content: T;
+}
+export interface RightsAwareExportAuditRow {
+  contentId: string;
+  sourceRefs: string[];
+  included: boolean;
+  blockers: Array<{ sourceRef: string; scope: RightsScope; state: RightsState }>;
+}
+export interface RightsAwareExportPackage<T = unknown> {
+  schemaVersion: typeof RIGHTS_AWARE_EXPORT_SCHEMA;
+  policyVersion: "nihongobridge-rights-policy@1";
+  content: Array<{ contentId: string; provenanceRefs: string[]; content: T }>;
+  audit: RightsAwareExportAuditRow[];
+  rightsHistoryDigests: string[];
+  artifactDigest: string;
+}
+
+function canonical(value: unknown): string {
+  if (value === null || typeof value !== "object") return JSON.stringify(value);
+  if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
+  const record = value as Record<string, unknown>;
+  return `{${Object.keys(record).sort().map((key) => `${JSON.stringify(key)}:${canonical(record[key])}`).join(",")}}`;
+}
+function sha256(value: unknown): string { return createHash("sha256").update(canonical(value), "utf8").digest("hex"); }
+
+function matchesAuthoritativeHistory(history: readonly RightsHistoryEvent[]): boolean {
+  if (!validateRightsHistory(history).valid || history.length !== K0_5A_INITIAL_RIGHTS_HISTORY.length) return false;
+  return history.every((event, index) => event.eventDigest === K0_5A_INITIAL_RIGHTS_HISTORY[index]?.eventDigest);
+}
+
+/**
+ * Mixed-source export: independently cleared rows can ship; blocked/unknown rows are omitted,
+ * with an audit record retained. No row is accepted on license name or source identity alone.
+ */
+export function buildRightsAwareExport<T>(input: {
+  rows: readonly RightsAwareExportRow<T>[];
+  rightsHistory: readonly RightsHistoryEvent[];
+}): RightsAwareExportPackage<T> {
+  if (!matchesAuthoritativeHistory(input.rightsHistory)) {
+    throw new Error("Export blocked: caller-supplied policy history is not authoritative.");
+  }
+  const history = K0_5A_INITIAL_RIGHTS_HISTORY;
+  const historyCheck = validateRightsHistory(history);
+  if (!historyCheck.valid) throw new Error("Export blocked: authoritative rights history is invalid.");
+  const content: RightsAwareExportPackage<T>["content"] = [];
+  const audit: RightsAwareExportAuditRow[] = [];
+  const seenIds = new Set<string>();
+  for (const row of input.rows) {
+    if (!row.contentId.trim() || seenIds.has(row.contentId)) throw new Error(`Export blocked: missing or duplicate content ID ${row.contentId}`);
+    seenIds.add(row.contentId);
+    const sourceRefs = [...new Set(row.provenanceRefs)].sort();
+    const decision = publicDistributionDecision(history, sourceRefs);
+    const blockers = [...decision.blockers];
+    const included = blockers.length === 0;
+    if (included) content.push({ contentId: row.contentId, provenanceRefs: sourceRefs, content: row.content });
+    audit.push({ contentId: row.contentId, sourceRefs, included, blockers: blockers.sort((a, b) => a.sourceRef.localeCompare(b.sourceRef) || a.scope.localeCompare(b.scope)) });
+  }
+  const unsigned = {
+    schemaVersion: RIGHTS_AWARE_EXPORT_SCHEMA,
+    policyVersion: "nihongobridge-rights-policy@1" as const,
+    content: content.sort((a, b) => a.contentId.localeCompare(b.contentId)),
+    audit: audit.sort((a, b) => a.contentId.localeCompare(b.contentId)),
+    rightsHistoryDigests: [...new Set(history.map((event) => event.eventDigest))].sort(),
+  };
+  return { ...unsigned, artifactDigest: sha256(unsigned) };
+}
+
+/** Verifies package integrity and blocks any tampered audit or non-cleared source reference. */
+export function verifyRightsAwareExport<T>(
+  value: RightsAwareExportPackage<T>,
+  rightsHistory: readonly RightsHistoryEvent[],
+): { valid: boolean; issues: string[] } {
+  const issues: string[] = [];
+  if (!value || value.schemaVersion !== RIGHTS_AWARE_EXPORT_SCHEMA || value.policyVersion !== "nihongobridge-rights-policy@1") {
+    return { valid: false, issues: ["unsupported rights-aware export schema or policy version"] };
+  }
+  if (!matchesAuthoritativeHistory(rightsHistory)) issues.push("supplied rights history is not authoritative");
+  const history = K0_5A_INITIAL_RIGHTS_HISTORY;
+  const historyCheck = validateRightsHistory(history);
+  if (!historyCheck.valid) issues.push("authoritative rights history is invalid");
+  const { artifactDigest, ...unsigned } = value;
+  if (artifactDigest !== sha256(unsigned)) issues.push("export artifact digest mismatch");
+  const currentHistoryDigests = [...new Set(history.map((event) => event.eventDigest))].sort();
+  if (canonical(value.rightsHistoryDigests) !== canonical(currentHistoryDigests)) issues.push("export rights-history pins do not match the supplied history");
+  const auditById = new Map<string, RightsAwareExportAuditRow>();
+  for (const row of value.audit) {
+    if (auditById.has(row.contentId)) issues.push(`duplicate audit row for ${row.contentId}`);
+    auditById.set(row.contentId, row);
+    if (row.included && row.blockers.length) issues.push(`${row.contentId}: positive audit decision contains blockers`);
+    if (!row.included && !row.blockers.length) issues.push(`${row.contentId}: omitted row has no recorded blocker`);
+  }
+  const contentIds = new Set<string>();
+  for (const row of value.content) {
+    if (contentIds.has(row.contentId)) issues.push(`duplicate included content ID ${row.contentId}`);
+    contentIds.add(row.contentId);
+    const audit = auditById.get(row.contentId);
+    if (!audit?.included) issues.push(`${row.contentId}: included content lacks a positive audit decision`);
+    const expectedSources = [...new Set(row.provenanceRefs)].sort();
+    if (audit && canonical(audit.sourceRefs) !== canonical(expectedSources)) issues.push(`${row.contentId}: audit source references differ from included row provenance`);
+    const decision = publicDistributionDecision(history, row.provenanceRefs);
+    if (!decision.allowed) issues.push(`${row.contentId}: content references source data not cleared for public distribution`);
+    if (!row.provenanceRefs.length) issues.push(`${row.contentId}: empty field provenance`);
+  }
+  for (const audit of value.audit) {
+    if (audit.included && !contentIds.has(audit.contentId)) issues.push(`${audit.contentId}: audit claims inclusion but content is absent`);
+    if (!audit.included && contentIds.has(audit.contentId)) issues.push(`${audit.contentId}: blocked row appears in output content`);
+    const decision = publicDistributionDecision(history, audit.sourceRefs);
+    if (decision.allowed !== audit.included) issues.push(`${audit.contentId}: audit inclusion decision does not match current rights state`);
+    const expectedBlockers = decision.blockers.sort((a, b) => a.sourceRef.localeCompare(b.sourceRef) || a.scope.localeCompare(b.scope));
+    if (canonical(expectedBlockers) !== canonical(audit.blockers)) issues.push(`${audit.contentId}: audit blockers differ from current rights state`);
+  }
+  return { valid: issues.length === 0, issues: [...new Set(issues)].sort() };
+}
