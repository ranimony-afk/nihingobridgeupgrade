+import { NextResponse } from "next/server";
+import { buildKanjiFoundationPublicProjection } from "@/services/knowledge/editorial/kanjiFoundation";
+import { readKanjiFoundationSnapshot } from "@/services/knowledge/editorial/kanjiFoundationRepository";
+
+export const dynamic = "force-dynamic";
+export const revalidate = 0;
+
+type Params = { params: Promise<{ identityId: string }> };
+
+export async function GET(_request: Request, { params }: Params): Promise<NextResponse> {
+  try {
+    const { identityId } = await params;
+    const projection = buildKanjiFoundationPublicProjection(await readKanjiFoundationSnapshot(), new Date().toISOString());
+    const kanji = projection.kanji.find((entry) => entry.identityId === identityId);
+    if (!kanji) {
+      return NextResponse.json({ success: false, error: { code: "NOT_FOUND", message: "Published Kanji not found." } }, {
+        status: 404,
+        headers: { "Cache-Control": "no-store, max-age=0, must-revalidate", Pragma: "no-cache", "X-Kanji-Foundation-Version": projection.contentDigest },
+      });
+    }
+    return NextResponse.json({ success: true, data: kanji }, {
+      headers: { "Cache-Control": "no-store, max-age=0, must-revalidate", Pragma: "no-cache", "X-Kanji-Foundation-Version": projection.contentDigest },
+    });
+  } catch {
+    return NextResponse.json({ success: false, error: { code: "FOUNDATION_READ_FAILED", message: "Kanji learning content is temporarily unavailable." } }, {
+      status: 503,
+      headers: { "Cache-Control": "no-store, max-age=0, must-revalidate", Pragma: "no-cache" },
+    });
+  }
+}
diff --git a/src/app/api/kanji-foundation/route.ts b/src/app/api/kanji-foundation/route.ts
new file mode 100644
index 0000000..1da3fd9
--- /dev/null
+++ b/src/app/api/kanji-foundation/route.ts
@@ -0,0 +1,38 @@
+import { NextResponse } from "next/server";
+import { buildKanjiFoundationPublicProjection } from "@/services/knowledge/editorial/kanjiFoundation";
+import { readKanjiFoundationSnapshot } from "@/services/knowledge/editorial/kanjiFoundationRepository";
+
+export const dynamic = "force-dynamic";
+export const revalidate = 0;
+
+function noStore(data: unknown, digest: string): NextResponse {
+  return NextResponse.json({ success: true, data }, {
+    headers: {
+      "Cache-Control": "no-store, max-age=0, must-revalidate",
+      Pragma: "no-cache",
+      "X-Kanji-Foundation-Version": digest,
+    },
+  });
+}
+
+export async function GET(request: Request): Promise<NextResponse> {
+  try {
+    const snapshot = await readKanjiFoundationSnapshot();
+    const projection = buildKanjiFoundationPublicProjection(snapshot, new Date().toISOString());
+    const rawQuery = new URL(request.url).searchParams.get("q")?.trim() ?? "";
+    if (rawQuery.length > 80) return NextResponse.json({ success: false, error: { code: "INVALID_QUERY", message: "Search query is too long." } }, {
+      status: 400,
+      headers: { "Cache-Control": "no-store, max-age=0, must-revalidate", Pragma: "no-cache", "X-Kanji-Foundation-Version": projection.contentDigest },
+    });
+    const query = rawQuery.toLocaleLowerCase("ja-JP");
+    const kanji = query
+      ? projection.kanji.filter((entry) => JSON.stringify(entry).toLocaleLowerCase("ja-JP").includes(query))
+      : projection.kanji;
+    return noStore({ schemaVersion: projection.schemaVersion, contentDigest: projection.contentDigest, kanji }, projection.contentDigest);
+  } catch {
+    return NextResponse.json({ success: false, error: { code: "FOUNDATION_READ_FAILED", message: "Kanji learning content is temporarily unavailable." } }, {
+      status: 503,
+      headers: { "Cache-Control": "no-store, max-age=0, must-revalidate", Pragma: "no-cache" },
+    });
+  }
+}
