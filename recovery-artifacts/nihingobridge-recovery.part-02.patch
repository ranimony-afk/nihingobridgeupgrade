+SOURCE_LICENSE = "CC BY-SA 4.0"
+LICENSE_URL = "https://creativecommons.org/licenses/by-sa/4.0/"
+JLPT_LEVELS = ("N5", "N4", "N3", "N2", "N1")
+USER_AGENT = "NihongoBridge-K0.14-openjlpt-materializer/1.0"
+
+# Expected bytes are pinned to the K0.13-identified Git commit and rechecked on
+# acquisition. SHA-1 is Git's blob object ID; SHA-256 is the artifact digest.
+PINNED_FILES: dict[str, dict[str, Any]] = {
+    "LICENSE": {
+        "bytes": 20138,
+        "gitBlob": "2d58298e6eda10e7204abb52722efbc840db2390",
+        "sha256": "28a9529c7d0bb4dc51f4bf5c116a3d16ef247a052f7591466768ddf563fd1cf5",
+    },
+    "NOTICE.md": {
