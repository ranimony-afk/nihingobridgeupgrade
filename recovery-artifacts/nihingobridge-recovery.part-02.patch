+#!/usr/bin/env python3
+"""Pinned, local-only OpenJLPT v0.2.0 grammar acquisition and ETL.
+
+This tool writes only to data/k014/openjlpt/v0.2.0 (ignored by Git under the
+repository's existing /data/ convention). It never writes to a database, CMS,
+application source, canonical seed or public/learner artifact.
+"""
+from __future__ import annotations
+
+import argparse
+import base64
+import hashlib
+import json
+import os
+import sys
+import unicodedata
+import urllib.parse
+import urllib.request
+from collections import Counter
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+DATA_ROOT = REPO_ROOT / "data" / "k014" / "openjlpt" / "v0.2.0"
+RAW_ROOT = DATA_ROOT / "source"
+BUILD_ROOT = DATA_ROOT / "build"
+REPOSITORY = "evanclan/OpenJLPT"
+RELEASE = "v0.2.0"
+COMMIT = "c42fd9fa3777bfc1775446f7c418d549dfd6e4cf"
