@@ -0,0 +1,292 @@
+import { describe, expect, it, vi } from "vitest";
+import {
+  appendRightsEvent,
+  createOwnerClearanceEvents,
+  RIGHTS_POLICY_VERSION,
+  type RightsHistoryEvent,
+} from "@/services/knowledge/provenance/rightsPolicy";
+import {
+  KANJI_MEMBERSHIP_SCHEMA,
+  type KanjiMembershipEvent,
+} from "@/services/knowledge/editorial/kanjiMembership";
+import {
+  assertKanjiDeliveryAllowedBySnapshot,
+  decideKanjiDeliveryFromSnapshot,
+  digestKanjiDeliveryPolicySnapshot,
+  KANJI_DELIVERY_SNAPSHOT_SCHEMA,
+  type KanjiDeliveryPolicySnapshot,
+} from "@/lib/kanji/deliveryPolicySnapshot";
+import { PolicyVersionedCache } from "@/lib/kanji/policyVersionedCache";
+import { withPolicySnapshotResponseBoundary } from "@/lib/api/rightsRestrictedResponse";
+import { noStoreJsonResponse } from "@/lib/api/noStoreJsonResponse";
+import { GET as getPolicyVersion } from "@/app/api/kanji/policy-version/route";
+
+const TEST_SOURCE = "first-party:test-only-synthetic-kanji";
+const TEST_CHARACTER = "\uE000"; // Private-use identity; not a source Kanji fixture.
+const TEST_EDITORIAL_ID = "test-only-synthetic-editorial";
+const SHA = "a".repeat(64);
+const SOURCES = [TEST_SOURCE] as const;
+
+function allowedRightsHistory(): RightsHistoryEvent[] {
+  return createOwnerClearanceEvents({
+    sourceRef: TEST_SOURCE,
+    eventIdPrefix: "test-only:synthetic-rights",
+    recordedOn: "2026-11-02",
+    ownerAuthorizationRef: "test-only:synthetic-authorization",
+    ownerAuthorizationSha256: SHA,
+  });
+}
+
+function membershipHistory(state: "published" | "withdrawn" = "published"): KanjiMembershipEvent[] {
+  const base: KanjiMembershipEvent = {
+    schemaVersion: KANJI_MEMBERSHIP_SCHEMA,
+    eventId: "test-only:membership:candidate",
+    identityId: "test-only:identity",
+    exactCharacter: TEST_CHARACTER,
+    goal: "general_reading_coverage",
+    state: "candidate",
+    sequence: 1,
+    previousEventId: null,
+    sourceAssertionIds: ["test-only:assertion"],
+    sourceRefs: [TEST_SOURCE],
+    decisionEvidenceRef: "test-only:membership-evidence",
+    decisionAuthority: "test-only:synthetic-authority",
+    decisionTrust: "authenticated_external",
+    authenticationEvidenceRef: "test-only:synthetic-authentication",
+    authenticationEvidenceSha256: SHA,
+  };
+  const approved = { ...base, eventId: "test-only:membership:approved", state: "approved" as const, sequence: 2, previousEventId: base.eventId };
+  const published = { ...base, eventId: "test-only:membership:published", state: "published" as const, sequence: 3, previousEventId: approved.eventId };
+  if (state === "published") return [base, approved, published];
+  return [base, approved, published, {
+    ...base,
+    eventId: "test-only:membership:withdrawn",
+    state: "withdrawn",
+    sequence: 4,
+    previousEventId: published.eventId,
+  }];
+}
+
+function allowedSnapshot(): KanjiDeliveryPolicySnapshot {
+  return {
+    schemaVersion: KANJI_DELIVERY_SNAPSHOT_SCHEMA,
+    rightsPolicyVersion: RIGHTS_POLICY_VERSION,
+    membershipSchemaVersion: KANJI_MEMBERSHIP_SCHEMA,
+    sourceVersions: ["test-only:synthetic-source@1"],
+    sourceSets: [{ name: "synthetic-test-only", sourceRefs: SOURCES }],
+    rightsHistory: allowedRightsHistory(),
+    membershipHistory: membershipHistory(),
+    membershipEvidenceVerified: true,
+    editorialReleaseAuthorizationVerified: true,
+    editorialRecords: [{
+      id: TEST_EDITORIAL_ID,
+      character: TEST_CHARACTER,
+      version: 1,
+      origin: "editorial",
+      editorialStatus: "published",
+      provenanceRef: TEST_SOURCE,
+      sourceReferences: SOURCES,
+      reviewerId: "test-only:synthetic-reviewer",
+      reviewedAt: "2026-11-02T00:00:00.000Z",
+      publishedAt: "2026-11-02T00:00:00.000Z",
+      revisionDigest: SHA,
+    }],
+  };
+}
+
+function blockedRightsSnapshot(snapshot: KanjiDeliveryPolicySnapshot): KanjiDeliveryPolicySnapshot {
+  const rightsHistory = appendRightsEvent(snapshot.rightsHistory, {
+    eventId: "test-only:synthetic-rights:public-distribution-revoked",
+    sourceRef: TEST_SOURCE,
+    scope: "public_distribution",
+    state: "BLOCKED",
+    recordedOn: "2026-11-02",
+    actor: "test-only:synthetic-transition",
+    rationale: "Synthetic rights transition for policy/cache boundary testing only.",
+    evidenceRef: "test-only:synthetic-transition-evidence",
+    evidenceClass: "project_gate_record",
+    evidenceSha256: null,
+  });
+  return { ...snapshot, rightsHistory };
+}
+
+describe("K0.7B trusted policy snapshot and cache coherence", () => {
+  it("publishes only an opaque no-store policy fingerprint and keeps successful JSON responses no-store", async () => {
+    const status = getPolicyVersion();
+    expect(status.status).toBe(200);
+    expect(status.headers.get("Cache-Control")).toBe("no-store");
+    const payload = await status.json();
+    expect(payload).toEqual({ version: expect.stringMatching(/^[0-9a-f]{64}$/) });
+    expect(JSON.stringify(payload)).not.toMatch(/sourceRef|KANJIDIC2|KanjiVG|public_distribution|rightsHistory/i);
+
+    const success = noStoreJsonResponse({ success: true, data: "synthetic fixture" });
+    expect(success.headers.get("Cache-Control")).toBe("no-store");
+  });
+
+  it("derives cache policy identity from rights, membership, editorial, and pinned source-version inputs", () => {
+    const initial = allowedSnapshot();
+    const digest = digestKanjiDeliveryPolicySnapshot(initial);
+    expect(digest).toMatch(/^[0-9a-f]{64}$/);
+    expect(digestKanjiDeliveryPolicySnapshot({ ...initial, rightsHistory: blockedRightsSnapshot(initial).rightsHistory })).not.toBe(digest);
+    expect(digestKanjiDeliveryPolicySnapshot({ ...initial, membershipHistory: membershipHistory("withdrawn") })).not.toBe(digest);
+    expect(digestKanjiDeliveryPolicySnapshot({
+      ...initial,
+      editorialRecords: [{ ...initial.editorialRecords[0], version: 2, revisionDigest: "b".repeat(64) }],
+    })).not.toBe(digest);
+    expect(digestKanjiDeliveryPolicySnapshot({ ...initial, sourceVersions: ["test-only:synthetic-source@2"] })).not.toBe(digest);
+  });
+
+  it("fails closed when a trusted snapshot is unknown or malformed", async () => {
+    const initial = allowedSnapshot();
+    const unknown = { ...initial, rightsPolicyVersion: "unknown-policy-version" } as unknown as KanjiDeliveryPolicySnapshot;
+    expect(decideKanjiDeliveryFromSnapshot(unknown, SOURCES, TEST_CHARACTER).allowed).toBe(false);
+    expect(() => digestKanjiDeliveryPolicySnapshot(unknown)).toThrow("Kanji content is temporarily unavailable.");
+
+    const handler = vi.fn(async () => new Response("must not run", { status: 200 }));
+    const gated = withPolicySnapshotResponseBoundary({
+      handler,
+      resolveSnapshot: () => unknown,
+      sourceRefs: SOURCES,
+      character: TEST_CHARACTER,
+    });
+    const response = await gated();
+    expect(response.status).toBe(451);
+    expect(response.headers.get("Cache-Control")).toBe("no-store");
+    expect(handler).not.toHaveBeenCalled();
+  });
+
+  it("rekeys a warm synthetic cache on trusted policy changes and denies before any warm value can escape", () => {
+    let snapshot = allowedSnapshot();
+    const cache = new PolicyVersionedCache<string>(4);
+    let loads = 0;
+    const authorize = () => assertKanjiDeliveryAllowedBySnapshot(snapshot, SOURCES, TEST_CHARACTER);
+    const firstPolicyVersion = digestKanjiDeliveryPolicySnapshot(snapshot);
+    const first = cache.getOrLoad({
+      key: "synthetic-result",
+      policyVersion: firstPolicyVersion,
+      sourceVersion: "test-only:synthetic-source@1",
+      resolvePolicyVersion: () => digestKanjiDeliveryPolicySnapshot(snapshot),
+      authorize,
+      load: () => `value-${++loads}`,
+    });
+    expect(first).toBe("value-1");
+    expect(cache.getOrLoad({
+      key: "synthetic-result",
+      policyVersion: firstPolicyVersion,
+      sourceVersion: "test-only:synthetic-source@1",
+      resolvePolicyVersion: () => digestKanjiDeliveryPolicySnapshot(snapshot),
+      authorize,
+      load: () => `value-${++loads}`,
+    })).toBe("value-1");
+    expect(loads).toBe(1);
+    expect(cache.getOrLoad({
+      key: "synthetic-result",
+      policyVersion: firstPolicyVersion,
+      sourceVersion: "test-only:synthetic-source@2",
+      resolvePolicyVersion: () => digestKanjiDeliveryPolicySnapshot(snapshot),
+      authorize,
+      load: () => `value-${++loads}`,
+    })).toBe("value-2");
+    expect(loads).toBe(2);
+
+    // An editorial revision that remains deliverable still changes cache identity.
+    snapshot = {
+      ...snapshot,
+      editorialRecords: [{ ...snapshot.editorialRecords[0], version: 2, revisionDigest: "b".repeat(64) }],
+    };
+    const revisedPolicyVersion = digestKanjiDeliveryPolicySnapshot(snapshot);
+    expect(revisedPolicyVersion).not.toBe(firstPolicyVersion);
+    expect(() => cache.getOrLoad({
+      key: "synthetic-result",
+      policyVersion: firstPolicyVersion,
+      sourceVersion: "test-only:synthetic-source@1",
+      resolvePolicyVersion: () => digestKanjiDeliveryPolicySnapshot(snapshot),
+      authorize: () => assertKanjiDeliveryAllowedBySnapshot(snapshot, SOURCES, TEST_CHARACTER),
+      load: () => `stale-${++loads}`,
+    })).toThrow("Kanji content is temporarily unavailable.");
+    expect(loads).toBe(2);
+    expect(cache.getOrLoad({
+      key: "synthetic-result",
+      policyVersion: revisedPolicyVersion,
+      sourceVersion: "test-only:synthetic-source@1",
+      resolvePolicyVersion: () => digestKanjiDeliveryPolicySnapshot(snapshot),
+      authorize: () => assertKanjiDeliveryAllowedBySnapshot(snapshot, SOURCES, TEST_CHARACTER),
+      load: () => `value-${++loads}`,
+    })).toBe("value-3");
+    expect(loads).toBe(3);
+
+    // Append-only synthetic rights transition; no historical or production record is edited.
+    snapshot = blockedRightsSnapshot(snapshot);
+    expect(() => cache.getOrLoad({
+      key: "synthetic-result",
+      policyVersion: digestKanjiDeliveryPolicySnapshot(snapshot),
+      sourceVersion: "test-only:synthetic-source@1",
+      resolvePolicyVersion: () => digestKanjiDeliveryPolicySnapshot(snapshot),
+      authorize: () => assertKanjiDeliveryAllowedBySnapshot(snapshot, SOURCES, TEST_CHARACTER),
+      load: () => `value-${++loads}`,
+    })).toThrow("Kanji content is temporarily unavailable.");
+    expect(loads).toBe(3);
+  });
+
+  it("enforces an append-only membership withdrawal and an editorial publication transition at the same decision boundary", () => {
+    const initial = allowedSnapshot();
+    expect(decideKanjiDeliveryFromSnapshot(initial, SOURCES, TEST_CHARACTER, TEST_EDITORIAL_ID).allowed).toBe(true);
+
+    const withdrawn = { ...initial, membershipHistory: membershipHistory("withdrawn") };
+    expect(decideKanjiDeliveryFromSnapshot(withdrawn, SOURCES, TEST_CHARACTER, TEST_EDITORIAL_ID).allowed).toBe(false);
+
+    const editorialReview = {
+      ...initial,
+      editorialRecords: [{ ...initial.editorialRecords[0], editorialStatus: "review" }],
+    };
+    expect(decideKanjiDeliveryFromSnapshot(editorialReview, SOURCES, TEST_CHARACTER, TEST_EDITORIAL_ID).allowed).toBe(false);
+  });
+
+  it("uses the production response boundary for allowed-to-blocked transitions and returns generic no-store 451", async () => {
+    let snapshot = allowedSnapshot();
+    const handler = vi.fn(async () => new Response("synthetic-only payload", { status: 200 }));
+    const gated = withPolicySnapshotResponseBoundary({
+      handler,
+      resolveSnapshot: () => snapshot,
+      sourceRefs: SOURCES,
+      character: TEST_CHARACTER,
+      editorialRecordId: TEST_EDITORIAL_ID,
+    });
+
+    const first = await gated();
+    expect(first.status).toBe(200);
+    expect(first.headers.get("Cache-Control")).toBe("no-store");
+    expect(await first.text()).toBe("synthetic-only payload");
+    expect(handler).toHaveBeenCalledTimes(1);
+
+    snapshot = blockedRightsSnapshot(snapshot);
+    const afterRightsTransition = await gated();
+    expect(afterRightsTransition.status).toBe(451);
+    expect(afterRightsTransition.headers.get("Cache-Control")).toBe("no-store");
+    const blockedBody = await afterRightsTransition.text();
+    expect(blockedBody).toContain("CONTENT_UNAVAILABLE");
+    expect(blockedBody).not.toMatch(/test-only|synthetic-rights|public_distribution|sourceRef/i);
+    expect(handler).toHaveBeenCalledTimes(1);
+  });
+
+  it("discards in-flight output if editorial policy changes before the read completes", async () => {
+    let snapshot = allowedSnapshot();
+    const gated = withPolicySnapshotResponseBoundary({
+      resolveSnapshot: () => snapshot,
+      sourceRefs: SOURCES,
+      character: TEST_CHARACTER,
+      editorialRecordId: TEST_EDITORIAL_ID,
+      handler: async () => {
+        snapshot = {
+          ...snapshot,
+          editorialRecords: [{ ...snapshot.editorialRecords[0], editorialStatus: "review" }],
+        };
+        return new Response("must not escape", { status: 200 });
+      },
+    });
+    const response = await gated();
+    expect(response.status).toBe(451);
+    expect(response.headers.get("Cache-Control")).toBe("no-store");
+    expect(await response.text()).not.toContain("must not escape");
+  });
+});
