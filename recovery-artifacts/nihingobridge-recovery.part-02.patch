+++ b/scripts/verify-k011-readiness.py
@@ -0,0 +1,372 @@
+#!/usr/bin/env python3
+"""Read-only consistency verifier for the K0.11 readiness evidence.
+
+This checks evidence identity and report arithmetic only. It does not inspect
+source corpora, determine legal permission, or turn technical capability into
+authorization. It writes nothing and fails closed on unknown vocabulary.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import sys
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+REPORT = Path("reports/gates/PHASE-K0.11-SOURCE-AUTHORIZATION-READINESS.json")
+K010_JSON = Path("reports/gates/PHASE-K0.10-CANDIDATE-PATH-DECISIONS.json")
+K010_REPORT = Path("reports/gates/PHASE-K0.10-CANDIDATE-PATH-VERIFICATION.md")
+RIGHTS_STATES = {"UNKNOWN", "BLOCKED", "CONDITIONAL"}
+RIGHTS_SCOPES = {"retention", "internal_analysis", "derivation", "public_distribution"}
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _canonical(value: Any) -> str:
+    """Match canonicalFoundationJson's recursively sorted object keys."""
+    if value is None or isinstance(value, (str, bool, int, float)):
+        return json.dumps(value, ensure_ascii=False, separators=(",", ":"))
+    if isinstance(value, list):
+        return "[" + ",".join(_canonical(item) for item in value) + "]"
+    if isinstance(value, dict):
+        return "{" + ",".join(
+            json.dumps(key, ensure_ascii=False) + ":" + _canonical(value[key])
+            for key in sorted(value)
+        ) + "}"
+    raise TypeError(f"unsupported canonical JSON value: {type(value).__name__}")
+
+
+def _check_pointer(path: Path, expected: dict[str, Any], errors: list[str]) -> None:
+    try:
+        text = path.read_text(encoding="ascii")
+    except (OSError, UnicodeError) as exc:
+        errors.append(f"Tatoeba pointer unavailable/unreadable: {path}: {exc}")
+        return
+    match = re.fullmatch(
+        r"version https://git-lfs.github.com/spec/v1\n"
+        r"oid sha256:([0-9a-f]{64})\nsize ([0-9]+)\n?",
+        text,
+    )
+    if not match:
+        errors.append(f"Tatoeba path is not an expected LFS pointer; fail closed: {path}")
+        return
+    if path.stat().st_size != expected.get("pointerFileBytes"):
+        errors.append(f"Tatoeba pointer byte count changed: {path}")
+    if _sha256(path) != expected.get("pointerFileSha256"):
+        errors.append(f"Tatoeba pointer-file hash changed: {path}")
+    if match.group(1) != expected.get("declaredLfsObjectSha256"):
+        errors.append(f"Tatoeba declared LFS OID changed: {path}")
+    if int(match.group(2)) != expected.get("declaredArchiveBytes"):
+        errors.append(f"Tatoeba declared LFS size changed: {path}")
+    if expected.get("objectBytesPresent") is not False:
+        errors.append(f"Tatoeba evidence must not represent pointer metadata as corpus bytes: {path}")
+
+
+def audit_report(report: dict[str, Any], root: Path = ROOT) -> list[str]:
+    """Return consistency errors; never resolves or grants rights."""
+    errors: list[str] = []
+    if report.get("schemaVersion") != "nihongobridge-k011-source-authorization-provenance-readiness@1":
+        errors.append("unsupported K0.11 report schema")
+    if report.get("verdict") != "BLOCKED":
+        errors.append("K0.11 verdict must remain BLOCKED for this evidence set")
+
+    boundary = report.get("authorityBoundary", {})
+    for flag in (
+        "rightsClearanceCreated",
+        "ownerDecisionChanged",
+        "sourceLockChanged",
+        "legalPermissionInferred",
+        "commercialReusePermissionEstablished",
+        "manualApprovalFlagAccepted",
+        "syntheticEvidenceRepresentedAsAuthentic",
+        "sourceCorpusContentParsedInK011",
+        "workbookCellsRead",
+        "tatoebaLfsObjectsFetchedOrUnpacked",
+        "databaseOrCmsAccessed",
+        "publicDeliveryOrPublication",
+    ):
+        if boundary.get(flag) is not False:
+            errors.append(f"authority boundary must keep {flag}=false")
+    if set(boundary.get("onlyExistingRightsVocabulary", [])) != RIGHTS_STATES:
+        errors.append("report rights vocabulary must be the conservative existing UNKNOWN/BLOCKED/CONDITIONAL subset")
+    if boundary.get("localWorkbookByteIdentityHashComputed") is not True:
+        errors.append("workbook byte-identity hashing must be disclosed without parsing cells")
+
+    # Hash pins must still identify the exact evidence files listed in the report.
+    evidence = report.get("evidenceFiles", {})
+    for rel, observed in evidence.items():
+        path = root / rel
+        if not path.is_file():
+            errors.append(f"evidence file missing: {rel}")
+            continue
+        if path.stat().st_size != observed.get("bytes") or _sha256(path) != observed.get("sha256"):
+            errors.append(f"evidence hash/size mismatch: {rel}")
+
+    # Require complete lock and runtime-registry coverage without treating the
+    # runtime registry's operational status as a permission decision.
+    try:
+        lock = json.loads((root / "reports/gates/PHASE-K0.4A-2501-KANJI-SOURCE-LOCK.json").read_text())
+        lock_by_id = {entry["sourceId"]: entry for entry in lock["sources"]}
+        lock_ids = set(lock_by_id)
+    except (OSError, ValueError, KeyError, TypeError) as exc:
+        errors.append(f"cannot read source-lock identity list: {exc}")
+        lock_by_id = {}
+        lock_ids = set()
+    policy_path = root / "src/services/knowledge/provenance/rightsPolicy.ts"
+    try:
+        policy_text = policy_path.read_text()
+        initial_rights: dict[str, dict[str, str]] = {}
+        for match in re.finditer(r'baseline\("([^"]+)"\s*,\s*\{([^}]*)\}', policy_text):
+            states = dict(re.findall(
+                r'"?(retention|internal_analysis|derivation|public_distribution)"?\s*:\s*"(UNKNOWN|BLOCKED|CONDITIONAL|CLEARED)"',
+                match.group(2),
+            ))
+            if states:
+                initial_rights[match.group(1)] = states
+    except OSError as exc:
+        errors.append(f"cannot read K0.5A initial rights baseline: {exc}")
+        initial_rights = {}
+    registry_path = root / "src/services/knowledge/provenance/registry.ts"
+    try:
+        registry_text = registry_path.read_text()
+        registry_ids = set(re.findall(
+            r'^\s{2}"((?:upstream|first-party|local|candidate|editorial):[^\"]+)"\s*:\s*\{',
+            registry_text,
+            re.MULTILINE,
+        ))
+    except OSError as exc:
+        errors.append(f"cannot read runtime registry identities: {exc}")
+        registry_ids = set()
+
+    entries = report.get("sourceInventory", [])
+    source_ids = [entry.get("sourceId") for entry in entries]
+    if len(source_ids) != len(set(source_ids)):
+        errors.append("source inventory contains duplicate source IDs")
+    by_id = {entry.get("sourceId"): entry for entry in entries}
+    if not lock_ids.issubset(by_id):
+        errors.append("source inventory omits one or more K0.4A source-lock IDs")
+    if not registry_ids.issubset(by_id):
+        errors.append("source inventory omits one or more runtime registry IDs")
+    counts = report.get("registeredSourceCounts", {})
+    if counts.get("k04aSourceLock") != len(lock_ids):
+        errors.append("K0.4A source count does not match current source lock")
+    if counts.get("runtimeRegistry") != len(registry_ids):
+        errors.append("runtime registry source count does not match current registry")
+    if set(counts.get("runtimeRegistryIds", [])) != registry_ids:
+        errors.append("runtime registry ID list does not match current registry")
+    for sid in lock_ids:
+        if by_id.get(sid, {}).get("registration", {}).get("sourceLock") != "K0.4A":
+            errors.append(f"source-lock origin is not recorded for {sid}")
+    for sid in registry_ids:
+        if by_id.get(sid, {}).get("registration", {}).get("runtimeRegistry") is not True:
+            errors.append(f"runtime-registry origin is not recorded for {sid}")
+    for sid, locked in lock_by_id.items():
+        entry = by_id.get(sid, {})
+        if entry.get("sourceName") != locked.get("sourceName"):
+            errors.append(f"source name differs from K0.4A lock for {sid}")
+        if entry.get("rights", {}).get("sourceLockClearanceState") != locked.get("clearanceState", "UNKNOWN"):
+            errors.append(f"source-lock clearance state differs for {sid}")
+    for sid, entry in by_id.items():
+        expected_states = initial_rights.get(sid, {
+            "retention": "UNKNOWN",
+            "internal_analysis": "UNKNOWN",
+            "derivation": "UNKNOWN",
+            "public_distribution": "UNKNOWN",
+        })
+        if entry.get("rights", {}).get("scopeStates") != expected_states:
+            errors.append(f"scope states do not match K0.5A initial baseline/default for {sid}")
+
+    # Rights state is intentionally fail-closed in this readiness artifact:
+    # no manually typed APPROVED/CLEARED state can pass as clearance.
+    for entry in entries:
+        rights = entry.get("rights", {})
+        scopes = rights.get("scopeStates", {})
+        if set(scopes) != RIGHTS_SCOPES:
+            errors.append(f"rights scopes missing/extra for {entry.get('sourceId')}")
+        for scope, state in scopes.items():
+            if state not in RIGHTS_STATES:
+                errors.append(f"invalid or permissive rights state {state!r} for {entry.get('sourceId')}:{scope}")
+        if rights.get("evidenceIsNotClearance") is not True:
+            errors.append(f"rights evidence boundary missing for {entry.get('sourceId')}")
+        if entry.get("technicalCapability", {}).get("sourceCorpusBytesInspectedInK011") is not False:
+            errors.append(f"source corpus content inspection must remain false for {entry.get('sourceId')}")
+    for row in report.get("fieldAuthorizationMatrix", []):
+        if row.get("authorizationState") not in RIGHTS_STATES:
+            errors.append(f"invalid or permissive field authorization state for {row.get('fieldFamily')}")
+        for scope, state in row.get("rightsByScope", {}).items():
+            if scope not in RIGHTS_SCOPES or state not in RIGHTS_STATES:
+                errors.append(f"invalid field rights state for {row.get('fieldFamily')}:{scope}")
+
+    # Recompute K0.10 machine evidence arithmetic and per-run canonical hashes.
+    try:
+        k010 = json.loads((root / K010_JSON).read_text())
+    except (OSError, ValueError) as exc:
+        errors.append(f"cannot read K0.10 machine evidence: {exc}")
+        k010 = {}
+    rec = report.get("k010Reconciliation", {})
+    if k010.get("evidenceType") != "SYNTHETIC_SOFTWARE_PATH_ONLY" or k010.get("sourceUsed") is not None:
+        errors.append("K0.10 evidence is not safely labeled as synthetic-only/no authentic source")
+    if rec.get("jsonEvidenceType") != k010.get("evidenceType") or rec.get("sourceUsed") != k010.get("sourceUsed"):
+        errors.append("K0.10 source/synthetic labeling does not match source evidence")
+    declared_runs = rec.get("runs", {})
+    if set(declared_runs) != set(k010.get("runs", {})):
+        errors.append("K0.10 run inventory does not match source evidence")
+    for name, run in k010.get("runs", {}).items():
+        decisions = run.get("decisions", [])
+        recomputed_reasons: dict[str, int] = {}
+        outcome_counts: dict[str, int] = {}
+        for decision in decisions:
+            reason = decision.get("reasonCode")
+            outcome = decision.get("outcome")
+            recomputed_reasons[reason] = recomputed_reasons.get(reason, 0) + 1
+            outcome_counts[outcome] = outcome_counts.get(outcome, 0) + 1
+        body = dict(run)
+        claimed_internal_hash = body.pop("internalReportSha256", None)
+        actual_internal_hash = hashlib.sha256(_canonical(body).encode("utf-8")).hexdigest()
+        counts_obj = run.get("counts", {})
+        counted = {
+            "evaluated": sum(v for k, v in outcome_counts.items() if k != "NOT_EVALUATED"),
+            "eligible": outcome_counts.get("ELIGIBLE_FOR_PUBLIC_PROJECTION", 0),
+            "rejected": outcome_counts.get("REJECTED", 0),
+            "blocked": sum(outcome_counts.get(x, 0) for x in ("BLOCKED_RIGHTS", "BLOCKED_PROVENANCE", "BLOCKED_HUMAN_REVIEW")),
+            "blockedRights": outcome_counts.get("BLOCKED_RIGHTS", 0),
+            "blockedProvenance": outcome_counts.get("BLOCKED_PROVENANCE", 0),
+            "blockedHumanReview": outcome_counts.get("BLOCKED_HUMAN_REVIEW", 0),
+            "invalid": outcome_counts.get("INVALID_INPUT", 0),
+            "notEvaluated": outcome_counts.get("NOT_EVALUATED", 0),
+            "withheld": len(decisions) - outcome_counts.get("ELIGIBLE_FOR_PUBLIC_PROJECTION", 0),
+        }
+        if counts_obj != counted:
+            errors.append(f"K0.10 outcome counts mismatch in {name}")
+        discovery = run.get("discovery", {})
+        if discovery.get("suppliedItems") != len(decisions):
+            errors.append(f"K0.10 supplied item/decision count mismatch in {name}")
+        if sum(discovery.get(key, 0) for key in ("identityItems", "fieldItems", "unknownKindItems")) != discovery.get("suppliedItems"):
+            errors.append(f"K0.10 input kind counts mismatch in {name}")
+        if run.get("reasonCounts") != dict(sorted(recomputed_reasons.items())):
+            errors.append(f"K0.10 reason totals mismatch in {name}")
+        if claimed_internal_hash != actual_internal_hash:
+            errors.append(f"K0.10 canonical internal-report hash mismatch in {name}")
+        recorded = declared_runs.get(name, {})
+        if recorded.get("counts") != counts_obj or recorded.get("computedReasonCounts") != dict(sorted(recomputed_reasons.items())):
+            errors.append(f"K0.11 K0.10 reconciliation summary mismatch in {name}")
+        if recorded.get("reasonCountsMatch") is not True or recorded.get("decisionCountMatches") is not True or recorded.get("internalReportSha256Matches") is not True:
+            errors.append(f"K0.11 does not record all K0.10 consistency checks as passing in {name}")
+        for key in ("input", "learnerArtifact"):
+            digest = run.get(key, {}).get("sha256", "")
+            if not re.fullmatch(r"[0-9a-f]{64}", digest):
+                errors.append(f"K0.10 {key} hash is not valid SHA-256 shape in {name}")
+        if recorded.get("exactInputAndArtifactBytesRetained") is not False:
+            errors.append(f"K0.10 transient input/artifact limitation is not disclosed in {name}")
+
+    determinism = k010.get("determinism", {})
+    if rec.get("determinismEvidence") != determinism:
+        errors.append("K0.10 determinism evidence does not match the machine JSON")
+    for key in ("repeatedNonEmptyInput", "identicalInternalReports", "identicalLearnerArtifacts"):
+        if determinism.get(key) is not True:
+            errors.append(f"K0.10 historical non-empty determinism assertion is not true: {key}")
+    if rec.get("allRecordedCountsReasonTotalsAndInternalReportHashesReconcile") is not True:
+        errors.append("K0.10 reconciliation summary does not record successful arithmetic/hash checks")
+    expected_hashes = rec.get("preservedHistoricalHashes", {})
+    for key, rel, json_key in (
+        ("k04aSourceLockSha256", Path("reports/gates/PHASE-K0.4A-2501-KANJI-SOURCE-LOCK.json"), "k04aSourceLockSha256"),
+        ("k08OwnerDecisionSha256", Path("reports/gates/PHASE-K0.8-OWNER-SOURCE-AND-PROVENANCE-DECISIONS.json"), "k08OwnerDecisionSha256"),
+    ):
+        actual = _sha256(root / rel) if (root / rel).is_file() else None
+        if actual is None or expected_hashes.get(key, {}).get("current") != actual or expected_hashes.get(key, {}).get("recorded") != k010.get("preservedGateHashes", {}).get(json_key) or expected_hashes.get(key, {}).get("matches") is not True:
+            errors.append(f"preserved K0.10 historical hash mismatch: {key}")
+
+    outputs = rec.get("outputArtifactHashes", {})
+    narrative_path = root / K010_REPORT
+    if narrative_path.is_file() and outputs.get("reportSha256") != _sha256(narrative_path):
+        errors.append("K0.10 narrative report hash mismatch")
+    if (root / K010_JSON).is_file() and outputs.get("decisionJsonSha256") != _sha256(root / K010_JSON):
+        errors.append("K0.10 machine evidence hash mismatch")
+
+    # Reconcile every numeric cell in the historical K0.10 Markdown run table
+    # against its JSON run, rather than trusting either representation alone.
+    if narrative_path.is_file():
+        rows_by_label: dict[str, list[str]] = {}
+        for line in narrative_path.read_text(encoding="utf-8").splitlines():
+            if not line.lstrip().startswith("|"):
+                continue
+            cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
+            if len(cells) >= 10:
+                rows_by_label[cells[0]] = cells
+        for run_name, summary in declared_runs.items():
+            label = summary.get("narrativeRowLabel")
+            cells = rows_by_label.get(label)
+            if not cells:
+                errors.append(f"K0.10 narrative run row missing: {label}")
+                continue
+            run = k010.get("runs", {}).get(run_name, {})
+            discovery = run.get("discovery", {})
+            counts_obj = run.get("counts", {})
+            item_match = re.fullmatch(r"([0-9]+) \(([0-9]+) / ([0-9]+) / ([0-9]+)\)", cells[1])
+            if not item_match:
+                errors.append(f"K0.10 narrative item-kind cell malformed: {label}")
+                continue
+            item_values = tuple(int(value) for value in item_match.groups())
+            expected_items = (
+                discovery.get("suppliedItems"),
+                discovery.get("identityItems"),
+                discovery.get("fieldItems"),
+                discovery.get("unknownKindItems"),
+            )
+            if item_values != expected_items:
+                errors.append(f"K0.10 narrative supplied/kind counts differ from JSON: {label}")
+            narrative_count_keys = ("evaluated", "eligible", "blockedRights", "blockedProvenance", "blockedHumanReview", "invalid", "notEvaluated")
+            try:
+                values = tuple(int(cells[index]) for index in range(2, 9))
+            except (ValueError, IndexError):
+                errors.append(f"K0.10 narrative count cells malformed: {label}")
+                continue
+            if values != tuple(counts_obj.get(key) for key in narrative_count_keys):
+                errors.append(f"K0.10 narrative decision counts differ from JSON: {label}")
+
+    # Verify only workbook byte identity (never parse OOXML cells) and the LFS
+    # pointer text. LFS object OIDs/sizes are declarations, not archive hashes.
+    workbook = report.get("localArtifactAvailability", {}).get("radicalsWorkbook", {})
+    workbook_path = root / workbook.get("path", "")
+    if not workbook_path.is_file() or workbook_path.stat().st_size != workbook.get("bytes") or _sha256(workbook_path) != workbook.get("sha256"):
+        errors.append("radicals workbook byte identity changed (cells are never opened)")
+    if workbook.get("inspection") != "Byte identity only; no cell content read in K0.11.":
+        errors.append("workbook inspection boundary is missing")
+    phase = report.get("phase14Tatoeba", {})
+    if phase.get("14.5A", {}).get("status") != "BLOCKED_ARTIFACT_BYTES_UNRETRIEVABLE":
+        errors.append("Tatoeba 14.5A must remain blocked for unavailable corpus bytes")
+    if phase.get("14.5B", {}).get("status") != "BLOCKED_PREIMPLEMENTATION_AUDIT" or phase.get("14.5B", {}).get("doNotCollapseWith14_5A") is not True:
+        errors.append("Tatoeba 14.5B must remain distinct from 14.5A")
+    pointers = {item.get("path"): item for item in phase.get("14.5A", {}).get("currentLocalPointers", [])}
+    expected_paths = {str(path.relative_to(root)) for path in (root / "data/tatoeba").glob("*.tar.bz2")}
+    if set(pointers) != expected_paths:
+        errors.append("Tatoeba pointer inventory does not match current local pointer filenames")
+    for rel, expected in pointers.items():
+        _check_pointer(root / rel, expected, errors)
+
+    return errors
+
+
+def main() -> int:
+    try:
+        report = json.loads((ROOT / REPORT).read_text(encoding="utf-8"))
+    except (OSError, ValueError) as exc:
+        print(f"K0.11 readiness verification FAILED: cannot load report: {exc}", file=sys.stderr)
+        return 2
+    errors = audit_report(report)
+    if errors:
+        print("K0.11 readiness verification FAILED (fail-closed):", file=sys.stderr)
+        for error in errors:
+            print(f"- {error}", file=sys.stderr)
+        return 2
+    print("K0.11 readiness evidence is internally consistent; gate verdict remains BLOCKED.")
+    print("No rights clearance, owner decision, or permission is produced by this verifier.")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
