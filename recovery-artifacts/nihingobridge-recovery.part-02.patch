index 0000000..390ec4d
--- /dev/null
+++ b/src/services/knowledge/provenance/rightsResolution.ts
@@ -0,0 +1,54 @@
+import {
+  currentRightsState,
+  validateRightsHistory,
+  RIGHTS_SCOPES,
+  type RightsHistoryEvent,
+  type RightsScope,
+  type RightsState,
+} from "./rightsPolicy";
+
+export interface RightsResolutionAction {
+  actionId: string;
+  action: string;
+  closureEvidence: string;
+}
+
+/** Operational checklist only; these actions do not resolve or interpret legal rights. */
+export function rightsResolutionActions(sourceRef: string, history: readonly RightsHistoryEvent[] = []): {
+  sourceRef: string;
+  currentStates: Record<RightsScope, RightsState>;
+  actions: RightsResolutionAction[];
+  effect: "no_clearance_granted";
+} {
+  const historyValid = validateRightsHistory(history).valid;
+  const currentStates = Object.fromEntries(RIGHTS_SCOPES.map((scope) => [scope, historyValid ? currentRightsState(history, sourceRef, scope) : "UNKNOWN"])) as Record<RightsScope, RightsState>;
+  const actions: RightsResolutionAction[] = [];
+  if (sourceRef === "upstream:kanjidic2:2023-08") {
+    actions.push(
+      { actionId: "K2-01", action: "Retrieve the primary EDRDG KANJIDIC2 terms and retain a dated, immutable capture with URL, response metadata and SHA-256.", closureEvidence: "Primary EDRDG page/capture plus reproducible digest; a repository notice or GitHub metadata is insufficient." },
+      { actionId: "K2-02", action: "Resolve the recorded CC BY-SA 3.0 versus CC BY-SA 4.0 conflict for this exact release with qualified rights review.", closureEvidence: "Written source/release-specific analysis citing the primary grant and applicable license version." },
+      { actionId: "K2-03", action: "Map field-level scope, exclusions and attribution for meanings, readings, stroke counts, grade/radical fields and derived frequency separately.", closureEvidence: "Field-by-field source-to-output map and exclusions confirmed against primary terms." },
+      { actionId: "K2-04", action: "Obtain a separate decision for retention, internal analysis, derivation and public distribution; do not treat a checksum as permission.", closureEvidence: "Append-only decision events for each scope, each bound to relevant evidence digests." },
+    );
+  } else if (sourceRef === "upstream:jmdict:2023-08") {
+    actions.push(
+      { actionId: "JM-01", action: "Retrieve and retain the primary EDRDG JMdict terms applicable to the pinned 2023-08 release.", closureEvidence: "Dated primary notice capture and SHA-256, not the local contract string alone." },
+      { actionId: "JM-02", action: "Resolve English gloss and separately credited translation scope, field by field, before transforming or exporting entries.", closureEvidence: "Qualified field/translation review tied to source record identifiers and fields." },
+      { actionId: "JM-03", action: "Decide retention, internal analysis, derivation and public distribution independently; record attribution/share-alike obligations.", closureEvidence: "Separate append-only scope events backed by primary terms and qualified review." },
+    );
+  } else if (sourceRef === "upstream:kanjivg:2024-08") {
+    actions.push(
+      { actionId: "KVG-01", action: "Retain the primary KanjiVG release/license notice and verify the pinned release's attribution and share-alike terms.", closureEvidence: "Primary notice capture, release identity, digest and qualified interpretation." },
+      { actionId: "KVG-02", action: "Review the already tracked bounded asset separately from any new transforms or playback output.", closureEvidence: "Scope-specific decision for existing artifact, new derivative output and public delivery." },
+      { actionId: "KVG-03", action: "Compare independently authored geometry or another source without copying KanjiVG paths or assuming equivalent coverage.", closureEvidence: "Original author/revision chain, exact asset identity and owner authorization; coverage separately measured." },
+    );
+  } else if (sourceRef.startsWith("first-party:")) {
+    actions.push(
+      { actionId: "FP-01", action: "Record the exact first-party asset/version and field-level authorship/revision history; keep it separate from all upstream assertions.", closureEvidence: "Immutable revision digest chain and field provenance references." },
+      { actionId: "FP-02", action: "Obtain explicit owner authorization for the named use scopes and any public delivery license/attribution choice.", closureEvidence: "Owner authorization artifact and SHA-256, appended per sourceRef and scope." },
+    );
+  } else {
+    actions.push({ actionId: "GEN-01", action: "Identify the exact source, release, fields and primary terms before use; leave missing evidence UNKNOWN.", closureEvidence: "Pinned source artifact, primary terms capture, field map and per-scope decision evidence." });
+  }
+  return { sourceRef, currentStates, actions, effect: "no_clearance_granted" };
+}
