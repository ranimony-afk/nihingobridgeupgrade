diff --git a/tests/dictionary-rights-delivery-gate.test.ts b/tests/dictionary-rights-delivery-gate.test.ts
new file mode 100644
index 0000000..42ad1e4
--- /dev/null
+++ b/tests/dictionary-rights-delivery-gate.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, it, vi } from "vitest";
+import type { NextRequest } from "next/server";
+
+const { searchEntries, getEntryDetail, autocomplete } = vi.hoisted(() => ({
+  searchEntries: vi.fn(),
+  getEntryDetail: vi.fn(),
+  autocomplete: vi.fn(),
+}));
+
+vi.mock("@/services/dictionary", () => ({
+  DictionaryService: { searchEntries, getEntryDetail, autocomplete, ensureInitialized: vi.fn() },
+}));
+
+import { GET as mobileSearch } from "@/app/api/v1/mobile/dictionary/search/route";
+import { GET as dictionarySearch } from "@/app/api/dictionary/search/route";
+import { GET as dictionaryCatalog } from "@/app/api/dictionary/route";
+import { GET as dictionaryDetail } from "@/app/api/dictionary/[id]/route";
+import { GET as enrichedDictionaryDetail } from "@/app/api/dictionary/entry/[id]/route";
+import { dictionaryPublicSourceRefs } from "@/lib/dictionary/publicRights";
+
+function request(path: string): NextRequest {
+  const url = new URL(path, "http://localhost");
+  return { nextUrl: url, url: url.toString(), method: "GET" } as unknown as NextRequest;
+}
+
+const params = { params: Promise.resolve({ id: "de-mizu" }) };
+
+describe("K0.5B dictionary public-delivery rights boundary", () => {
+  it("keeps the unresolved K0.5A dictionary allowlist empty", () => {
+    expect(dictionaryPublicSourceRefs()).toEqual([]);
+  });
+
+  it("returns no-store 451 from every dictionary API surface before service/database access", async () => {
+    const responses = await Promise.all([
+      mobileSearch(request("/api/v1/mobile/dictionary/search?q=mizu")),
+      dictionarySearch(request("/api/dictionary/search?q=mizu")),
+      dictionaryCatalog(request("/api/dictionary?q=mizu")),
+      dictionaryDetail(request("/api/dictionary/de-mizu"), params),
+      enrichedDictionaryDetail(request("/api/dictionary/entry/de-mizu"), params),
+    ]);
+
+    for (const response of responses) {
+      expect(response.status).toBe(451);
+      expect(response.headers.get("cache-control")).toBe("no-store");
+      expect(await response.json()).toEqual({
+        success: false,
+        error: {
+          code: "RIGHTS_RESTRICTED",
+          message: "This content is temporarily unavailable.",
+        },
+      });
+    }
+
+    expect(searchEntries).not.toHaveBeenCalled();
+    expect(getEntryDetail).not.toHaveBeenCalled();
+    expect(autocomplete).not.toHaveBeenCalled();
+  });
+
+  it("retains parameter validation precedence for malformed mobile requests", async () => {
+    const response = await mobileSearch(request("/api/v1/mobile/dictionary/search"));
+    expect(response.status).toBe(400);
+    expect(searchEntries).not.toHaveBeenCalled();
+  });
+});
