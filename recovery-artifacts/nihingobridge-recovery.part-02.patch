new file mode 100644
index 0000000..6253b9f
--- /dev/null
+++ b/src/services/knowledge/provenance/rightsEnforcement.ts
@@ -0,0 +1,57 @@
+import { getRegisteredSource, listAllRegisteredSources } from "./registry";
+import {
+  assertSourceOperationAllowed,
+  K0_5A_INITIAL_RIGHTS_HISTORY,
+  publicDistributionDecision,
+  sourceOperationDecision,
+} from "./rightsPolicy";
+import type { SourceDomain } from "./types";
+
+/**
+ * Runtime adapter for the authoritative K0.5A history. The history is deliberately
+ * immutable here: registry `active` metadata is not a clearance event, and no
+ * caller can supply an ad-hoc history to bypass this boundary.
+ */
+export function currentSourceOperationDecision(sourceRef: string) {
+  const canonicalSourceRef = getRegisteredSource(sourceRef)?.id ?? sourceRef;
+  return sourceOperationDecision(K0_5A_INITIAL_RIGHTS_HISTORY, canonicalSourceRef);
+}
+
+/** Fail closed before source reads, parsing, transformation, or persistence. */
+export function assertCurrentSourceOperationAllowed(sourceRef: string): void {
+  if (typeof sourceRef !== "string" || !sourceRef.trim()) {
+    throw new Error("[RIGHTS_GATE] Source operation denied: sourceRef is missing.");
+  }
+  const canonicalSourceRef = getRegisteredSource(sourceRef)?.id ?? sourceRef;
+  assertSourceOperationAllowed(K0_5A_INITIAL_RIGHTS_HISTORY, canonicalSourceRef);
+}
+
+/** Validate every row's exact source before any batch side effect. */
+export function assertCurrentSourceOperationsAllowed(sourceRefs: readonly (string | null | undefined)[]): void {
+  if (!sourceRefs.length) {
+    throw new Error("[RIGHTS_GATE] Source operation denied: no source provenance was supplied.");
+  }
+  for (const sourceRef of [...new Set(sourceRefs)]) {
+    assertCurrentSourceOperationAllowed(sourceRef as string);
+  }
+}
+
+/**
+ * Return only registered sources whose derivation and public-distribution scopes
+ * are both currently cleared. Unregistered and newly introduced source refs are
+ * never added implicitly; callers must use this list as a query allowlist.
+ */
+export function publiclyAllowedSourceRefs(domains: readonly SourceDomain[]): string[] {
+  const domainSet = new Set(domains);
+  return [...new Set(listAllRegisteredSources()
+    .filter((source) => domainSet.has(source.domain))
+    .map((source) => source.id))]
+    .filter((sourceRef) => publicDistributionDecision(K0_5A_INITIAL_RIGHTS_HISTORY, [sourceRef]).allowed)
+    .sort();
+}
+
+export function currentPublicDistributionDecision(sourceRefs: readonly string[]) {
+  const canonicalSourceRefs = sourceRefs.map((sourceRef) => getRegisteredSource(sourceRef)?.id ?? sourceRef);
+  return publicDistributionDecision(K0_5A_INITIAL_RIGHTS_HISTORY, canonicalSourceRefs);
+}
+
diff --git a/src/services/knowledge/provenance/rightsPolicy.ts b/src/services/knowledge/provenance/rightsPolicy.ts
new file mode 100644
index 0000000..436cbaf
--- /dev/null
+++ b/src/services/knowledge/provenance/rightsPolicy.ts
@@ -0,0 +1,272 @@
+import { createHash } from "node:crypto";
+
+/** K0.5A source- and use-specific rights contract. A state is not a legal conclusion. */
+export const RIGHTS_HISTORY_SCHEMA = "nihongobridge-source-rights-history@1" as const;
+export const RIGHTS_POLICY_VERSION = "nihongobridge-rights-policy@1" as const;
+
+export const RIGHTS_SCOPES = ["retention", "internal_analysis", "derivation", "public_distribution"] as const;
+export type RightsScope = (typeof RIGHTS_SCOPES)[number];
+export const RIGHTS_STATES = ["CLEARED", "CONDITIONAL", "BLOCKED", "UNKNOWN"] as const;
+export type RightsState = (typeof RIGHTS_STATES)[number];
+export type RightsEvidenceClass = "primary_license" | "qualified_review" | "owner_authorization" | "project_gate_record";
+
+export interface RightsHistoryEvent {
+  schemaVersion: typeof RIGHTS_HISTORY_SCHEMA;
+  eventId: string;
+  sourceRef: string;
+  scope: RightsScope;
+  sequence: number;
+  state: RightsState;
+  recordedOn: string;
+  actor: string;
+  rationale: string;
+  evidenceRef: string;
+  evidenceClass: RightsEvidenceClass;
+  evidenceSha256: string | null;
+  qualifiedReviewRef: string | null;
+  qualifiedReviewSha256: string | null;
+  previousEventDigest: string | null;
+  eventDigest: string;
+}
+
+export type RightsHistoryAppend = Omit<RightsHistoryEvent, "schemaVersion" | "sequence" | "previousEventDigest" | "eventDigest" | "qualifiedReviewRef" | "qualifiedReviewSha256"> & {
+  qualifiedReviewRef?: string | null;
+  qualifiedReviewSha256?: string | null;
+};
+
+const SHA256 = /^[0-9a-f]{64}$/u;
+const ISO_DATE = /^\d{4}-\d{2}-\d{2}$/u;
+const RIGHTS_EVENT_KEYS = [
+  "schemaVersion", "eventId", "sourceRef", "scope", "sequence", "state", "recordedOn", "actor",
+  "rationale", "evidenceRef", "evidenceClass", "evidenceSha256", "qualifiedReviewRef",
+  "qualifiedReviewSha256", "previousEventDigest", "eventDigest",
+].sort();
+
+function eventPayload(event: Omit<RightsHistoryEvent, "eventDigest">): Record<string, unknown> {
+  return {
+    schemaVersion: event.schemaVersion,
+    eventId: event.eventId,
+    sourceRef: event.sourceRef,
+    scope: event.scope,
+    sequence: event.sequence,
+    state: event.state,
+    recordedOn: event.recordedOn,
+    actor: event.actor,
+    rationale: event.rationale,
+    evidenceRef: event.evidenceRef,
+    evidenceClass: event.evidenceClass,
+    evidenceSha256: event.evidenceSha256,
+    qualifiedReviewRef: event.qualifiedReviewRef,
+    qualifiedReviewSha256: event.qualifiedReviewSha256,
+    previousEventDigest: event.previousEventDigest,
+  };
+}
+
+function digest(value: unknown): string {
+  return createHash("sha256").update(JSON.stringify(value), "utf8").digest("hex");
+}
+
+function validateAppend(input: RightsHistoryAppend): string[] {
+  const issues: string[] = [];
+  if (!input.eventId.trim() || input.eventId.length > 160) issues.push("eventId must contain 1–160 characters");
+  if (!input.sourceRef.trim() || input.sourceRef.length > 240) issues.push("sourceRef must contain 1–240 characters");
+  if (!RIGHTS_SCOPES.includes(input.scope)) issues.push("scope is unsupported");
+  if (!RIGHTS_STATES.includes(input.state)) issues.push("state is unsupported");
+  if (!ISO_DATE.test(input.recordedOn) || Number.isNaN(Date.parse(`${input.recordedOn}T00:00:00Z`))) issues.push("recordedOn must be an ISO calendar date");
+  if (!input.actor.trim() || input.actor.length > 160) issues.push("actor must contain 1–160 characters");
+  if (!input.rationale.trim() || input.rationale.length > 2_000) issues.push("rationale must contain 1–2,000 characters");
+  if (!input.evidenceRef.trim() || input.evidenceRef.length > 1_000) issues.push("evidenceRef must contain 1–1,000 characters");
+  if (!["primary_license", "qualified_review", "owner_authorization", "project_gate_record"].includes(input.evidenceClass)) issues.push("evidenceClass is unsupported");
+  if (input.evidenceSha256 !== null && !SHA256.test(input.evidenceSha256)) issues.push("evidenceSha256 must be lowercase SHA-256 or null");
+  if (input.qualifiedReviewRef != null && (typeof input.qualifiedReviewRef !== "string" || !input.qualifiedReviewRef.trim() || input.qualifiedReviewRef.length > 1_000)) issues.push("qualifiedReviewRef must be a non-empty reference or null");
+  if (input.qualifiedReviewSha256 != null && !SHA256.test(input.qualifiedReviewSha256)) issues.push("qualifiedReviewSha256 must be lowercase SHA-256 or null");
+  if ((input.qualifiedReviewRef == null) !== (input.qualifiedReviewSha256 == null)) issues.push("qualified rights review reference and digest must be supplied together");
+  if (input.state === "CLEARED") {
+    if (!input.evidenceSha256) issues.push("CLEARED requires a digest of the evidence, not a project-gate reference alone");
+    const firstParty = input.sourceRef.startsWith("first-party:");
+    if (firstParty && input.evidenceClass !== "owner_authorization") issues.push("First-party clearance requires explicit owner authorization evidence");
+    if (!firstParty && (input.evidenceClass !== "primary_license" || !input.qualifiedReviewRef || !input.qualifiedReviewSha256)) issues.push("Third-party clearance requires both primary license evidence and a separately pinned qualified rights review");
+  }
+  return issues;
+}
+
+/** Validate ordering and hash links independently for each source/scope stream. */
+export function validateRightsHistory(events: readonly RightsHistoryEvent[]): { valid: boolean; issues: string[] } {
+  const issues: string[] = [];
+  const seenIds = new Set<string>();
+  const streams = new Map<string, RightsHistoryEvent[]>();
+  for (const event of events) {
+    if (!event || event.schemaVersion !== RIGHTS_HISTORY_SCHEMA) {
+      issues.push("unsupported rights-history event schema");
+      continue;
+    }
+    if (Object.keys(event).sort().join("\u0000") !== RIGHTS_EVENT_KEYS.join("\u0000")) issues.push(`${event.eventId}: rights event has missing or unsupported fields`);
+    if (!Number.isInteger(event.sequence) || event.sequence < 1) issues.push(`${event.eventId}: sequence must be a positive integer`);
+    if (event.previousEventDigest !== null && !SHA256.test(event.previousEventDigest)) issues.push(`${event.eventId}: invalid previous-event digest`);
+    if (!SHA256.test(event.eventDigest)) issues.push(`${event.eventId}: invalid event digest`);
+    if (seenIds.has(event.eventId)) issues.push(`duplicate rights event id: ${event.eventId}`);
+    seenIds.add(event.eventId);
+    issues.push(...validateAppend(event).map((issue) => `${event.eventId}: ${issue}`));
+    const key = `${event.sourceRef}\u0000${event.scope}`;
+    const list = streams.get(key) ?? [];
+    list.push(event);
+    streams.set(key, list);
+  }
+  for (const [key, stream] of streams) {
+    stream.sort((a, b) => a.sequence - b.sequence);
+    let priorDigest: string | null = null;
+    stream.forEach((event, index) => {
+      if (event.sequence !== index + 1) issues.push(`${key}: expected sequence ${index + 1}, received ${event.sequence}`);
+      if (event.previousEventDigest !== priorDigest) issues.push(`${event.eventId}: broken previous-event hash link`);
+      const expected = digest(eventPayload(event));
+      if (event.eventDigest !== expected) issues.push(`${event.eventId}: event digest mismatch`);
+      priorDigest = event.eventDigest;
+    });
+  }
+  return { valid: issues.length === 0, issues: [...new Set(issues)].sort() };
+}
+
+/** Append-only constructor: it returns a new history and never edits prior events. */
+export function appendRightsEvent(
+  history: readonly RightsHistoryEvent[],
+  input: RightsHistoryAppend,
+): RightsHistoryEvent[] {
+  const invalid = validateAppend(input);
+  if (invalid.length) throw new Error(`Rights event rejected: ${invalid.join("; ")}`);
+  const check = validateRightsHistory(history);
+  if (!check.valid) throw new Error(`Cannot append to invalid rights history: ${check.issues.join("; ")}`);
+  if (history.some((event) => event.eventId === input.eventId)) throw new Error(`Rights event id already exists: ${input.eventId}`);
+  const stream = history.filter((event) => event.sourceRef === input.sourceRef && event.scope === input.scope)
+    .sort((a, b) => a.sequence - b.sequence);
+  const prior = stream.at(-1) ?? null;
+  const unsigned: Omit<RightsHistoryEvent, "eventDigest"> = {
+    schemaVersion: RIGHTS_HISTORY_SCHEMA,
+    ...input,
+    qualifiedReviewRef: input.qualifiedReviewRef ?? null,
+    qualifiedReviewSha256: input.qualifiedReviewSha256 ?? null,
+    sequence: (prior?.sequence ?? 0) + 1,
+    previousEventDigest: prior?.eventDigest ?? null,
+  };
+  const event: RightsHistoryEvent = { ...unsigned, eventDigest: digest(eventPayload(unsigned)) };
+  return [...history, event];
+}
+
+const GATE_REF = "reports/gates/PHASE-K0.4A-2501-KANJI-SOURCE-LOCK.json";
+const PROJECT_REVIEW = {
+  recordedOn: "2026-11-02",
+  actor: "project-gate:K0.4A",
+  evidenceRef: GATE_REF,
+  evidenceClass: "project_gate_record" as const,
+  evidenceSha256: null,
+};
+
+function baseline(sourceRef: string, states: Record<RightsScope, RightsState>, rationale: string): RightsHistoryEvent[] {
+  let result: RightsHistoryEvent[] = [];
+  for (const scope of RIGHTS_SCOPES) {
+    result = appendRightsEvent(result, {
+      ...PROJECT_REVIEW,
+      eventId: `k04a:${sourceRef}:${scope}`,
+      sourceRef,
+      scope,
+      state: states[scope],
+      rationale,
+    });
+  }
+  return result;
+}
+
+/**
+ * Immutable K0.4A carry-forward. These are project gate states, not legal findings.
+ * The omitted evidence bytes are deliberately not reconstructed or implied.
+ */
+export const K0_5A_INITIAL_RIGHTS_HISTORY: readonly RightsHistoryEvent[] = Object.freeze([
+  ...baseline("upstream:kanjidic2:2023-08", { retention: "UNKNOWN", internal_analysis: "UNKNOWN", derivation: "BLOCKED", public_distribution: "BLOCKED" }, "K0.4A: primary EDRDG terms were not obtained; rights for retention, analysis, derivation and distribution remain unresolved."),
+  ...baseline("candidate:official-joyo-table", { retention: "UNKNOWN", internal_analysis: "UNKNOWN", derivation: "BLOCKED", public_distribution: "BLOCKED" }, "K0.4A: no primary official Jōyō artifact or terms were obtained."),
+  ...baseline("candidate:official-school-kanji-curriculum", { retention: "UNKNOWN", internal_analysis: "UNKNOWN", derivation: "BLOCKED", public_distribution: "BLOCKED" }, "K0.4A: no primary school curriculum artifact or source terms were obtained."),
+  ...baseline("candidate:official-jinmeiyo-source", { retention: "UNKNOWN", internal_analysis: "UNKNOWN", derivation: "BLOCKED", public_distribution: "BLOCKED" }, "K0.4A: no official Jinmeiyō source artifact or terms were obtained."),
+  ...baseline("candidate:official-place-name-source", { retention: "UNKNOWN", internal_analysis: "UNKNOWN", derivation: "BLOCKED", public_distribution: "BLOCKED" }, "K0.4A: no authoritative place-name source artifact or terms were obtained."),
+  ...baseline("candidate:official-jlpt-kanji-membership", { retention: "UNKNOWN", internal_analysis: "UNKNOWN", derivation: "BLOCKED", public_distribution: "BLOCKED" }, "K0.4A: no primary per-character JLPT membership source was obtained; membership is not established."),
+  ...baseline("candidate:third-party-jlpt-kanji-mappings", { retention: "UNKNOWN", internal_analysis: "UNKNOWN", derivation: "BLOCKED", public_distribution: "BLOCKED" }, "K0.4A: no selected mapping list or source-specific terms were obtained."),
+  ...baseline("upstream:kanjidic2:2023-08:frequency", { retention: "UNKNOWN", internal_analysis: "UNKNOWN", derivation: "BLOCKED", public_distribution: "BLOCKED" }, "K0.4A: prior aggregate exists but no rerun or legal clearance was established; parent-source rights remain unresolved."),
+  ...baseline("upstream:tatoeba:2024-07", { retention: "UNKNOWN", internal_analysis: "UNKNOWN", derivation: "BLOCKED", public_distribution: "BLOCKED" }, "K0.4A: pointers only; no source archive or applicable snapshot terms were available."),
+  ...baseline("local:kanji-radicals-workbook:sha256-cb9cebec9ef8b866c5fb5eb7c9509f1e57f2ce16394182feae3ab3afd09adba1", { retention: "UNKNOWN", internal_analysis: "UNKNOWN", derivation: "BLOCKED", public_distribution: "BLOCKED" }, "K0.4A: metadata only; worksheet cells were not extracted and origin/rights remain unknown."),
+  ...baseline("candidate:specialist-advanced-reference", { retention: "UNKNOWN", internal_analysis: "UNKNOWN", derivation: "BLOCKED", public_distribution: "BLOCKED" }, "K0.4A: no named specialist source or primary terms were pinned."),
+  ...baseline("derived:kanjidic2-facts-slice:m3",  { retention: "CONDITIONAL", internal_analysis: "CONDITIONAL", derivation: "BLOCKED", public_distribution: "BLOCKED" }, "K0.4A: existing tracked artifact only; no new derivation or distribution authorized while parent-source rights are unresolved."),
+  ...baseline("upstream:jmdict:2023-08", { retention: "UNKNOWN", internal_analysis: "UNKNOWN", derivation: "CONDITIONAL", public_distribution: "BLOCKED" }, "K0.4A: source-specific primary terms and field review remain pending; no public distribution authorized."),
+  ...baseline("upstream:kanjivg:2024-08", { retention: "CONDITIONAL", internal_analysis: "CONDITIONAL", derivation: "CONDITIONAL", public_distribution: "BLOCKED" }, "K0.4A: existing bounded artifact has conditional evidence; new output distribution remains blocked pending source review."),
+  ...baseline("first-party:kanji-mindtree:v1", { retention: "CONDITIONAL", internal_analysis: "CONDITIONAL", derivation: "CONDITIONAL", public_distribution: "CONDITIONAL" }, "K0.4A: first-party work is distinct from upstream data; external derivation and public delivery still require explicit owner authorization."),
+  ...baseline("first-party:kanji-corpus:v1", { retention: "CONDITIONAL", internal_analysis: "CONDITIONAL", derivation: "CONDITIONAL", public_distribution: "CONDITIONAL" }, "K0.4A: first-party work is distinct from upstream data; external derivation and public delivery still require explicit owner authorization."),
+].map((event) => Object.freeze(event)));
+
+export function currentRightsState(
+  history: readonly RightsHistoryEvent[],
+  sourceRef: string,
+  scope: RightsScope,
+): RightsState {
+  return history.filter((event) => event.sourceRef === sourceRef && event.scope === scope)
+    .sort((a, b) => b.sequence - a.sequence)[0]?.state ?? "UNKNOWN";
+}
+
+export function sourceOperationDecision(
+  history: readonly RightsHistoryEvent[],
+  sourceRef: string,
+): { allowed: boolean; blockers: Array<{ scope: RightsScope; state: RightsState }> } {
+  const required: RightsScope[] = ["retention", "internal_analysis", "derivation"];
+  if (!validateRightsHistory(history).valid) return { allowed: false, blockers: required.map((scope) => ({ scope, state: "UNKNOWN" })) };
+  const blockers = required.flatMap((scope) => {
+    const state = currentRightsState(history, sourceRef, scope);
+    return state === "CLEARED" ? [] : [{ scope, state }];
+  });
+  return { allowed: blockers.length === 0, blockers };
+}
+
+export function assertSourceOperationAllowed(history: readonly RightsHistoryEvent[], sourceRef: string): void {
+  const decision = sourceOperationDecision(history, sourceRef);
+  if (!decision.allowed) {
+    const detail = decision.blockers.map((item) => `${item.scope}=${item.state}`).join(", ");
+    throw new Error(`[RIGHTS_GATE] Source adapter execution denied for ${sourceRef}: ${detail}.`);
+  }
+}
+
+export function publicDistributionDecision(
+  history: readonly RightsHistoryEvent[],
+  sourceRefs: readonly string[],
+): { allowed: boolean; blockers: Array<{ sourceRef: string; scope: RightsScope; state: RightsState }> } {
+  const blockers: Array<{ sourceRef: string; scope: RightsScope; state: RightsState }> = [];
+  const uniqueSources = [...new Set(sourceRefs)];
+  if (!uniqueSources.length) return { allowed: false, blockers: [{ sourceRef: "", scope: "public_distribution", state: "UNKNOWN" }] };
+  if (!validateRightsHistory(history).valid) {
+    return { allowed: false, blockers: uniqueSources.flatMap((sourceRef) => (["derivation", "public_distribution"] as const).map((scope) => ({ sourceRef, scope, state: "UNKNOWN" as const }))) };
+  }
+  for (const sourceRef of uniqueSources) {
+    for (const scope of ["derivation", "public_distribution"] as const) {
+      const state = currentRightsState(history, sourceRef, scope);
+      if (state !== "CLEARED") blockers.push({ sourceRef, scope, state });
+    }
+  }
+  return { allowed: blockers.length === 0, blockers };
+}
+
+export function createOwnerClearanceEvents(input: {
+  sourceRef: `first-party:${string}`;
+  eventIdPrefix: string;
+  recordedOn: string;
+  ownerAuthorizationRef: string;
+  ownerAuthorizationSha256: string;
+  scopes?: readonly RightsScope[];
+  history?: readonly RightsHistoryEvent[];
+}): RightsHistoryEvent[] {
+  const scopes = input.scopes ?? ["retention", "internal_analysis", "derivation", "public_distribution"];
+  return scopes.reduce<RightsHistoryEvent[]>((events, scope) => appendRightsEvent(events, {
+    eventId: `${input.eventIdPrefix}:${scope}`,
+    sourceRef: input.sourceRef,
+    scope,
+    state: "CLEARED",
+    recordedOn: input.recordedOn,
+    actor: "project-owner",
+    rationale: "Explicit first-party owner authorization for the named scope; does not authorize any other source or derivative.",
+    evidenceRef: input.ownerAuthorizationRef,
+    evidenceClass: "owner_authorization",
+    evidenceSha256: input.ownerAuthorizationSha256,
+  }), [...(input.history ?? [])]);
+}
diff --git a/src/services/knowledge/provenance/rightsResolution.ts b/src/services/knowledge/provenance/rightsResolution.ts
