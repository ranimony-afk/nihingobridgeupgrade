+        "sha256": "f33440f1aa08f655b00243d25273333b3cb444e676f53a186f57956fddf95a70",
+    },
+    "README.md": {
+        "bytes": 8326,
+        "gitBlob": "d1eb81abcf1eb48f029820e6f21cf16f36726772",
+        "sha256": "22786723bc9543cf6cca953f669d23b3164b2d1b2f493900a106a45d1b6f4670",
+    },
+    "sources/grammar/README.md": {
+        "bytes": 569,
+        "gitBlob": "a4739898ec09cfed52c5ee61524ee43b3c8aa452",
+        "sha256": "4b49e9cd14edcd28c86f1acddeefe36e3fc6b51527b58203a5778e3d7fd580fc",
+    },
+    "sources/grammar/n5.json": {
+        "bytes": 7984,
+        "gitBlob": "6217b6448e3a2d08457cc2d2646b05a184d66f3e",
+        "sha256": "70042efc06bf127b59b9e61d71f91d3db475a3b21f175cd5e9504cc9307de3a8",
+    },
+    "sources/grammar/n4.json": {
+        "bytes": 8442,
+        "gitBlob": "4a236d94270c5ffb192835ed9165f40586a28870",
+        "sha256": "68e982ad670f2bd680dbeb48f2c9a8d8dfc87e075de5d8938db9766c249e9d66",
+    },
+    "sources/grammar/n3.json": {
+        "bytes": 8911,
+        "gitBlob": "44b250199fece0984031413cb916243b997772d7",
+        "sha256": "cd5214231b17e76d6026d653c03d5bd3a56b7c3feb6da57ea4bab14fe4d99c9c",
+    },
+    "sources/grammar/n2.json": {
+        "bytes": 9105,
+        "gitBlob": "27028f8b3116cb1b9b9dee823b795f952ddafc59",
+        "sha256": "ce0091d4f441dd1ed2abfebc7d317fe881461358dcdbbe5be8cdce361bdf24ae",
+    },
+    "sources/grammar/n1.json": {
+        "bytes": 9244,
+        "gitBlob": "3f4ece9ea3e2b7e6e30193ecf443ac84855b2ccf",
+        "sha256": "9687367e9a9305632bc9b5602fe2290867fa8e4d069d3b3b478c59574f2449fe",
+    },
+}
+GRAMMAR_PATHS = [f"sources/grammar/{level.lower()}.json" for level in JLPT_LEVELS]
+REQUIRED_TYPES: dict[str, tuple[type, ...]] = {
+    "pattern": (str,),
+    "level": (str,),
+    "meaning": (str,),
+    "formation": (str, type(None)),
+    "examples": (list,),
+    "tags": (list,),
+}
+
+
+def sha256_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def git_blob_sha(data: bytes) -> str:
+    header = f"blob {len(data)}\0".encode("ascii")
+    return hashlib.sha1(header + data).hexdigest()
+
+
+def json_bytes(value: Any) -> bytes:
+    return (json.dumps(value, ensure_ascii=False, sort_keys=True, indent=2) + "\n").encode("utf-8")
+
+
+def atomic_write(path: Path, data: bytes, *, overwrite_generated: bool = False) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    if path.exists() and not overwrite_generated:
+        existing = path.read_bytes()
+        if existing != data:
+            raise RuntimeError(f"Refusing to overwrite a pre-existing different file: {path}")
+        return
+    temp = path.with_name(path.name + ".k014-tmp")
+    temp.write_bytes(data)
+    os.replace(temp, path)
+
+
+def request_github_contents(path: str) -> bytes:
+    escaped = urllib.parse.quote(path, safe="/")
+    query = urllib.parse.urlencode({"ref": COMMIT})
+    url = f"https://api.github.com/repos/{REPOSITORY}/contents/{escaped}?{query}"
+    request = urllib.request.Request(
+        url,
+        headers={
+            "Accept": "application/vnd.github+json",
+            "User-Agent": USER_AGENT,
+        },
+    )
+    with urllib.request.urlopen(request, timeout=30) as response:
+        payload = json.load(response)
+    if payload.get("encoding") != "base64" or not isinstance(payload.get("content"), str):
+        raise RuntimeError(f"Unexpected GitHub Contents response for {path}")
+    return base64.b64decode(payload["content"], validate=False)
+
+
+def verify_pinned_bytes(path: str, data: bytes) -> dict[str, Any]:
+    expected = PINNED_FILES[path]
+    actual = {
+        "bytes": len(data),
+        "gitBlob": git_blob_sha(data),
+        "sha256": sha256_bytes(data),
+    }
+    if actual != expected:
+        raise RuntimeError(
+            f"Pinned source mismatch for {path}: expected {expected}; got {actual}"
+        )
+    return {"path": path, **actual}
+
+
+def source_path(path: str) -> Path:
+    return RAW_ROOT / path
+
+
+def acquisition_manifest_path() -> Path:
+    return RAW_ROOT / "acquisition-manifest.json"
+
+
+def acquire() -> dict[str, Any]:
+    if acquisition_manifest_path().exists():
+        manifest = json.loads(acquisition_manifest_path().read_text(encoding="utf-8"))
+        for path, expected in PINNED_FILES.items():
+            local = source_path(path)
+            if not local.is_file():
+                raise RuntimeError(f"Manifest exists but source file is missing: {local}")
+            actual = verify_pinned_bytes(path, local.read_bytes())
+            if any(actual[k] != expected[k] for k in ("bytes", "gitBlob", "sha256")):
+                raise RuntimeError(f"Existing materialization failed pin verification: {local}")
+        return {"state": "EXISTING_PINNED_SNAPSHOT_VERIFIED", "manifest": manifest}
+
+    files = []
+    for path in PINNED_FILES:
+        data = request_github_contents(path)
+        files.append(verify_pinned_bytes(path, data))
+        atomic_write(source_path(path), data)
+
+    manifest = {
+        "manifestVersion": "nihongobridge-openjlpt-acquisition@1",
+        "retrievedAtUTC": datetime.now(timezone.utc).isoformat(timespec="seconds"),
+        "sourceId": SOURCE_ID,
+        "publisher": "OpenJLPT / evanclan",
+        "repository": f"https://github.com/{REPOSITORY}",
+        "release": RELEASE,
+        "immutableCommit": COMMIT,
+        "scope": "Five grammar seed JSON files plus their release license, notice, root README and grammar-source README; no other OpenJLPT dataset files.",
+        "transport": "GitHub Contents API over HTTPS, each request pinned to the immutable commit above.",
+        "files": files,
+        "recordSourceCount": 100,
+        "license": {
+            "identifier": SOURCE_LICENSE,
+            "licenseUrl": LICENSE_URL,
+            "licenseSha256": PINNED_FILES["LICENSE"]["sha256"],
+            "noticeSha256": PINNED_FILES["NOTICE.md"]["sha256"],
+            "commercialUse": "Permitted by CC BY-SA 4.0 subject to attribution, change indication, ShareAlike and applicable upstream conditions.",
+            "projectUseStatus": "K0.14_LOCAL_NONCANONICAL_RESEARCH_MATERIALIZATION_ONLY",
+            "publicationOrProductionAuthorization": "NOT_AUTHORIZED",
+        },
+        "provenanceLimitations": [
+            "Source files are described as hand-curated; per-entry author/source lineage was not supplied.",
+            "Example sentence origin is not independently mapped per example.",
+            "No native-speaker or other human review is asserted by this acquisition manifest.",
+        ],
+    }
+    atomic_write(acquisition_manifest_path(), json_bytes(manifest))
+    return {"state": "ACQUIRED_AND_PINNED", "manifest": manifest}
+
+
+def normalize_value(value: Any) -> Any:
+    """NFC + outer-whitespace normalization; preserves every original value separately."""
+    if isinstance(value, str):
+        return unicodedata.normalize("NFC", value).strip()
+    if isinstance(value, list):
+        return [normalize_value(item) for item in value]
+    if isinstance(value, dict):
+        return {key: normalize_value(item) for key, item in value.items()}
+    return value
+
+
+def record_digest(record: dict[str, Any]) -> str:
+    return sha256_bytes(json.dumps(record, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8"))
+
+
+def level_from_path(path: str) -> str:
+    return Path(path).stem.upper()
+
+
+def validate_record(record: Any, *, path: str, index: int) -> list[dict[str, Any]]:
+    locator = {"file": path, "arrayIndex": index}
+    issues: list[dict[str, Any]] = []
+    if not isinstance(record, dict):
+        return [{"class": "STRUCTURAL", "code": "record_not_object", "locator": locator}]
+    for field, accepted in REQUIRED_TYPES.items():
+        if field not in record:
+            issues.append({"class": "STRUCTURAL", "code": "missing_field", "field": field, "locator": locator})
+            continue
+        if not isinstance(record[field], accepted):
+            issues.append({"class": "STRUCTURAL", "code": "wrong_field_type", "field": field, "actualType": type(record[field]).__name__, "locator": locator})
+    for field in ("pattern", "level", "meaning"):
+        value = record.get(field)
+        if isinstance(value, str) and not value.strip():
+            issues.append({"class": "STRUCTURAL", "code": "empty_required_text", "field": field, "locator": locator})
+    formation = record.get("formation")
+    if isinstance(formation, str) and not formation.strip():
+        issues.append({"class": "STRUCTURAL", "code": "empty_formation", "field": "formation", "locator": locator})
+    tags = record.get("tags")
+    if isinstance(tags, list):
+        for tag_index, tag in enumerate(tags, start=1):
+            if not isinstance(tag, str) or not tag.strip():
+                issues.append({"class": "STRUCTURAL", "code": "tag_not_nonempty_string", "field": "tags", "tagIndex": tag_index, "locator": locator})
+    value = record.get("level")
+    if isinstance(value, str):
+        normalized_level = value.strip().upper()
+        expected_level = level_from_path(path)
+        if normalized_level not in JLPT_LEVELS:
+            issues.append({"class": "STRUCTURAL", "code": "invalid_community_level", "field": "level", "locator": locator})
+        elif normalized_level != expected_level:
+            issues.append({"class": "STRUCTURAL", "code": "level_path_mismatch", "field": "level", "locator": locator})
+    examples = record.get("examples")
+    if isinstance(examples, list):
+        for example_index, example in enumerate(examples, start=1):
+            if not isinstance(example, dict):
+                issues.append({"class": "STRUCTURAL", "code": "example_not_object", "field": "examples", "exampleIndex": example_index, "locator": locator})
+                continue
+            for key in ("ja", "en"):
+                if not isinstance(example.get(key), str) or not example[key].strip():
+                    issues.append({"class": "STRUCTURAL", "code": "example_language_field_missing_or_empty", "field": f"examples.{key}", "exampleIndex": example_index, "locator": locator})
+    return issues
+
+
+def build_outputs() -> tuple[dict[str, Any], dict[str, Any], list[dict[str, Any]]]:
+    manifest_path = acquisition_manifest_path()
+    if not manifest_path.is_file():
+        raise RuntimeError("Run `acquire` first; no pinned source materialization exists.")
+    acquire_manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    source_files = {item["path"]: item for item in acquire_manifest["files"]}
+    records_out: list[dict[str, Any]] = []
+    rejects: list[dict[str, Any]] = []
+    issues: list[dict[str, Any]] = []
+    exact_seen: dict[str, str] = {}
+    pattern_seen: dict[str, str] = {}
+    exact_duplicates: list[dict[str, str]] = []
+    pattern_duplicates: list[dict[str, str]] = []
+    level_counts: Counter[str] = Counter()
+    example_records: Counter[str] = Counter()
+    example_item_types: Counter[str] = Counter()
+    example_key_shapes: Counter[str] = Counter()
+    examples_japanese_nonempty = 0
+    examples_english_nonempty = 0
+    examples_per_record: list[int] = []
+    missing_fields: Counter[str] = Counter()
+    normalized_fields: Counter[str] = Counter()
+    tag_values: set[str] = set()
+    tag_item_count = 0
+    empty_tag_count = 0
+    pattern_records_with_cjk = 0
+    pattern_records_with_kana = 0
+    level_matches_file_count = 0
+    source_count = 0
+    parse_count = 0
+
+    for path in GRAMMAR_PATHS:
+        local = source_path(path)
+        file_bytes = local.read_bytes()
+        verified = verify_pinned_bytes(path, file_bytes)
+        source_hash = verified["sha256"]
+        try:
+            raw_array = json.loads(file_bytes.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+            raise RuntimeError(f"Could not parse pinned UTF-8 JSON {path}: {exc}") from exc
+        if not isinstance(raw_array, list):
+            raise RuntimeError(f"Expected a top-level JSON array in {path}")
+
+        expected_level = level_from_path(path)
+        for index, raw_record in enumerate(raw_array, start=1):
+            source_count += 1
+            parse_count += 1
+            locator = {"file": path, "arrayIndex": index}
+            row_issues = validate_record(raw_record, path=path, index=index)
+            if row_issues:
+                issues.extend(row_issues)
+                rejects.append({"locator": locator, "reasonCodes": sorted({i["code"] for i in row_issues}), "sourceRecord": raw_record})
+                continue
+
+            assert isinstance(raw_record, dict)
+            level = raw_record["level"].strip().upper()
+            level_counts[level] += 1
+            if level == expected_level:
+                level_matches_file_count += 1
+            raw_pattern = raw_record["pattern"]
+            pattern_key = unicodedata.normalize("NFC", raw_pattern).strip()
+            if any(0x3400 <= ord(char) <= 0x9FFF for char in raw_pattern):
+                pattern_records_with_cjk += 1
+            if any(0x3040 <= ord(char) <= 0x30FF for char in raw_pattern):
+                pattern_records_with_kana += 1
+            for tag in raw_record["tags"]:
+                tag_item_count += 1
+                if isinstance(tag, str) and tag.strip():
+                    tag_values.add(unicodedata.normalize("NFC", tag).strip())
+                else:
+                    empty_tag_count += 1
+            canonical_digest = record_digest(raw_record)
+            candidate_id = f"olp-v0.2.0-{expected_level.lower()}-{index:04d}"
+            if canonical_digest in exact_seen:
+                exact_duplicates.append({"firstCandidateId": exact_seen[canonical_digest], "duplicateCandidateId": candidate_id, "kind": "EXACT_SOURCE_RECORD"})
+            else:
+                exact_seen[canonical_digest] = candidate_id
+            if pattern_key in pattern_seen:
+                pattern_duplicates.append({"firstCandidateId": pattern_seen[pattern_key], "duplicateCandidateId": candidate_id, "kind": "NFC_TRIMMED_PATTERN_KEY"})
+            else:
+                pattern_seen[pattern_key] = candidate_id
+
+            fields: dict[str, Any] = {}
+            for field in sorted(set(REQUIRED_TYPES) | set(raw_record)):
+                if field in raw_record:
+                    original = raw_record[field]
+                    normalized = normalize_value(original)
+                    normalized_fields[field] += 1
+                    present = True
+                else:
+                    original = None
+                    normalized = None
+                    present = False
+                    missing_fields[field] += 1
+                fields[field] = {
+                    "originalValue": original,
+                    "normalizedValue": normalized,
+                    "fieldState": "PRESENT" if present else "ABSENT",
+                    "provenance": {
+                        "sourceId": SOURCE_ID,
+                        "sourceVersion": RELEASE,
+                        "sourceCommit": COMMIT,
+                        "sourceArtifact": path,
+                        "sourceArtifactSha256": source_hash,
+                        "sourceRecordId": None,
+                        "sourceRecordLocator": locator,
+                        "sourceField": field,
+                    },
+                }
+
+            examples = raw_record.get("examples")
+            has_examples = isinstance(examples, list) and len(examples) > 0
+            example_records["withExamples" if has_examples else "withoutExamples"] += 1
+            examples_per_record.append(len(examples) if isinstance(examples, list) else 0)
+            if isinstance(examples, list):
+                for example in examples:
+                    example_item_types[type(example).__name__] += 1
+                    if isinstance(example, dict):
+                        example_key_shapes[",".join(sorted(example))] += 1
+                        examples_japanese_nonempty += isinstance(example.get("ja"), str) and bool(example["ja"].strip())
+                        examples_english_nonempty += isinstance(example.get("en"), str) and bool(example["en"].strip())
+            records_out.append({
+                "candidateRecordId": candidate_id,
+                "sourceRecordId": None,
+                "sourceRecordLocator": locator,
+                "sourceRecordCanonicalJsonSha256": canonical_digest,
+                "fields": fields,
+                "editorialStatus": "UNREVIEWED",
+                "humanReviewStatus": "NOT_REVIEWED",
+                "semanticAccuracyStatus": "HUMAN_REVIEW_REQUIRED",
+                "publicationStatus": "NOT_AUTHORIZED",
+                "canonicalIntegrationStatus": "NOT_INTEGRATED",
+                "sourceLicenseStatus": "CC_BY-SA-4.0_CONDITIONAL; source-authority/per-field-provenance follow-up remains",
+            })
+
+    issue_counts = Counter(issue["class"] for issue in issues)
+    quality = {
+        "reportVersion": "nihongobridge-k014-quality-report@1",
+        "dataset": "OpenJLPT grammar-only seed v0.2.0",
+        "sourceCount": source_count,
+        "parsedCount": parse_count,
+        "normalizedCount": len(records_out),
+        "structurallyValidCount": len(records_out),
+        "rejectedCount": len(rejects),
+        "exactDuplicateRecordCount": len(exact_duplicates),
+        "duplicatePatternKeyCount": len(pattern_duplicates),
+        "duplicateRecordsRetained": True,
+        "levelDistribution": {level: level_counts.get(level, 0) for level in JLPT_LEVELS},
+        "levelMatchesFileCount": level_matches_file_count,
+        "sourceIdentifierFieldPresent": False,
+        "exampleAvailability": {
+            "recordsWithExamples": example_records.get("withExamples", 0),
+            "recordsWithoutExamples": example_records.get("withoutExamples", 0),
+            "exampleItemCount": sum(example_item_types.values()),
+            "examplesPerRecordMin": min(examples_per_record, default=0),
+            "examplesPerRecordMax": max(examples_per_record, default=0),
+            "exampleItemTypes": dict(sorted(example_item_types.items())),
+            "exampleKeyShapes": dict(sorted(example_key_shapes.items())),
+            "examplesWithNonemptyJa": examples_japanese_nonempty,
+            "examplesWithNonemptyEn": examples_english_nonempty,
+            "exampleOriginSpecifiedPerExample": False,
+        },
+        "patternScriptCoverage": {
+            "recordsContainingCjkCodePoint": pattern_records_with_cjk,
+            "recordsContainingHiraganaOrKatakanaCodePoint": pattern_records_with_kana,
+            "interpretation": "Character-range presence only; not linguistic validation.",
+        },
+        "tagCoverage": {"tagItemCount": tag_item_count, "distinctNonemptyTagCount": len(tag_values), "emptyTagValueCount": empty_tag_count},
+        "fieldPresenceCounts": dict(sorted(normalized_fields.items())),
+        "missingFieldCounts": dict(sorted(missing_fields.items())),
+        "issueClassCounts": dict(sorted(issue_counts.items())),
+        "qualityClasses": {
+            "STRUCTURAL": {"validatedRecords": len(records_out), "rejectedRecords": len(rejects), "issues": len([i for i in issues if i["class"] == "STRUCTURAL"])},
+            "PROVENANCE": {"recordsWithExamplesMissingPerExampleOrigin": example_records.get("withExamples", 0), "status": "SOURCE-FILE PROVENANCE PRESENT; ORIGINAL EXAMPLE AUTHOR/SOURCE NOT MAPPED"},
+            "LINGUISTIC": {"recordsRequiringQualifiedReview": source_count, "status": "NOT_REVIEWED"},
+            "SEMANTIC": {"recordsRequiringHumanMeaning/usageReview": source_count, "status": "NOT_REVIEWED"},
+            "CROSS_REFERENCE": {"explicitSourceLinks": 0, "resolvedLinks": 0, "status": "NO SOURCE IDS OR CROSS-REFERENCE FIELDS"},
+            "HUMAN_REVIEW_REQUIRED": {"pendingRecords": source_count, "reviewedRecords": 0},
+        },
+        "issues": issues,
+        "exactDuplicates": exact_duplicates,
+        "duplicatePatternKeys": pattern_duplicates,
+        "crossReferenceCoverage": {"sourceDeclaredCrossReferenceFields": 0, "resolvedCrossReferences": 0, "status": "NO_SOURCE_CROSS_REFERENCE_FIELD_OBSERVED; no links fabricated"},
+        "semanticValidation": {"status": "NOT_PERFORMED", "reason": "Structural checks do not establish grammar correctness or naturalness."},
+        "humanReview": {"reviewPendingCount": len(records_out) + len(rejects), "reviewedCount": 0, "status": "REQUIRED_BEFORE_LEARNER_OR_PUBLIC_USE"},
+        "integratedCount": "UNKNOWN_NOT_CHECKED; no database or CMS accessed",
+    }
+    normalized = {
+        "schemaVersion": "nihongobridge.openjlpt-grammar-materialized@1",
+        "dataset": {
+            "sourceId": SOURCE_ID,
+            "publisher": "OpenJLPT / evanclan",
+            "release": RELEASE,
+            "sourceCommit": COMMIT,
+            "sourceLicense": SOURCE_LICENSE,
+            "attribution": "OpenJLPT v0.2.0; retain the accompanying LICENSE and NOTICE; link CC BY-SA 4.0 and identify this normalization as a change.",
+            "sourceScope": "Grammar source files only; no OpenJLPT vocabulary, kanji, Tatoeba or other aggregate records included.",
+            "technicalUseStatus": "LOCAL_NONCANONICAL_K014_MATERIALIZATION",
+            "editorialStatus": "UNREVIEWED",
+            "publicationStatus": "NOT_AUTHORIZED",
+        },
+        "records": records_out,
+    }
+    return normalized, quality, rejects
+
+
+def build_review_queue(normalized: dict[str, Any], quality: dict[str, Any]) -> dict[str, Any]:
+    duplicate_ids = {
+        duplicate["duplicateCandidateId"]
+        for duplicate in quality["duplicatePatternKeys"]
+    } | {
+        duplicate["firstCandidateId"]
+        for duplicate in quality["duplicatePatternKeys"]
+    }
+    items = []
+    for record in normalized["records"]:
+        is_duplicate = record["candidateRecordId"] in duplicate_ids
+        items.append({
+            "recordId": record["candidateRecordId"],
+            "sourceId": SOURCE_ID,
+            "sourceVersion": RELEASE,
+            "fieldsUnderReview": ["pattern", "level", "meaning", "formation", "examples", "tags"],
+            "suspectedIssue": (
+                "Pattern key duplicates another source row across JLPT levels; determine whether it is a legitimate level overlap or a source defect."
+                if is_duplicate else
+                "No human review or per-example origin was supplied; verify meaning, formation, level fit, naturalness, example fit and source attribution."
+            ),
+            "reasonCodes": (["PATTERN_KEY_DUPLICATE", "HUMAN_REVIEW_REQUIRED"] if is_duplicate else ["HUMAN_REVIEW_REQUIRED", "EXAMPLE_ORIGIN_UNMAPPED"]),
+            "expectedCorrection": None,
+            "evidence": {
+                "sourceArtifact": record["sourceRecordLocator"]["file"],
+                "sourceArtifactSha256": record["fields"]["pattern"]["provenance"]["sourceArtifactSha256"],
+                "sourceRecordLocator": record["sourceRecordLocator"],
+                "sourceRecordCanonicalJsonSha256": record["sourceRecordCanonicalJsonSha256"],
+            },
+            "reviewPriority": "HIGH" if is_duplicate else "NORMAL",
+            "reviewerDecision": "PENDING",
+            "reviewedBy": None,
+            "reviewTimestampUTC": None,
+            "allowedDecisions": ["APPROVE", "REJECT", "CORRECT", "DEFER", "NEEDS_SOURCE_EVIDENCE"],
+            "publicationStatus": "NOT_AUTHORIZED",
+        })
+    return {
+        "queueVersion": "nihongobridge-k014-review-queue@1",
+        "dataset": "OpenJLPT grammar-only seed v0.2.0",
+        "candidateCount": len(items),
+        "pendingCount": len(items),
+        "items": items,
+    }
+
+
+def write_build() -> dict[str, Any]:
+    normalized, quality, rejects = build_outputs()
+    review_queue = build_review_queue(normalized, quality)
+    normalized_data = json_bytes(normalized)
+    quality_data = json_bytes(quality)
+    rejects_data = json_bytes(rejects)
+    duplicates_data = json_bytes({"exactDuplicates": quality["exactDuplicates"], "duplicatePatternKeys": quality["duplicatePatternKeys"], "recordsDeduplicated": False})
+    review_queue_data = json_bytes(review_queue)
+    prior_manifest_path = BUILD_ROOT / "build-manifest.json"
+    prior_output = BUILD_ROOT / "normalized.json"
+    same_as_previous = prior_output.is_file() and prior_output.read_bytes() == normalized_data
+    atomic_write(prior_output, normalized_data, overwrite_generated=True)
+    atomic_write(BUILD_ROOT / "quality-report.json", quality_data, overwrite_generated=True)
+    atomic_write(BUILD_ROOT / "rejected.json", rejects_data, overwrite_generated=True)
+    atomic_write(BUILD_ROOT / "duplicates.json", duplicates_data, overwrite_generated=True)
+    atomic_write(BUILD_ROOT / "review-queue.json", review_queue_data, overwrite_generated=True)
+    source_manifest = json.loads(acquisition_manifest_path().read_text(encoding="utf-8"))
+    build_manifest = {
+        "manifestVersion": "nihongobridge-openjlpt-build@1",
+        "builtAtUTC": datetime.now(timezone.utc).isoformat(timespec="seconds"),
+        "datasetName": "OpenJLPT grammar-only seed",
+        "datasetVersion": RELEASE,
+        "sourceId": SOURCE_ID,
+        "sourceCommit": COMMIT,
+        "sourceInputChecksums": [{"path": f["path"], "sha256": f["sha256"], "bytes": f["bytes"]} for f in source_manifest["files"] if f["path"] in GRAMMAR_PATHS],
+        "transformation": {"name": "scripts/k014_openjlpt_grammar.py", "version": "1.0.0", "unicodeNormalization": "NFC plus outer whitespace trim; original values preserved per field", "deduplication": "diagnostic only; duplicates retained"},
+        "counts": {
+            "targetCount": 10000,
+            "sourceCount": quality["sourceCount"],
+            "materializedCount": quality["sourceCount"],
+            "parsedCount": quality["parsedCount"],
+            "normalizedCount": quality["normalizedCount"],
+            "structurallyValidatedCount": quality["structurallyValidCount"],
+            "duplicateExactCount": quality["exactDuplicateRecordCount"],
+            "duplicatePatternKeyCount": quality["duplicatePatternKeyCount"],
+            "rejectedCount": quality["rejectedCount"],
+            "reviewPendingCount": quality["humanReview"]["reviewPendingCount"],
+            "integratedCount": quality["integratedCount"],
+        },
+        "validationClassCounts": quality["issueClassCounts"],
+        "outputs": {
+            "normalized.json": {"bytes": len(normalized_data), "sha256": sha256_bytes(normalized_data)},
+            "quality-report.json": {"bytes": len(quality_data), "sha256": sha256_bytes(quality_data)},
+            "rejected.json": {"bytes": len(rejects_data), "sha256": sha256_bytes(rejects_data)},
+            "duplicates.json": {"bytes": len(duplicates_data), "sha256": sha256_bytes(duplicates_data)},
+            "review-queue.json": {"bytes": len(review_queue_data), "sha256": sha256_bytes(review_queue_data)},
+        },
+        "sameNormalizedBytesAsPreviousBuild": same_as_previous if prior_output.is_file() else None,
+        "sourceLicenseAndProjectUse": source_manifest["license"],
+        "publicationAuthorization": "NOT_AUTHORIZED",
+    }
+    atomic_write(prior_manifest_path, json_bytes(build_manifest), overwrite_generated=True)
+    return build_manifest
+
+
+def verify_build() -> dict[str, Any]:
+    normalized, quality, rejects = build_outputs()
+    review_queue = build_review_queue(normalized, quality)
+    expected = {
+        "normalized.json": json_bytes(normalized),
+        "quality-report.json": json_bytes(quality),
+        "rejected.json": json_bytes(rejects),
+        "duplicates.json": json_bytes({"exactDuplicates": quality["exactDuplicates"], "duplicatePatternKeys": quality["duplicatePatternKeys"], "recordsDeduplicated": False}),
+        "review-queue.json": json_bytes(review_queue),
+    }
+    errors = []
+    for name, content in expected.items():
+        path = BUILD_ROOT / name
+        if not path.is_file():
+            errors.append({"file": name, "reason": "OUTPUT_MISSING"})
+        elif path.read_bytes() != content:
+            errors.append({"file": name, "reason": "OUTPUT_BYTES_DIFFER_FROM_REBUILD"})
+    if errors:
+        raise RuntimeError(json.dumps({"verification": "FAIL", "errors": errors}, ensure_ascii=False))
+    return {
+        "verification": "PASS",
+        "byteForByteDeterministicOutputs": True,
+        "verifiedOutputNames": sorted(expected),
+        "sourceCount": quality["sourceCount"],
+        "normalizedCount": quality["normalizedCount"],
+        "rejectedCount": quality["rejectedCount"],
+        "integratedCount": quality["integratedCount"],
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("command", choices=("acquire", "build", "verify"))
+    args = parser.parse_args(argv)
+    try:
+        if args.command == "acquire":
+            result = acquire()
+        elif args.command == "build":
+            result = write_build()
+        else:
+            result = verify_build()
+    except Exception as exc:  # CLI boundary: concise failure, nonzero exit.
+        print(json.dumps({"status": "ERROR", "error": str(exc)}, ensure_ascii=False), file=sys.stderr)
+        return 1
+    print(json.dumps(result, ensure_ascii=False, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
