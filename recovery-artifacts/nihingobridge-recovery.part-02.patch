+++ b/tests/kanji-foundation.test.ts
@@ -0,0 +1,680 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import { execFileSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { AuthorizationError, resetActorResolver, setActorResolver, type CmsRole } from "@/lib/auth";
+import { CmsError, CmsService } from "@/services/cms";
+import {
+  buildKanjiFoundationPublicProjection,
+  canonicalFoundationJson,
+  createFoundationFieldPayload,
+  createIdentityDraftPayload,
+  diagnoseFoundationProjection,
+  identityCmsItemId,
+  identityCmsTitle,
+  KANJI_FOUNDATION_ITEM_SCHEMA,
+  rightsStatusForField,
+  sha256Foundation,
+  validateProvisionalCohort,
+  verifyFoundationFieldProvenance,
+  type FoundationCmsSnapshot,
+  type FoundationFieldPayload,
+  type FoundationIdentityPayload,
+  type FoundationProjectionResult,
+  type ProvisionalCohort,
+} from "@/services/knowledge/editorial/kanjiFoundation";
+import { KanjiFoundationWorkflow } from "@/services/knowledge/editorial/kanjiFoundationWorkflow";
+import { KANJI_FOUNDATION_CANDIDATE_REPORT_SCHEMA, KANJI_FOUNDATION_PIPELINE_VERSION, type FoundationCandidateBuildReport } from "@/services/knowledge/editorial/kanjiFoundationBuildReport";
+import { K0_5A_INITIAL_RIGHTS_HISTORY } from "@/services/knowledge/provenance/rightsPolicy";
+import cohortJson from "@/data/kanji-foundation/provisional-draft-shells.json";
+import { FakeCmsStore } from "./cms-fake-store";
+import { MINDTREE_EVIDENCE_GRAPH_SCHEMA, validateMindTreeEvidenceGraph } from "@/services/knowledge/editorial/mindTreeEvidenceGraph";
+import { KANJI_MEMBERSHIP_SCHEMA_V2, validateKanjiMembershipHistory, type KanjiMembershipEvent } from "@/services/knowledge/editorial/kanjiMembership";
+
+const NOW = new Date("2026-11-02T13:30:00.000Z");
+const EVIDENCE_HASH = "a".repeat(64);
+
+let store: FakeCmsStore;
+let idSequence: number;
+let workflow: KanjiFoundationWorkflow;
+
+function actAs(role: CmsRole, id = `${role}-k09`) {
+  setActorResolver(() => ({ id, role }));
+}
+
+function cmsFactory(deterministicId?: string): CmsService {
+  let used = false;
+  return new CmsService(store, {
+    clock: () => new Date(NOW),
+    generateId: (prefix) => {
+      if (prefix === "item" && deterministicId && !used) {
+        used = true;
+        return deterministicId;
+      }
+      return `test-k09-${prefix}-${++idSequence}`;
+    },
+  });
+}
+
+function runFoundationBuildCli(snapshot: FoundationCmsSnapshot): {
+  report: FoundationCandidateBuildReport;
+  artifact: FoundationProjectionResult;
+  artifactBytes: Buffer;
+  reportBytes: Buffer;
+  inputSha256: string;
+} {
+  const directory = mkdtempSync(path.join(tmpdir(), "nihongobridge-k010-"));
+  try {
+    const inputPath = path.join(directory, "snapshot.json");
+    const outputPath = path.join(directory, "learner-artifact.json");
+    const inputBytes = Buffer.from(JSON.stringify(snapshot), "utf8");
+    writeFileSync(inputPath, inputBytes);
+    const reportText = execFileSync(process.execPath, ["--import", "tsx", "scripts/build-kanji-foundation.ts", "--input", inputPath, "--output", outputPath], {
+      cwd: process.cwd(),
+      encoding: "utf8",
+      stdio: ["ignore", "pipe", "pipe"],
+    });
+    const artifactBytes = readFileSync(outputPath);
+    return {
+      report: JSON.parse(reportText) as FoundationCandidateBuildReport,
+      artifact: JSON.parse(artifactBytes.toString("utf8")) as FoundationProjectionResult,
+      artifactBytes,
+      reportBytes: Buffer.from(reportText, "utf8"),
+      inputSha256: createHash("sha256").update(inputBytes).digest("hex"),
+    };
+  } finally {
+    rmSync(directory, { recursive: true, force: true });
+  }
+}
+
+beforeEach(() => {
+  resetActorResolver();
+  store = new FakeCmsStore();
+  idSequence = 0;
+  workflow = new KanjiFoundationWorkflow({ clock: () => new Date(NOW), cmsFactory });
+});
+
+describe("K0.9 first-party Kanji foundation", () => {
+  it("validates the exact five empty, unattributed provisional identity shells", async () => {
+    const cohort = cohortJson as ProvisionalCohort;
+    expect(validateProvisionalCohort(cohort)).toEqual({ valid: true, issues: [] });
+    expect(cohort.records.map((record) => record.character)).toEqual(["明", "休", "道", "新", "話"]);
+    expect(cohort.records.every((record) => Object.keys(record.fields).length === 0)).toBe(true);
+    expect(cohort.records.every((record) => record.createdBy === null)).toBe(true);
+
+    actAs("editor");
+    const records = [];
+    for (const seed of cohort.records) records.push(await workflow.createCohortShell(seed.identityId));
+    expect(records).toHaveLength(5);
+    expect(records.every((item) => item.contentType === "kanji" && item.entityId === null && item.status === "draft")).toBe(true);
+    expect(records.every((item) => item.sourceRef === "first-party:kanji-foundation:k09")).toBe(true);
+    for (const item of records) {
+      const payload = item.stagedPayload as { kind: string; identity: { character: string }; provenance: { actorId: string | null }; membership: { state: string; history: unknown[] } };
+      expect(payload.kind).toBe("identity");
+      expect(payload.provenance.actorId).toBeNull();
+      expect(payload.membership).toEqual({ state: "CANDIDATE", history: [], evidenceVerification: null });
+      const versions = await cmsFactory().getVersions(item.id);
+      expect(versions).toHaveLength(1);
+      expect(versions[0].statusAtSnapshot).toBe("draft");
+    }
+  });
+
+  it("extends membership with deferred and excluded decisions while preserving the K0.5A v1 contract", () => {
+    const candidate: KanjiMembershipEvent = {
+      schemaVersion: KANJI_MEMBERSHIP_SCHEMA_V2,
+      eventId: "membership:candidate",
+      identityId: "kanji-u7532",
+      exactCharacter: "甲",
+      goal: "japanese_literacy",
+      state: "candidate",
+      sequence: 1,
+      previousEventId: null,
+      sourceAssertionIds: ["membership-source"],
+      sourceRefs: ["first-party:test:membership"],
+      decisionEvidenceRef: "test:candidate",
+      decisionAuthority: "test actor",
+      decisionTrust: "unverified_local_attribution",
+      authenticationEvidenceRef: null,
+      authenticationEvidenceSha256: null,
+    };
+    const deferred: KanjiMembershipEvent = { ...candidate, eventId: "membership:deferred", state: "deferred", sequence: 2, previousEventId: candidate.eventId };
+    const reconsidered: KanjiMembershipEvent = { ...candidate, eventId: "membership:reconsidered", state: "candidate", sequence: 3, previousEventId: deferred.eventId };
+    expect(validateKanjiMembershipHistory([candidate, deferred, reconsidered])).toEqual({ valid: true, issues: [] });
+    const excluded: KanjiMembershipEvent = { ...candidate, eventId: "membership:excluded", state: "excluded", sequence: 2, previousEventId: candidate.eventId };
+    expect(validateKanjiMembershipHistory([candidate, excluded]).valid).toBe(true);
+    expect(validateKanjiMembershipHistory([{ ...candidate, schemaVersion: "nihongobridge-kanji-membership@1", state: "deferred" } as KanjiMembershipEvent]).valid).toBe(false);
+  });
+
+  // Synthetic software-only evidence: IDs, owner/reviewer references, hashes, and drafted text below are test fixtures, not authentic source evidence or rights approval.
+  it("requires authenticated CMS roles, immutable review events, and field-specific rights before field publication", async () => {
+    actAs("editor");
+    const identity = await workflow.createNewIdentityShell("甲");
+    const draft = await workflow.createField({ identityId: "kanji-u7532", fieldKey: "meaning", value: "A newly authored draft note.", creationMethod: "human_draft" });
+    const payload0 = draft.stagedPayload as unknown as FoundationFieldPayload;
+    expect(rightsStatusForField(payload0)).toBe("UNKNOWN");
+    expect(draft.entityId).toBeNull();
+
+    await expect(workflow.verifyField(draft.id, "review/evidence", EVIDENCE_HASH)).rejects.toBeInstanceOf(AuthorizationError);
+    actAs("admin", "reviewer-admin");
+    const verified = await workflow.verifyField(draft.id, "review/evidence", EVIDENCE_HASH);
+    const verifiedPayload = verified.stagedPayload as unknown as FoundationFieldPayload;
+    expect(verifiedPayload.provenance.state).toBe("VERIFIED");
+    expect(verifiedPayload.provenance.verification?.reviewerId).toBe("reviewer-admin");
+
+    actAs("editor");
+    const submitted = await workflow.submitReview(draft.id);
+    actAs("reviewer");
+    const approved = await workflow.approve(draft.id);
+    expect(approved.status).toBe("approved");
+    actAs("admin", "delivery-admin");
+    await expect(workflow.publish(draft.id)).rejects.toMatchObject({ code: "VALIDATION_ERROR" });
+    expect((await cmsFactory().getItem(draft.id)).status).toBe("approved");
+
+    await workflow.setFieldRights({
+      itemId: draft.id,
+      scope: "derivation",
+      state: "CLEARED",
+      evidenceRef: "owner/meaning-rights",
+      evidenceClass: "owner_authorization",
+      evidenceSha256: EVIDENCE_HASH,
+      rationale: "Explicit owner authorization for this exact first-party field source.",
+    });
+    await workflow.setFieldRights({
+      itemId: draft.id,
+      scope: "public_distribution",
+      state: "CLEARED",
+      evidenceRef: "owner/meaning-distribution",
+      evidenceClass: "owner_authorization",
+      evidenceSha256: EVIDENCE_HASH,
+      rationale: "Explicit owner authorization for public distribution of this field source.",
+    });
+    const rightsUpdated = await cmsFactory().getItem(draft.id);
+    expect(rightsUpdated.status).toBe("draft");
+    expect(rightsStatusForField(rightsUpdated.stagedPayload as unknown as FoundationFieldPayload)).toBe("CLEARED");
+
+    actAs("editor");
+    await workflow.submitReview(draft.id);
+    actAs("reviewer");
+    await workflow.approve(draft.id);
+    actAs("admin", "delivery-admin");
+    const publishedField = await workflow.publish(draft.id);
+    expect(publishedField.status).toBe("published");
+
+    // A cleared and reviewed field is still not exposed until identity membership and identity delivery are independently authorized.
+    const blockedProjection = await workflow.publicProjection();
+    expect(blockedProjection.kanji).toEqual([]);
+    expect(submitted.status).toBe("review");
+    expect(approved.status).toBe("approved");
+    expect((await cmsFactory().getVersions(draft.id)).length).toBeGreaterThan(6);
+
+    // Identity membership and delivery are separate from the reviewed field.
+    const currentIdentity = await cmsFactory().getItem(identity.id);
+    const identityPayload = currentIdentity.stagedPayload as unknown as FoundationIdentityPayload;
+    actAs("admin", "identity-rights-admin");
+    await workflow.setIdentityRights({
+      identityId: "kanji-u7532",
+      scope: "derivation",
+      state: "CLEARED",
+      evidenceRef: "owner/identity-derivation",
+      evidenceClass: "owner_authorization",
+      evidenceSha256: EVIDENCE_HASH,
+      rationale: "Owner authorization for the exact first-party identity.",
+    });
+    await workflow.setIdentityRights({
+      identityId: "kanji-u7532",
+      scope: "public_distribution",
+      state: "CLEARED",
+      evidenceRef: "owner/identity-distribution",
+      evidenceClass: "owner_authorization",
+      evidenceSha256: EVIDENCE_HASH,
+      rationale: "Owner authorization for public delivery of the exact identity.",
+    });
+    await workflow.appendMembershipDecision({
+      identityId: "kanji-u7532",
+      goal: "japanese_literacy",
+      state: "candidate",
+      eventId: "membership-candidate-1",
+      sourceAssertionIds: ["identity-membership-source"],
+      sourceAssertions: [{
+        id: "identity-membership-source",
+        sourceRef: identityPayload.identitySourceRef,
+        sourceVersion: "K0.9-first-party",
+        sourceRecordRef: "kanji-u7532",
+        evidenceRef: "owner/membership-evidence",
+        assertedFields: ["membership"],
+      }],
