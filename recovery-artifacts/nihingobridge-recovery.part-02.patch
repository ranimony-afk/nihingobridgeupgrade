diff --git a/tests/kanji-corpus-provenance.test.ts b/tests/kanji-corpus-provenance.test.ts
new file mode 100644
index 0000000..cf69e24
--- /dev/null
+++ b/tests/kanji-corpus-provenance.test.ts
@@ -0,0 +1,82 @@
+import { describe, expect, it } from "vitest";
+import {
+  AUTHORITATIVE_SOURCE_REGISTRY,
+  getRegisteredSource,
+  ProvenanceService,
+  SOURCE_ALIASES,
+} from "@/services/knowledge/provenance";
+import {
+  buildCorpusPilotDataset,
+  buildMindtreeDataset,
+} from "@/services/knowledge/canonicalDataset";
+
+const CORPUS_REF = "first-party:kanji-corpus:v1";
+const MINDTREE_REF = "first-party:kanji-mindtree:v1";
+const KANJIDIC2_REF = "upstream:kanjidic2:2024-07";
+
+describe("first-party Kanji corpus provenance", () => {
+  it("registers the corpus as a distinct first-party source, not a KANJIDIC2 alias", () => {
+    const corpus = AUTHORITATIVE_SOURCE_REGISTRY[CORPUS_REF];
+
+    expect(corpus).toBeDefined();
+    expect(corpus.id).toBe(CORPUS_REF);
+    expect(corpus.type).toBe("first_party");
+    expect(corpus.domain).toBe("kanji");
+    expect(corpus.status).toBe("active");
+    expect(corpus.uri).toBeNull();
+    expect(corpus.targetTables).toEqual([
+      "kanji_entries",
+      "kanji_radicals",
+      "kanji_composition",
+    ]);
+    expect(SOURCE_ALIASES[CORPUS_REF]).toBeUndefined();
+
+    const resolvedCorpus = getRegisteredSource(CORPUS_REF);
+    const resolvedUpstream = getRegisteredSource(KANJIDIC2_REF);
+    expect(resolvedCorpus?.id).toBe(CORPUS_REF);
+    expect(resolvedCorpus?.type).toBe("first_party");
+    expect(resolvedUpstream?.id).toBe(KANJIDIC2_REF);
+    expect(resolvedUpstream?.type).toBe("upstream");
+    expect(resolvedCorpus?.id).not.toBe(resolvedUpstream?.id);
+  });
+
+  it("resolves all 12 curated corpus Kanji records to the first-party identity", () => {
+    const corpus = buildCorpusPilotDataset();
+    const sources = corpus.rows.kanji.map((record) => record.sourceRef);
+
+    expect(corpus.sourceRef).toBe(CORPUS_REF);
+    expect(corpus.rows.kanji).toHaveLength(12);
+    expect(new Set(sources)).toEqual(new Set([CORPUS_REF]));
+    expect(sources).toHaveLength(12);
+    expect(ProvenanceService.assertIngestible(CORPUS_REF).id).toBe(CORPUS_REF);
+    expect(ProvenanceService.resolveProvenance(CORPUS_REF)).toMatchObject({
+      sourceRef: CORPUS_REF,
+      type: "first_party",
+      domain: "kanji",
+    });
+  });
+
+  it("preserves the independent provenance of all 33 Mind Tree Kanji", () => {
+    const mindtree = buildMindtreeDataset();
+
+    expect(mindtree.rows.kanji).toHaveLength(33);
+    expect(new Set(mindtree.rows.kanji.map((record) => record.sourceRef))).toEqual(
+      new Set([MINDTREE_REF])
+    );
+    expect(getRegisteredSource(MINDTREE_REF)?.type).toBe("first_party");
+    expect(getRegisteredSource(MINDTREE_REF)?.id).toBe(MINDTREE_REF);
+  });
+
+  it("contains no alias that resolves the corpus identity to an upstream source", () => {
+    const upstreamIds = new Set(
+      Object.values(AUTHORITATIVE_SOURCE_REGISTRY)
+        .filter((source) => source.type === "upstream")
+        .map((source) => source.id)
+    );
+
+    expect(Object.hasOwn(SOURCE_ALIASES, CORPUS_REF)).toBe(false);
+    for (const [alias, canonicalId] of Object.entries(SOURCE_ALIASES)) {
+      if (alias === CORPUS_REF) expect(upstreamIds.has(canonicalId)).toBe(false);
+    }
+  });
+});
