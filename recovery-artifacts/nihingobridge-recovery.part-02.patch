diff --git a/src/services/knowledge/editorial/fieldProvenance.ts b/src/services/knowledge/editorial/fieldProvenance.ts
new file mode 100644
index 0000000..4d8d9f5
--- /dev/null
+++ b/src/services/knowledge/editorial/fieldProvenance.ts
@@ -0,0 +1,280 @@
+import { createHash } from "node:crypto";
+
+/** Source assertions and editorial statements are evidence; neither defines canonical identity. */
+export const EDITORIAL_CONTENT_SCHEMA = "nihongobridge-editorial-content@1" as const;
+export type FieldOrigin =
+  | { kind: "source_assertion"; id: string }
+  | { kind: "editorial_revision"; id: string };
+export interface FieldValue<T> { value: T; provenance: FieldOrigin }
+
+export interface CanonicalKanjiIdentity {
+  id: string;
+  /** Exact Unicode scalar. No normalization, compatibility folding or variant merge is performed. */
+  character: string;
+  variantOfIdentityId: string | null;
+}
+
+export interface SourceAssertion {
+  id: string;
+  sourceRef: string;
+  sourceVersion: string;
+  sourceRecordRef: string;
+  evidenceRef: string;
+  /** Explicit field paths asserted by this source record; values are never copied here. */
+  assertedFields: string[];
+}
+
+export interface FirstPartyEditorialRevision {
+  id: string;
+  contentId: string;
+  version: number;
+  previousRevisionId: string | null;
+  recordedOn: string;
+  authorAttribution: string;
+  identityTrust: "unverified_local_attribution";
+  changeSummary: string;
+  changedFields: string[];
+  /** Exact immutable snapshot for this authored revision, not an upstream copy. */
+  contentSnapshot: Record<string, unknown>;
+  contentDigest: string;
+  revisionDigest: string;
+}
+
+export interface KanjiContentRecord {
+  id: string;
+  identityId: string;
+  meaning: FieldValue<string> | null;
+  strokeCount: FieldValue<number> | null;
+  gradeLevel: FieldValue<number | null> | null;
+  jlptLevel: FieldValue<string | null> | null;
+  frequencyRank: FieldValue<number | null> | null;
+}
+export interface KanjiReadingRecord {
+  id: string;
+  kanjiContentId: string;
+  reading: FieldValue<string>;
+  kind: "on" | "kun" | "name" | "other";
+}
+export interface VocabularyRecord {
+  id: string;
+  writtenForm: FieldValue<string>;
+  readingIds: string[];
+}
+export interface SenseRecord {
+  id: string;
+  vocabularyId: string;
+  gloss: FieldValue<string>;
+  partOfSpeech: FieldValue<string[]> | null;
+}
+export interface ExampleRecord {
+  id: string;
+  vocabularyId: string | null;
+  sentence: FieldValue<string>;
+  reading: FieldValue<string> | null;
+  translation: FieldValue<string> | null;
+}
+
+export interface EditorialContentDataset {
+  schemaVersion: typeof EDITORIAL_CONTENT_SCHEMA;
+  identities: CanonicalKanjiIdentity[];
+  sourceAssertions: SourceAssertion[];
+  editorialRevisions: FirstPartyEditorialRevision[];
+  kanji: KanjiContentRecord[];
+  readings: KanjiReadingRecord[];
+  vocabulary: VocabularyRecord[];
+  senses: SenseRecord[];
+  examples: ExampleRecord[];
+}
+
+const HASH = /^[0-9a-f]{64}$/u;
+const DATE = /^\d{4}-\d{2}-\d{2}$/u;
+const SINGLE_CODE_POINT = (value: string) => typeof value === "string" && [...value].length === 1;
+
+function canonicalJson(value: unknown): string {
+  if (value === null || typeof value === "string" || typeof value === "boolean") return JSON.stringify(value);
+  if (typeof value === "number") {
+    if (!Number.isFinite(value)) throw new Error("Editorial content snapshot has a non-finite number.");
+    return JSON.stringify(value);
+  }
+  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(",")}]`;
+  if (typeof value === "object") {
+    const record = value as Record<string, unknown>;
+    return `{${Object.keys(record).sort().map((key) => `${JSON.stringify(key)}:${canonicalJson(record[key])}`).join(",")}}`;
+  }
+  throw new Error(`Editorial content snapshot contains unsupported ${typeof value}.`);
+}
+
+function sha256(value: string): string { return createHash("sha256").update(value, "utf8").digest("hex"); }
+
+export function digestEditorialContent(snapshot: Record<string, unknown>): string {
+  return sha256(canonicalJson(snapshot));
+}
+
+export function editorialRevisionDigest(value: Omit<FirstPartyEditorialRevision, "revisionDigest">): string {
+  return sha256(canonicalJson({
+    id: value.id,
+    contentId: value.contentId,
+    version: value.version,
+    previousRevisionId: value.previousRevisionId,
+    recordedOn: value.recordedOn,
+    authorAttribution: value.authorAttribution,
+    identityTrust: value.identityTrust,
+    changeSummary: value.changeSummary,
+    changedFields: [...value.changedFields],
+    contentDigest: value.contentDigest,
+  }));
+}
+
+function indexUnique<T extends { id: string }>(rows: readonly T[], label: string, issues: string[]): Map<string, T> {
+  const map = new Map<string, T>();
+  for (const row of rows) {
+    if (!row || typeof row.id !== "string" || !row.id.trim()) {
+      issues.push(`${label}: record has no ID`);
+      continue;
+    }
+    if (map.has(row.id)) issues.push(`${label}: duplicate ID ${row.id}`);
+    else map.set(row.id, row);
+  }
+  return map;
+}
+
+export function validateEditorialContentDataset(dataset: EditorialContentDataset): { valid: boolean; issues: string[] } {
+  const issues: string[] = [];
+  if (!dataset || dataset.schemaVersion !== EDITORIAL_CONTENT_SCHEMA) return { valid: false, issues: ["unsupported editorial content schema"] };
+  const identities = indexUnique(dataset.identities, "identity", issues);
+  const assertions = indexUnique(dataset.sourceAssertions, "source assertion", issues);
+  const revisions = indexUnique(dataset.editorialRevisions, "editorial revision", issues);
+  const kanji = indexUnique(dataset.kanji, "Kanji content", issues);
+  const readings = indexUnique(dataset.readings, "reading", issues);
+  const vocabulary = indexUnique(dataset.vocabulary, "vocabulary", issues);
+  indexUnique(dataset.senses, "sense", issues);
+  indexUnique(dataset.examples, "example", issues);
+
+  for (const identity of identities.values()) {
+    if (!SINGLE_CODE_POINT(identity.character)) issues.push(`${identity.id}: canonical identity must preserve one exact Unicode scalar`);
+    if (identity.variantOfIdentityId !== null && !identities.has(identity.variantOfIdentityId)) issues.push(`${identity.id}: variant target does not exist`);
+    if (identity.variantOfIdentityId === identity.id) issues.push(`${identity.id}: identity cannot be its own variant`);
+  }
+  for (const assertion of assertions.values()) {
+    if (!assertion.sourceRef.trim() || !assertion.sourceVersion.trim() || !assertion.sourceRecordRef.trim() || !assertion.evidenceRef.trim()) {
+      issues.push(`${assertion.id}: source assertion lacks source/release/record/evidence reference`);
+    }
+    if (!Array.isArray(assertion.assertedFields) || assertion.assertedFields.length === 0 || new Set(assertion.assertedFields).size !== assertion.assertedFields.length) {
+      issues.push(`${assertion.id}: assertedFields must be a non-empty unique list`);
+    }
+  }
+  const revisionStreams = new Map<string, FirstPartyEditorialRevision[]>();
+  for (const revision of revisions.values()) {
+    const stream = revisionStreams.get(revision.contentId) ?? [];
+    stream.push(revision);
+    revisionStreams.set(revision.contentId, stream);
+    if (!Number.isInteger(revision.version) || revision.version < 1) issues.push(`${revision.id}: invalid revision version`);
+    if (!DATE.test(revision.recordedOn) || Number.isNaN(Date.parse(`${revision.recordedOn}T00:00:00Z`))) issues.push(`${revision.id}: invalid recordedOn date`);
+    if (!revision.authorAttribution.trim() || revision.identityTrust !== "unverified_local_attribution") issues.push(`${revision.id}: local authorship must be explicit and remain unverified`);
+    if (!revision.changeSummary.trim() || !revision.changedFields.length) issues.push(`${revision.id}: change summary and changedFields are required`);
+    if (!revision.contentSnapshot || typeof revision.contentSnapshot !== "object" || Array.isArray(revision.contentSnapshot)) issues.push(`${revision.id}: content snapshot must be a plain object`);
+    if (!HASH.test(revision.contentDigest)) issues.push(`${revision.id}: invalid content digest`);
+    if (!HASH.test(revision.revisionDigest)) issues.push(`${revision.id}: invalid revision-event digest`);
+    if (revision.previousRevisionId !== null && !revisions.has(revision.previousRevisionId)) issues.push(`${revision.id}: previous revision is missing`);
+    const prior = revision.previousRevisionId ? revisions.get(revision.previousRevisionId) : null;
+    if (prior && (prior.contentId !== revision.contentId || prior.version + 1 !== revision.version)) issues.push(`${revision.id}: revision chain must stay on one content ID and increment exactly one version`);
+    try {
+      if (revision.contentDigest !== digestEditorialContent(revision.contentSnapshot)) issues.push(`${revision.id}: content snapshot digest mismatch`);
+      if (revision.revisionDigest !== editorialRevisionDigest(revision)) issues.push(`${revision.id}: revision-event digest mismatch`);
+    } catch {
+      issues.push(`${revision.id}: content snapshot cannot be deterministically digested`);
+    }
+  }
+  for (const [contentId, stream] of revisionStreams) {
+    stream.sort((a, b) => a.version - b.version);
+    if (stream.some((revision, index) => revision.version !== index + 1)) issues.push(`${contentId}: revision versions must be contiguous and unique starting at v1`);
+    if (stream[0]?.previousRevisionId !== null) issues.push(`${contentId}: first revision must start a new append-only chain`);
+  }
+
+  const field = (ownerId: string, path: string, value: FieldValue<unknown> | null | undefined) => {
+    if (value == null) return;
+    if (!value.provenance || typeof value.provenance.id !== "string") {
+      issues.push(`${ownerId}.${path}: field-level provenance is required`);
+      return;
+    }
+    if (value.provenance.kind === "source_assertion") {
+      const assertion = assertions.get(value.provenance.id);
+      if (!assertion) issues.push(`${ownerId}.${path}: source assertion ${value.provenance.id} is missing`);
+      else if (!assertion.assertedFields.includes(path)) issues.push(`${ownerId}.${path}: source assertion does not claim this field path`);
+    } else if (value.provenance.kind === "editorial_revision") {
+      const revision = revisions.get(value.provenance.id);
+      if (!revision) issues.push(`${ownerId}.${path}: editorial revision ${value.provenance.id} is missing`);
+      else if (revision.contentId !== ownerId || !revision.changedFields.includes(path)) issues.push(`${ownerId}.${path}: editorial revision is not for this content/field`);
+      else {
+        const segments = path.split(".");
+        let snapshotValue: unknown = revision.contentSnapshot;
+        let present = true;
+        for (const segment of segments) {
+          if (!snapshotValue || typeof snapshotValue !== "object" || !Object.prototype.hasOwnProperty.call(snapshotValue, segment)) { present = false; break; }
+          snapshotValue = (snapshotValue as Record<string, unknown>)[segment];
+        }
+        if (!present) issues.push(`${ownerId}.${path}: editorial revision snapshot omits the field`);
+        else {
+          try {
+            if (canonicalJson(snapshotValue) !== canonicalJson(value.value)) issues.push(`${ownerId}.${path}: field value differs from its cited editorial revision snapshot`);
+          } catch {
+            issues.push(`${ownerId}.${path}: field value cannot be compared to its editorial revision snapshot`);
+          }
+        }
+      }
+    } else {
+      issues.push(`${ownerId}.${path}: unsupported provenance kind`);
+    }
+  };
+
+  for (const record of kanji.values()) {
+    if (!identities.has(record.identityId)) issues.push(`${record.id}: canonical identity is missing`);
+    field(record.id, "meaning", record.meaning);
+    field(record.id, "strokeCount", record.strokeCount);
+    field(record.id, "gradeLevel", record.gradeLevel);
+    field(record.id, "jlptLevel", record.jlptLevel);
+    field(record.id, "frequencyRank", record.frequencyRank);
+  }
+  for (const record of readings.values()) {
+    if (!kanji.has(record.kanjiContentId)) issues.push(`${record.id}: parent Kanji content is missing`);
+    field(record.id, "reading", record.reading);
+  }
+  for (const record of vocabulary.values()) {
+    field(record.id, "writtenForm", record.writtenForm);
+    for (const readingId of record.readingIds) if (!readings.has(readingId)) issues.push(`${record.id}: reading ${readingId} is missing`);
+  }
+  for (const sense of dataset.senses) {
+    if (!vocabulary.has(sense.vocabularyId)) issues.push(`${sense.id}: vocabulary parent is missing`);
+    field(sense.id, "gloss", sense.gloss);
+    field(sense.id, "partOfSpeech", sense.partOfSpeech);
+  }
+  for (const example of dataset.examples) {
+    if (example.vocabularyId !== null && !vocabulary.has(example.vocabularyId)) issues.push(`${example.id}: vocabulary parent is missing`);
+    field(example.id, "sentence", example.sentence);
+    field(example.id, "reading", example.reading);
+    field(example.id, "translation", example.translation);
+  }
+  return { valid: issues.length === 0, issues: [...new Set(issues)].sort() };
+}
+
+/** Add a revision without mutating prior history; callers must supply the full changed-field list. */
+export function appendEditorialRevision(
+  history: readonly FirstPartyEditorialRevision[],
+  input: Omit<FirstPartyEditorialRevision, "version" | "previousRevisionId" | "contentDigest" | "revisionDigest">,
+): FirstPartyEditorialRevision[] {
+  const sameContent = history.filter((item) => item.contentId === input.contentId).sort((a, b) => a.version - b.version);
+  const prior = sameContent.at(-1) ?? null;
+  if (!input.authorAttribution.trim() || !input.changeSummary.trim() || input.changedFields.length === 0) throw new Error("Editorial revision requires local author attribution, a change summary and changed field paths.");
+  if (input.changedFields.some((field) => !field.trim()) || new Set(input.changedFields).size !== input.changedFields.length) throw new Error("Changed field paths must be non-empty and unique.");
+  if (!input.contentSnapshot || typeof input.contentSnapshot !== "object" || Array.isArray(input.contentSnapshot)) throw new Error("Editorial revision requires an exact object content snapshot.");
+  if (input.identityTrust !== "unverified_local_attribution") throw new Error("Local editorial attribution cannot be upgraded to verified identity.");
+  if (history.some((item) => item.id === input.id)) throw new Error(`Editorial revision ID already exists: ${input.id}`);
+  const base = {
+    ...input,
+    version: (prior?.version ?? 0) + 1,
+    previousRevisionId: prior?.id ?? null,
+    contentDigest: digestEditorialContent(input.contentSnapshot),
+  };
+  const next: FirstPartyEditorialRevision = { ...base, revisionDigest: editorialRevisionDigest(base) };
+  return [...history, next];
+}
