index 0000000..9e2a080
--- /dev/null
+++ b/src/services/knowledge/editorial/mindTreeEvidenceGraph.ts
@@ -0,0 +1,153 @@
+/** Source-decoupled, multi-decomposition graph contract. Validation is structural, not linguistic or legal review. */
+export const MINDTREE_EVIDENCE_GRAPH_SCHEMA = "nihongobridge-mindtree-evidence-graph@1" as const;
+
+export interface MindTreeCanonicalIdentity {
+  id: string;
+  /** Exact glyph/code-point sequence. Identity is not normalized or merged with a source assertion. */
+  character: string;
+  variantOfIdentityId: string | null;
+}
+export interface MindTreeSourceAssertion {
+  id: string;
+  sourceRef: string;
+  sourceVersion: string;
+  sourceRecordRef: string;
+  evidenceRef: string;
+}
+export interface MindTreeComponentOccurrence {
+  id: string;
+  componentIdentityId: string;
+  renderedAs: string;
+  position: string | null;
+  orderIndex: number;
+}
+export type MindTreeComponentRole = "radical" | "visual_component" | "semantic_component" | "phonetic_component";
+
+export interface MindTreeClaimEdge {
+  id: string;
+  fromOccurrenceId: string;
+  toOccurrenceId: string;
+  relation: "contains" | "role_claim" | "variant_claim";
+  /** Optional, explicitly asserted role. Resemblance never infers semantic/phonetic function. */
+  componentRole?: MindTreeComponentRole | null;
+  claim: string | null;
+  sourceAssertionId: string;
+}
+export interface MindTreeDecomposition {
+  id: string;
+  glyphIdentityId: string;
+  sourceAssertionId: string;
+  sourceRef: string;
+  sourceVersion: string;
+  occurrences: MindTreeComponentOccurrence[];
+  edges: MindTreeClaimEdge[];
+  state: "candidate" | "editorially_reviewed";
+  /** Neither state implies corpus membership, rights clearance, approval, or publication. */
+}
+export interface MindTreeEvidenceGraph {
+  schemaVersion: typeof MINDTREE_EVIDENCE_GRAPH_SCHEMA;
+  identities: MindTreeCanonicalIdentity[];
+  sourceAssertions: MindTreeSourceAssertion[];
+  decompositions: MindTreeDecomposition[];
+}
+
+function scalar(value: unknown): value is string { return typeof value === "string" && [...value].length === 1; }
+function nonempty(value: unknown): value is string { return typeof value === "string" && value.trim().length > 0; }
+function uniqueIndex<T extends { id: string }>(items: readonly T[], label: string, issues: string[]): Map<string, T> {
+  const result = new Map<string, T>();
+  for (const item of items) {
+    if (!item || !nonempty(item.id)) { issues.push(`${label}: missing identifier`); continue; }
+    if (result.has(item.id)) issues.push(`${label}: duplicate identifier ${item.id}`);
+    else result.set(item.id, item);
+  }
+  return result;
+}
+
+export function validateMindTreeEvidenceGraph(graph: MindTreeEvidenceGraph): { valid: boolean; issues: string[] } {
+  if (!graph || graph.schemaVersion !== MINDTREE_EVIDENCE_GRAPH_SCHEMA) return { valid: false, issues: ["unsupported Mind Tree evidence graph schema"] };
+  if (!Array.isArray(graph.identities) || !Array.isArray(graph.sourceAssertions) || !Array.isArray(graph.decompositions)) {
+    return { valid: false, issues: ["identities, sourceAssertions and decompositions must be arrays"] };
+  }
+  if (graph.identities.length > 100_000 || graph.sourceAssertions.length > 100_000 || graph.decompositions.length > 100_000) {
+    return { valid: false, issues: ["graph resource limit exceeded"] };
+  }
+  const issues: string[] = [];
+  const identities = uniqueIndex(graph.identities, "identity", issues);
+  const assertions = uniqueIndex(graph.sourceAssertions, "source assertion", issues);
+  const decompositions = uniqueIndex(graph.decompositions, "decomposition", issues);
+  for (const identity of identities.values()) {
+    if (!scalar(identity.character)) issues.push(`${identity.id}: identity must retain one exact Unicode scalar`);
+    if (identity.variantOfIdentityId !== null && !identities.has(identity.variantOfIdentityId)) issues.push(`${identity.id}: variant identity target is missing`);
+    if (identity.variantOfIdentityId === identity.id) issues.push(`${identity.id}: identity cannot be its own variant`);
+  }
+  for (const assertion of assertions.values()) {
+    if (![assertion.sourceRef, assertion.sourceVersion, assertion.sourceRecordRef, assertion.evidenceRef].every(nonempty)) {
+      issues.push(`${assertion.id}: source assertion must identify source, release, record and evidence`);
+    }
+  }
+  for (const decomposition of decompositions.values()) {
+    if (!identities.has(decomposition.glyphIdentityId)) issues.push(`${decomposition.id}: glyph canonical identity is missing`);
+    const source = assertions.get(decomposition.sourceAssertionId);
+    if (!source) issues.push(`${decomposition.id}: top-level source assertion is missing`);
+    else if (source.sourceRef !== decomposition.sourceRef || source.sourceVersion !== decomposition.sourceVersion) {
+      issues.push(`${decomposition.id}: source metadata does not match its source assertion`);
+    }
+    if (!Array.isArray(decomposition.occurrences) || !Array.isArray(decomposition.edges)) {
+      issues.push(`${decomposition.id}: occurrences and edges must be arrays`);
+      continue;
+    }
+    const occurrences = uniqueIndex(decomposition.occurrences, `${decomposition.id} occurrence`, issues);
+    for (const occurrence of occurrences.values()) {
+      if (!identities.has(occurrence.componentIdentityId)) issues.push(`${decomposition.id}/${occurrence.id}: component canonical identity is missing`);
+      if (!nonempty(occurrence.renderedAs) || (occurrence.position !== null && !nonempty(occurrence.position))) issues.push(`${decomposition.id}/${occurrence.id}: rendered form/position is invalid`);
+      if (!Number.isInteger(occurrence.orderIndex) || occurrence.orderIndex < 0) issues.push(`${decomposition.id}/${occurrence.id}: orderIndex must be a non-negative integer`);
+    }
+    if (decomposition.occurrences.length > 100_000 || decomposition.edges.length > 200_000) {
+      issues.push(`${decomposition.id}: graph resource limit exceeded`);
+      continue;
+    }
+    const edgeIds = new Set<string>();
+    const indegree = new Map([...occurrences.keys()].map((id) => [id, 0]));
+    const adjacency = new Map([...occurrences.keys()].map((id) => [id, [] as string[]]));
+    for (const edge of decomposition.edges) {
+      if (!edge || typeof edge !== "object") { issues.push(`${decomposition.id}: malformed edge`); continue; }
+      if (!nonempty(edge.id) || edgeIds.has(edge.id)) issues.push(`${decomposition.id}: missing or duplicate edge ID ${edge.id}`);
+      edgeIds.add(edge.id);
+      const hasFrom = occurrences.has(edge.fromOccurrenceId);
+      const hasTo = occurrences.has(edge.toOccurrenceId);
+      if (!hasFrom || !hasTo) issues.push(`${decomposition.id}/${edge.id}: edge endpoint is outside this decomposition`);
+      else {
+        adjacency.get(edge.fromOccurrenceId)?.push(edge.toOccurrenceId);
+        indegree.set(edge.toOccurrenceId, (indegree.get(edge.toOccurrenceId) ?? 0) + 1);
+      }
+      const evidence = assertions.get(edge.sourceAssertionId);
+      if (!evidence) issues.push(`${decomposition.id}/${edge.id}: edge-level source assertion is missing`);
+      else if (evidence.sourceRef !== decomposition.sourceRef) issues.push(`${decomposition.id}/${edge.id}: edge provenance crosses source boundaries`);
+      if (edge.relation === "role_claim" && !nonempty(edge.claim)) issues.push(`${decomposition.id}/${edge.id}: role claims require an explicit, sourced claim`);
+      if (edge.relation !== "role_claim" && edge.claim !== null) issues.push(`${decomposition.id}/${edge.id}: non-role relation cannot carry an unspecific claim`);
+      if (edge.componentRole != null && !["radical", "visual_component", "semantic_component", "phonetic_component"].includes(edge.componentRole)) {
+        issues.push(`${decomposition.id}/${edge.id}: unsupported component role`);
+      }
+      if (edge.componentRole != null && edge.relation !== "role_claim") issues.push(`${decomposition.id}/${edge.id}: component roles must be explicit role claims`);
+    }
+    const ready = [...indegree].filter(([, count]) => count === 0).map(([id]) => id);
+    let visited = 0;
+    while (ready.length) {
+      const node = ready.pop()!;
+      visited++;
+      for (const child of adjacency.get(node) ?? []) {
+        const remaining = (indegree.get(child) ?? 0) - 1;
+        indegree.set(child, remaining);
+        if (remaining === 0) ready.push(child);
+      }
+    }
+    if (visited !== occurrences.size) issues.push(`${decomposition.id}: decomposition edges contain a cycle`);
+  }
+  return { valid: issues.length === 0, issues: [...new Set(issues)].sort() };
+}
+
+/** Return distinct authored/source alternatives; never chooses a preferred decomposition. */
+export function decompositionsForIdentity(graph: MindTreeEvidenceGraph, identityId: string): MindTreeDecomposition[] {
+  if (!validateMindTreeEvidenceGraph(graph).valid) return [];
+  return graph.decompositions.filter((item) => item.glyphIdentityId === identityId);
+}
