+import {
+  K0_5A_INITIAL_RIGHTS_HISTORY,
+  publicDistributionDecision,
+  validateRightsHistory,
+} from "../provenance/rightsPolicy";
+import { mayAppearInPublicCorpus, validateKanjiMembershipHistory } from "./kanjiMembership";
+import type { SourceAssertion } from "./fieldProvenance";
+
+const COHORT = cohortData as ProvisionalCohort;
+const cohortCheck = validateProvisionalCohort(COHORT);
+if (!cohortCheck.valid) throw new Error(`K0.9 cohort seed is invalid: ${cohortCheck.issues.join("; ")}`);
+
+function asObject(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+function isIdentityPayload(value: unknown): value is FoundationIdentityPayload {
+  return asObject(value) && value.schemaVersion === "nihongobridge-kanji-foundation-cms-item@1" && value.kind === "identity";
+}
+function isFieldPayload(value: unknown): value is FoundationFieldPayload {
+  return asObject(value) && value.schemaVersion === "nihongobridge-kanji-foundation-cms-item@1" && value.kind === "field";
+}
+function hash(value: unknown): string { return sha256Foundation(value); }
+function isoNow(): string { return new Date().toISOString(); }
+
+function cmsForDeterministicItem(itemId?: string): CmsService {
+  let usedItemId = false;
+  return getCmsService({
+    generateId: (prefix) => {
+      if (prefix === "item" && itemId && !usedItemId) {
+        usedItemId = true;
+        return itemId;
+      }
+      return `k09-${prefix}-${randomUUID()}`;
+    },
+  });
+}
+
+function toFoundationItem(item: CmsItemRecord): FoundationCmsItem {
+  return {
+    id: item.id,
+    contentType: item.contentType,
+    entityId: item.entityId,
+    title: item.title,
+    status: item.status as CmsStatus,
+    currentVersion: item.currentVersion,
+    stagedPayload: item.stagedPayload,
+    sourceRef: item.sourceRef,
+    authorId: item.authorId,
+    reviewerId: item.reviewerId,
+    publishedAt: item.publishedAt,
+  };
+}
+
+function isK09Item(item: CmsItemRecord): boolean {
+  return item.contentType === "kanji" && item.entityId === null && item.sourceRef === KANJI_FOUNDATION_SOURCE_REF
+    && item.title.startsWith("K09|");
+}
+
+async function listK09Items(cms: CmsService): Promise<CmsItemRecord[]> {
+  const all: CmsItemRecord[] = [];
+  const limit = 100;
+  for (let offset = 0; offset <= 100_000; offset += limit) {
+    const page = await cms.listItems({ contentType: "kanji", q: "K09|", limit, offset });
+    all.push(...page.filter(isK09Item));
+    if (page.length < limit) return all;
+  }
+  throw CmsError.validation("K0.9 CMS listing exceeded the bounded paging limit.");
+}
+
+function expectedCurrentDigest(payload: FoundationIdentityPayload | FoundationFieldPayload): boolean {
+  const { revisionDigest, ...rest } = payload;
+  return typeof revisionDigest === "string" && revisionDigest === hash(rest);
+}
+
+function versionNumber(details: unknown): number | null {
+  return asObject(details) && Number.isInteger(details.versionNumber) ? Number(details.versionNumber) : null;
+}
+
+function verifiedRevisionInCmsHistory(input: {
+  payload: FoundationIdentityPayload | FoundationFieldPayload;
+  authorId: string;+  versions: Awaited<ReturnType<CmsService["getVersions"]>>;
+  audits: Awaited<ReturnType<CmsService["getAuditTrail"]>>;
+  revisionDigest: string;
+  reviewerId: string;
+}): boolean {
+  if (input.reviewerId === input.authorId) return false;
+  const before = input.versions.some((version) => {
+    if (!asObject(version.snapshotPayload)) return false;
+    const snapshot = version.snapshotPayload;
+    return snapshot.revisionDigest === input.revisionDigest
+      || (asObject(snapshot.editorialRevision) && snapshot.editorialRevision.revisionDigest === input.revisionDigest);
+  });
+  const verificationVersion = input.versions.find((version) => {
+    if (version.statusAtSnapshot !== "draft" || !asObject(version.snapshotPayload) || version.createdById !== input.reviewerId) return false;
+    const snapshot = version.snapshotPayload;
+    const review = isFieldPayload(input.payload)
+      ? asObject(snapshot.provenance) && asObject(snapshot.provenance.verification) ? snapshot.provenance.verification : null
+      : asObject(snapshot.membership) && asObject(snapshot.membership.evidenceVerification) ? snapshot.membership.evidenceVerification : null;
+    return asObject(review) && review.revisionDigest === input.revisionDigest && review.reviewerId === input.reviewerId;
+  });
+  return before && Boolean(verificationVersion && input.audits.some((audit) => audit.action === "edit"
+    && audit.actorId === input.reviewerId && versionNumber(audit.details) === verificationVersion.versionNumber));
+}
+
+function assertK09CmsItem(item: CmsItemRecord): void {
+  if (!isK09Item(item)) throw CmsError.notFound("K0.9 foundation item", item.id);
+  if (!isIdentityPayload(item.stagedPayload) && !isFieldPayload(item.stagedPayload)) throw CmsError.validation("Stored K0.9 item payload is invalid.");
+}
+
+function validateSafeIdentity(character: string): { identityId: string; codePoint: string } {
+  if ([...character].length !== 1 || !/\p{Script=Han}/u.test(character)) {
+    throw CmsError.validation("A new identity must be exactly one Han Unicode scalar; no normalization or variant merge is applied.", { field: "character" });
+  }
+  const point = character.codePointAt(0)!;
+  const hex = point.toString(16).toLowerCase();
+  return {
+    identityId: `kanji-u${hex}`,
+    codePoint: `U+${point.toString(16).toUpperCase().padStart(4, "0")}`,
+  };
+}
+
+function toSeed(character: string, identityId: string, codePoint: string, now: string): ProvisionalIdentitySeed {
+  return {
+    identityId,
+    character,
+    codePoint,
+    variantRelationship: "UNASSESSED",
+    membershipState: "CANDIDATE",
+    editorialStatus: "DRAFT",
+    createdAt: now,
+    createdBy: null,
+    creationMethod: "K0.9 identity-only provisional shell",
+    fields: {},
+  };
+}
+
+export class KanjiFoundationWorkflow {
+  private readonly clock: () => Date;
+  private readonly cmsFactory: (deterministicItemId?: string) => CmsService;
+
+  constructor(options: { clock?: () => Date; cmsFactory?: (deterministicItemId?: string) => CmsService } = {}) {
+    this.clock = options.clock ?? (() => new Date());
+    this.cmsFactory = options.cmsFactory ?? cmsForDeterministicItem;
+  }
+
+  async listInternal(): Promise<{
+    cohort: ProvisionalCohort;
+    records: Array<{ item: CmsItemRecord; versions: unknown[]; audits: unknown[] }>;
+    publicDelivery: Array<{ identityId: string; fieldKeys: string[] }>;
+  }> {
+    const cms = this.cmsFactory();
+    const [cohortRecords, all] = [COHORT.records, await listK09Items(cms)];
+    const records = await Promise.all(all.map(async (item) => ({
+      item,
+      versions: await cms.getVersions(item.id),
+      audits: await cms.getAuditTrail(item.id),
+    })));
+    const projection = await this.publicProjection();
+    return {
+      cohort: { ...COHORT, records: cohortRecords },
+      records,
+      publicDelivery: projection.kanji.map((entry) => ({ identityId: entry.identityId, fieldKeys: entry.fields.map((field) => field.key) })),
+    };
+  }
+
+  async getInternalItem(itemId: string): Promise<{ item: CmsItemRecord; versions: unknown[]; audits: unknown[] }> {
+    const cms = this.cmsFactory();
+    const item = await cms.getItem(itemId);
+    assertK09CmsItem(item);
+    return { item, versions: await cms.getVersions(itemId), audits: await cms.getAuditTrail(itemId) };
+  }
+
+  async createCohortShell(identityId: string): Promise<CmsItemRecord> {
+    const seed = COHORT.records.find((row) => row.identityId === identityId);
+    if (!seed) throw CmsError.notFound("provisional K0.9 identity", identityId);
+    return this.createIdentityShell(seed);
+  }
+
+  async createIdentityShell(seed: ProvisionalIdentitySeed): Promise<CmsItemRecord> {
+    const itemId = identityCmsItemId(seed.identityId);
+    const cms = this.cmsFactory(itemId);
+    try {
+      const current = await cms.getItem(itemId);
+      assertK09CmsItem(current);
+      if (!isIdentityPayload(current.stagedPayload) || current.stagedPayload.identity.identityId !== seed.identityId) {
+        throw CmsError.validation("Deterministic identity ID is already occupied by a different K0.9 item.");
+      }
+      return current;
+    } catch (error) {
+      if (!(error instanceof CmsError) || error.code !== "NOT_FOUND") throw error;
+    }
+    const now = this.clock().toISOString();
+    const payload = createIdentityDraftPayload(seed, now);
+    return cms.createDraft({
+      contentType: "kanji",
+      entityId: null,
+      title: identityCmsTitle(seed.identityId),
+      stagedPayload: payload,
+      sourceRef: KANJI_FOUNDATION_SOURCE_REF,
+      provenanceType: "editorial_curated",
+      changeSummary: "Create empty K0.9 provisional identity shell; no substantive Kanji fields or membership decisions.",
+    });
+  }
+
+  async createNewIdentityShell(character: string): Promise<CmsItemRecord> {
+    const { identityId, codePoint } = validateSafeIdentity(character);
+    const now = this.clock().toISOString();
+    return this.createIdentityShell(toSeed(character, identityId, codePoint, now));
+  }
+
+  async createField(input: {
+    identityId: string;
+    fieldKey: string;
+    value: unknown;
+    creationMethod: FoundationCreationMethod;
+    sourceAssertions?: SourceAssertion[];
+  }): Promise<CmsItemRecord> {
+    const contributor = await requirePermission("cms.create");
+    const cms = this.cmsFactory();
+    const identityItem = await cms.getItem(identityCmsItemId(input.identityId));
+    assertK09CmsItem(identityItem);
+    if (!isIdentityPayload(identityItem.stagedPayload)) throw CmsError.validation("Field parent is not an identity shell.");
+    const fieldItems = (await listK09Items(cms)).filter((item) => isFieldPayload(item.stagedPayload)
+      && item.stagedPayload.identityId === input.identityId && item.stagedPayload.fieldKey === input.fieldKey)
+      .sort((a, b) => (isFieldPayload(a.stagedPayload) ? a.stagedPayload.revisionNumber : 0) - (isFieldPayload(b.stagedPayload) ? b.stagedPayload.revisionNumber : 0));
+    const previousItem = fieldItems.at(-1);
+    const previous = previousItem && isFieldPayload(previousItem.stagedPayload) ? previousItem.stagedPayload : undefined;
+    if (previousItem?.status === "review") {
+      throw CmsError.validation("A reviewer must approve or request changes on the current revision before another field revision is created.", { status: previousItem.status });
+    }
+    const now = this.clock().toISOString();
+    const payload = createFoundationFieldPayload({
+      identityId: input.identityId,
+      character: identityItem.stagedPayload.identity.character,
+      fieldKey: input.fieldKey,
+      value: input.value,
+      creationMethod: input.creationMethod,
+      contributorId: contributor.id,
+      recordedAt: now,
+      sourceAssertions: input.sourceAssertions,
+      previous,
+    });
+    if (previousItem?.status === "draft") {
+      return cms.updateDraft(previousItem.id, {
+        expectedVersion: previousItem.currentVersion,
+        title: fieldCmsTitle(input.identityId, input.fieldKey, payload.revisionNumber),
+        stagedPayload: payload,
+        changeSummary: `K0.9 field revision ${payload.revisionNumber}`,
+      });
+    }
+    const itemId = fieldCmsItemId(input.identityId, input.fieldKey, payload.revisionNumber);
+    return this.cmsFactory(itemId).createDraft({
+      contentType: "kanji",
+      entityId: null,
+      title: fieldCmsTitle(input.identityId, input.fieldKey, payload.revisionNumber),
+      stagedPayload: payload,
+      sourceRef: KANJI_FOUNDATION_SOURCE_REF,
+      provenanceType: "editorial_curated",
+      changeSummary: `Create K0.9 first-party field draft ${input.fieldKey}; no public-delivery claim.`,
+    });
+  }
+
+  async verifyField(itemId: string, evidenceRef: string, evidenceSha256: string): Promise<CmsItemRecord> {
+    const actor = await requireRole("admin");
+    const cms = this.cmsFactory();
+    const item = await cms.getItem(itemId);
+    assertK09CmsItem(item);
+    if (item.status !== "draft" || !isFieldPayload(item.stagedPayload) || !expectedCurrentDigest(item.stagedPayload)) {
+      throw CmsError.validation("Only a valid draft field revision may receive a provenance review.");
+    }
+    const payload = verifyFoundationFieldProvenance({
+      payload: item.stagedPayload,
+      reviewerId: actor.id,
+      evidenceRef,
+      evidenceSha256,
+      verifiedAt: this.clock().toISOString(),
+    });
+    return cms.updateDraft(item.id, {
+      expectedVersion: item.currentVersion,
+      stagedPayload: payload,
+      changeSummary: `K0.9 provenance review bound to field revision ${item.stagedPayload.editorialRevision.revisionDigest}`,
+    });
+  }
+
+  async setFieldRights(input: {
+    itemId: string;
+    sourceRef?: string;
+    scope: "retention" | "internal_analysis" | "derivation" | "public_distribution";
+    state: "CLEARED" | "CONDITIONAL" | "BLOCKED" | "UNKNOWN";
+    evidenceRef: string;
+    evidenceClass: "owner_authorization" | "primary_license" | "qualified_review" | "project_gate_record";
+    evidenceSha256: string | null;
+    qualifiedReviewRef?: string | null;
+    qualifiedReviewSha256?: string | null;
+    rationale: string;
+  }): Promise<CmsItemRecord> {
