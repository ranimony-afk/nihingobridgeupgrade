--- /dev/null
+++ b/src/lib/dictionary/publicRights.ts
@@ -0,0 +1,34 @@
+import { publiclyAllowedSourceRefs } from "@/services/knowledge/provenance/rightsEnforcement";
+import type { SourceDomain } from "@/services/knowledge/provenance/types";
+
+/** Only sources with both derivation and public distribution CLEARED may be queried. */
+export class RightsDeliveryDeniedError extends Error {
+  constructor() {
+    super("[RIGHTS_GATE] Dictionary delivery denied: no source has both derivation and public distribution cleared.");
+    this.name = "RightsDeliveryDeniedError";
+  }
+}
+
+export function dictionaryPublicSourceRefs(): string[] {
+  return publiclyAllowedSourceRefs(["dictionary"]);
+}
+
+export function requireDictionaryPublicSourceRefs(): string[] {
+  const sourceRefs = dictionaryPublicSourceRefs();
+  if (sourceRefs.length === 0) throw new RightsDeliveryDeniedError();
+  return sourceRefs;
+}
+
+export function publicSourceRefsForDomain(domain: SourceDomain): string[] {
+  return publiclyAllowedSourceRefs([domain]);
+}
+
+export function dictionaryRightsWithheldPayload() {
+  return {
+    success: false,
+    error: {
+      code: "RIGHTS_RESTRICTED",
+      message: "This content is temporarily unavailable.",
+    },
+  } as const;
+}
diff --git a/src/lib/kanji/deliveryPolicySnapshot.ts b/src/lib/kanji/deliveryPolicySnapshot.ts
new file mode 100644
index 0000000..3aac75f
--- /dev/null
+++ b/src/lib/kanji/deliveryPolicySnapshot.ts
@@ -0,0 +1,194 @@
+import { createHash } from "node:crypto";
+import {
+  publicDistributionDecision,
+  RIGHTS_POLICY_VERSION,
+  validateRightsHistory,
+  type RightsHistoryEvent,
+} from "@/services/knowledge/provenance/rightsPolicy";
+import {
+  KANJI_MEMBERSHIP_SCHEMA,
+  mayAppearInPublicCorpus,
+  validateKanjiMembershipHistory,
+  type KanjiMembershipEvent,
+} from "@/services/knowledge/editorial/kanjiMembership";
+
+export const KANJI_DELIVERY_SNAPSHOT_SCHEMA = "nihongobridge-kanji-delivery-snapshot@1" as const;
+
+export interface EditorialPublicationSnapshot {
+  id: string;
+  character: string;
+  version: number;
+  origin: "first_party" | "editorial" | "ai_candidate";
+  editorialStatus: string;
+  provenanceRef: string;
+  sourceReferences: readonly string[];
+  reviewerId: string | null;
+  reviewedAt: string | null;
+  publishedAt: string | null;
+  revisionDigest: string | null;
+}
+
+/**
+ * Trusted server-side inputs that can affect Kanji/MindTree public delivery.
+ * Production resolves this from immutable checked-in policy/content snapshots.
+ * Tests may construct synthetic snapshots; request data must never be used here.
+ */
+export interface KanjiDeliveryPolicySnapshot {
+  schemaVersion: typeof KANJI_DELIVERY_SNAPSHOT_SCHEMA;
+  rightsPolicyVersion: typeof RIGHTS_POLICY_VERSION;
+  membershipSchemaVersion: typeof KANJI_MEMBERSHIP_SCHEMA;
+  sourceVersions: readonly string[];
+  sourceSets: readonly { name: string; sourceRefs: readonly string[] }[];
+  rightsHistory: readonly RightsHistoryEvent[];
+  membershipHistory: readonly KanjiMembershipEvent[];
+  membershipEvidenceVerified: boolean;
+  editorialReleaseAuthorizationVerified: boolean;
+  editorialRecords: readonly EditorialPublicationSnapshot[];
+}
+
+export class KanjiRightsDeliveryDeniedError extends Error {
+  constructor() {
+    super("Kanji content is temporarily unavailable.");
+    this.name = "KanjiRightsDeliveryDeniedError";
+  }
+}
+
+export type KanjiDeliveryPolicyDecision = {
+  allowed: boolean;
+  blockers: Array<{ sourceRef: string; scope: string; state: string }>;
+  reason: string;
+};
+
+function canonicalJson(value: unknown): string {
+  if (value === null || typeof value === "string" || typeof value === "boolean") return JSON.stringify(value);
+  if (typeof value === "number") {
+    if (!Number.isFinite(value)) throw new Error("invalid policy number");
+    return JSON.stringify(value);
+  }
+  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(",")}]`;
+  if (typeof value === "object") {
+    const record = value as Record<string, unknown>;
+    return `{${Object.keys(record).sort().map((key) => `${JSON.stringify(key)}:${canonicalJson(record[key])}`).join(",")}}`;
+  }
+  throw new Error("unsupported policy snapshot value");
+}
+
+function validateSnapshot(snapshot: KanjiDeliveryPolicySnapshot): boolean {
+  try {
+    if (!snapshot || snapshot.schemaVersion !== KANJI_DELIVERY_SNAPSHOT_SCHEMA ||
+      snapshot.rightsPolicyVersion !== RIGHTS_POLICY_VERSION ||
+      snapshot.membershipSchemaVersion !== KANJI_MEMBERSHIP_SCHEMA ||
+      typeof snapshot.membershipEvidenceVerified !== "boolean" ||
+      typeof snapshot.editorialReleaseAuthorizationVerified !== "boolean" ||
+      !Array.isArray(snapshot.sourceVersions) || !Array.isArray(snapshot.sourceSets) ||
+      !Array.isArray(snapshot.rightsHistory) || !Array.isArray(snapshot.membershipHistory) ||
+      !Array.isArray(snapshot.editorialRecords)) return false;
+  if (!validateRightsHistory(snapshot.rightsHistory).valid ||
+      !validateKanjiMembershipHistory(snapshot.membershipHistory).valid) return false;
+  if ((snapshot.sourceVersions as unknown[]).some((version: unknown) => typeof version !== "string" || !version.trim())) return false;
+  if ((snapshot.sourceSets as unknown[]).some((value: unknown) => {
+    if (!value || typeof value !== "object") return true;
+    const set = value as { name?: unknown; sourceRefs?: unknown };
+    return typeof set.name !== "string" || !set.name.trim() || !Array.isArray(set.sourceRefs) ||
+      set.sourceRefs.some((ref: unknown) => typeof ref !== "string" || !ref.trim());
+  })) return false;
+  if ((snapshot.editorialRecords as unknown[]).some((value: unknown) => {
+    if (!value || typeof value !== "object") return true;
+    const record = value as Record<string, unknown>;
+    return typeof record.id !== "string" || !record.id.trim() || typeof record.character !== "string" ||
+      Array.from(record.character).length !== 1 || !Number.isInteger(record.version) || Number(record.version) < 1 ||
+      !["first_party", "editorial", "ai_candidate"].includes(String(record.origin)) ||
+      typeof record.editorialStatus !== "string" || !record.editorialStatus.trim() ||
+      typeof record.provenanceRef !== "string" || !record.provenanceRef.trim() ||
+      !Array.isArray(record.sourceReferences) || !record.sourceReferences.length ||
+      record.sourceReferences.some((ref: unknown) => typeof ref !== "string" || !ref.trim()) ||
+      !["reviewerId", "reviewedAt", "publishedAt", "revisionDigest"].every((key) =>
+        record[key] === null || typeof record[key] === "string") ||
+      (record.revisionDigest !== null && record.revisionDigest !== undefined &&
+        !/^[0-9a-f]{64}$/u.test(String(record.revisionDigest)));
+  })) return false;
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/** Stable internal digest. Never serialize this digest or the snapshot into a learner payload. */
+export function digestKanjiDeliveryPolicySnapshot(snapshot: KanjiDeliveryPolicySnapshot): string {
+  if (!validateSnapshot(snapshot)) throw new KanjiRightsDeliveryDeniedError();
+  try {
+    return createHash("sha256").update(canonicalJson(snapshot), "utf8").digest("hex");
+  } catch {
+    throw new KanjiRightsDeliveryDeniedError();
+  }
+}
+
+export function decideKanjiDeliveryFromSnapshot(
+  snapshot: KanjiDeliveryPolicySnapshot,
+  sourceRefs: readonly string[],
+  character?: string,
+  editorialRecordId?: string,
+): KanjiDeliveryPolicyDecision {
+  if (!validateSnapshot(snapshot)) {
+    return { allowed: false, blockers: [{ sourceRef: "", scope: "public_distribution", state: "UNKNOWN" }], reason: "policy_unavailable" };
+  }
+  const rights = publicDistributionDecision(snapshot.rightsHistory, sourceRefs);
+  if (!rights.allowed) return { ...rights, reason: "source_rights_not_cleared" };
+
+  if (!character) return { allowed: false, blockers: [], reason: "membership_not_bound_to_character" };
+  const events = snapshot.membershipHistory
+    .filter((event) => event.exactCharacter === character)
+    .sort((left, right) => left.sequence - right.sequence);
+  const membership = mayAppearInPublicCorpus({
+    latestEvent: events.at(-1) ?? null,
+    rightsHistory: snapshot.rightsHistory,
+    membershipEvidenceVerified: snapshot.membershipEvidenceVerified,
+  });
+  if (!membership.allowed) return { allowed: false, blockers: [], reason: membership.reason };
+
+  if (editorialRecordId) {
+    const record = snapshot.editorialRecords.find((item) => item.id === editorialRecordId);
+    if (!record || record.character !== character || record.editorialStatus !== "published" ||
+        record.origin === "ai_candidate" || !record.reviewerId || !record.reviewedAt ||
+        !record.publishedAt || !snapshot.editorialReleaseAuthorizationVerified) {
+      return { allowed: false, blockers: [], reason: "editorial_publication_not_verified" };
+    }
+    const editorialRights = publicDistributionDecision(snapshot.rightsHistory, record.sourceReferences);
+    if (!editorialRights.allowed) return { ...editorialRights, reason: "editorial_source_rights_not_cleared" };
+  }
+  return { allowed: true, blockers: [], reason: "policy_snapshot_allows_delivery" };
+}
+
+export function assertKanjiDeliveryAllowedBySnapshot(
+  snapshot: KanjiDeliveryPolicySnapshot,
+  sourceRefs: readonly string[],
+  character?: string,
+  editorialRecordId?: string,
+): void {
+  if (!decideKanjiDeliveryFromSnapshot(snapshot, sourceRefs, character, editorialRecordId).allowed) {
+    throw new KanjiRightsDeliveryDeniedError();
+  }
+}
+
+/**
+ * Enforce the same trusted-snapshot contract before and after a read. A snapshot
+ * change during an asynchronous read discards the result; a test-only resolver
+ * can model a transition without mutating production policy or touching a DB.
+ */
+export async function runWithKanjiDeliveryPolicySnapshot<T>(input: {
+  resolveSnapshot: () => KanjiDeliveryPolicySnapshot;
+  sourceRefs: readonly string[];
+  character?: string;
+  editorialRecordId?: string;
+  read: () => T | Promise<T>;
+}): Promise<T> {
+  const before = input.resolveSnapshot();
+  const beforeDigest = digestKanjiDeliveryPolicySnapshot(before);
+  assertKanjiDeliveryAllowedBySnapshot(before, input.sourceRefs, input.character, input.editorialRecordId);
+  const value = await input.read();
+  const after = input.resolveSnapshot();
+  const afterDigest = digestKanjiDeliveryPolicySnapshot(after);
+  assertKanjiDeliveryAllowedBySnapshot(after, input.sourceRefs, input.character, input.editorialRecordId);
+  if (afterDigest !== beforeDigest) throw new KanjiRightsDeliveryDeniedError();
+  return value;
+}
