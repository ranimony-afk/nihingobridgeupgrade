+  for (const candidate of snapshot.items) {
+    const staged = candidate.item.stagedPayload;
+    if (!object(staged) || staged.schemaVersion !== KANJI_FOUNDATION_ITEM_SCHEMA || staged.kind !== "identity" || !object(staged.identity)) continue;
+    const identityId = staged.identity.identityId;
+    const character = staged.identity.character;
+    if (typeof identityId !== "string" || typeof character !== "string") continue;
+    const previousItemId = identityIds.get(identityId);
+    const previousIdentityId = identityCharacters.get(character);
+    if ((previousItemId && previousItemId !== candidate.item.id) || (previousIdentityId && previousIdentityId !== identityId)) {
+      throw new Error("K0.9 export contains duplicate canonical identity IDs or exact characters.");
+    }
+    identityIds.set(identityId, candidate.item.id);
+    identityCharacters.set(character, identityId);
+  }
+  const identities = snapshot.items.flatMap((item) => {
+    const identity = identityEligibility(item, snapshot.rightsHistory);
+    return identity ? [{ input: item, identity }] : [];
+  });
+  const latestFields = new Map<string, FoundationProjectionItem>();
+  for (const candidate of snapshot.items) {
+    const staged = candidate.item.stagedPayload;
+    if (!object(staged) || staged.schemaVersion !== KANJI_FOUNDATION_ITEM_SCHEMA || staged.kind !== "field" || typeof staged.identityId !== "string" || typeof staged.fieldKey !== "string" || !Number.isInteger(staged.revisionNumber)) continue;
+    const key = `${staged.identityId}\u0000${staged.fieldKey}`;
+    const prior = latestFields.get(key);
+    const priorPayload = prior?.item.stagedPayload;
+    if (priorPayload && object(priorPayload) && Number(staged.revisionNumber) === Number(priorPayload.revisionNumber)
+      && prior.item.id !== candidate.item.id) throw new Error(`K0.9 export contains conflicting ${key} field revision ${String(staged.revisionNumber)}.`);
+    if (!priorPayload || !object(priorPayload) || Number(staged.revisionNumber) > Number(priorPayload.revisionNumber)) latestFields.set(key, candidate);
+  }
+  const output: FoundationPublicKanji[] = [];
+  for (const { identity, input: identityItem } of identities) {
+    const fields = [...latestFields.values()].flatMap((candidate) => {
+      const field = fieldEligibility(candidate, identity, snapshot.rightsHistory);
+      if (!field) return [];
+      const value = safePublicValue(field.fieldKey as FoundationPublicFieldKey, field.field.value);
+      if (value === null) return [];
+      return [{ key: field.fieldKey as FoundationPublicFieldKey, value }];
+    }).sort((a, b) => a.key.localeCompare(b.key));
+    output.push({
+      identityId: identity.identity.identityId,
+      character: identity.identity.character,
+      codePoint: identity.identity.codePoint,
+      fields,
+    });
+    void identityItem;
+  }
+  output.sort((a, b) => a.character.codePointAt(0)! - b.character.codePointAt(0)!);
+  const canonical = { schemaVersion: KANJI_FOUNDATION_EXPORT_SCHEMA, generatedAt, kanji: output };
+  return { ...canonical, contentDigest: sha256Foundation({ schemaVersion: canonical.schemaVersion, kanji: output }) };
+}
+
+/** Internal build report only; never serialized in learner responses or the derived public artifact. */
+export function diagnoseFoundationProjection(snapshot: FoundationCmsSnapshot, projection: FoundationProjectionResult): FoundationPipelineRejection[] {
+  const visibleIdentityIds = new Set(projection.kanji.map((entry) => entry.identityId));
+  const visibleFields = new Set(projection.kanji.flatMap((entry) => entry.fields.map((field) => `${entry.identityId}\u0000${field.key}`)));
+  const rejections: FoundationPipelineRejection[] = [];
+  for (const candidate of snapshot.items) {
+    const staged = candidate.item.stagedPayload;
+    if (!object(staged) || staged.schemaVersion !== KANJI_FOUNDATION_ITEM_SCHEMA || !["identity", "field"].includes(String(staged.kind))) {
+      rejections.push({ itemId: candidate.item.id, kind: "unknown", reasonCode: "INVALID_K09_PAYLOAD_SCHEMA" });
+      continue;
+    }
+    if (staged.kind === "identity") {
+      const payload = staged as unknown as FoundationIdentityPayload;
+      const identityId = object(payload.identity) && typeof payload.identity.identityId === "string" ? payload.identity.identityId : undefined;
+      if (candidate.item.status !== "published") rejections.push({ itemId: candidate.item.id, kind: "identity", ...(identityId ? { identityId } : {}), reasonCode: `CMS_STATUS_${String(candidate.item.status).toUpperCase()}` });
+      else if (!identityStructureIsValid(payload)) rejections.push({ itemId: candidate.item.id, kind: "identity", ...(identityId ? { identityId } : {}), reasonCode: "IDENTITY_SCHEMA_OR_MEMBERSHIP_HISTORY_INVALID" });
+      else if (payload.membership.state !== "PUBLISHED") rejections.push({ itemId: candidate.item.id, kind: "identity", identityId, reasonCode: "MEMBERSHIP_NOT_PUBLISHED" });
+      else if (!payload.membership.evidenceVerification || !verificationWasPersisted(candidate, payload, payload.membership.evidenceVerification)) rejections.push({ itemId: candidate.item.id, kind: "identity", identityId, reasonCode: "MEMBERSHIP_EVIDENCE_REVIEW_NOT_PERSISTED" });
+      else if (!publicDistributionDecision([...snapshot.rightsHistory, ...payload.identityRightsHistory], [payload.identitySourceRef]).allowed) rejections.push({ itemId: candidate.item.id, kind: "identity", identityId, reasonCode: "IDENTITY_RIGHTS_NOT_CLEARED" });
+      else if (!visibleIdentityIds.has(identityId ?? "")) rejections.push({ itemId: candidate.item.id, kind: "identity", ...(identityId ? { identityId } : {}), reasonCode: "IDENTITY_REVIEW_OR_DELIVERY_AUDIT_GATE_FAILED" });
+      continue;
+    }
+    const payload = staged as unknown as FoundationFieldPayload;
+    const identityId = typeof payload.identityId === "string" ? payload.identityId : undefined;
+    const fieldKey = typeof payload.fieldKey === "string" ? payload.fieldKey : undefined;
+    const detail = { itemId: candidate.item.id, kind: "field" as const, ...(identityId ? { identityId } : {}), ...(fieldKey ? { fieldKey } : {}) };
+    if (candidate.item.status !== "published") rejections.push({ ...detail, reasonCode: `CMS_STATUS_${String(candidate.item.status).toUpperCase()}` });
+    else if (!fieldProvenanceIsComplete(payload)) rejections.push({ ...detail, reasonCode: "FIELD_PROVENANCE_MISSING_OR_INVALID" });
+    else if (!fieldStructureIsValid(payload)) rejections.push({ ...detail, reasonCode: "FIELD_SCHEMA_OR_CONTENT_INVALID" });
+    else if (payload.provenance.state !== "VERIFIED") rejections.push({ ...detail, reasonCode: "FIELD_PROVENANCE_NOT_VERIFIED" });
+    else if (!payload.provenance.verification || !verificationWasPersisted(candidate, payload, payload.provenance.verification)) rejections.push({ ...detail, reasonCode: "FIELD_REVIEW_EVENT_NOT_PERSISTED" });
+    else if (!visibleIdentityIds.has(payload.identityId)) rejections.push({ ...detail, reasonCode: "IDENTITY_NOT_PUBLICLY_ELIGIBLE" });
+    else if (!publicDistributionDecision([...snapshot.rightsHistory, ...payload.rightsHistory], [payload.fieldSourceRef, ...payload.provenance.sourceAssertions.map((assertion) => assertion.sourceRef)]).allowed) rejections.push({ ...detail, reasonCode: "FIELD_SOURCE_RIGHTS_NOT_CLEARED" });
+    else if (!visibleFields.has(`${payload.identityId}\u0000${payload.fieldKey}`)) rejections.push({ ...detail, reasonCode: "FIELD_CONTENT_OR_PUBLICATION_AUDIT_GATE_FAILED" });
+  }
+  return rejections.sort((a, b) => a.itemId.localeCompare(b.itemId) || a.reasonCode.localeCompare(b.reasonCode));
+}
+
+/** Helper for explicit state labels in the authorized internal preview only. */
+export function cmsEditorialLabel(status: string): "NO_DATA" | "DRAFT" | "IN_REVIEW" | "APPROVED_UNPUBLISHED" | "PUBLISHED" | "BLOCKED" {
+  if (status === "draft") return "DRAFT";
+  if (status === "review") return "IN_REVIEW";
+  if (status === "approved" || status === "scheduled") return "APPROVED_UNPUBLISHED";
+  if (status === "published") return "PUBLISHED";
+  if (status === "archived") return "BLOCKED";
+  return "NO_DATA";
+}
+
+export function rightsStatusForField(payload: FoundationFieldPayload, sharedHistory: readonly RightsHistoryEvent[] = []): RightsState {
+  const history = [...K0_5A_INITIAL_RIGHTS_HISTORY, ...sharedHistory, ...payload.rightsHistory];
+  const decision = publicDistributionDecision(history, [payload.fieldSourceRef]);
+  return decision.allowed ? "CLEARED" : decision.blockers.find((item) => item.scope === "public_distribution")?.state ?? "UNKNOWN";
+}
diff --git a/src/services/knowledge/editorial/kanjiFoundationBuildReport.ts b/src/services/knowledge/editorial/kanjiFoundationBuildReport.ts
new file mode 100644
index 0000000..060c1f1
--- /dev/null
+++ b/src/services/knowledge/editorial/kanjiFoundationBuildReport.ts
@@ -0,0 +1,298 @@
+import { createHash } from "node:crypto";
+import {
+  canonicalFoundationJson,
+  diagnoseFoundationProjection,
+  type FoundationCmsSnapshot,
+  type FoundationPipelineRejection,
+  type FoundationProjectionResult,
+} from "./kanjiFoundation";
+import { currentRightsState, publicDistributionDecision, RIGHTS_SCOPES, type RightsHistoryEvent, type RightsScope, type RightsState } from "../provenance/rightsPolicy";
+
+export const KANJI_FOUNDATION_CANDIDATE_REPORT_SCHEMA = "nihongobridge-kanji-foundation-candidate-report@1" as const;
+export const KANJI_FOUNDATION_PIPELINE_VERSION = "k0.10-candidate-path@1" as const;
+
+export type FoundationCandidateOutcome =
+  | "ELIGIBLE_FOR_PUBLIC_PROJECTION"
+  | "REJECTED"
+  | "BLOCKED_RIGHTS"
+  | "BLOCKED_PROVENANCE"
+  | "BLOCKED_HUMAN_REVIEW"
+  | "INVALID_INPUT"
+  | "NOT_EVALUATED";
+
+export interface FoundationCandidateDecision {
+  candidateId: string;
+  candidateKind: "identity" | "field" | "unknown";
+  identityId?: string;
+  fieldKey?: string;
+  outcome: FoundationCandidateOutcome;
+  reasonCode: string;
+  cmsStatus: string;
+  rightsStatus: RightsState;
+  publicDeliveryAllowed: boolean;
+  rightsBySource: Array<{ sourceRef: string; scope: RightsScope; state: RightsState }>;
+  creationMethod?: string;
+  provenanceState?: string;
+  revisionDigest?: string;
+  sourceRefs: string[];
+  sourceAssertions: Array<{
+    id: string;
+    sourceRef: string;
+    sourceVersion: string;
+    sourceRecordRef: string;
+    evidenceRef: string;
+    assertedFields: string[];
+  }>;
+  reviewEvidence: {
+    present: boolean;
+    reviewerId?: string;
+    evidenceRef?: string;
+    evidenceSha256?: string;
+    revisionDigest?: string;
+  };
+}
+
+export interface FoundationCandidateBuildReport {
+  schemaVersion: typeof KANJI_FOUNDATION_CANDIDATE_REPORT_SCHEMA;
+  pipelineVersion: typeof KANJI_FOUNDATION_PIPELINE_VERSION;
+  discovery: {
+    method: "enumerate_authorized_cms_export_items";
+    status: "EMPTY_INPUT" | "CANDIDATES_PRESENT";
+    suppliedItems: number;
+    identityItems: number;
+    fieldItems: number;
+    unknownKindItems: number;
+  };
+  input: {
+    name: string;
+    schemaVersion: string;
+    sha256: string;
+  };
+  counts: {
+    evaluated: number;
+    eligible: number;
+    rejected: number;
+    blocked: number;
+    blockedRights: number;
+    blockedProvenance: number;
+    blockedHumanReview: number;
+    invalid: number;
+    notEvaluated: number;
+    withheld: number;
+  };
+  reasonCounts: Record<string, number>;
+  decisions: FoundationCandidateDecision[];
+  learnerArtifact: {
+    schemaVersion: string;
+    sha256: string;
+    contentDigest: string;
+    eligibleIdentities: number;
+    eligibleFields: number;
+  };
+  internalReportSha256: string;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function stringField(value: unknown): string | undefined {
+  return typeof value === "string" && value.length > 0 ? value : undefined;
+}
+
+function sha256(value: string | Uint8Array): string {
+  return createHash("sha256").update(value).digest("hex");
+}
+
+function candidateKind(payload: unknown): FoundationCandidateDecision["candidateKind"] {
+  if (!isRecord(payload)) return "unknown";
+  if (payload.kind === "identity") return "identity";
+  if (payload.kind === "field") return "field";
+  return "unknown";
+}
+
+function sourceAssertions(payload: Record<string, unknown> | undefined): FoundationCandidateDecision["sourceAssertions"] {
+  const provenance = payload && isRecord(payload.provenance) ? payload.provenance : undefined;
+  const assertions = provenance && Array.isArray(provenance.sourceAssertions) ? provenance.sourceAssertions : [];
+  return assertions.flatMap((value) => {
+    if (!isRecord(value)) return [];
+    const id = stringField(value.id);
+    const sourceRef = stringField(value.sourceRef);
+    const sourceVersion = stringField(value.sourceVersion);
+    const sourceRecordRef = stringField(value.sourceRecordRef);
+    const evidenceRef = stringField(value.evidenceRef);
+    const assertedFields = Array.isArray(value.assertedFields)
+      ? value.assertedFields.filter((field): field is string => typeof field === "string")
+      : [];
+    if (!id || !sourceRef || !sourceVersion || !sourceRecordRef || !evidenceRef) return [];
+    return [{ id, sourceRef, sourceVersion, sourceRecordRef, evidenceRef, assertedFields }];
+  }).sort((a, b) => a.id.localeCompare(b.id));
+}
+
+function rightsState(history: readonly RightsHistoryEvent[], sourceRefs: readonly string[]): RightsState {
+  if (!sourceRefs.length) return "UNKNOWN";
+  const states = sourceRefs.flatMap((sourceRef) => RIGHTS_SCOPES.map((scope) => currentRightsState(history, sourceRef, scope)));
+  if (states.some((state) => state === "BLOCKED")) return "BLOCKED";
+  if (states.some((state) => state === "UNKNOWN")) return "UNKNOWN";
+  if (states.some((state) => state === "CONDITIONAL")) return "CONDITIONAL";
+  return "CLEARED";
+}
+
+function reviewEvidence(payload: Record<string, unknown> | undefined): FoundationCandidateDecision["reviewEvidence"] {
+  if (!payload) return { present: false };
+  const membership = isRecord(payload.membership) ? payload.membership : undefined;
+  const provenance = isRecord(payload.provenance) ? payload.provenance : undefined;
+  const raw = membership && isRecord(membership.evidenceVerification)
+    ? membership.evidenceVerification
+    : provenance && isRecord(provenance.verification) ? provenance.verification : undefined;
+  if (!raw) return { present: false };
+  return {
+    present: true,
+    ...(stringField(raw.reviewerId) ? { reviewerId: stringField(raw.reviewerId) } : {}),
+    ...(stringField(raw.evidenceRef) ? { evidenceRef: stringField(raw.evidenceRef) } : {}),
+    ...(stringField(raw.evidenceSha256) ? { evidenceSha256: stringField(raw.evidenceSha256) } : {}),
+    ...(stringField(raw.revisionDigest) ? { revisionDigest: stringField(raw.revisionDigest) } : {}),
+  };
+}
+
+function outcomeFor(reasonCode: string | undefined, isEligible: boolean): FoundationCandidateOutcome {
+  if (isEligible) return "ELIGIBLE_FOR_PUBLIC_PROJECTION";
+  if (!reasonCode) return "NOT_EVALUATED";
+  if (reasonCode.includes("RIGHTS")) return "BLOCKED_RIGHTS";
+  if (reasonCode.includes("PROVENANCE")) return "BLOCKED_PROVENANCE";
+  if (reasonCode.includes("INVALID") || reasonCode.includes("SCHEMA")) return "INVALID_INPUT";
+  if (reasonCode.includes("REVIEW") || reasonCode.includes("CMS_STATUS") || reasonCode.includes("MEMBERSHIP") || reasonCode.includes("AUDIT")) {
+    return "BLOCKED_HUMAN_REVIEW";
+  }
+  if (reasonCode === "IDENTITY_NOT_PUBLICLY_ELIGIBLE") return "NOT_EVALUATED";
+  return "REJECTED";
+}
+
+function rejectionFor(candidate: FoundationCmsSnapshot["items"][number], rejections: readonly FoundationPipelineRejection[]): FoundationPipelineRejection | undefined {
+  return rejections.find((rejection) => rejection.itemId === candidate.item.id);
+}
+
+export function createFoundationCandidateBuildReport(input: {
+  snapshot: FoundationCmsSnapshot;
+  projection: FoundationProjectionResult;
+  inputName: string;
+  inputSha256: string;
+  learnerArtifactSha256: string;
+}): FoundationCandidateBuildReport {
+  if (!/^[0-9a-f]{64}$/u.test(input.inputSha256) || !/^[0-9a-f]{64}$/u.test(input.learnerArtifactSha256)) {
+    throw new Error("Candidate report requires exact lowercase SHA-256 input and learner-artifact hashes.");
+  }
+  const { snapshot, projection } = input;
+  const rejections = diagnoseFoundationProjection(snapshot, projection);
+  const identityPayloads = new Map<string, Record<string, unknown>>();
+  for (const candidate of snapshot.items) {
+    const payload = candidate.item.stagedPayload;
+    if (candidateKind(payload) !== "identity" || !isRecord(payload) || !isRecord(payload.identity)) continue;
+    const identityId = stringField(payload.identity.identityId);
+    if (identityId) identityPayloads.set(identityId, payload);
+  }
+  const publicIdentityIds = new Set(projection.kanji.map((entry) => entry.identityId));
+  const decisions = snapshot.items.map((candidate): FoundationCandidateDecision => {
+    const payloadValue = candidate.item.stagedPayload;
+    const payload = isRecord(payloadValue) ? payloadValue : undefined;
+    const kind = candidateKind(payloadValue);
+    const identity = payload && isRecord(payload.identity) ? payload.identity : undefined;
+    const identityId = stringField(kind === "identity" ? identity?.identityId : payload?.identityId);
+    const fieldKey = stringField(payload?.fieldKey);
+    const rejection = rejectionFor(candidate, rejections);
+    const appearsInPublicProjection = kind === "identity"
+      ? Boolean(identityId && publicIdentityIds.has(identityId))
+      : kind === "field" && Boolean(identityId && fieldKey && projection.kanji.some((row) => row.identityId === identityId && row.fields.some((field) => field.key === fieldKey)));
+    const isEligible = !rejection && appearsInPublicProjection;
+    const reasonCode = rejection?.reasonCode ?? (isEligible
+      ? kind === "identity" ? "ELIGIBLE_PUBLIC_IDENTITY" : "ELIGIBLE_PUBLIC_FIELD"
+      : kind === "unknown" ? "INVALID_K09_PAYLOAD_SCHEMA" : "NO_DECISION_FROM_PROJECTION");
+    const outcome = outcomeFor(rejection?.reasonCode, isEligible);
+    const linkedIdentity = identityId ? identityPayloads.get(identityId) : undefined;
+    const assertions = sourceAssertions(payload);
+    const sourceRefs = [...new Set([
+      stringField(payload?.identitySourceRef),
+      stringField(payload?.fieldSourceRef),
+      stringField(linkedIdentity?.identitySourceRef),
+      ...assertions.map((assertion) => assertion.sourceRef),
+    ].filter((value): value is string => Boolean(value)))].sort();
+    const rightsHistory = [
+      ...snapshot.rightsHistory,
+      ...(Array.isArray(linkedIdentity?.identityRightsHistory) ? linkedIdentity.identityRightsHistory as RightsHistoryEvent[] : []),
+      ...(linkedIdentity !== payload && Array.isArray(payload?.identityRightsHistory) ? payload.identityRightsHistory as RightsHistoryEvent[] : []),
+      ...(Array.isArray(payload?.rightsHistory) ? payload.rightsHistory as RightsHistoryEvent[] : []),
+    ];
+    const rightsStatusValue = rightsState(rightsHistory, sourceRefs);
+    const publicDeliveryAllowed = sourceRefs.length > 0 && publicDistributionDecision(rightsHistory, sourceRefs).allowed;
+    const rightsBySource = sourceRefs.flatMap((sourceRef) => RIGHTS_SCOPES.map((scope) => ({
+      sourceRef,
+      scope,
+      state: currentRightsState(rightsHistory, sourceRef, scope),
+    })));
+    const review = reviewEvidence(payload);
+    return {
+      candidateId: candidate.item.id,
+      candidateKind: kind,
+      ...(identityId ? { identityId } : {}),
+      ...(fieldKey ? { fieldKey } : {}),
+      outcome,
+      reasonCode,
+      cmsStatus: String(candidate.item.status),
+      rightsStatus: rightsStatusValue,
+      publicDeliveryAllowed,
+      rightsBySource,
+      ...(stringField(payload?.creationMethod) ? { creationMethod: stringField(payload?.creationMethod) } : {}),
+      ...(stringField(payload?.provenance && isRecord(payload.provenance) ? payload.provenance.state : undefined)
+        ? { provenanceState: stringField((payload?.provenance as Record<string, unknown>).state) }
+        : {}),
+      ...(stringField(payload?.revisionDigest) ? { revisionDigest: stringField(payload?.revisionDigest) } : {}),
+      sourceRefs,
+      sourceAssertions: assertions,
+      reviewEvidence: review,
+    };
+  }).sort((a, b) => a.candidateId.localeCompare(b.candidateId) || a.candidateKind.localeCompare(b.candidateKind));
+
+  const count = (outcome: FoundationCandidateOutcome) => decisions.filter((decision) => decision.outcome === outcome).length;
+  const reasonCounts: Record<string, number> = {};
+  for (const decision of decisions) reasonCounts[decision.reasonCode] = (reasonCounts[decision.reasonCode] ?? 0) + 1;
+  const fieldCount = projection.kanji.reduce((total, row) => total + row.fields.length, 0);
+  const reportBody = {
+    schemaVersion: KANJI_FOUNDATION_CANDIDATE_REPORT_SCHEMA,
+    pipelineVersion: KANJI_FOUNDATION_PIPELINE_VERSION,
+    discovery: {
+      method: "enumerate_authorized_cms_export_items" as const,
+      status: snapshot.items.length === 0 ? "EMPTY_INPUT" as const : "CANDIDATES_PRESENT" as const,
+      suppliedItems: snapshot.items.length,
+      identityItems: snapshot.items.filter((candidate) => candidateKind(candidate.item.stagedPayload) === "identity").length,
+      fieldItems: snapshot.items.filter((candidate) => candidateKind(candidate.item.stagedPayload) === "field").length,
+      unknownKindItems: snapshot.items.filter((candidate) => candidateKind(candidate.item.stagedPayload) === "unknown").length,
+    },
+    input: {
+      name: input.inputName,
+      schemaVersion: snapshot.schemaVersion,
+      sha256: input.inputSha256,
+    },
+    counts: {
+      evaluated: decisions.filter((decision) => decision.outcome !== "NOT_EVALUATED").length,
+      eligible: count("ELIGIBLE_FOR_PUBLIC_PROJECTION"),
+      rejected: count("REJECTED"),
+      blocked: count("BLOCKED_RIGHTS") + count("BLOCKED_PROVENANCE") + count("BLOCKED_HUMAN_REVIEW"),
+      blockedRights: count("BLOCKED_RIGHTS"),
+      blockedProvenance: count("BLOCKED_PROVENANCE"),
+      blockedHumanReview: count("BLOCKED_HUMAN_REVIEW"),
+      invalid: count("INVALID_INPUT"),
+      notEvaluated: count("NOT_EVALUATED"),
+      withheld: decisions.filter((decision) => decision.outcome !== "ELIGIBLE_FOR_PUBLIC_PROJECTION").length,
+    },
+    reasonCounts: Object.fromEntries(Object.entries(reasonCounts).sort(([a], [b]) => a.localeCompare(b))),
+    decisions,
+    learnerArtifact: {
+      schemaVersion: projection.schemaVersion,
+      sha256: input.learnerArtifactSha256,
+      contentDigest: projection.contentDigest,
+      eligibleIdentities: projection.kanji.length,
+      eligibleFields: fieldCount,
+    },
+  };
+  return { ...reportBody, internalReportSha256: sha256(canonicalFoundationJson(reportBody)) };
+}
diff --git a/src/services/knowledge/editorial/kanjiFoundationRepository.ts b/src/services/knowledge/editorial/kanjiFoundationRepository.ts
new file mode 100644
index 0000000..e828665
--- /dev/null
+++ b/src/services/knowledge/editorial/kanjiFoundationRepository.ts
@@ -0,0 +1,107 @@
+import "server-only";
+
+import { and, asc, eq, inArray } from "drizzle-orm";
+import { db } from "@/db";
+import { cmsAuditLog, cmsContentItems, cmsContentVersions } from "@/db/schema";
+import {
+  KANJI_FOUNDATION_EXPORT_SCHEMA,
+  KANJI_FOUNDATION_SOURCE_REF,
+  type FoundationCmsAudit,
+  type FoundationCmsItem,
+  type FoundationCmsSnapshot,
+  type FoundationCmsVersion,
+  type FoundationProjectionItem,
+} from "./kanjiFoundation";
+import { K0_5A_INITIAL_RIGHTS_HISTORY } from "../provenance/rightsPolicy";
+
+const PAGE_SIZE = 1_000;
+const MAX_ITEMS = 100_000;
+const BATCH_SIZE = 500;
+
+/**
+ * Public read adapter for K0.9 CMS-originated records only. It never reads
+ * canonical Kanji tables or legacy CMS overlays. Results are rebuilt from
+ * one repeatable-read transaction across current rows, immutable snapshots,
+ * and audit records. Callers must send no-store headers and must not persist
+ * a search/index projection.
+ */
+export async function readKanjiFoundationSnapshot(): Promise<FoundationCmsSnapshot> {
+  return db.transaction(async (tx) => {
+    const items: FoundationCmsItem[] = [];
+    for (let offset = 0; offset < MAX_ITEMS; offset += PAGE_SIZE) {
+      const page = await tx.select({
+        id: cmsContentItems.id,
+        contentType: cmsContentItems.contentType,
+        entityId: cmsContentItems.entityId,
+        title: cmsContentItems.title,
+        status: cmsContentItems.status,
+        currentVersion: cmsContentItems.currentVersion,
+        stagedPayload: cmsContentItems.stagedPayload,
+        sourceRef: cmsContentItems.sourceRef,
+        authorId: cmsContentItems.authorId,
+        reviewerId: cmsContentItems.reviewerId,
+        publishedAt: cmsContentItems.publishedAt,
+      }).from(cmsContentItems)
+        .where(and(eq(cmsContentItems.contentType, "kanji"), eq(cmsContentItems.sourceRef, KANJI_FOUNDATION_SOURCE_REF)))
+        .orderBy(asc(cmsContentItems.id))
+        .limit(PAGE_SIZE)
+        .offset(offset);
+      items.push(...page);
+      if (page.length < PAGE_SIZE) break;
+    }
+    if (items.length >= MAX_ITEMS) throw new Error("K0.9 public read exceeded its bounded item limit.");
+
+    const versions: FoundationCmsVersion[] = [];
+    const audits: FoundationCmsAudit[] = [];
+    const ids = items.map((item) => item.id);
+    for (let offset = 0; offset < ids.length; offset += BATCH_SIZE) {
+      const batch = ids.slice(offset, offset + BATCH_SIZE);
+      const [versionRows, auditRows] = await Promise.all([
+        tx.select({
+          contentItemId: cmsContentVersions.contentItemId,
+          versionNumber: cmsContentVersions.versionNumber,
+          snapshotPayload: cmsContentVersions.snapshotPayload,
+          statusAtSnapshot: cmsContentVersions.statusAtSnapshot,
+          createdById: cmsContentVersions.createdById,
+        }).from(cmsContentVersions)
+          .where(inArray(cmsContentVersions.contentItemId, batch))
+          .orderBy(asc(cmsContentVersions.contentItemId), asc(cmsContentVersions.versionNumber)),
+        tx.select({
+          contentItemId: cmsAuditLog.contentItemId,
+          actorId: cmsAuditLog.actorId,
+          action: cmsAuditLog.action,
+          details: cmsAuditLog.details,
+          occurredAt: cmsAuditLog.occurredAt,
+        }).from(cmsAuditLog)
+          .where(inArray(cmsAuditLog.contentItemId, batch))
+          .orderBy(asc(cmsAuditLog.contentItemId), asc(cmsAuditLog.occurredAt)),
+      ]);
+      versions.push(...versionRows);
+      audits.push(...auditRows as FoundationCmsAudit[]);
+    }
+
+    const versionByItem = new Map<string, FoundationCmsVersion[]>();
+    for (const version of versions) {
+      const rows = versionByItem.get(version.contentItemId) ?? [];
+      rows.push(version);
+      versionByItem.set(version.contentItemId, rows);
+    }
+    const auditByItem = new Map<string, FoundationCmsAudit[]>();
+    for (const audit of audits) {
+      if (!audit.contentItemId) continue;
+      const rows = auditByItem.get(audit.contentItemId) ?? [];
+      rows.push(audit);
+      auditByItem.set(audit.contentItemId, rows);
+    }
+    const projections: FoundationProjectionItem[] = items.map((item) => ({
+      item,
+      versions: versionByItem.get(item.id) ?? [],
+      audits: auditByItem.get(item.id) ?? [],
+    }));
+    return {
+      schemaVersion: KANJI_FOUNDATION_EXPORT_SCHEMA,
+      items: projections,
+      rightsHistory: [...K0_5A_INITIAL_RIGHTS_HISTORY],
+    };
+  }, { isolationLevel: "repeatable read" });
+}
