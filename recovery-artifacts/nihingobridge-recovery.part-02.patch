index 0000000..7938039
--- /dev/null
+++ b/src/lib/kanji/strokeAssetContract.ts
@@ -0,0 +1,37 @@
+export const STROKE_ASSET_SCHEMA = "nihongobridge-stroke-asset@1" as const;
+export interface StrokeAsset {
+  schemaVersion: typeof STROKE_ASSET_SCHEMA;
+  assetId: string;
+  label: string;
+  geometryOrigin: "synthetic_test_geometry" | "first_party_original_geometry";
+  sourceRef: string;
+  strokes: Array<{ id: string; pathData: string; description: string }>;
+}
+
+const SAFE_PATH_DATA = /^[MmLlHhVvCcSsQqTtAaZz0-9,. +\-]+$/u;
+
+/** Runtime boundary: no upstream asset, external reference, or arbitrary SVG markup can enter the player. */
+export function validateStrokeAsset(value: unknown): { valid: boolean; issues: string[]; asset?: StrokeAsset } {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return { valid: false, issues: ["stroke asset must be an object"] };
+  const asset = value as Partial<StrokeAsset>;
+  const issues: string[] = [];
+  if (asset.schemaVersion !== STROKE_ASSET_SCHEMA) issues.push("unsupported stroke asset schema");
+  if (typeof asset.assetId !== "string" || !asset.assetId.trim()) issues.push("assetId is required");
+  if (typeof asset.label !== "string" || !asset.label.trim() || /[<>]/u.test(asset.label)) issues.push("asset label must be plain text");
+  if (asset.geometryOrigin === "synthetic_test_geometry") {
+    if (typeof asset.sourceRef !== "string" || !asset.sourceRef.startsWith("test:")) issues.push("synthetic geometry must use a test: source reference");
+  } else if (asset.geometryOrigin === "first_party_original_geometry") {
+    if (typeof asset.sourceRef !== "string" || !asset.sourceRef.startsWith("first-party:")) issues.push("original geometry must use a first-party source reference");
+  } else issues.push("only synthetic-test or first-party-original geometry is accepted");
+  if (!Array.isArray(asset.strokes) || asset.strokes.length < 1 || asset.strokes.length > 32) issues.push("strokes must contain 1–32 paths");
+  else {
+    const ids = new Set<string>();
+    for (const stroke of asset.strokes) {
+      if (!stroke || typeof stroke.id !== "string" || !stroke.id.trim() || ids.has(stroke.id)) issues.push("stroke IDs must be non-empty and unique");
+      else ids.add(stroke.id);
+      if (typeof stroke.pathData !== "string" || stroke.pathData.length > 2_000 || !SAFE_PATH_DATA.test(stroke.pathData)) issues.push(`${stroke.id || "stroke"}: unsafe or invalid path data`);
+      if (typeof stroke.description !== "string" || !stroke.description.trim() || /[<>]/u.test(stroke.description)) issues.push(`${stroke.id || "stroke"}: plain-text description is required`);
+    }
+  }
+  return issues.length ? { valid: false, issues } : { valid: true, issues: [], asset: asset as StrokeAsset };
+}
