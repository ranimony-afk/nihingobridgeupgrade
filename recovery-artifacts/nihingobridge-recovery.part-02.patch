+    let item = await cms.getItem(input.itemId);
+    assertK09CmsItem(item);
+    if (!isFieldPayload(item.stagedPayload) || !expectedCurrentDigest(item.stagedPayload)) throw CmsError.validation("Rights decision must target a valid K0.9 field revision.");
+    if (item.status === "archived") throw CmsError.validation("Archived field history is immutable; create a new field revision to change rights.");
+    if (item.status !== "draft") {
+      const version = Math.max(1, item.currentVersion - 1);
+      item = await cms.rollback(item.id, { expectedVersion: item.currentVersion, targetVersion: version, changeSummary: "Return K0.9 field to draft for a new field-specific rights event." });
+      cms = this.cmsFactory();
+    }
+    const payload = appendFoundationRightsDecision({
+      payload: item.stagedPayload as unknown as FoundationFieldPayload,
+      sourceRef: input.sourceRef,
+      scope: input.scope,
+      state: input.state,
+      actorId: actor.id,
+      recordedAt: this.clock().toISOString(),
+      evidenceRef: input.evidenceRef,
+      evidenceClass: input.evidenceClass,
+      evidenceSha256: input.evidenceSha256,
+      qualifiedReviewRef: input.qualifiedReviewRef,
+      qualifiedReviewSha256: input.qualifiedReviewSha256,
+      rationale: input.rationale,
+    });
+    return cms.updateDraft(item.id, {
+      expectedVersion: item.currentVersion,
+      stagedPayload: payload,
+      changeSummary: `K0.9 rights ${input.state} for ${input.scope}, bound to ${input.sourceRef ?? payload.fieldSourceRef}`,
+    });
+  }
+
+  async setIdentityRights(input: {
+    identityId: string;
+    scope: "retention" | "internal_analysis" | "derivation" | "public_distribution";
+    state: "CLEARED" | "CONDITIONAL" | "BLOCKED" | "UNKNOWN";
+    evidenceRef: string;
+    evidenceClass: "owner_authorization" | "project_gate_record";
+    evidenceSha256: string | null;
+    rationale: string;
+  }): Promise<CmsItemRecord> {
+    const actor = await requireRole("admin");
+    let cms = this.cmsFactory();
+    let item = await cms.getItem(identityCmsItemId(input.identityId));
+    assertK09CmsItem(item);
+    if (!isIdentityPayload(item.stagedPayload) || !expectedCurrentDigest(item.stagedPayload)) throw CmsError.validation("Rights decision must target a valid K0.9 identity revision.");
+    if (item.status === "archived") throw CmsError.validation("Archived identity history is immutable.");
+    if (item.status !== "draft") {
+      item = await cms.rollback(item.id, { expectedVersion: item.currentVersion, targetVersion: Math.max(1, item.currentVersion - 1), changeSummary: "Return K0.9 identity to draft for a new identity-specific rights event." });
+      cms = this.cmsFactory();
+    }
+    const payload = appendFoundationIdentityRightsDecision({
+      payload: item.stagedPayload as unknown as FoundationIdentityPayload,
+      scope: input.scope,
+      state: input.state,
+      actorId: actor.id,
+      recordedAt: this.clock().toISOString(),
+      evidenceRef: input.evidenceRef,
+      evidenceClass: input.evidenceClass,
+      evidenceSha256: input.evidenceSha256,
+      rationale: input.rationale,
+    });
+    return cms.updateDraft(item.id, {
+      expectedVersion: item.currentVersion,
+      stagedPayload: payload,
+      changeSummary: `K0.9 identity rights ${input.state} for ${input.scope}.`,
+    });
+  }
+
+  async appendMembershipDecision(input: {
+    identityId: string;
+    goal: "japanese_literacy" | "general_reading_coverage" | "learner_progression" | "comprehensive_reference";
+    state: "candidate" | "approved" | "published" | "excluded" | "deferred" | "withdrawn";
+    eventId: string;
+    sourceAssertionIds: string[];
+    sourceAssertions: SourceAssertion[];
+    sourceRefs: string[];
+    decisionEvidenceRef: string;
+    decisionAuthority: string;
+    decisionTrust: "unverified_local_attribution" | "authenticated_external";
+    authenticationEvidenceRef: string | null;
+    authenticationEvidenceSha256: string | null;
+  }): Promise<CmsItemRecord> {
+    await requireRole("admin");
+    const cms = this.cmsFactory();
+    let item = await cms.getItem(identityCmsItemId(input.identityId));
+    assertK09CmsItem(item);
+    if (!isIdentityPayload(item.stagedPayload) || !expectedCurrentDigest(item.stagedPayload)) throw CmsError.validation("Membership decision must target a valid K0.9 identity revision.");
+    if (item.status === "archived") throw CmsError.validation("Archived identity history is immutable; restore through an authorized new revision.");
+    let activeCms = cms;
+    if (item.status !== "draft") {
+      item = await cms.rollback(item.id, { expectedVersion: item.currentVersion, targetVersion: Math.max(1, item.currentVersion - 1), changeSummary: "Return K0.9 identity to draft for a new membership decision event." });
+      activeCms = this.cmsFactory();
+    }
+    const { identityId: _identityId, ...decision } = input;
+    const payload = appendFoundationMembershipDecision({ payload: item.stagedPayload as unknown as FoundationIdentityPayload, ...decision });
+    return activeCms.updateDraft(item.id, {
+      expectedVersion: item.currentVersion,
+      stagedPayload: payload,
+      changeSummary: `K0.9 membership ${input.state} decision for ${input.goal}; independent of field rights and content review.`,
+    });
+  }
+
+  async verifyMembership(identityId: string, evidenceRef: string, evidenceSha256: string): Promise<CmsItemRecord> {
+    const actor = await requireRole("admin");
+    const cms = this.cmsFactory();
+    const item = await cms.getItem(identityCmsItemId(identityId));
+    assertK09CmsItem(item);
+    if (item.status !== "draft" || !isIdentityPayload(item.stagedPayload) || !expectedCurrentDigest(item.stagedPayload)) {
+      throw CmsError.validation("Only a valid draft identity revision may receive membership evidence review.");
+    }
+    const payload = verifyFoundationMembershipEvidence({
+      payload: item.stagedPayload,
+      reviewerId: actor.id,
+      evidenceRef,
+      evidenceSha256,
+      verifiedAt: this.clock().toISOString(),
+    });
+    return cms.updateDraft(item.id, {
+      expectedVersion: item.currentVersion,
+      stagedPayload: payload,
+      changeSummary: `K0.9 membership evidence review bound to identity revision ${item.stagedPayload.revisionDigest}`,
+    });
+  }
+
+  async submitReview(itemId: string): Promise<CmsItemRecord> {
+    const cms = this.cmsFactory();
+    const item = await cms.getItem(itemId);
+    assertK09CmsItem(item);
+    const payload = isIdentityPayload(item.stagedPayload) ? item.stagedPayload
+      : isFieldPayload(item.stagedPayload) ? item.stagedPayload : null;
+    if (!payload || !expectedCurrentDigest(payload)) throw CmsError.validation("K0.9 payload digest mismatch; review is blocked.");
+    if (isFieldPayload(payload) && payload.field.provenance.kind === "source_assertion" && payload.creationMethod !== "source_derived") {
+      throw CmsError.validation("Field source provenance does not match its declared authoring method.");
+    }
+    return cms.submitForReview(item.id, { expectedVersion: item.currentVersion, changeSummary: `Submit exact K0.9 revision ${payload.revisionDigest} for independent review.` });
+  }
+
+  async approve(itemId: string): Promise<CmsItemRecord> {
+    const cms = this.cmsFactory();
+    const item = await cms.getItem(itemId);
+    assertK09CmsItem(item);
+    const payload = isIdentityPayload(item.stagedPayload) ? item.stagedPayload
+      : isFieldPayload(item.stagedPayload) ? item.stagedPayload : null;
+    if (!payload || !expectedCurrentDigest(payload)) throw CmsError.validation("K0.9 payload digest mismatch; approval is blocked.");
+    return cms.approve(item.id, { expectedVersion: item.currentVersion, changeSummary: `Approve exact K0.9 revision ${payload.revisionDigest}.` });
+  }
+
+  async requestChanges(itemId: string, reason: string): Promise<CmsItemRecord> {
+    const cms = this.cmsFactory();
+    const item = await cms.getItem(itemId);
+    assertK09CmsItem(item);
+    return cms.requestChanges(item.id, { expectedVersion: item.currentVersion, reason, changeSummary: "K0.9 independent reviewer requests a new draft revision." });
+  }
+
+  private async assertPublishable(item: CmsItemRecord, cms: CmsService): Promise<void> {
+    assertK09CmsItem(item);
+    const versions = await cms.getVersions(item.id);
+    const audits = await cms.getAuditTrail(item.id);
+    const commonHistory = K0_5A_INITIAL_RIGHTS_HISTORY;
+    if (isFieldPayload(item.stagedPayload)) {
+      const payload = item.stagedPayload;
+      if (!expectedCurrentDigest(payload) || payload.provenance.state !== "VERIFIED" || !payload.provenance.verification
+        || payload.provenance.verification.revisionDigest !== payload.editorialRevision.revisionDigest) {
+        throw CmsError.validation("Field publication requires persisted field-specific provenance review bound to the exact editorial revision.");
+      }
+      const recorded = verifiedRevisionInCmsHistory({
+        payload,
+        authorId: item.authorId,
+        versions,
+        audits,
+        revisionDigest: payload.editorialRevision.revisionDigest,
+        reviewerId: payload.provenance.verification.reviewerId,
+      });
+      if (!recorded) throw CmsError.validation("Provenance review event is not present in the immutable CMS version/audit history.");
+      const history = [...commonHistory, ...payload.rightsHistory];
+      if (!validateRightsHistory(history).valid) throw CmsError.validation("Field rights history is invalid.");
+      const delivery = publicDistributionDecision(history, [payload.fieldSourceRef, ...payload.provenance.sourceAssertions.map((row) => row.sourceRef)]);
+      if (!delivery.allowed) throw CmsError.validation("Field-specific rights do not permit public delivery.", { blockers: delivery.blockers });
+      return;
+    }
+    if (!isIdentityPayload(item.stagedPayload)) throw CmsError.validation("Identity payload is invalid.");
+    const payload = item.stagedPayload;
+    if (!expectedCurrentDigest(payload) || payload.membership.state !== "PUBLISHED" || !payload.membership.evidenceVerification) {
+      throw CmsError.validation("Identity delivery requires a separate published membership decision and pinned evidence review.");
+    }
+    const membershipValidation = validateKanjiMembershipHistory(payload.membership.history);
+    if (!membershipValidation.valid) throw CmsError.validation("Identity membership history is invalid.", { issues: membershipValidation.issues });
+    const verification = payload.membership.evidenceVerification;
+    if (!verifiedRevisionInCmsHistory({ payload, authorId: item.authorId, versions, audits, revisionDigest: verification.revisionDigest, reviewerId: verification.reviewerId })) {
+      throw CmsError.validation("Membership evidence review is not present in immutable CMS history.");
+    }
+    const history = [...commonHistory, ...payload.identityRightsHistory];
+    if (!validateRightsHistory(history).valid) throw CmsError.validation("Identity rights history is invalid.");
+    const latestPublished = latestFoundationMembershipEvents(payload.membership.history).filter((event) => event.state === "published");
+    const membership = latestPublished.some((event) => mayAppearInPublicCorpus({ latestEvent: event, rightsHistory: [...history], membershipEvidenceVerified: true }).allowed);
+    if (!membership) throw CmsError.validation("Membership authority and source rights do not allow public delivery.");
+    if (!publicDistributionDecision(history, [payload.identitySourceRef]).allowed) throw CmsError.validation("Identity-specific rights do not allow public delivery.");
+  }
+
+  async publish(itemId: string): Promise<CmsItemRecord> {
+    const cms = this.cmsFactory();
+    const item = await cms.getItem(itemId);
+    await this.assertPublishable(item, cms);
+    return cms.publish(item.id, { expectedVersion: item.currentVersion, changeSummary: "K0.9 publish after independent field, rights, membership and exact-revision gates." });
+  }
+
+  async archive(itemId: string): Promise<CmsItemRecord> {
+    const cms = this.cmsFactory();
+    const item = await cms.getItem(itemId);
+    assertK09CmsItem(item);
+    return cms.archive(item.id, { expectedVersion: item.currentVersion, changeSummary: "Withdraw K0.9 delivery while preserving immutable versions and audit." });
+  }
+
+  async exportSnapshot(): Promise<FoundationCmsSnapshot> {
+    const cms = this.cmsFactory();
+    const items = await listK09Items(cms);
+    const projections = await Promise.all(items.map(async (item) => ({
+      item: toFoundationItem(item),
+      versions: (await cms.getVersions(item.id)).map((version) => ({
+        contentItemId: version.contentItemId,
+        versionNumber: version.versionNumber,
+        snapshotPayload: version.snapshotPayload,
+        statusAtSnapshot: version.statusAtSnapshot,
+        createdById: version.createdById,
+      })),
+      audits: (await cms.getAuditTrail(item.id)).map((audit) => ({
+        contentItemId: audit.contentItemId,
+        actorId: audit.actorId,
+        action: audit.action,
+        details: audit.details,
+        occurredAt: audit.occurredAt,
+      })),
+    })));
+    const snapshot: FoundationCmsSnapshot = {
+      schemaVersion: "nihongobridge-kanji-foundation-export@1",
+      items: projections as FoundationProjectionItem[],
+      rightsHistory: [...K0_5A_INITIAL_RIGHTS_HISTORY],
+    };
+    return snapshot;
+  }
+
+  async publicProjection(): Promise<ReturnType<typeof buildKanjiFoundationPublicProjection>> {
+    return buildKanjiFoundationPublicProjection(await this.exportSnapshot(), this.clock().toISOString());
+  }
+}
+
+export const kanjiFoundationWorkflow = new KanjiFoundationWorkflow();
