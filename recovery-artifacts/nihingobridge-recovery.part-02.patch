@@ -0,0 +1,72 @@
+import { createHash } from "node:crypto";
+import { readFile, mkdir, writeFile, rename, rm } from "node:fs/promises";
+import path from "node:path";
+import { buildKanjiFoundationPublicProjection, type FoundationCmsSnapshot } from "../src/services/knowledge/editorial/kanjiFoundation";
+import { createFoundationCandidateBuildReport } from "../src/services/knowledge/editorial/kanjiFoundationBuildReport";
+
+const FIXED_BUILD_TIME = "1970-01-01T00:00:00.000Z";
+const sha256 = (value: string | Uint8Array): string => createHash("sha256").update(value).digest("hex");
+
+function usage(): never {
+  throw new Error("Usage: node --import tsx scripts/build-kanji-foundation.ts --input <authorized-cms-export.json> --output <derived-public-json>");
+}
+
+function argumentsMap(argv: string[]): { input: string; output: string } {
+  const values = new Map<string, string>();
+  for (let index = 0; index < argv.length; index++) {
+    const key = argv[index];
+    if (key !== "--input" && key !== "--output") usage();
+    const value = argv[index + 1];
+    if (!value || value.startsWith("--") || values.has(key)) usage();
+    values.set(key, value);
+    index++;
+  }
+  const input = values.get("--input");
+  const output = values.get("--output");
+  if (!input || !output) usage();
+  return { input, output };
+}
+
+async function main(): Promise<void> {
+  const { input, output } = argumentsMap(process.argv.slice(2));
+  const inputPath = path.resolve(input);
+  const outputPath = path.resolve(output);
+  if (inputPath === outputPath) throw new Error("Input export and derived output must be different files.");
+  const relativeOutput = path.relative(process.cwd(), outputPath).split(path.sep).join("/");
+  const insideRepository = relativeOutput !== ".." && !relativeOutput.startsWith("../") && !path.isAbsolute(relativeOutput);
+  const ignoredBuildRoot = /^(dist|build|coverage|out|\.next|\.output)\//u.test(relativeOutput);
+  if (insideRepository && !ignoredBuildRoot) {
+    throw new Error("Derived snapshots inside the repository must stay under an ignored build-output directory (dist/, build/, coverage/, out/, .next/, .output/) or be written outside the repository.");
+  }
+
+  const inputBytes = await readFile(inputPath);
+  const parsed: unknown = JSON.parse(inputBytes.toString("utf8"));
+  const snapshotValue = typeof parsed === "object" && parsed !== null && !Array.isArray(parsed) && "data" in parsed
+    ? (parsed as { data: unknown }).data
+    : parsed;
+  const snapshot = snapshotValue as FoundationCmsSnapshot;
+  const projection = buildKanjiFoundationPublicProjection(snapshot, FIXED_BUILD_TIME);
+  const serialized = `${JSON.stringify(projection, null, 2)}\n`;
+  const report = createFoundationCandidateBuildReport({
+    snapshot,
+    projection,
+    inputName: path.basename(inputPath),
+    inputSha256: sha256(inputBytes),
+    learnerArtifactSha256: sha256(serialized),
+  });
+  await mkdir(path.dirname(outputPath), { recursive: true });
+  const temporaryPath = `${outputPath}.${process.pid}.tmp`;
+  try {
+    await writeFile(temporaryPath, serialized, { encoding: "utf8", flag: "wx" });
+    await rename(temporaryPath, outputPath);
+  } catch (error) {
+    await rm(temporaryPath, { force: true });
+    throw error;
+  }
+  console.log(JSON.stringify(report, null, 2));
+}
+
+main().catch((error: unknown) => {
+  console.error(error instanceof Error ? error.message : "K0.9 pipeline failed.");
+  process.exitCode = 1;
+});
