+import { listAllRegisteredSources } from "@/services/knowledge/provenance/registry";
+import { dictionaryPublicSourceRefs } from "@/lib/dictionary/publicRights";
+import {
+  assertKanjiDeliveryAllowedBySnapshot,
+  decideKanjiDeliveryFromSnapshot,
+  KanjiRightsDeliveryDeniedError,
+  type KanjiDeliveryPolicySnapshot,
+} from "@/lib/kanji/deliveryPolicySnapshot";
+
+export { KanjiRightsDeliveryDeniedError } from "@/lib/kanji/deliveryPolicySnapshot";
+
+/** Current production inputs are immutable, checked-in snapshots; no live rights provider exists. */
+const membershipEvidenceVerified = false;
+const editorialReleaseAuthorizationVerified = false;
+
+/** The current public MindTree page is a composite of all three source families. */
+export const MINDTREE_PUBLIC_SOURCE_REFS = [
+  "upstream:kanjivg:2024-08",
+  "upstream:kanjidic2:2023-08",
+  "derived:kanjidic2-facts-slice:m3",
+  "first-party:kanji-mindtree:v1",
+  "first-party:kanji-corpus:v1",
+] as const;
+
+/** Legacy database aggregates cannot distinguish their source mix or field-level origin. */
+export const LEGACY_KANJI_API_SOURCE_REFS = [
+  ...MINDTREE_PUBLIC_SOURCE_REFS,
+  "first-party:kanji-mindtree:v1",
+  "first-party:kanji-corpus:v1",
+] as const;
+
+function contentDigest(value: unknown): string {
+  return createHash("sha256").update(JSON.stringify(value), "utf8").digest("hex");
+}
+
+const registeredSources = listAllRegisteredSources().slice().sort((left, right) => left.id.localeCompare(right.id));
+const registryDomains = ["dictionary", "kanji", "mixed"] as const;
+
+const productionPolicySnapshot: KanjiDeliveryPolicySnapshot = Object.freeze({
+  schemaVersion: "nihongobridge-kanji-delivery-snapshot@1",
+  rightsPolicyVersion: RIGHTS_POLICY_VERSION,
+  membershipSchemaVersion: KANJI_MEMBERSHIP_SCHEMA,
+  sourceVersions: Object.freeze([
+    `kanjivg:${KANJIVG_SOURCE_VERSION}:${KANJIVG_ARCHIVE_SHA256}:${KANJIVG_TRANSFORMATION_VERSION}:${contentDigest(kanjivgSliceJson)}`,
+    `kanjidic2:${KANJIDIC2_MINDTREE_SOURCE_REF}:${KANJIDIC2_MINDTREE_SLICE_SHA256}`,
+    `first-party-kanji:${KANJI_SOURCE_REF}:${contentDigest(KANJI)}`,
+    ...registeredSources.map((source) => `registry:${source.id}@${source.version};domain=${source.domain};status=${source.status};content=${source.contentHash ?? "unhashed"}`),
+  ]),
+  sourceSets: Object.freeze([
+    Object.freeze({ name: "mindtree-public", sourceRefs: MINDTREE_PUBLIC_SOURCE_REFS }),
+    Object.freeze({ name: "legacy-kanji-api", sourceRefs: LEGACY_KANJI_API_SOURCE_REFS }),
+    Object.freeze({ name: "dictionary-public-allowlist", sourceRefs: Object.freeze(dictionaryPublicSourceRefs()) }),
+    ...registryDomains.map((domain) => Object.freeze({
+      name: `source-registry-domain:${domain}`,
+      sourceRefs: Object.freeze(registeredSources.filter((source) => source.domain === domain).map((source) => source.id)),
+    })),
+  ]),
+  rightsHistory: K0_5A_INITIAL_RIGHTS_HISTORY,
+  membershipHistory: KANJI_MEMBERSHIP_BASELINE,
+  membershipEvidenceVerified,
+  editorialReleaseAuthorizationVerified,
+  editorialRecords: Object.freeze(MINDTREE_MNEMONIC_RECORDS.map((record) => Object.freeze({
+    id: record.id,
+    character: record.character,
+    version: record.version,
+    origin: record.origin,
+    editorialStatus: record.editorialStatus,
+    provenanceRef: record.provenanceRef,
+    sourceReferences: Object.freeze([...record.sourceReferences]),
+    reviewerId: record.reviewerId ?? null,
+    reviewedAt: record.reviewedAt ?? null,
+    publishedAt: record.publishedAt ?? null,
+    revisionDigest: contentDigest(record),
+  }))),
+});
+
+/** Internal server-only resolver shared by production guards and the test boundary seam. */
+export function resolveCurrentKanjiDeliveryPolicySnapshot(): KanjiDeliveryPolicySnapshot {
+  return productionPolicySnapshot;
+}
+
+export function mindTreePublicDeliveryDecision(character?: string) {
+  return decideKanjiDeliveryFromSnapshot(productionPolicySnapshot, MINDTREE_PUBLIC_SOURCE_REFS, character);
+}
+
+export function legacyKanjiApiDeliveryDecision() {
+  return decideKanjiDeliveryFromSnapshot(productionPolicySnapshot, LEGACY_KANJI_API_SOURCE_REFS);
+}
+
+export function assertMindTreePublicDeliveryAllowed(character?: string): void {
+  assertKanjiDeliveryAllowedBySnapshot(productionPolicySnapshot, MINDTREE_PUBLIC_SOURCE_REFS, character);
+}
+
+export function assertKanjiPublicDeliveryAllowed(): void {
+  assertKanjiDeliveryAllowedBySnapshot(productionPolicySnapshot, LEGACY_KANJI_API_SOURCE_REFS);
+}
+
+export function isKanjiRightsDeliveryDeniedError(error: unknown): error is KanjiRightsDeliveryDeniedError {
+  return error instanceof KanjiRightsDeliveryDeniedError ||
+    (error instanceof Error && error.name === "KanjiRightsDeliveryDeniedError");
+}
diff --git a/src/lib/kanji/policyVersionedCache.ts b/src/lib/kanji/policyVersionedCache.ts
new file mode 100644
index 0000000..69db919
--- /dev/null
+++ b/src/lib/kanji/policyVersionedCache.ts
@@ -0,0 +1,66 @@
+import { KanjiRightsDeliveryDeniedError } from "@/lib/kanji/deliveryPolicySnapshot";
+
+export interface PolicyVersionedCacheLoad<T> {
+  key: string;
+  policyVersion: string;
+  sourceVersion: string;
+  resolvePolicyVersion: () => string;
+  authorize: () => void;
+  load: () => T | undefined;
+}
+
+interface CacheEntry<T> {
+  policyVersion: string;
+  sourceVersion: string;
+  value: T;
+}
+
+/**
+ * A process-local cache for immutable derived assets. A cache hit is valid only
+ * for the exact trusted policy and content-source versions, and authorization
+ * is rechecked immediately before returning a value. There is intentionally no
+ * public get/set/clear API that can bypass this contract.
+ */
+export class PolicyVersionedCache<T> {
+  private readonly entries = new Map<string, CacheEntry<T>>();
+
+  constructor(private readonly maxEntries: number) {
+    if (!Number.isInteger(maxEntries) || maxEntries < 1) throw new Error("maxEntries must be positive");
+  }
+
+  getOrLoad(input: PolicyVersionedCacheLoad<T>): T | undefined {
+    if (!input.key || !input.policyVersion || !input.sourceVersion) {
+      input.authorize();
+      return undefined;
+    }
+    const authorizeCurrentPolicy = () => {
+      input.authorize();
+      if (input.resolvePolicyVersion() !== input.policyVersion) throw new KanjiRightsDeliveryDeniedError();
+    };
+    authorizeCurrentPolicy();
+    const cacheKey = `${input.sourceVersion}\u0000${input.key}`;
+    const hit = this.entries.get(cacheKey);
+    if (hit && hit.policyVersion === input.policyVersion && hit.sourceVersion === input.sourceVersion) {
+      authorizeCurrentPolicy();
+      this.entries.delete(cacheKey);
+      this.entries.set(cacheKey, hit);
+      return hit.value;
+    }
+
+    const value = input.load();
+    authorizeCurrentPolicy();
+    if (value === undefined) return undefined;
+    this.entries.delete(cacheKey);
+    this.entries.set(cacheKey, {
+      policyVersion: input.policyVersion,
+      sourceVersion: input.sourceVersion,
+      value,
+    });
+    while (this.entries.size > this.maxEntries) {
+      const oldestKey = this.entries.keys().next().value;
+      if (oldestKey === undefined) break;
+      this.entries.delete(oldestKey);
+    }
+    return value;
+  }
+}
