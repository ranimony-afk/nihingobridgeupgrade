+    expect(html).toContain('role="img"');
+    expect(html).toContain('role="status"');
+    expect(html).toContain("not a Kanji drawing or linguistic fact");
+    expect(html).toContain(">Next stroke</button>");
+    expect(html).toContain(">Reset</button>");
+  });
+
+  it("accepts synthetic test geometry and rejects upstream sources and active SVG path payloads", () => {
+    const asset = {
+      schemaVersion: "nihongobridge-stroke-asset@1",
+      assetId: "test:asset:1",
+      label: "three-line practice shape",
+      geometryOrigin: "synthetic_test_geometry",
+      sourceRef: "test:stroke-player:fixture@1",
+      strokes: [{ id: "line-1", pathData: "M 10 10 L 90 90", description: "diagonal line" }],
+    };
+    expect(validateStrokeAsset(asset).valid).toBe(true);
+    expect(validateStrokeAsset({ ...asset, sourceRef: "upstream:kanjivg:2024-08" }).valid).toBe(false);
+    expect(validateStrokeAsset({ ...asset, strokes: [{ ...asset.strokes[0], pathData: "M 0 0 <script>" }] }).valid).toBe(false);
+  });
+});
