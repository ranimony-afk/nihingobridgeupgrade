@@ -0,0 +1,84 @@
+"""K0.14 tests for the pinned OpenJLPT grammar-only adapter.
+
+The source-data test reads the acquired v0.2.0 snapshot. Synthetic records are
+used only to exercise validator edge cases; they are not counted as authentic
+dataset records or accuracy evidence.
+"""
+from __future__ import annotations
+
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from scripts.k014_openjlpt_grammar import (  # noqa: E402
+    PINNED_FILES,
+    RAW_ROOT,
+    build_outputs,
+    build_review_queue,
+    normalize_value,
+    source_path,
+    validate_record,
+    verify_pinned_bytes,
+)
+
+
+class OpenJLPTRawSnapshotTests(unittest.TestCase):
+    def test_all_pinned_release_files_match_checksums(self) -> None:
+        for relative, expected in PINNED_FILES.items():
+            path = source_path(relative)
+            self.assertTrue(path.is_file(), relative)
+            actual = verify_pinned_bytes(relative, path.read_bytes())
+            self.assertEqual(expected["bytes"], actual["bytes"], relative)
+            self.assertEqual(expected["gitBlob"], actual["gitBlob"], relative)
+            self.assertEqual(expected["sha256"], actual["sha256"], relative)
+
+    def test_real_source_records_parse_and_validate_without_claiming_semantic_accuracy(self) -> None:
+        self.assertTrue((RAW_ROOT / "acquisition-manifest.json").is_file())
+        normalized, quality, rejected = build_outputs()
+        self.assertEqual(100, quality["sourceCount"])
+        self.assertEqual(100, quality["parsedCount"])
+        self.assertEqual(100, quality["structurallyValidCount"])
+        self.assertEqual(100, quality["normalizedCount"])
+        self.assertEqual(0, quality["rejectedCount"])
+        self.assertEqual(0, quality["exactDuplicateRecordCount"])
+        self.assertEqual(1, quality["duplicatePatternKeyCount"])
+        self.assertEqual([], rejected)
+        self.assertEqual(100, len(normalized["records"]))
+        self.assertEqual("NOT_AUTHORIZED", normalized["dataset"]["publicationStatus"])
+        self.assertEqual(100, quality["humanReview"]["reviewPendingCount"])
+        self.assertEqual({"N1": 20, "N2": 20, "N3": 20, "N4": 20, "N5": 20}, quality["levelDistribution"])
+        self.assertEqual(200, quality["exampleAvailability"]["exampleItemCount"])
+        self.assertEqual({"en,ja": 200}, quality["exampleAvailability"]["exampleKeyShapes"])
+        self.assertEqual(100, quality["qualityClasses"]["PROVENANCE"]["recordsWithExamplesMissingPerExampleOrigin"])
+        queue = build_review_queue(normalized, quality)
+        self.assertEqual(100, queue["pendingCount"])
+        self.assertEqual(100, len(queue["items"]))
+        self.assertEqual("NOT_PERFORMED", quality["semanticValidation"]["status"])
+
+    def test_synthetic_validator_edge_case_only(self) -> None:
+        fixture = {
+            "pattern": "〜ている",
+            "level": "N5",
+            "meaning": "state or ongoing action",
+            "formation": "Verb て-form + いる",
+            "examples": [{"ja": "例文", "en": "Example."}],
+            "tags": ["aspect"],
+        }
+        self.assertEqual([], validate_record(fixture, path="sources/grammar/n5.json", index=1))
+        malformed = dict(fixture, examples=[{"ja": "例文"}])
+        codes = {issue["code"] for issue in validate_record(malformed, path="sources/grammar/n5.json", index=1)}
+        self.assertIn("example_language_field_missing_or_empty", codes)
+
+    def test_unicode_normalization_is_additive_not_destructive(self) -> None:
+        original = "  カ\u3099  "
+        normalized = normalize_value(original)
+        self.assertEqual("カ\u3099", original.strip())
+        self.assertEqual("ガ", normalized)
+        self.assertNotEqual(original, normalized)
+
+
+if __name__ == "__main__":
+    unittest.main()
