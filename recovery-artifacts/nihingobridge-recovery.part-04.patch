+++ b/tests/test_k011_readiness.py
@@ -0,0 +1,71 @@
+"""Focused fail-closed tests for the read-only K0.11 evidence verifier."""
+from __future__ import annotations
+
+import copy
+import importlib.util
+import json
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+REPORT_PATH = ROOT / "reports/gates/PHASE-K0.11-SOURCE-AUTHORIZATION-READINESS.json"
+MODULE_PATH = ROOT / "scripts/verify-k011-readiness.py"
+SPEC = importlib.util.spec_from_file_location("verify_k011_readiness", MODULE_PATH)
+assert SPEC and SPEC.loader
+verifier = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(verifier)
+
+
+class K011ReadinessVerifierTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls) -> None:
+        cls.baseline = json.loads(REPORT_PATH.read_text(encoding="utf-8"))
+
+    def test_current_evidence_is_consistent_but_verdict_remains_blocked(self) -> None:
+        self.assertEqual(self.baseline["verdict"], "BLOCKED")
+        self.assertEqual(verifier.audit_report(self.baseline, ROOT), [])
+
+    def test_manually_entered_approved_is_rejected(self) -> None:
+        altered = copy.deepcopy(self.baseline)
+        altered["sourceInventory"][0]["rights"]["scopeStates"]["retention"] = "APPROVED"
+        errors = verifier.audit_report(altered, ROOT)
+        self.assertTrue(any("invalid or permissive rights state" in error for error in errors))
+
+    def test_cleared_is_not_a_valid_k011_readiness_state(self) -> None:
+        altered = copy.deepcopy(self.baseline)
+        altered["sourceInventory"][0]["rights"]["scopeStates"]["public_distribution"] = "CLEARED"
+        errors = verifier.audit_report(altered, ROOT)
+        self.assertTrue(any("invalid or permissive rights state" in error for error in errors))
+
+    def test_mismatched_reason_total_fails_closed(self) -> None:
+        altered = copy.deepcopy(self.baseline)
+        first = next(iter(altered["k010Reconciliation"]["runs"].values()))
+        first["computedReasonCounts"] = {"FABRICATED": 1}
+        errors = verifier.audit_report(altered, ROOT)
+        self.assertTrue(any("K0.11 K0.10 reconciliation summary mismatch" in error for error in errors))
+
+    def test_source_lock_hash_mismatch_fails_closed(self) -> None:
+        altered = copy.deepcopy(self.baseline)
+        lock_id = next(
+            entry["sourceId"] for entry in altered["sourceInventory"]
+            if entry["registration"].get("sourceLock") == "K0.4A"
+        )
+        altered["sourceInventory"] = [entry for entry in altered["sourceInventory"] if entry["sourceId"] != lock_id]
+        errors = verifier.audit_report(altered, ROOT)
+        self.assertTrue(any("omits one or more K0.4A source-lock IDs" in error for error in errors))
+
+    def test_tatoeba_phases_cannot_be_collapsed(self) -> None:
+        altered = copy.deepcopy(self.baseline)
+        altered["phase14Tatoeba"]["14.5B"]["doNotCollapseWith14_5A"] = False
+        errors = verifier.audit_report(altered, ROOT)
+        self.assertTrue(any("14.5B must remain distinct" in error for error in errors))
+
+    def test_k010_narrative_table_cannot_drift_from_machine_counts(self) -> None:
+        altered = copy.deepcopy(self.baseline)
+        altered["k010Reconciliation"]["runs"]["syntheticEligible"]["narrativeRowLabel"] = "Empty export"
+        errors = verifier.audit_report(altered, ROOT)
+        self.assertTrue(any("narrative supplied/kind counts differ" in error for error in errors))
+
+
+if __name__ == "__main__":
+    unittest.main()
