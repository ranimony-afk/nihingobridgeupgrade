+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+import kanji_k0_candidate_simulation as simulation  # noqa: E402
+
+
+class CandidateSimulationTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self.records = {
+            "A": {"grade": 2, "freq": 1, "jlpt": 4, "nanori": False},
+            "B": {"grade": 9, "freq": 3, "jlpt": 1, "nanori": True},
+            "C": {"grade": None, "freq": 2, "jlpt": None, "nanori": False},
+            "D": {"grade": 1, "freq": None, "jlpt": None, "nanori": True},
+            "E": {"grade": None, "freq": None, "jlpt": 2, "nanori": False},
+        }
+
+    def test_scenario_counts_and_source_proxies_are_explicit(self) -> None:
+        result = simulation.calculate_summary(self.records, target_count=3)
+
+        self.assertEqual(result["dimension_proxy_counts"]["literacy_grade_1_6_or_8"], 2)
+        self.assertEqual(result["dimension_proxy_counts"]["frequency_rank_present"], 3)
+        self.assertEqual(result["dimension_proxy_counts"]["legacy_jlpt_present"], 3)
+        self.assertEqual(result["dimension_proxy_counts"]["name_grade_9_or_10"], 1)
+        self.assertEqual(result["intersections"]["frequency_and_name_grade"], 1)
+        self.assertEqual(result["union_counts"]["literacy_or_frequency"], 4)
+        self.assertEqual(result["union_counts"]["all_four_signals"], 5)
+
+        scenarios = {item["name"]: item for item in result["scenarios"]}
+        self.assertEqual(scenarios["literacy_first_proxy"]["candidate_count"], 2)
+        self.assertEqual(scenarios["frequency_first_proxy"]["candidate_count"], 3)
+        self.assertEqual(scenarios["learner_first_legacy_jlpt_proxy"]["candidate_count"], 3)
+        self.assertEqual(scenarios["comprehensive_reference_name_grade_proxy"]["candidate_count"], 3)
+        self.assertEqual(scenarios["balanced_hybrid_evidence_union_proxy"]["candidate_count"], 5)
+        self.assertFalse(result["union_counts"]["legacy_jlpt_adds_no_members_beyond_literacy_or_name_grade"])
+
+    def test_ranked_outsider_sensitivity_is_deterministic_but_unapproved(self) -> None:
+        result = simulation.calculate_summary(self.records, target_count=3)
+        sensitivity = result["literacy_core_plus_top_ranked_frequency_outsiders_sensitivity"]
+
+        self.assertEqual(sensitivity["status"], "SIMULATED_ONLY_NOT_APPROVED")
+        self.assertEqual(sensitivity["extension_slots_derived_from_target_minus_literacy_proxy"], 1)
+        self.assertEqual(sensitivity["cutoff_frequency_rank"], 2)
+        self.assertEqual(sensitivity["candidate_count"], 3)
+        self.assertEqual(sensitivity["ranked_members"], 2)
+        self.assertEqual(sensitivity["no_grade_members_in_extension"], 1)
+
+    def test_duplicate_frequency_ranks_fail_closed(self) -> None:
+        invalid = {
+            "A": {"grade": 1, "freq": 1, "jlpt": None, "nanori": False},
+            "B": {"grade": 2, "freq": 1, "jlpt": None, "nanori": False},
+        }
+        with self.assertRaisesRegex(ValueError, "rank values are not unique"):
+            simulation.calculate_summary(invalid, target_count=2)
+
+    def test_unpinned_input_is_rejected_before_xml_parsing(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "not-kanjidic2.xml"
+            path.write_text("not the pinned source", encoding="utf-8")
+            with self.assertRaisesRegex(ValueError, "pin mismatch"):
+                simulation.parse_pinned_source(path)
+
+    def test_output_shape_contains_only_aggregate_counts(self) -> None:
+        result = simulation.calculate_summary(self.records, target_count=3)
+        encoded = json.dumps(result, ensure_ascii=False, sort_keys=True)
+        self.assertNotIn('"candidate_rows"', encoded)
+        self.assertNotIn('"characters"', encoded)
+        self.assertIn('"signal_cohort_counts_only"', encoded)
+
+
+if __name__ == "__main__":
+    unittest.main()