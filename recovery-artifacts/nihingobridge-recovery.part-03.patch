+
+const FIRST_PARTY = "first-party:kanji-corpus:v1";
+const SHA = "a".repeat(64);
+
+describe("K0.5A source-specific append-only rights history", () => {
+  it("carries every K0.4A source into the rights history without treating hashes as clearance", () => {
+    const report = JSON.parse(readFileSync("reports/gates/PHASE-K0.4A-2501-KANJI-SOURCE-LOCK.json", "utf8")) as { sources: Array<{ sourceId: string }> };
+    expect(new Set(K0_5A_INITIAL_RIGHTS_HISTORY.map((event) => event.sourceRef))).toEqual(new Set(report.sources.map((source) => source.sourceId)));
+    expect(validateRightsHistory(K0_5A_INITIAL_RIGHTS_HISTORY).valid).toBe(true);
+    expect(currentRightsState(K0_5A_INITIAL_RIGHTS_HISTORY, "upstream:kanjidic2:2023-08", "derivation")).toBe("BLOCKED");
+    expect(currentRightsState(K0_5A_INITIAL_RIGHTS_HISTORY, "upstream:jmdict:2023-08", "public_distribution")).toBe("BLOCKED");
+    expect(sourceOperationDecision(K0_5A_INITIAL_RIGHTS_HISTORY, "upstream:kanjidic2:2023-08").allowed).toBe(false);
+    expect(sourceOperationDecision(K0_5A_INITIAL_RIGHTS_HISTORY, "upstream:jmdict:2023-08").allowed).toBe(false);
+    expect(() => assertSourceOperationAllowed(K0_5A_INITIAL_RIGHTS_HISTORY, "upstream:kanjidic2:2023-08")).toThrow(/RIGHTS_GATE/);
+    expect(() => assertSourceOperationAllowed(K0_5A_INITIAL_RIGHTS_HISTORY, "upstream:jmdict:2023-08")).toThrow(/RIGHTS_GATE/);
+    expect(() => assertSourceOperationAllowed(K0_5A_INITIAL_RIGHTS_HISTORY, "upstream:kanjivg:2024-08")).toThrow(/RIGHTS_GATE/);
+    expect(publicDistributionDecision(K0_5A_INITIAL_RIGHTS_HISTORY, [FIRST_PARTY]).allowed).toBe(false);
+  });
+
+  it("lists exact rights-evidence closure actions and compares alternatives without inventing coverage", () => {
+    const actions = rightsResolutionActions("upstream:kanjidic2:2023-08", K0_5A_INITIAL_RIGHTS_HISTORY);
+    expect(actions.effect).toBe("no_clearance_granted");
+    expect(actions.actions.map((item) => item.actionId)).toEqual(["K2-01", "K2-02", "K2-03", "K2-04"]);
+    expect(actions.actions[1].action).toContain("CC BY-SA 3.0 versus CC BY-SA 4.0");
+    const comparison = compareSourceAlternatives([
