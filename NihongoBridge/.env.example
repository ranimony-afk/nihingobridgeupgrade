# ==============================================================================
# Nihongo Bridge Unified Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to create your active ".env" or ".env.local" file before running.
# All sensitive credentials and endpoints must remain strictly inside process.env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (Agnostic PostgreSQL / Supabase / Neon / Railway)
# ------------------------------------------------------------------------------
# Purpose: Connection string for PostgreSQL driver ('pg' connection pool).
# Required: YES (in all environments).
# Production: Use Supabase Transaction Pooler (Port 6543) with ?sslmode=require.
# Development: Local pg (e.g. postgresql://postgres:postgres@127.0.0.1:5432/app_db).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ------------------------------------------------------------------------------
# 2. NextAuth.js Authentication Configuration
# ------------------------------------------------------------------------------
# Purpose: Secret key used to encrypt session cookies and JWT tokens.
# Required: YES (in all environments).
# Production: Cryptographically random 32-character string (openssl rand -base64 32).
# Development: Local placeholder (e.g. dev-secret-32-chars-long-key-value).
NEXTAUTH_SECRET="your-secure-32-character-random-secret-key"

# Purpose: Canonical canonical URL of your deployed application.
# Required: YES (in all environments).
# Production: Your custom production domain (e.g., https://nihongobridge.com).
# Development: Local development host (e.g., http://localhost:3000).
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Supabase Integration (REST & Storage Abstractions)
# ------------------------------------------------------------------------------
# Purpose: Public URL of your Supabase project instance.
# Required: OPTIONAL (required for active cloud file storage).
# Production: Your unique Supabase REST endpoint (https://xyzproject.supabase.co).
# Development: Local mock or developer test instance url.
SUPABASE_URL="https://your-supabase-project-id.supabase.co"

# Purpose: Anonymous public API key for client-side storage hooks.
# Required: OPTIONAL (required for client-side uploads).
# Production: Public anonymized key safe to expose to client bundlers.
# Development: Public anon developer placeholder.
SUPABASE_ANON_KEY="your-supabase-anon-public-api-key"

# Purpose: Admin service role key to bypass database RLS policies.
# Required: OPTIONAL (required for backend storage deletions).
# Production: Bypasses RLS. STRICTLY server-side only. Never expose to client!
# Development: Developer service role key.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-admin-key"

# ------------------------------------------------------------------------------
# 4. Email Delivery (Resend API)
# ------------------------------------------------------------------------------
# Purpose: API key for the Resend email transmission gateway.
# Required: OPTIONAL (required for password resets or invitations).
# Production: Live Resend account token starting with "re_".
# Development: Local sandbox mock email token.
RESEND_API_KEY="re_your-resend-api-credential-key"

# Purpose: Verified email address representing the platform sender.
# Required: OPTIONAL (required for outbound emails).
# Production: Custom verified domain address (e.g., onboarding@nihongobridge.com).
# Development: Default test sender (e.g., onrunning@resend.dev).
EMAIL_FROM="onboarding@your-verified-domain.com"

# ------------------------------------------------------------------------------
# 5. Social Authentication (Google OAuth)
# ------------------------------------------------------------------------------
# Purpose: Client identification code for Google OAuth authentication.
# Required: OPTIONAL (required for Google social logins).
# Production: Live Google Developer console credential id.
# Development: Local test project credential id.
GOOGLE_CLIENT_ID="your-google-oauth-client-id-string"

# Purpose: Client private secret key for Google OAuth authentication.
# Required: OPTIONAL (required for Google social logins).
# Production: Live private secret token (strictly secure).
# Development: Local test project secret token.
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret-token"

# ------------------------------------------------------------------------------
# 6. Admin Default Session Credentials (Cold Start Seeding)
# ------------------------------------------------------------------------------
# Purpose: Default email address to bootstrap the initial admin account.
# Required: YES (used during programmatic database seeding).
# Production: Managed admin email address (e.g., admin@nihongobridge.com).
# Development: Local developer email (e.g., admin@dev.local).
ADMIN_EMAIL="admin@nihongobridge.com"

# Purpose: Default secure password to bootstrap the initial admin account.
# Required: YES (used during programmatic database seeding).
# Production: Secure, cryptographically strong password.
# Development: Local dev placeholder (e.g., AdminPassword123!).
ADMIN_PASSWORD="AdminBootstrapPassword123!"

# ------------------------------------------------------------------------------
# 7. Redis Cache Layer Configuration
# ------------------------------------------------------------------------------
# Purpose: Redis connection URL for advanced session caching & rate-limit queues.
# Required: OPTIONAL (defaults to in-memory maps if missing).
# Production: Cloud Redis clusters (e.g. redis://default:pass@redis-server:6379).
# Development: Local docker or in-memory redis instance.
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 8. Sentry Application Monitoring
# ------------------------------------------------------------------------------
# Purpose: Client DSN key for real-time error logging & crash reporting.
# Required: OPTIONAL (omitted if Sentry is inactive).
# Production: Live production Sentry project ingestion URL.
# Development: Muted or local test Dentry project URL.
SENTRY_DSN="https://your-sentry-dsn-ingest-url@sentry.io/12345"

# ------------------------------------------------------------------------------
# 9. Artificial Intelligence Services (OpenAI API)
# ------------------------------------------------------------------------------
# Purpose: OpenAI private API key for conversational AI tutoring & speech evaluations.
# Required: OPTIONAL (required for active Speech Pronunciation and Role-plays).
# Production: Live billing-active OpenAI API secret starting with "sk-".
# Development: Shared billing-capped test API secret.
OPENAI_API_KEY="sk-your-openai-api-secret-service-token"
